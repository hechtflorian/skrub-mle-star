    learning_rate=0.03,
    num_leaves=31,
    subsample=0.9,
    colsample_bytree=0.85,
    random_state=42,
    verbose=-1,
)

pipeline = X_train.skb.apply(build_features).skb.apply(model, y=y_train)
val_learner = pipeline.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

final_validation_score = accuracy_score(valid_part[target_col].astype(int), pd.Series(valid_pred).astype(int))
print(f"Final Validation Performance: {final_validation_score}")
