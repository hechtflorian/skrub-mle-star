import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split

# Use the competition metric from task_description.txt (# Metric section)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def preprocess_df(df):
    df = df.copy()

    if "PassengerId" in df.columns:
        passenger_split = df["PassengerId"].astype(str).str.split("_", expand=True)
        df["PassengerGroup"] = passenger_split[0]
        df["PassengerNum"] = pd.to_numeric(passenger_split[1], errors="coerce")
        df["PassengerGroupSize"] = df.groupby("PassengerGroup")["PassengerGroup"].transform("size")
        df["PassengerIsSolo"] = (df["PassengerGroupSize"] == 1).astype("int64")
        df = df.drop(columns=["PassengerId"], errors="ignore")

    if "Cabin" in df.columns:
        cabin_split = df["Cabin"].astype(str).str.split("/", expand=True)
        df["CabinDeck"] = cabin_split[0]
        df["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
        df["CabinSide"] = cabin_split[2]
        df["CabinHasNum"] = df["CabinNum"].notna().astype("int64")
        df["CabinNumBin"] = pd.cut(
            df["CabinNum"],
            bins=[-np.inf, 500, 1500, 3000, np.inf],
            labels=False,
        )
        df = df.drop(columns=["Cabin"], errors="ignore")

    numeric_cols = ["Age", "RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    for col in numeric_cols:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    if all(col in df.columns for col in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]):
        spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
        df["Spent"] = df[spend_cols].sum(axis=1, min_count=1)
        df["NoSpending"] = (df["Spent"].fillna(0) == 0).astype(int)
        df["SpentLog1p"] = np.log1p(df["Spent"].fillna(0))

    if "Age" in df.columns:
        df["AgeBin"] = pd.cut(
            df["Age"],
            bins=[-np.inf, 12, 18, 30, 45, 60, np.inf],
            labels=False,
        )

    # Light cleaning for missing/infinite values and simple robustness.
    for col in df.columns:
        if pd.api.types.is_numeric_dtype(df[col]):
            df[col] = df[col].replace([np.inf, -np.inf], np.nan)
        elif df[col].dtype == "object":
            df[col] = df[col].replace([np.inf, -np.inf], np.nan)

    return df


def build_graph(data_train):
    data_fe = data_train.skb.apply_func(preprocess_df)
    X = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_fe[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()
    # Keep the same backbone and a single vectorizer after feature engineering.
    model = estimator

    return X.skb.apply(vectorizer).skb.apply(model, y=y)


data_train = skrub.var("data", train_part)
pred = build_graph(data_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = metric_fn(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
