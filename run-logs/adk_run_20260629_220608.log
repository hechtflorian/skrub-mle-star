train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def preprocess_df(df):
    df = df.copy()

    if "PassengerId" in df.columns:
        df["PassengerGroup"] = df["PassengerId"].astype(str).str.split("_").str[0]
        df["PassengerNum"] = pd.to_numeric(
            df["PassengerId"].astype(str).str.split("_").str[1], errors="coerce"
        )
        df = df.drop(columns=["PassengerId"], errors="ignore")

    if "Cabin" in df.columns:
        cabin_split = df["Cabin"].astype(str).str.split("/", expand=True)
        df["CabinDeck"] = cabin_split[0]
        df["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
        df["CabinSide"] = cabin_split[2]
        df = df.drop(columns=["Cabin"], errors="ignore")

    if "Name" in df.columns:
        df["NameLen"] = df["Name"].astype(str).str.len()
        df["NameWords"] = df["Name"].astype(str).str.split().str.len()
        df["Surname"] = df["Name"].astype(str).str.split().str[-1]
        df = df.drop(columns=["Name"], errors="ignore")

    numeric_cols = ["Age", "RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    for col in numeric_cols:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    if all(col in df.columns for col in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]):
        df["Spent"] = df[["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]].sum(axis=1)
        df["NoSpending"] = (df["Spent"].fillna(0) == 0).astype(int)

    if "Age" in df.columns:
        df["AgeBin"] = pd.cut(
            df["Age"],
            bins=[-np.inf, 12, 18, 30, 45, 60, np.inf],
            labels=False,
        )

    if "CabinNum" in df.columns:
        df["CabinNumBin"] = pd.cut(
            df["CabinNum"],
            bins=[-np.inf, 1000, 2000, 3000, 4000, np.inf],
            labels=False,
        )

    for col in df.columns:
        if df[col].dtype == "object":
            df[col] = df[col].astype("category").cat.codes.replace(-1, np.nan)

    return df


def add_room_ratios(df):
    out = df.copy()
    for a, b, name in [
        ("RoomService", "FoodCourt", "RoomFoodRatio"),
        ("ShoppingMall", "Spa", "ShopSpaRatio"),
    ]:
        if a in out.columns and b in out.columns:
            denom = out[b].replace(0, np.nan)
            out[name] = (out[a] / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    return out


def score_variant(variant_name, build_graph):
    data_train = skrub.var("data", train_part)
    pred_graph = build_graph(data_train)
    learner = pred_graph.skb.make_learner(fitted=True)
    valid_pred = np.asarray(learner.predict({"data": valid_part}), dtype=float)
    score = accuracy_score(valid_part[target_col], valid_pred > 0.5)
    print(f"Ablation[{variant_name}] accuracy: {score}")
    return score


cat_model = CatBoostClassifier(
    loss_function="Logloss",
    random_seed=42,
    verbose=0,
    iterations=600,
    depth=7,
    learning_rate=0.03,
    l2_leaf_reg=4.0,
    subsample=0.8,
    rsm=0.85,
)

rf_model = RandomForestClassifier(
    n_estimators=400,
    max_depth=None,
    min_samples_leaf=2,
    random_state=42,
    n_jobs=-1,
)


def baseline_graph(data_train):
    X = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_train[target_col].skb.mark_as_y()
    return X.skb.apply(skrub.TableVectorizer()).skb.apply(cat_model, y=y)


def no_derived_features_graph(data_train):
    raw = data_train.copy()
    raw = raw.drop(columns=[c for c in ["Spent", "NoSpending", "AgeBin", "CabinNumBin",
                                        "PassengerGroup", "PassengerNum", "CabinDeck", "CabinNum",
                                        "CabinSide", "NameLen", "NameWords", "Surname", "RoomFoodRatio",
                                        "ShopSpaRatio"] if c in raw.columns], errors="ignore")
    X = raw.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = raw[target_col].skb.mark_as_y()
    return X.skb.apply(skrub.TableVectorizer()).skb.apply(cat_model, y=y)


def no_passenger_cabin_name_graph(data_train):
    df = preprocess_df(data_train)
    drop_cols = [c for c in ["PassengerGroup", "PassengerNum", "CabinDeck", "CabinNum", "CabinSide",
                             "NameLen", "NameWords", "Surname"] if c in df.columns]
    df = df.drop(columns=drop_cols, errors="ignore")
    X = df.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = df[target_col].skb.mark_as_y()
    return X.skb.apply(skrub.TableVectorizer()).skb.apply(cat_model, y=y)


def add_ratios_graph(data_train):
    df = preprocess_df(data_train)
    df = df.skb.apply_func(add_room_ratios) if hasattr(df, "skb") else df
    X = df.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = df[target_col].skb.mark_as_y()
    return X.skb.apply(skrub.TableVectorizer()).skb.apply(cat_model, y=y)


def rf_baseline_graph(data_train):
    df = preprocess_df(data_train)
    X = df.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = df[target_col].skb.mark_as_y()
    return X.skb.apply(skrub.TableVectorizer()).skb.apply(rf_model, y=y)


scores = {}
scores["baseline"] = score_variant("baseline", baseline_graph)
scores["no_derived_features"] = score_variant("no_derived_features", no_derived_features_graph)
scores["no_passenger_cabin_name"] = score_variant("no_passenger_cabin_name", no_passenger_cabin_name_graph)
scores["with_ratios"] = score_variant("with_ratios", add_ratios_graph)
scores["rf_baseline"] = score_variant("rf_baseline", rf_baseline_graph)

best_variant = max(scores, key=scores.get)
best_score = scores[best_variant]
print(f"Best ablation variant: {best_variant} | accuracy: {best_score}")
