    df = df.copy()

    if "PassengerId" in df.columns:
        passenger_split = df["PassengerId"].astype(str).str.split("_", expand=True)
        df["PassengerGroup"] = passenger_split[0]
        df["PassengerNum"] = pd.to_numeric(passenger_split[1], errors="coerce")
        df = df.drop(columns=["PassengerId"], errors="ignore")

    if "Cabin" in df.columns:
        cabin_split = df["Cabin"].astype(str).str.split("/", expand=True)
        df["CabinDeck"] = cabin_split[0]
        df["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
        df["CabinSide"] = cabin_split[2]
        if "PassengerGroup" in df.columns:
            df["CabinDeckGroup"] = (
                df["CabinDeck"].astype(str).fillna("missing")
                + "_"
                + df["PassengerGroup"].astype(str).fillna("missing")
            )
        else:
            df["CabinDeckGroup"] = df["CabinDeck"].astype(str).fillna("missing")
        df = df.drop(columns=["Cabin"], errors="ignore")

    if "PassengerGroup" in df.columns:
        group_sizes = df.groupby("PassengerGroup", dropna=False)["PassengerGroup"].transform("size")
        df["GroupSize"] = pd.to_numeric(group_sizes, errors="coerce")
        df["IsAlone"] = (df["GroupSize"].fillna(0) <= 1).astype(int)

    if "Name" in df.columns:
        df = df.drop(columns=["Name"], errors="ignore")

    numeric_cols = ["Age", "RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    for col in numeric_cols:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    spend_cols = [col for col in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if col in df.columns]
    if spend_cols:
        spend_block = df[spend_cols]
        spend_sum = spend_block.fillna(0).sum(axis=1)
        df["AnySpent"] = (spend_sum > 0).astype(int)
        df["LogSpent"] = np.log1p(spend_sum)
        df["Spent"] = spend_block.sum(axis=1)
        df["NoSpending"] = (df["Spent"].fillna(0) == 0).astype(int)

    if "Age" in df.columns:
        df["AgeBin"] = pd.cut(
            df["Age"],
            bins=[-np.inf, 12, 18, 30, 45, 60, np.inf],
            labels=False,
        )

    if "CabinNum" in df.columns:
        df["CabinNumBin"] = pd.cut(
            df["CabinNum"],
            bins=[-np.inf, 1000, 2000, 3000, 4000, np.inf],
            labels=False,
        )

    df = df.replace([np.inf, -np.inf], np.nan)

    for col in df.columns:
        if pd.api.types.is_object_dtype(df[col]) or pd.api.types.is_string_dtype(df[col]):
            df[col] = df[col].astype("category").cat.codes.replace(-1, np.nan)

    return df


