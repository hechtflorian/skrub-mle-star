        df["AnySpent"] = spend_block.fillna(0).sum(axis=1).gt(0).astype(int)
        df["LogSpent"] = np.log1p(spend_block.fillna(0).sum(axis=1))
        df["Spent"] = spend_block.sum(axis=1)
        df["NoSpending"] = (df["Spent"].fillna(0) == 0).astype(int)

