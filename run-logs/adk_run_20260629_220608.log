train_idx, valid_idx = train_test_split(
    np.arange(len(train_df_proc)), test_size=0.2, random_state=42
)
train_part = train_df_proc.iloc[train_idx].copy()
valid_part = train_df_proc.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

cat_model = CatBoostClassifier(
    loss_function="Logloss",
    random_seed=42,
    verbose=0,
    iterations=600,
    depth=7,
    learning_rate=0.03,
    l2_leaf_reg=4.0,
    subsample=0.8,
    rsm=0.85,
)

data_train_2 = skrub.var("data2", train_part)
X_train_2 = data_train_2.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train_2 = data_train_2[target_col].skb.mark_as_y()

rf_model = RandomForestClassifier(
    n_estimators=400,
    max_depth=None,
    min_samples_leaf=2,
    random_state=42,
    n_jobs=-1,
)

vectorizer = skrub.TableVectorizer()

cat_pred_graph = X_train.skb.apply(vectorizer).skb.apply(cat_model, y=y_train)
rf_pred_graph = X_train_2.skb.apply(skrub.TableVectorizer()).skb.apply(rf_model, y=y_train_2)

cat_learner = cat_pred_graph.skb.make_learner(fitted=True)
rf_learner = rf_pred_graph.skb.make_learner(fitted=True)

valid_pred_cat = np.asarray(cat_learner.predict({"data": valid_part}), dtype=float)
valid_pred_rf = np.asarray(rf_learner.predict({"data2": valid_part}), dtype=float)

# Learn a tiny gate from validation data
valid_eval = valid_part.copy()
valid_eval["pred_cat"] = valid_pred_cat
valid_eval["pred_rf"] = valid_pred_rf
valid_eval["pred_blend"] = 0.7 * valid_eval["pred_cat"] + 0.3 * valid_eval["pred_rf"]
valid_eval["pred_cat_bin"] = valid_eval["pred_cat"] > 0.5
valid_eval["pred_rf_bin"] = valid_eval["pred_rf"] > 0.5
valid_eval["pred_blend_bin"] = valid_eval["pred_blend"] > 0.5

# Candidate rules; choose only if RF clearly wins
rule_candidates = []

def subset_win_stats(mask, name, min_n=25, min_margin=0.015):
    m = mask.fillna(False) if hasattr(mask, "fillna") else np.asarray(mask, dtype=bool)
    if m.sum() < min_n:
        return None
    y_true = valid_eval.loc[m, target_col]
    acc_cat = accuracy_score(y_true, valid_eval.loc[m, "pred_cat_bin"])
    acc_rf = accuracy_score(y_true, valid_eval.loc[m, "pred_rf_bin"])
    acc_blend = accuracy_score(y_true, valid_eval.loc[m, "pred_blend_bin"])
    margin = acc_rf - acc_cat
    return {
        "name": name,
        "n": int(m.sum()),
        "acc_cat": acc_cat,
        "acc_rf": acc_rf,
        "acc_blend": acc_blend,
        "margin": margin,
    }

candidate_masks = []

if "NoSpending" in valid_eval.columns:
    candidate_masks.append(("NoSpending==1", valid_eval["NoSpending"] == 1))
if "AgeBin" in valid_eval.columns:
    candidate_masks.append(("AgeBin<=1", valid_eval["AgeBin"].isin([0, 1])))
if "CabinDeck" in valid_eval.columns:
    candidate_masks.append(("CabinDeck_is_known", valid_eval["CabinDeck"].notna() & (valid_eval["CabinDeck"] >= 0)))
if "CabinSide" in valid_eval.columns:
    candidate_masks.append(("CabinSide_specific", valid_eval["CabinSide"].notna() & (valid_eval["CabinSide"] >= 0)))

if "PassengerGroup" in valid_eval.columns:
    grp_counts = valid_eval["PassengerGroup"].value_counts(dropna=False)
    valid_eval["PassengerGroupSize"] = valid_eval["PassengerGroup"].map(grp_counts).fillna(0)
    candidate_masks.append(("PassengerGroupSize>=2", valid_eval["PassengerGroupSize"] >= 2))

subset_reports = []
for name, mask in candidate_masks:
    rep = subset_win_stats(mask, name)
    if rep is not None:
        subset_reports.append(rep)

# Prefer RF only where it wins clearly and stably
rf_favored_rules = []
for rep in subset_reports:
    if rep["margin"] >= 0.015 and rep["acc_rf"] >= rep["acc_blend"]:
        rf_favored_rules.append(rep["name"])

def gate_predict(df, cat_pred, rf_pred):
    out = 0.7 * cat_pred + 0.3 * rf_pred  # default original blend
    if "NoSpending" in df.columns and "NoSpending==1" in rf_favored_rules:
        out = np.where(df["NoSpending"] == 1, rf_pred, out)
    if "AgeBin" in df.columns and "AgeBin<=1" in rf_favored_rules:
        out = np.where(df["AgeBin"].isin([0, 1]), rf_pred, out)
    if "CabinDeck" in df.columns and "CabinDeck_is_known" in rf_favored_rules:
        out = np.where(df["CabinDeck"].notna() & (df["CabinDeck"] >= 0), rf_pred, out)
    if "CabinSide" in df.columns and "CabinSide_specific" in rf_favored_rules:
        out = np.where(df["CabinSide"].notna() & (df["CabinSide"] >= 0), rf_pred, out)
    if "PassengerGroupSize>=2" in rf_favored_rules and "PassengerGroup" in df.columns:
        grp_counts_local = df["PassengerGroup"].value_counts(dropna=False)
        grp_size = df["PassengerGroup"].map(grp_counts_local).fillna(0)
        out = np.where(grp_size >= 2, rf_pred, out)
    return out

valid_pred_ens = gate_predict(valid_eval, valid_eval["pred_cat"].values, valid_eval["pred_rf"].values)
valid_pred_binary = valid_pred_ens > 0.5

final_validation_score = accuracy_score(valid_eval[target_col], valid_pred_binary)
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df_proc)
X_full = data_full.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].skb.mark_as_y()

data_full_2 = skrub.var("data2", train_df_proc)
X_full_2 = data_full_2.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full_2 = data_full_2[target_col].skb.mark_as_y()

full_cat_pred_graph = X_full.skb.apply(skrub.TableVectorizer()).skb.apply(cat_model, y=y_full)
full_rf_pred_graph = X_full_2.skb.apply(skrub.TableVectorizer()).skb.apply(rf_model, y=y_full_2)

full_cat_learner = full_cat_pred_graph.skb.make_learner(fitted=True)
full_rf_learner = full_rf_pred_graph.skb.make_learner(fitted=True)

test_pred_cat = np.asarray(full_cat_learner.predict({"data": test_df_proc}), dtype=float)
test_pred_rf = np.asarray(full_rf_learner.predict({"data2": test_df_proc}), dtype=float)

test_pred_ens = gate_predict(test_df_proc, test_pred_cat, test_pred_rf)
test_pred_binary = test_pred_ens > 0.5

submission = pd.DataFrame(
    {
        "PassengerId": test_df["PassengerId"],
        "Transported": test_pred_binary.astype(bool),
    }
)
submission.to_csv("submission.csv", index=False)
