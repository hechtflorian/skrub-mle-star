import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from catboost import CatBoostClassifier

train_df = pd.read_csv("./input/train.csv")
target_col = "Transported"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

def preprocess(df):
    df = df.copy()

    cabin = df["Cabin"].astype("string") if "Cabin" in df.columns else None
    if cabin is not None:
        cabin_parts = cabin.str.split("/", expand=True)
        df["CabinDeck"] = cabin_parts[0]
        df["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        df["CabinSide"] = cabin_parts[2]
        df = df.drop(columns=["Cabin"])

    if "Name" in df.columns:
        name = df["Name"].astype("string")
        df["NameLen"] = name.str.len()
        df["Surname"] = name.str.split().str[-1]
        df = df.drop(columns=["Name"])

    if "PassengerId" in df.columns:
        pid = df["PassengerId"].astype("string")
        parts = pid.str.split("_", expand=True)
        df["Group"] = parts[0]
        df["PassengerNum"] = pd.to_numeric(parts[1], errors="coerce")
        df = df.drop(columns=["PassengerId"])

    for col in ["CryoSleep", "VIP"]:
        if col in df.columns:
            df[col] = df[col].astype("string").map(
                {"True": 1, "False": 0, "true": 1, "false": 0}
            )

    return df

model = CatBoostClassifier(
    iterations=800,
    learning_rate=0.03,
    depth=6,
    loss_function="Logloss",
    eval_metric="Accuracy",
    random_seed=42,
    verbose=0,
    allow_writing_files=False,
)

pred = X_train.skb.apply_func(preprocess).skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred).astype(bool)

final_validation_score = accuracy_score(valid_part[target_col].values, valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
