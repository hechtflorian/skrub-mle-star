import os
import numpy as np
import pandas as pd
import skrub
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split
from catboost import CatBoostClassifier

# Load data
train_path = "./input/train.csv"
test_path = "./input/test.csv"
train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "Transported"

# Basic feature engineering helpers (kept simple and DataOps-friendly)
def add_features(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()

    # Cabin split
    cabin = df["Cabin"].astype("string")
    cabin_parts = cabin.str.split("/", expand=True)
    if cabin_parts.shape[1] >= 3:
        df["CabinDeck"] = cabin_parts[0]
        df["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        df["CabinSide"] = cabin_parts[2]
    else:
        df["CabinDeck"] = pd.NA
        df["CabinNum"] = np.nan
        df["CabinSide"] = pd.NA

    # Name split
    name = df["Name"].astype("string")
    df["Surname"] = name.str.split(" ", n=1, expand=True)[1]
    df["FirstNameLen"] = name.str.len()

    # Spending features
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    for c in spend_cols:
        df[c] = pd.to_numeric(df[c], errors="coerce")
    df["TotalSpend"] = df[spend_cols].sum(axis=1)
    df["NoSpend"] = (df["TotalSpend"].fillna(0) == 0).astype(int)
    df["SpentAny"] = (df["TotalSpend"].fillna(0) > 0).astype(int)

    # Family/group feature from PassengerId prefix
    df["GroupId"] = df["PassengerId"].astype("string").str.split("_", n=1, expand=True)[0]

    # Keep original columns; CatBoost can handle mixed types after vectorization
    return df

# Holdout split
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# DataOps binding
data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Preprocessing + vectorization
vectorizer = skrub.TableVectorizer(
    low_cardinality=skrub.ToCategorical(),
    high_cardinality=skrub.StringEncoder(),
)

# CatBoost model as required
model = CatBoostClassifier(
    iterations=3000,
    learning_rate=0.03,
    depth=6,
    loss_function="Logloss",
    eval_metric="Accuracy",
    random_seed=42,
    verbose=0,
)

# DataOps pipeline
pred = (
    X_train
    .skb.apply_func(add_features)
    .skb.apply(vectorizer)
    .skb.apply(model, y=y_train)
)

# Fit on train_part only and evaluate on valid_part
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

# Convert predictions to boolean labels if needed
if isinstance(valid_pred, pd.DataFrame):
    valid_pred = valid_pred.iloc[:, 0].to_numpy()
elif isinstance(valid_pred, list):
    valid_pred = np.asarray(valid_pred)
else:
    valid_pred = np.asarray(valid_pred)

if valid_pred.dtype != bool:
    # CatBoost predict may return labels as 0/1 or strings; normalize robustly
    valid_pred = pd.Series(valid_pred).map(
        lambda x: True if str(x).lower() in ["1", "true", "yes"] else False
    ).to_numpy()

final_validation_score = accuracy_score(valid_part[target_col].astype(bool), valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
