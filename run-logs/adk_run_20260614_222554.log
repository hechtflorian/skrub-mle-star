import numpy as np
import pandas as pd
import skrub
from lightgbm import LGBMClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

train_df = pd.read_csv("./input/train.csv")
target_col = "Transported"

# Holdout split for honest validation
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

@skrub.deferred
def add_space_features(df):
    out = df.copy()

    cabin = out["Cabin"].fillna("U/U/U").astype(str).str.split("/", expand=True)
    if cabin.shape[1] == 3:
        out["CabinDeck"] = cabin[0]
        out["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
        out["CabinSide"] = cabin[2]
    else:
        out["CabinDeck"] = "U"
        out["CabinNum"] = np.nan
        out["CabinSide"] = "U"

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    for c in spend_cols:
        if c not in out.columns:
            out[c] = np.nan

    out["TotalSpend"] = out[spend_cols].fillna(0).sum(axis=1)
    out["LogTotalSpend"] = np.log1p(out["TotalSpend"])
    out["NoSpend"] = (out["TotalSpend"] == 0).astype(int)

    out["Age"] = pd.to_numeric(out["Age"], errors="coerce")
    out["AgeBin"] = pd.cut(
        out["Age"],
        bins=[-np.inf, 12, 18, 25, 35, 50, np.inf],
        labels=["child", "teen", "young_adult", "adult", "mid_age", "senior"],
    ).astype("object")

    out["GroupSize"] = out["PassengerId"].astype(str).str.split("_").str[0].map(
        out["PassengerId"].astype(str).str.split("_").str[0].value_counts()
    )
    out["GroupSize"] = pd.to_numeric(out["GroupSize"], errors="coerce").fillna(1).astype(int)

    out["IsAlone"] = (out["GroupSize"] == 1).astype(int)

    out["FamilyName"] = out["Name"].fillna("Unknown").astype(str).str.split().str[-1]
    out["FirstName"] = out["Name"].fillna("Unknown").astype(str).str.split().str[0]

    out["IsCryoSleep"] = out["CryoSleep"].fillna(False).astype(int)
    out["IsVIP"] = out["VIP"].fillna(False).astype(int)

    dest = out["Destination"].fillna("Unknown").astype(str)
    home = out["HomePlanet"].fillna("Unknown").astype(str)
    out["HomeDest"] = home + "_" + dest

    out["SpendPerAge"] = out["TotalSpend"] / (out["Age"].fillna(out["Age"].median()) + 1.0)
    out["SpendPerGroup"] = out["TotalSpend"] / out["GroupSize"].replace(0, np.nan)
    out["SpendPerGroup"] = out["SpendPerGroup"].replace([np.inf, -np.inf], np.nan).fillna(0.0)

    return out

