import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from catboost import CatBoostClassifier
from lightgbm import LGBMClassifier

train_df = pd.read_csv("./input/train.csv")
target_col = "Transported"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def eval_variant(variant_name, train_frame, vectorizer, cat_kwargs=None, lgb_kwargs=None, drop_cols=None):
    data_train = skrub.var("data", train_frame)
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    if drop_cols:
        X_train = X_train.skb.apply(lambda df: df.drop(columns=drop_cols, errors="ignore"))

    cat_model = CatBoostClassifier(
        verbose=0,
        loss_function="Logloss",
        random_seed=42,
        **(cat_kwargs or {})
    )
    lgb_model = LGBMClassifier(
        random_state=42,
        verbose=-1,
        **(lgb_kwargs or {})
    )

    cat_pred = X_train.skb.apply(vectorizer).skb.apply(cat_model, y=y_train)
    lgb_pred = X_train.skb.apply(vectorizer).skb.apply(lgb_model, y=y_train)

    cat_learner = cat_pred.skb.make_learner(fitted=True)
    lgb_learner = lgb_pred.skb.make_learner(fitted=True)

    valid_input = valid_part.copy()
    if drop_cols:
        valid_input = valid_input.drop(columns=drop_cols, errors="ignore")

    cat_valid_pred = np.asarray(cat_learner.predict({"data": valid_input})).ravel()
    lgb_valid_pred = np.asarray(lgb_learner.predict({"data": valid_input})).ravel()

    cat_valid_pred = cat_valid_pred >= 0.5 if cat_valid_pred.dtype != bool else cat_valid_pred
    lgb_valid_pred = lgb_valid_pred >= 0.5 if lgb_valid_pred.dtype != bool else lgb_valid_pred

    ensemble_valid_pred = (cat_valid_pred.astype(float) + lgb_valid_pred.astype(float)) / 2.0
    ensemble_valid_pred = ensemble_valid_pred >= 0.5

    score = accuracy_score(valid_part[target_col], ensemble_valid_pred)
    print(f"Ablation[{variant_name}] accuracy: {score}")
    return score

results = {}

# Baseline: same structure as current solution
baseline_vectorizer = skrub.TableVectorizer()
results["baseline"] = eval_variant(
    "baseline",
    train_part,
    baseline_vectorizer,
    cat_kwargs=dict(),
    lgb_kwargs=dict(n_estimators=300, learning_rate=0.05),
)

# Ablation 1: change preprocessing/encoding by dropping obviously redundant high-cardinality identifiers
# PassengerId and Name are near-unique and likely weak/noisy for generalization.
drop_id_vectorizer = skrub.TableVectorizer()
results["drop_id_name"] = eval_variant(
    "drop_id_name",
    train_part,
    drop_id_vectorizer,
    cat_kwargs=dict(),
    lgb_kwargs=dict(n_estimators=300, learning_rate=0.05),
    drop_cols=["PassengerId", "Name"],
)

# Ablation 2: simpler LightGBM / CatBoost training budget to test model contribution
# Keep same family, but reduce tree budget slightly.
reduced_budget_vectorizer = skrub.TableVectorizer()
results["reduced_budget"] = eval_variant(
    "reduced_budget",
    train_part,
    reduced_budget_vectorizer,
    cat_kwargs=dict(iterations=300),
    lgb_kwargs=dict(n_estimators=150, learning_rate=0.05),
)

best_variant = max(results, key=results.get)
best_score = results[best_variant]
print(f"Best ablation variant: {best_variant} | accuracy: {best_score}")
