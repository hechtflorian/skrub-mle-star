import os
import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

train_path = "./input/train.csv"
test_path = "./input/test.csv"

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

def build_features(df):
    df = df.copy()

    cabin = df["Cabin"].fillna("U/U/U").astype(str).str.split("/", expand=True)
    cabin.columns = ["Deck", "Num", "Side"]
    df["Deck"] = cabin["Deck"]
    df["Num"] = pd.to_numeric(cabin["Num"], errors="coerce")
    df["Side"] = cabin["Side"]

    df["Cabin"] = df["Cabin"].fillna("U/U/U").astype(str)
    df["HomePlanet"] = df["HomePlanet"].fillna("Unknown").astype(str)
    df["Destination"] = df["Destination"].fillna("Unknown").astype(str)

    for c in ["CryoSleep", "VIP"]:
        df[c] = df[c].fillna(False).astype(bool).astype(str)

    df["Age"] = df["Age"].fillna(df["Age"].median())
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df[spend_cols] = df[spend_cols].fillna(0)
    df["TotalSpend"] = df[spend_cols].sum(axis=1)
    df["NoSpending"] = (df["TotalSpend"] == 0).astype(int)
    df["FamilySize"] = df["PassengerId"].astype(str).str.split("_").str[0].map(
        df["PassengerId"].astype(str).str.split("_").str[0].value_counts()
    ).fillna(1).astype(int)

    df["Num"] = df["Num"].fillna(df["Num"].median())
    return df

train_df = build_features(train_df)
test_df = build_features(test_df)

target_col = "Transported"
metric_name = "accuracy_score"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42, stratify=train_df[target_col].astype(int)
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=[target_col, "PassengerId", "Name"], errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].astype(int).skb.mark_as_y()

cat_cols = ["HomePlanet", "CryoSleep", "Cabin", "Destination", "VIP", "Deck", "Side"]
model = CatBoostClassifier(
    iterations=600,
    depth=6,
    learning_rate=0.05,
    loss_function="Logloss",
    verbose=0,
    random_seed=42,
)

pred_graph = X_train.skb.apply(model, y=y_train)
learner = pred_graph.skb.make_learner(fitted=True)

valid_X = valid_part.drop(columns=[target_col, "PassengerId", "Name"], errors="ignore")
valid_pred = learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred).reshape(-1).astype(int)

final_validation_score = accuracy_score(valid_part[target_col].astype(int), valid_pred)
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
X_full = data_full.drop(columns=[target_col, "PassengerId", "Name"], errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].astype(int).skb.mark_as_y()

full_pred_graph = X_full.skb.apply(model, y=y_full)
full_learner = full_pred_graph.skb.make_learner(fitted=True)

test_pred = full_learner.predict({"data": test_df})
test_pred = np.asarray(test_pred).reshape(-1).astype(bool)

submission = pd.DataFrame(
    {"PassengerId": test_df["PassengerId"], "Transported": test_pred}
)
submission.to_csv("submission.csv", index=False)
```
