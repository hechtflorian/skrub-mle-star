lgb_variants = {
    "lgb_le150_lr0.03": dict(n_estimators=150, learning_rate=0.03),
    "lgb_le150_lr0.05": dict(n_estimators=150, learning_rate=0.05),
    "lgb_le250_lr0.03": dict(n_estimators=250, learning_rate=0.03),
    "lgb_le250_lr0.05": dict(n_estimators=250, learning_rate=0.05),
}

cat_model = skrub.choose_from(
    {
        k: CatBoostClassifier(
            verbose=0,
            loss_function="Logloss",
            random_seed=42,
            n_jobs=1,
            **v,
        )
        for k, v in cat_variants.items()
    },
    name="cat_model_variant",
)

lgb_model = skrub.choose_from(
    {
        k: LGBMClassifier(
            random_state=42,
            verbose=-1,
            n_jobs=1,
            **v,
        )
        for k, v in lgb_variants.items()
    },
    name="lgb_model_variant",
)

cat_pred = X_train.skb.apply(vectorizer).skb.apply(cat_model, y=y_train)
lgb_pred = X_train.skb.apply(vectorizer).skb.apply(lgb_model, y=y_train)

search = cat_pred.skb.make_randomized_search(n_iter=4, n_jobs=1, random_state=42, fitted=True)
# chain search on the final prediction DataOp for both variants via the lgb path
search = lgb_pred.skb.make_randomized_search(n_iter=4, n_jobs=1, random_state=42, fitted=True)

search.fit({"data": train_part})

best_learner = search.best_learner_
valid_pred = np.asarray(best_learner.predict({"data": valid_part})).ravel()
valid_pred = valid_pred >= 0.5 if valid_pred.dtype != bool else valid_pred
final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")

best_params = {
    "cat_model_variant": None,
    "lgb_model_variant": None,
}
bp = getattr(search, "best_params_", {}) or {}
for key, value in bp.items():
    if isinstance(value, str) and value in cat_variants:
        best_params["cat_model_variant"] = cat_variants[value]
    elif isinstance(value, str) and value in lgb_variants:
        best_params["lgb_model_variant"] = lgb_variants[value]

if best_params["cat_model_variant"] is None:
    best_params["cat_model_variant"] = cat_variants["cb_d5_lr0.03_it100"]
if best_params["lgb_model_variant"] is None:
    best_params["lgb_model_variant"] = lgb_variants["lgb_le250_lr0.05"]

print("TUNING_BEST_PARAMS:", json.dumps(best_params, default=str))
