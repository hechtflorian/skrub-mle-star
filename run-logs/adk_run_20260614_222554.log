    df = df.copy()
    cabin = df["Cabin"].fillna("")
    df["CabinDeck"] = cabin.str.split("/").str[0].replace("", np.nan)
    df["CabinSide"] = cabin.str.split("/").str[2].replace("", np.nan)
    df["CabinNum"] = pd.to_numeric(cabin.str.split("/").str[1], errors="coerce")

    name = df["Name"].fillna("")
    df["Surname"] = name.str.split(" ").str[-1].replace("", np.nan)

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df["TotalSpent"] = df[spend_cols].fillna(0).sum(axis=1)
    df["NoSpend"] = (df["TotalSpent"] == 0).astype(int)
    df["AgeGroup"] = pd.cut(
        df["Age"],
        bins=[-1, 12, 18, 30, 50, 120],
        labels=["child", "teen", "young_adult", "adult", "senior"],
    )
    return df

def prepare_xy(df):
    df = add_features(df)
    y = df[target_col].astype(bool)
    X = df.drop(columns=[target_col], errors="ignore")
    return X, y

X_train_df, y_train = prepare_xy(train_part)
X_valid_df, y_valid = prepare_xy(valid_part)

# DataOps graph kept as the backbone path.
data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train_op = data_train[target_col].skb.mark_as_y()

# Baseline ablation
baseline_model = RandomForestClassifier(
    n_estimators=200,
    random_state=42,
    n_jobs=-1,
)
baseline_pred_graph = X_train.skb.apply(baseline_model, y=y_train_op)
baseline_learner = baseline_pred_graph.skb.make_learner(fitted=True)
baseline_valid_pred = baseline_learner.predict({"data": valid_part})
baseline_score = accuracy_score(y_valid, baseline_valid_pred)
print(f"Ablation[baseline] accuracy: {baseline_score}")

# Ablated variant
raw_data_train = skrub.var("data", train_part)
raw_X_train = raw_data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
raw_y_train = raw_data_train[target_col].skb.mark_as_y()

ablated_model = RandomForestClassifier(
    n_estimators=100,
    max_depth=8,
    random_state=42,
    n_jobs=-1,
)
ablated_pred_graph = raw_X_train.skb.apply(ablated_model, y=raw_y_train)
ablated_learner = ablated_pred_graph.skb.make_learner(fitted=True)
ablated_valid_pred = ablated_learner.predict({"data": valid_part})
ablated_score = accuracy_score(y_valid, ablated_valid_pred)
print(f"Ablation[ablated_variant] accuracy: {ablated_score}")

final_validation_score = baseline_score
print(f"Final Validation Performance: {final_validation_score}")
