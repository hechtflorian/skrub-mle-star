test_df = pd.read_csv("./input/test.csv")

target_col = "Transported"

# Basic preprocessing helpers
def preprocess(df):
    df = df.copy()

    # Cabin-derived features
    cabin = df["Cabin"].astype("string")
    cabin_split = cabin.str.split("/", expand=True)
    df["CabinDeck"] = cabin_split[0]
    df["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
    df["CabinSide"] = cabin_split[2]

    # Name-derived feature
    df["HasSurname"] = df["Name"].notna().astype(int)

    # Total spending feature
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df["TotalSpending"] = df[spend_cols].fillna(0).sum(axis=1)

    # Simplify boolean-like fields
    for col in ["CryoSleep", "VIP"]:
        df[col] = df[col].astype("boolean")

    # Drop raw text/high-cardinality columns handled by derived features
    df = df.drop(columns=["Cabin", "Name"], errors="ignore")
    return df

train_df = preprocess(train_df)
test_df = preprocess(test_df)

# Split train / validation
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# DataOps binding on train_part only
data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Keep backbone model class unchanged in spirit: RandomForestClassifier
model = RandomForestClassifier(
    n_estimators=300,
    random_state=42,
    n_jobs=-1,
    min_samples_leaf=1,
)

# DataOps pipeline
vectorizer = skrub.TableVectorizer()
pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

# Validation prediction step fixed: do not cast directly with astype(bool)
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

# Convert predictions safely to boolean labels if needed
valid_pred_arr = np.asarray(valid_pred)
if valid_pred_arr.dtype == bool:
    valid_pred_labels = valid_pred_arr
else:
    # Handle probability / score outputs robustly
    if valid_pred_arr.ndim > 1 and valid_pred_arr.shape[1] > 1:
        valid_pred_labels = np.argmax(valid_pred_arr, axis=1).astype(bool)
    else:
        valid_pred_labels = (valid_pred_arr >= 0.5)

final_validation_score = accuracy_score(valid_part[target_col].values, valid_pred_labels)
print(f"Final Validation Performance: {final_validation_score}")
