import numpy as np
import skrub
from sklearn.metrics import accuracy_score

data_train = skrub.var("data", train_part)

@skrub.deferred
def add_spaceship_features(df):
    out = df.copy()

    # Cabin-derived features
    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin_split = cabin.fillna("").str.split("/", expand=True)
        out["deck"] = cabin_split[0].replace("", np.nan)
        if cabin_split.shape[1] > 1:
            out["cabin_num"] = pd.to_numeric(cabin_split[1], errors="coerce")
        else:
            out["cabin_num"] = np.nan
        if cabin_split.shape[1] > 2:
            out["side"] = cabin_split[2].replace("", np.nan)
        else:
            out["side"] = np.nan

    # PassengerId-derived group size
    if "PassengerId" in out.columns:
        pid = out["PassengerId"].astype("string").fillna("")
        group_id = pid.str.split("_", n=1, expand=True)[0]
        out["passenger_group_id"] = group_id.replace("", np.nan)
        out["group_size"] = group_id.map(group_id.value_counts()).astype(float)
        out["group_size"] = out["group_size"].fillna(1.0)
    else:
        out["group_size"] = 1.0

    # Spend aggregates
    spend_cols = [c for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if c in out.columns]
    if spend_cols:
        spend_block = out[spend_cols].apply(pd.to_numeric, errors="coerce")
        out["total_spend"] = spend_block.sum(axis=1)
        out["luxury_spend"] = spend_block[[c for c in ["Spa", "VRDeck"] if c in spend_block.columns]].sum(axis=1)
        out["luxury_spend_ratio"] = (
            out["luxury_spend"] / out["total_spend"].replace(0, np.nan)
        ).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        out["spend_count"] = (spend_block.fillna(0.0) > 0).sum(axis=1).astype(float)
    else:
        out["total_spend"] = 0.0
        out["luxury_spend"] = 0.0
        out["luxury_spend_ratio"] = 0.0
        out["spend_count"] = 0.0

    return out

data_fe = data_train.skb.apply_func(add_spaceship_features)
X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_fe[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()

cat_model = CatBoostClassifier(
    verbose=0,
    loss_function="Logloss",
    random_seed=42,
)

lgb_model = LGBMClassifier(
    random_state=42,
    n_estimators=300,
    learning_rate=0.05,
    verbose=-1,
)

cat_pred = X_train.skb.apply(vectorizer).skb.apply(cat_model, y=y_train)
lgb_pred = X_train.skb.apply(vectorizer).skb.apply(lgb_model, y=y_train)

cat_learner = cat_pred.skb.make_learner(fitted=True)
lgb_learner = lgb_pred.skb.make_learner(fitted=True)

valid_data = skrub.var("data", valid_part).skb.apply_func(add_spaceship_features)

cat_valid_pred = np.asarray(cat_learner.predict({"data": valid_data})).ravel()
lgb_valid_pred = np.asarray(lgb_learner.predict({"data": valid_data})).ravel()

cat_valid_pred = cat_valid_pred >= 0.5 if cat_valid_pred.dtype != bool else cat_valid_pred
lgb_valid_pred = lgb_valid_pred >= 0.5 if lgb_valid_pred.dtype != bool else lgb_valid_pred

ensemble_valid_pred = (cat_valid_pred.astype(float) + lgb_valid_pred.astype(float)) / 2.0
ensemble_valid_pred = ensemble_valid_pred >= 0.5

final_validation_score = accuracy_score(valid_part[target_col], ensemble_valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
