import numpy as np
import skrub
from skrub import ApplyToCols, Cleaner, DropCols, SquashingScaler
from skrub import selectors as s
from lightgbm import LGBMClassifier

data_train = skrub.var("data", train_part)
X = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()


def add_structural_features(df):
    out = df.copy()

    if "PassengerId" in out.columns:
        pid = out["PassengerId"].astype("string")
        group = pid.str.split("_", n=1).str[0]
        out["PassengerGroupSize"] = group.map(group.value_counts()).fillna(1).astype(float)
        out["PassengerGroupId"] = group

    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin_parts = cabin.str.extract(r"^\s*([A-Za-z])\s*([0-9]+)?\s*([A-Za-z]?)\s*$")
        out["CabinDeck"] = cabin_parts[0]
        out["CabinNumber"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        out["CabinSide"] = cabin_parts[2].replace("", np.nan)
        out["HasCabin"] = cabin.notna().astype(float)

    return out


X_fe = X.skb.apply_func(add_structural_features)

# Explicit column routing:
# - drop noisy identifiers
# - keep low-cardinality categoricals
# - clean heavy-tailed numerics lightly before vectorization
X_fe = X_fe.skb.apply(DropCols(cols=s.cols("PassengerId")))
X_fe = X_fe.skb.apply(
    ApplyToCols(
        Cleaner(drop_if_constant=True),
        cols=s.numeric(),
        allow_reject=True,
    )
)
X_fe = X_fe.skb.apply(
    ApplyToCols(
        SquashingScaler(max_absolute_value=3),
        cols=s.numeric(),
        allow_reject=True,
    )
)

vectorizer = skrub.TableVectorizer(
    low_cardinality="passthrough",
    high_cardinality="drop",
)

model = LGBMClassifier(
    n_estimators=800,
    learning_rate=0.03,
    num_leaves=31,
    subsample=0.9,
    colsample_bytree=0.8,
    min_child_samples=40,
    reg_alpha=0.2,
    random_state=random_state,
    verbose=-1,
)

pred_graph = X_fe.skb.apply(vectorizer).skb.apply(model, y=y_train)
```
