import os
import json
import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split
from skrub import ApplyToCols, SquashingScaler

# Paths
INPUT_DIR = "./input"
train_path = os.path.join(INPUT_DIR, "train.csv")

# Load data
train_df = pd.read_csv(train_path)

target_col = "median_house_value"

# Holdout split for honest validation
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

@skrub.deferred
def add_guarded_housing_ratios(df):
    out = df.copy()

    if "total_rooms" in out.columns and "households" in out.columns:
        denom = out["households"].replace(0, np.nan)
        out["rooms_per_household_struct"] = (
            (out["total_rooms"] / denom)
            .replace([np.inf, -np.inf], np.nan)
            .fillna(0.0)
        )

    if "population" in out.columns and "households" in out.columns:
        denom = out["households"].replace(0, np.nan)
        out["population_per_household_struct"] = (
            (out["population"] / denom)
            .replace([np.inf, -np.inf], np.nan)
            .fillna(0.0)
        )

    return out

def build_graph(dataframe):
    data = skrub.var("data", dataframe)

    # frozen structural feature engineering block
    data = data.skb.apply_func(add_guarded_housing_ratios)

    X = data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data[target_col].skb.mark_as_y()

    # frozen preprocessing
    X = X.skb.apply(ApplyToCols(SquashingScaler(max_absolute_value=3), cols=skrub.selectors.numeric()))

    vectorizer = skrub.TableVectorizer()

    # focus block: model-side choose_from variant grid for non-sklearn estimator
    variants = {
        "d7_lr0.03": {
            "depth": 7,
            "learning_rate": 0.03,
            "iterations": 500,
        },
        "d8_lr0.03": {
            "depth": 8,
            "learning_rate": 0.03,
            "iterations": 500,
        },
        "d8_lr0.05": {
            "depth": 8,
            "learning_rate": 0.05,
            "iterations": 500,
        },
        "d9_lr0.03": {
            "depth": 9,
            "learning_rate": 0.03,
            "iterations": 500,
        },
    }
    model = skrub.choose_from(
        {
            k: CatBoostRegressor(
                loss_function="RMSE",
                random_seed=42,
                verbose=0,
                n_jobs=1,
                **params,
            )
            for k, params in variants.items()
        },
        name="model_variant",
    )

    pred_graph = X.skb.apply(vectorizer).skb.apply(model, y=y)
    return pred_graph, variants

pred, variants = build_graph(train_part)

# real holdout randomized search
search = pred.skb.make_randomized_search(n_iter=4, n_jobs=2, random_state=42, fitted=True)
search.fit({"data": train_part})

best_learner = search.best_learner_
valid_pred = best_learner.predict({"data": valid_part})
final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

# JSON-serializable best params
best_variant = search.best_params_.get("model_variant", None)
if hasattr(best_variant, "item"):
    best_variant = best_variant.item()
if best_variant is None and hasattr(search, "results_"):
    best_variant = search.results_.iloc[0].get("model_variant")

best_params = dict(variants[str(best_variant)])
print("TUNING_BEST_PARAMS:", json.dumps(best_params, default=str))
```
