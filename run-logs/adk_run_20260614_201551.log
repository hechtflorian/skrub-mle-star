    df["TotalSpend_x_CryoSleep"] = df["TotalSpend"] * cryo_num
    df["AgeBin_x_Deck"] = df["AgeBin"].astype("object").fillna("Missing").astype(str) + "_" + df["Deck"].astype("object").fillna("Missing").astype(str)

