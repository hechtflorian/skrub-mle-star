import pandas as pd
import skrub
import lightgbm as lgb
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

train_df = pd.read_csv("./input/train.csv")
target_col = "Transported"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def evaluate_variant(variant_name, data_frame, vectorizer, model):
    data_train = skrub.var("data", data_frame)
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
    val_learner = pred.skb.make_learner(fitted=True)
    valid_pred = val_learner.predict({"data": valid_part})
    score = accuracy_score(valid_part[target_col], valid_pred)
    print(f"Ablation[{variant_name}] accuracy_score: {score}")
    return score

baseline_vectorizer = skrub.TableVectorizer()
baseline_model = lgb.LGBMClassifier(
    random_state=42, n_estimators=200, learning_rate=0.05, verbose=-1
)

# Ablation 1: baseline
baseline_score = evaluate_variant(
    "baseline_tablevectorizer",
    train_part,
    baseline_vectorizer,
    baseline_model,
)

# Ablation 2: drop likely redundant high-cardinality identifiers
train_part_drop = train_part.drop(columns=["PassengerId", "Name"], errors="ignore")
drop_id_score = evaluate_variant(
    "drop_passengerid_name",
    train_part_drop,
    skrub.TableVectorizer(),
    lgb.LGBMClassifier(
        random_state=42, n_estimators=200, learning_rate=0.05, verbose=-1
    ),
)

# Ablation 3: cleaner preprocessing on the original training subset
clean_vectorizer = skrub.TableVectorizer(drop_uninformative=True)
clean_score = evaluate_variant(
    "drop_uninformative_in_vectorizer",
    train_part,
    clean_vectorizer,
    lgb.LGBMClassifier(
        random_state=42, n_estimators=200, learning_rate=0.05, verbose=-1
    ),
)

# Ablation 4: stronger regularization / simpler model
simple_model_score = evaluate_variant(
    "fewer_estimators_higher_lr",
    train_part,
    skrub.TableVectorizer(),
    lgb.LGBMClassifier(
        random_state=42, n_estimators=80, learning_rate=0.1, verbose=-1
    ),
)

scores = {
    "baseline_tablevectorizer": baseline_score,
    "drop_passengerid_name": drop_id_score,
    "drop_uninformative_in_vectorizer": clean_score,
    "fewer_estimators_higher_lr": simple_model_score,
}

best_variant = max(scores, key=scores.get)
best_score = scores[best_variant]
print(f"Best ablation variant: {best_variant} | accuracy_score: {best_score}")
