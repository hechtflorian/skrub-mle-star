        out["NameLength"] = name.str.len()
        out["Surname"] = name.str.split(" ", n=1).str[0]
        out["HasTitle"] = name.str.contains(
            r"\b(Mr|Mrs|Miss|Master|Dr|Rev|Col|Major|Mlle|Mme|Ms)\b",
            regex=True,
            na=False,
        )

    if {"PassengerGroup", "PassengerNum"}.issubset(out.columns):
        out["PassengerGroupSizeProxy"] = out["PassengerGroup"].map(
