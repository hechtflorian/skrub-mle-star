import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")
target_col = "Transported"

@skrub.deferred
def add_space_features(df):
    out = df.copy()

    cabin = out["Cabin"].fillna("M/0/S").astype(str).str.split("/", expand=True)
    cabin.columns = ["Deck", "Num", "Side"]
    out["Deck"] = cabin["Deck"].replace("", np.nan)
    out["Num"] = pd.to_numeric(cabin["Num"], errors="coerce")
    out["Side"] = cabin["Side"].replace("", np.nan)

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    for c in spend_cols:
        out[c] = pd.to_numeric(out[c], errors="coerce")
    out["Spending"] = out[spend_cols].fillna(0).sum(axis=1)
    out["LogSpending"] = np.log1p(out["Spending"])
    out["NoSpending"] = (out["Spending"] == 0).astype(int)

    out["Age"] = pd.to_numeric(out["Age"], errors="coerce")
    out["AgeSquared"] = out["Age"] ** 2
    out["AgeIsMissing"] = out["Age"].isna().astype(int)

    out["CryoSleep"] = out["CryoSleep"].map({True: 1, False: 0, "True": 1, "False": 0})
    out["VIP"] = out["VIP"].map({True: 1, False: 0, "True": 1, "False": 0})

    return out

def build_pipeline(train_part):
    data_train = skrub.var("data", train_part)
    data_fe = data_train.skb.apply_func(add_space_features)
    X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_fe[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer(
        low_cardinality=skrub.ToCategorical(),
        high_cardinality=skrub.StringEncoder(),
    )

    X_vec = X_train.skb.apply(vectorizer)

    model = CatBoostClassifier(
        iterations=1200,
        depth=6,
        learning_rate=0.03,
        loss_function="Logloss",
        eval_metric="Accuracy",
        random_seed=42,
        verbose=0,
    )

    pred_graph = X_vec.skb.apply(model, y=y_train)
    return pred_graph

train_part, valid_part = train_test_split(
    train_df, test_size=0.2, random_state=42, stratify=train_df[target_col].astype(int)
)

pred_graph = build_pipeline(train_part)
val_learner = pred_graph.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

final_validation_score = accuracy_score(
    valid_part[target_col].astype(int),
    np.asarray(valid_pred).astype(int).ravel(),
)

print(f"Final Validation Performance: {final_validation_score}")
```
