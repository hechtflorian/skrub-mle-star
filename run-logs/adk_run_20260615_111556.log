import os
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
import lightgbm as lgb

INPUT_DIR = "./input"
TRAIN_PATH = os.path.join(INPUT_DIR, "train.csv")
TEST_PATH = os.path.join(INPUT_DIR, "test.csv")

train_df = pd.read_csv(TRAIN_PATH)
test_df = pd.read_csv(TEST_PATH)

target_col = "Transported"

def add_features(df):
    df = df.copy()

    cabin = df["Cabin"].fillna("M/0/S").astype(str).str.split("/", expand=True)
    df["Deck"] = cabin[0].replace("nan", np.nan)
    df["Num"] = pd.to_numeric(cabin[1], errors="coerce")
    df["Side"] = cabin[2].replace("nan", np.nan)

    df["Group"] = df["PassengerId"].astype(str).str.split("_", expand=True)[0]
    df["GroupSize"] = df.groupby("Group")["PassengerId"].transform("count")
    df["IsAlone"] = (df["GroupSize"] == 1).astype(int)

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df["Spending"] = df[spend_cols].fillna(0).sum(axis=1)
    df["NoSpending"] = (df["Spending"] == 0).astype(int)
    df["AnyService"] = (df[spend_cols].fillna(0).sum(axis=1) > 0).astype(int)

    df["CabinNumMod3"] = (df["Num"] % 3).fillna(-1)
    df["AgeBin"] = pd.cut(df["Age"], bins=[-np.inf, 12, 18, 25, 35, 50, 65, np.inf], labels=False)

    return df

train_df = add_features(train_df)
test_df = add_features(test_df)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42, stratify=train_df[target_col].astype(int)
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

