from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()
target_col = "Transported"

@skrub.deferred
def add_structural_features(df):
    out = df.copy()

    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin_parts = cabin.str.split("/", expand=True)
        out["CabinDeck"] = cabin_parts[0]
        out["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        out["CabinSide"] = cabin_parts[2]

    if "PassengerId" in out.columns:
        passenger = out["PassengerId"].astype("string")
        out["PassengerGroup"] = passenger.str.split("_", n=1).str[0]

    return out

data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(add_structural_features)

X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_fe[target_col].skb.mark_as_y()

X_train = X_train.skb.apply(skrub.DropCols(cols=s.cols("PassengerId", "Cabin", "Name")))

numeric_selector = s.numeric()
categorical_selector = s.string() | s.categorical()

numeric_path = X_train.skb.select(numeric_selector).skb.apply(
    skrub.ApplyToCols(
        skrub.SquashingScaler(max_absolute_value=3),
        cols=numeric_selector,
        allow_reject=True,
    )
)

categorical_path = X_train.skb.select(categorical_selector).skb.apply(
    skrub.TableVectorizer(
        low_cardinality=skrub.ToCategorical(),
        high_cardinality=skrub.GapEncoder(n_components=4),
    )
)

X_train_proc = numeric_path.skb.concat([categorical_path], axis=1)

model = lgb.LGBMClassifier(
    random_state=42,
    n_estimators=300,
    learning_rate=0.05,
    num_leaves=31,
    min_child_samples=20,
    subsample=0.8,
    colsample_bytree=0.8,
    verbose=-1,
)

pred = X_train_proc.skb.apply(model, y=y_train)
val_learner = pred.skb.make_learner(fitted=True)

valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
