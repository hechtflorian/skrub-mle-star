import subprocess
import sys

subprocess.check_call([sys.executable, "-m", "pip", "install", "lightgbm"])

import numpy as np
import pandas as pd
import skrub
import skrub.selectors as s
import lightgbm as lgb
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")
target_col = "Transported"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

@skrub.deferred
def add_spaceship_features(df):
    out = df.copy()

    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin_parts = cabin.str.split("/", n=2, expand=True)
        if cabin_parts.shape[1] >= 1:
            out["CabinDeck"] = cabin_parts[0]
        if cabin_parts.shape[1] >= 2:
            out["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        if cabin_parts.shape[1] >= 3:
            out["CabinSide"] = cabin_parts[2]

    if "PassengerId" in out.columns:
        pid = out["PassengerId"].astype("string")
        out["PassengerGroup"] = pd.to_numeric(pid.str.split("_").str[0], errors="coerce")
        out["PassengerNum"] = pd.to_numeric(pid.str.split("_").str[1], errors="coerce")

    if "Name" in out.columns:
        name = out["Name"].astype("string")
        out["NameLength"] = name.str.len()
        out["Surname"] = name.str.split(" ", n=1).str[0]
        out["HasTitle"] = name.str.contains(r"\b(Mr|Mrs|Miss|Master|Dr|Rev|Col|Major|Mlle|Mme|Ms)\b", regex=True, na=False)

    if {"PassengerGroup", "PassengerNum"}.issubset(out.columns):
        out["PassengerGroupSizeProxy"] = out["PassengerGroup"].map(out["PassengerGroup"].value_counts(dropna=True))
        out["PassengerGroupSizeProxy"] = out["PassengerGroupSizeProxy"].fillna(0)

    return out

data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(add_spaceship_features)

X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

X_train = X_train.skb.apply(skrub.DropCols(cols=s.cols("PassengerId")))
X_train = X_train.skb.apply(skrub.ApplyToCols(skrub.Cleaner(drop_if_constant=True), cols=s.all()))
X_train = X_train.skb.apply(skrub.ApplyToCols(skrub.SquashingScaler(max_absolute_value=3), cols=s.numeric()))

vectorizer = skrub.TableVectorizer(
    high_cardinality=skrub.GapEncoder(),
    low_cardinality=skrub.ToCategorical(),
)
model = lgb.LGBMClassifier(
    random_state=42,
    n_estimators=300,
    learning_rate=0.05,
    verbose=-1,
)

pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
