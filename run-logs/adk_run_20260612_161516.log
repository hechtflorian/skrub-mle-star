import numpy as np
import skrub
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split
from sklearn.ensemble import HistGradientBoostingRegressor

# Keep the same holdout protocol and do not refit on full train_df here.
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)

@skrub.deferred
def add_structural_numeric_features(df):
    out = df.copy()

    # Keep baseline features, but add a small fixed structural preprocessing change
    # on correlated numeric columns. If the expected housing columns exist, create
    # a bounded density-style feature and a robust clipped version of the main ratio.
    if {"total_bedrooms", "total_rooms"}.issubset(out.columns):
        denom = out["total_rooms"].replace(0, np.nan)
        bedroom_room_ratio = (out["total_bedrooms"] / denom).replace(
            [np.inf, -np.inf], np.nan
        )
        out["bedrooms_per_room"] = bedroom_room_ratio.fillna(0.0)

    if {"population", "households"}.issubset(out.columns):
        denom = out["households"].replace(0, np.nan)
        pop_per_household = (out["population"] / denom).replace(
            [np.inf, -np.inf], np.nan
        )
        out["population_per_household"] = pop_per_household.fillna(0.0)

    if {"total_rooms", "households"}.issubset(out.columns):
        denom = out["households"].replace(0, np.nan)
        rooms_per_household = (out["total_rooms"] / denom).replace(
            [np.inf, -np.inf], np.nan
        )
        out["rooms_per_household"] = rooms_per_household.fillna(0.0)

    # Mild cleanup for numeric stability on heavy-tailed features.
    num_cols = out.select_dtypes(include=[np.number]).columns
    for col in num_cols:
        if col == target_col:
            continue
        vals = out[col]
        if vals.notna().any():
            lo = vals.quantile(0.01)
            hi = vals.quantile(0.99)
            if np.isfinite(lo) and np.isfinite(hi) and lo < hi:
                out[col] = vals.clip(lo, hi)

    return out

data_train_fe = data_train.skb.apply_func(add_structural_numeric_features)
X_train = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

# Single post-FE vectorizer on all features, as recommended for structural FE edits.
X_train_vec = X_train.skb.apply(skrub.TableVectorizer())

# Reuse a strong fixed tree baseline.
model = HistGradientBoostingRegressor(
    learning_rate=0.05,
    max_depth=6,
    max_iter=300,
    min_samples_leaf=20,
    l2_regularization=0.0,
    random_state=42,
)

pred_graph = X_train_vec.skb.apply(model, y=y_train)

val_learner = pred_graph.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")
