import numpy as np
import pandas as pd
import skrub
from lightgbm import LGBMRegressor
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

# Paths
train_path = os.path.join("./input", "train.csv")

# Load data
train_df = pd.read_csv(train_path)
target_col = "median_house_value"

# Holdout split (same as baseline)
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def evaluate_variant(variant_name, train_frame, build_graph_fn):
    data_train = skrub.var("data", train_frame)
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    pred_graph = build_graph_fn(X_train, y_train)
    learner = pred_graph.skb.make_learner(fitted=True)
    valid_pred = learner.predict({"data": valid_part})
    rmse = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
    print(f"Ablation[{variant_name}] RMSE: {rmse}")
    return rmse

# Shared models
lgbm_model = LGBMRegressor(
    n_estimators=2000,
    learning_rate=0.03,
    num_leaves=64,
    random_state=42,
    n_jobs=-1,
)

rf_model = RandomForestRegressor(
    n_estimators=200,
    random_state=42,
    n_jobs=-1,
)

# Variant 1: baseline ensemble from the current solution
def build_baseline(X_train, y_train):
    vectorizer = skrub.TableVectorizer()
    lgbm_pred_graph = X_train.skb.apply(vectorizer).skb.apply(lgbm_model, y=y_train)
    rf_pred_graph = X_train.skb.apply(vectorizer).skb.apply(rf_model, y=y_train)

    # Keep the same 0.7 / 0.3 ensemble logic
    lgbm_learner = lgbm_pred_graph.skb.make_learner(fitted=True)
    rf_learner = rf_pred_graph.skb.make_learner(fitted=True)

    class _EnsembleGraph:
        def __init__(self, lgbm_learner, rf_learner):
            self.lgbm_learner = lgbm_learner
            self.rf_learner = rf_learner

        def skb(self):
            return self

        def make_learner(self, fitted=True):
            return self

        def predict(self, env):
            lgbm_pred = self.lgbm_learner.predict(env)
            rf_pred = self.rf_learner.predict(env)
            return 0.7 * np.asarray(lgbm_pred) + 0.3 * np.asarray(rf_pred)

    # Minimal wrapper to preserve the two-model structure for ablation scoring
    return _EnsembleGraph(lgbm_learner, rf_learner)

# Variant 2: remove RandomForest and use only LightGBM
def build_lgbm_only(X_train, y_train):
    vectorizer = skrub.TableVectorizer()
    return X_train.skb.apply(vectorizer).skb.apply(lgbm_model, y=y_train)

# Variant 3: redundancy ablation, drop one highly correlated column
# total_bedrooms is strongly correlated with households / total_rooms
def build_drop_redundant(X_train, y_train):
    vectorizer = skrub.TableVectorizer()
    X_reduced = X_train.skb.apply(skrub.DropCols(cols=["total_bedrooms"]))
    return X_reduced.skb.apply(vectorizer).skb.apply(lgbm_model, y=y_train)

# Run ablations
baseline_rmse = evaluate_variant("baseline_ensemble", train_part, build_baseline)
lgbm_only_rmse = evaluate_variant("lgbm_only", train_part, build_lgbm_only)
drop_redundant_rmse = evaluate_variant("drop_total_bedrooms", train_part, build_drop_redundant)

results = {
    "baseline_ensemble": baseline_rmse,
    "lgbm_only": lgbm_only_rmse,
    "drop_total_bedrooms": drop_redundant_rmse,
}
best_variant = min(results, key=results.get)
best_score = results[best_variant]

print(f"Best ablation variant: {best_variant} | RMSE: {best_score}")
