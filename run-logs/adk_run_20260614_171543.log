# A few safe ratio transforms for common numeric pairs
common_ratio_pairs = [
    ("total_rooms", "households"),
    ("total_bedrooms", "total_rooms"),
    ("population", "households"),
    ("population", "total_rooms"),
]
for a, b in common_ratio_pairs:
