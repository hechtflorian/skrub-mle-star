seeds = [SEED, SEED + 7, SEED + 21]
oof_pred = np.zeros(len(X), dtype=float)
test_pred = np.zeros(len(test), dtype=float)

model_params = dict(
    iterations=5000,
    learning_rate=0.025,
    depth=8,
    loss_function="RMSE",
    eval_metric="RMSE",
    bagging_temperature=0.4,
    l2_leaf_reg=5.0,
