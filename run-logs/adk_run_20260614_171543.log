import os
import random
import subprocess
import sys

import numpy as np
import pandas as pd

# Ensure required package is available
try:
    from catboost import CatBoostRegressor, Pool
except ModuleNotFoundError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", "catboost"])
    from catboost import CatBoostRegressor, Pool

from sklearn.model_selection import KFold, train_test_split
from sklearn.metrics import mean_squared_error
from sklearn.linear_model import Ridge

SEED = 42
random.seed(SEED)
np.random.seed(SEED)

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train = pd.read_csv(train_path)
test = pd.read_csv(test_path)

target_col = "median_house_value"
X = train.drop(columns=[target_col]).copy()
y = train[target_col].copy()

# -----------------------------
# Common preprocessing
# -----------------------------
median_values = X.median(numeric_only=True)
X = X.fillna(median_values)
test = test.fillna(median_values)

# =============================
# Model A: simple CatBoost
# =============================
X_tr_A, X_val_A, y_tr_A, y_val_A = train_test_split(
    X, y, test_size=0.2, random_state=SEED
)

train_pool_A = Pool(X_tr_A, y_tr_A)
val_pool_A = Pool(X_val_A, y_val_A)

model_A = CatBoostRegressor(
    iterations=3000,
    learning_rate=0.03,
    depth=8,
    loss_function="RMSE",
    random_seed=SEED,
    verbose=200,
)

model_A.fit(
    train_pool_A,
    eval_set=val_pool_A,
    use_best_model=True
)

val_preds_A = model_A.predict(X_val_A)
val_rmse_A = np.sqrt(mean_squared_error(y_val_A, val_preds_A))

# Train Model A on full data for test predictions
full_pool_A = Pool(X, y)
model_A_full = CatBoostRegressor(
    iterations=3000,
    learning_rate=0.03,
    depth=8,
    loss_function="RMSE",
    random_seed=SEED,
    verbose=200,
)
model_A_full.fit(full_pool_A, verbose=200)
test_preds_A = model_A_full.predict(test)

# =============================
# Model B: stronger CatBoost with KFold + seed averaging
# =============================
# Minimal feature engineering
def add_features(df: pd.DataFrame) -> pd.DataFrame:
    out = df.copy()
    cols = list(out.columns)
    numeric_cols = [c for c in cols if pd.api.types.is_numeric_dtype(out[c])]

    # Safe engineered features from available numeric columns
    if len(numeric_cols) >= 2:
        out["num_sum"] = out[numeric_cols].sum(axis=1)
        out["num_mean"] = out[numeric_cols].mean(axis=1)
        out["num_std"] = out[numeric_cols].std(axis=1)
        out["num_min"] = out[numeric_cols].min(axis=1)
        out["num_max"] = out[numeric_cols].max(axis=1)
    if len(numeric_cols) >= 1:
        for c in numeric_cols[: min(5, len(numeric_cols))]:
            out[f"{c}_sq"] = out[c] ** 2
            out[f"{c}_log1p_abs"] = np.log1p(np.abs(out[c]))

    return out

X_B = add_features(X)
test_B = add_features(test)

# Align columns after feature engineering
X_B, test_B = X_B.align(test_B, join="left", axis=1, fill_value=np.nan)
X_B = X_B.fillna(X_B.median(numeric_only=True))
test_B = test_B.fillna(X_B.median(numeric_only=True))

kf = KFold(n_splits=5, shuffle=True, random_state=SEED)

oof_B = np.zeros(len(X_B))
test_preds_B = np.zeros(len(test_B))

seed_list = [SEED, SEED + 1]
for seed in seed_list:
    fold_test_pred = np.zeros(len(test_B))
    for fold, (tr_idx, va_idx) in enumerate(kf.split(X_B)):
        X_tr, X_va = X_B.iloc[tr_idx], X_B.iloc[va_idx]
        y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]

        train_pool = Pool(X_tr, y_tr)
        val_pool = Pool(X_va, y_va)

        model_B = CatBoostRegressor(
            iterations=4000,
            learning_rate=0.02,
            depth=8,
            loss_function="RMSE",
            random_seed=seed,
            verbose=200,
        )

        model_B.fit(train_pool, eval_set=val_pool, use_best_model=True)
        oof_B[va_idx] += model_B.predict(X_va) / len(seed_list)
        fold_test_pred += model_B.predict(test_B) / kf.n_splits

    test_preds_B += fold_test_pred / len(seed_list)

rmse_B = np.sqrt(mean_squared_error(y, oof_B))

# =============================
# Ensemble: simple stacking
# =============================
oof_A = np.zeros(len(X))
# For Model A, create aligned OOF using the same KFold strategy for blending
for tr_idx, va_idx in kf.split(X):
    X_tr, X_va = X.iloc[tr_idx], X.iloc[va_idx]
    y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]

    train_pool = Pool(X_tr, y_tr)
    val_pool = Pool(X_va, y_va)
    model_A_cv = CatBoostRegressor(
        iterations=3000,
        learning_rate=0.03,
        depth=8,
        loss_function="RMSE",
        random_seed=SEED,
        verbose=0,
    )
    model_A_cv.fit(train_pool, eval_set=val_pool, use_best_model=True)
    oof_A[va_idx] = model_A_cv.predict(X_va)

stack_train = np.column_stack([oof_A, oof_B])
stack_test = np.column_stack([test_preds_A, test_preds_B])

meta = Ridge(alpha=1.0, random_state=SEED)
meta.fit(stack_train, y)
final_oof = meta.predict(stack_train)
final_test = meta.predict(stack_test)

final_validation_score = np.sqrt(mean_squared_error(y, final_oof))

submission = pd.DataFrame({target_col: final_test})
submission.to_csv("submission.csv", index=False)

print(f"Model A Validation Performance: {val_rmse_A}")
print(f"Model B Validation Performance: {rmse_B}")
print(f"Final Validation Performance: {final_validation_score}")
