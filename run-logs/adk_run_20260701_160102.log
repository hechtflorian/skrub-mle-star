import numpy as np
import pandas as pd
import skrub
import skrub.selectors as s
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.linear_model import LogisticRegression

def fe_func(df):
    out = df.copy()

    cabin = out["Cabin"].fillna("X/0/X").astype(str)
    cabin_split = cabin.str.split("/", n=2, expand=True)

    out["CabinKnown"] = out["Cabin"].notna().astype(int)
    out["HasCabin"] = out["CabinKnown"]
    out["Deck"] = cabin_split[0].fillna("X").astype(str)
    out["Num"] = pd.to_numeric(cabin_split[1], errors="coerce")
    out["Side"] = cabin_split[2].fillna("X").astype(str)
    out["CabinDeckSide"] = out["Deck"].astype(str) + "_" + out["Side"].astype(str)

    pid = out["PassengerId"].astype(str)
    pid_split = pid.str.split("_", n=1, expand=True)

    passenger_group = pd.to_numeric(pid_split[0], errors="coerce")
    passenger_num = pd.to_numeric(pid_split[1], errors="coerce")

    out["PassengerGroup"] = passenger_group.fillna(-1).astype(int)
    out["PassengerNum"] = passenger_num.fillna(-1).astype(int)

    if passenger_group.notna().any():
        group_size = passenger_group.map(passenger_group.value_counts(dropna=False))
        out["GroupSize"] = group_size.fillna(1).astype(float)
        out["IsGroupAlone"] = (out["GroupSize"] <= 1).astype(int)
    else:
        out["GroupSize"] = 1.0
        out["IsGroupAlone"] = 1

    out["GroupSize"] = out["GroupSize"].fillna(1.0)
    return out


train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(fe_func)

X = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y = data_fe[target_col].skb.mark_as_y()

# Light routed preprocessing:
# - drop raw Cabin after parsing
# - route low-cardinality categoricals through a simple categorical cast
# - preserve higher-cardinality string fields for generic vectorization
X = X.skb.apply(skrub.DropCols(cols=s.cols("Cabin")))

low_card_str = s.string() & s.cardinality_below(40)
high_card_str = s.string() & ~s.cardinality_below(40)

X_low = X.skb.select(low_card_str).skb.apply(
    skrub.ApplyToCols(skrub.ToCategorical(), cols=s.all(), allow_reject=True)
)
X_high = X.skb.select(high_card_str)
X_num = X.skb.select(s.numeric())

X_routed = X_num.skb.concat([X_low, X_high], axis=1)

vectorizer = skrub.TableVectorizer()
pred = X_routed.skb.apply(vectorizer).skb.apply(
    LogisticRegression(max_iter=1000, class_weight="balanced"),
    y=y,
)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
