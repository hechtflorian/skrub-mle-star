import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split

def fe_func(df):
    out = df.copy()

    cabin_raw = out["Cabin"].fillna("X/0/X").astype(str)
    cabin_split = cabin_raw.str.split("/", n=2, expand=True)

    out["CabinKnown"] = out["Cabin"].notna().astype(int)
    out["HasCabin"] = out["CabinKnown"]

    out["Deck"] = cabin_split[0].fillna("X").astype(str)
    out["Num"] = pd.to_numeric(cabin_split[1], errors="coerce")
    out["Side"] = cabin_split[2].fillna("X").astype(str)
    out["CabinDeckSide"] = (
        out["Deck"].fillna("X").astype(str) + "_" + out["Side"].fillna("X").astype(str)
    )

    pid = out["PassengerId"].astype(str)
    pid_split = pid.str.split("_", n=1, expand=True)

    group_id = pd.to_numeric(pid_split[0], errors="coerce")
    group_num = pd.to_numeric(pid_split[1], errors="coerce")

    out["PassengerGroup"] = group_id
    out["PassengerNum"] = group_num

    if group_id.notna().any():
        group_counts = group_id.map(group_id.value_counts(dropna=False))
        out["GroupSize"] = group_counts.fillna(1).astype(float)
        out["IsGroupAlone"] = (out["GroupSize"] <= 1).astype(int)
    else:
        out["GroupSize"] = 1.0
        out["IsGroupAlone"] = 1

    out["GroupSize"] = out["GroupSize"].fillna(1.0)
    out["PassengerGroup"] = out["PassengerGroup"].fillna(-1).astype(int)
    out["PassengerNum"] = out["PassengerNum"].fillna(-1).astype(int)

    return out


train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(fe_func)

X = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y = data_fe[target_col].skb.mark_as_y()

import skrub.selectors as s
from skrub import DropCols, ApplyToCols, ToCategorical

# Light routed preprocessing:
# - keep parsed cabin/ID structure
# - explicitly route low-cardinality categoricals
# - drop raw Cabin after parsing since parsed pieces capture the signal
X_pre = X.skb.apply(DropCols(cols=s.cols("Cabin")))
X_cat = X_pre.skb.select(s.string() & s.cardinality_below(40)).skb.apply(
    ApplyToCols(ToCategorical(), cols=s.all(), allow_reject=True)
)
X_high = X_pre.skb.select(s.string() & ~s.cardinality_below(40))
X_num = X_pre.skb.select(s.numeric())

X_routed = X_num.skb.concat([X_cat, X_high], axis=1)
vectorizer = skrub.TableVectorizer()
predictor = X_routed.skb.apply(vectorizer).skb.apply(
    skrub.make_tabular_classifier() if hasattr(skrub, "make_tabular_classifier") else skrub.TableVectorizer(),
    y=y,
)

val_learner = predictor.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = accuracy_score(valid_part[target_col], valid_pred) if "accuracy_score" in globals() else metric_fn(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
