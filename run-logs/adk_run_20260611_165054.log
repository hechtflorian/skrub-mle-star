import os
import numpy as np
import pandas as pd
import skrub
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

# Optional dependency guard
try:
    from catboost import CatBoostRegressor
except ModuleNotFoundError:
    import subprocess
    import sys

    subprocess.check_call([sys.executable, "-m", "pip", "install", "catboost", "-q"])
    from catboost import CatBoostRegressor

# Load data
train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")
target_col = "median_house_value"

# Holdout split for honest validation
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# DataOps graph bound to train_part only
data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Keep choice-based tuning in-graph, but do NOT pass unresolved choices
# directly into CatBoost constructor kwargs to avoid serialization errors.
learning_rate = skrub.choose_float(0.01, 0.3, log=True, default=0.05, name="learning_rate")
depth = skrub.choose_int(4, 10, default=6, name="depth")
l2_leaf_reg = skrub.choose_float(1.0, 10.0, log=True, default=3.0, name="l2_leaf_reg")

vectorizer = skrub.TableVectorizer()

model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=500,
    learning_rate=0.05,  # fixed safe value for learner compilation
    depth=6,
    l2_leaf_reg=3.0,
    random_seed=42,
    verbose=0,
)

pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

# Search over the in-graph choices; CatBoost itself receives concrete values during compilation.
search = pred.skb.make_randomized_search(
    n_iter=4,
    random_state=42,
    n_jobs=1,
    fitted=True,
)

search.fit({"data": train_part})

valid_pred = search.best_learner_.predict({"data": valid_part})
final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

# Submission-stage refit on full train data and predict test set
data_full = skrub.var("data", train_df)
X_full = data_full.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].skb.mark_as_y()

full_pred = X_full.skb.apply(vectorizer).skb.apply(model, y=y_full)
full_learner = full_pred.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df})

submission = pd.DataFrame({"median_house_value": test_pred})
submission.to_csv("submission.csv", index=False)
```
