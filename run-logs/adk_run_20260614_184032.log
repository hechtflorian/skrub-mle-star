import numpy as np
import pandas as pd
import skrub
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split
from catboost import CatBoostRegressor

train_df = pd.read_csv("./input/train.csv")
target_col = "median_house_value"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def eval_variant(variant_name, data_frame, vectorizer, model):
    data_train = skrub.var("data", data_frame)
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    predictor = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
    val_learner = predictor.skb.make_learner(fitted=True)
    valid_pred = val_learner.predict({"data": valid_part})
    rmse = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
    print(f"Ablation[{variant_name}] RMSE: {rmse}")
    return rmse


baseline_vectorizer = skrub.TableVectorizer()
baseline_model = CatBoostRegressor(verbose=0, random_seed=42)

scores = {}
scores["baseline"] = eval_variant(
    "baseline", train_part, baseline_vectorizer, baseline_model
)

# Ablation 1: drop one highly redundant feature (households, correlated with bedrooms/rooms/population)
@skrub.deferred
def drop_households(df):
    out = df.copy()
    if "households" in out.columns:
        out = out.drop(columns=["households"])
    return out

data_train_drop = skrub.var("data", train_part).skb.apply_func(drop_households)
train_drop = data_train_drop.copy()
scores["drop_households"] = eval_variant(
    "drop_households",
    train_drop,
    skrub.TableVectorizer(),
    CatBoostRegressor(verbose=0, random_seed=42),
)

# Ablation 2: add a simple ratio feature to exploit correlated count columns
@skrub.deferred
def add_rooms_per_household(df):
    out = df.copy()
    if "total_rooms" in out.columns and "households" in out.columns:
        denom = out["households"].replace(0, np.nan)
        out["rooms_per_household"] = (
            (out["total_rooms"] / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        )
    return out

data_train_ratio = skrub.var("data", train_part).skb.apply_func(add_rooms_per_household)
train_ratio = data_train_ratio.copy()
scores["rooms_per_household"] = eval_variant(
    "rooms_per_household",
    train_ratio,
    skrub.TableVectorizer(),
    CatBoostRegressor(verbose=0, random_seed=42),
)

best_variant = min(scores, key=scores.get)
best_score = scores[best_variant]
print(f"Best ablation variant: {best_variant} | RMSE: {best_score}")
