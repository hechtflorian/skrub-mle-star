import os
import warnings

import numpy as np
import pandas as pd
import skrub
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

warnings.filterwarnings("ignore")


def main():
    train_path = os.path.join("./input", "train.csv")
    test_path = os.path.join("./input", "test.csv")

    train_df = pd.read_csv(train_path)
    test_df = pd.read_csv(test_path)

    target_col = "median_house_value"
    feature_cols = [c for c in train_df.columns if c != target_col]

    # Keep subsampling only for fast iteration/debugging; final evaluation uses full data.
    data = skrub.var("data", train_df)

    # Hold out a validation split for local performance reporting.
    train_part, valid_part = train_test_split(train_df, test_size=0.2, random_state=42)

    train_data = skrub.var("train_data", train_part)
    valid_data = skrub.var("valid_data", valid_part)
    test_data = skrub.var("test_data", test_df)

    X_train = train_data[feature_cols].skb.mark_as_X()
    y_train = train_data[target_col].skb.mark_as_y()

    X_valid = valid_data[feature_cols].skb.mark_as_X()
    y_valid = valid_data[target_col].skb.mark_as_y()

    X_test = test_data[feature_cols].skb.mark_as_X()

    vectorizer = skrub.TableVectorizer()

    # DataOps-first training graph
    X_train_vec = X_train.skb.apply(vectorizer)
    eval_model = HistGradientBoostingRegressor(random_state=42)
    train_pred = X_train_vec.skb.apply(eval_model, y=y_train)

    # Correct usage: compile the DataOps plan into a learner before predicting.
    train_learner = train_pred.skb.make_learner(fitted=True)

    valid_pred = train_learner.predict({"train_data": train_part, "valid_data": valid_part, "test_data": test_df, "data": valid_part})
    valid_pred = np.asarray(valid_pred).reshape(-1)

    final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
    print(f"Final Validation Performance: {final_validation_score}")

    # Fit final model on all training data and predict on test.
    full_X = data[feature_cols].skb.mark_as_X()
    full_y = data[target_col].skb.mark_as_y()
    full_X_vec = full_X.skb.apply(vectorizer)
    full_pred = full_X_vec.skb.apply(HistGradientBoostingRegressor(random_state=42), y=full_y)
    full_learner = full_pred.skb.make_learner(fitted=True)

    test_predictions = full_learner.predict({"data": test_df})
    test_predictions = np.asarray(test_predictions).reshape(-1)

    submission = pd.DataFrame({"median_house_value": test_predictions})
    submission.to_csv("submission.csv", index=False)


if __name__ == "__main__":
    main()
```
