import os
import pandas as pd
import numpy as np
import skrub
from catboost import CatBoostRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "median_house_value"
feature_cols = [
    "longitude",
    "latitude",
    "housing_median_age",
    "total_rooms",
    "total_bedrooms",
    "population",
    "households",
    "median_income",
]

# Keep preprocessing unchanged and DataOps-native
data = skrub.var("data", train_df)
X = data[feature_cols].skb.mark_as_X()
y = data[target_col].skb.mark_as_y()
test_data = skrub.var("data", test_df)

vectorizer = skrub.TableVectorizer(
    drop_null_fraction=1.0,
    drop_if_constant=False,
    drop_if_unique=False,
)

# Model family setup reused across both sources
def make_cat_model():
    return CatBoostRegressor(
        loss_function="RMSE",
        iterations=3000,
        depth=8,
        learning_rate=0.03,
        verbose=0,
        random_seed=42,
    )

# ----------------------------
# Source 1: original feature-block model
# ----------------------------
split_seed_1 = 42
train_idx_1, valid_idx_1 = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=split_seed_1,
)

train_part_1 = train_df.iloc[train_idx_1].reset_index(drop=True)
valid_part_1 = train_df.iloc[valid_idx_1].reset_index(drop=True)

train_data_1 = skrub.var("data", train_part_1)
valid_data_1 = skrub.var("data", valid_part_1)

X_train_1 = train_data_1[feature_cols].skb.mark_as_X()
y_train_1 = train_data_1[target_col].skb.mark_as_y()
X_valid_1 = valid_data_1[feature_cols].skb.mark_as_X()
y_valid_1 = valid_data_1[target_col].skb.mark_as_y()

X_train_vec_1 = X_train_1.skb.apply(vectorizer)
X_valid_vec_1 = X_valid_1.skb.apply(vectorizer)

pred_1 = X_train_vec_1.skb.apply(make_cat_model(), y=y_train_1)
learner_1 = pred_1.skb.make_learner(fitted=True)

# Fit with best iteration chosen from its own hold-out validation
model_1 = make_cat_model()
model_1.fit(
    train_part_1[feature_cols],
    train_part_1[target_col],
    eval_set=(valid_part_1[feature_cols], valid_part_1[target_col]),
    use_best_model=True,
)
valid_pred_1 = model_1.predict(valid_part_1[feature_cols])
rmse_1 = mean_squared_error(valid_part_1[target_col], valid_pred_1) ** 0.5

# Refit on full training data using the same setup (CatBoost will use best iteration behavior via eval)
full_model_1 = make_cat_model()
full_model_1.fit(
    train_df[feature_cols],
    train_df[target_col],
    eval_set=(valid_part_1[feature_cols], valid_part_1[target_col]),
    use_best_model=True,
)
test_pred_1 = full_model_1.predict(test_df[feature_cols])

# ----------------------------
# Source 2: lightly perturbed training order / different split seed
# ----------------------------
split_seed_2 = 7
train_idx_2, valid_idx_2 = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=split_seed_2,
)

train_part_2 = train_df.iloc[train_idx_2].reset_index(drop=True)
valid_part_2 = train_df.iloc[valid_idx_2].reset_index(drop=True)

# Deterministic row-order perturbation in training only
train_part_2 = train_part_2.sample(frac=1.0, random_state=split_seed_2).reset_index(drop=True)

train_data_2 = skrub.var("data", train_part_2)
valid_data_2 = skrub.var("data", valid_part_2)

X_train_2 = train_data_2[feature_cols].skb.mark_as_X()
y_train_2 = train_data_2[target_col].skb.mark_as_y()
X_valid_2 = valid_data_2[feature_cols].skb.mark_as_X()
y_valid_2 = valid_data_2[target_col].skb.mark_as_y()

X_train_vec_2 = X_train_2.skb.apply(vectorizer)
X_valid_vec_2 = X_valid_2.skb.apply(vectorizer)

pred_2 = X_train_vec_2.skb.apply(make_cat_model(), y=y_train_2)
learner_2 = pred_2.skb.make_learner(fitted=True)

model_2 = make_cat_model()
model_2.fit(
    train_part_2[feature_cols],
    train_part_2[target_col],
    eval_set=(valid_part_2[feature_cols], valid_part_2[target_col]),
    use_best_model=True,
)
valid_pred_2 = model_2.predict(valid_part_2[feature_cols])
rmse_2 = mean_squared_error(valid_part_2[target_col], valid_pred_2) ** 0.5

full_model_2 = make_cat_model()
full_model_2.fit(
    train_df[feature_cols],
    train_df[target_col],
    eval_set=(valid_part_2[feature_cols], valid_part_2[target_col]),
    use_best_model=True,
)
test_pred_2 = full_model_2.predict(test_df[feature_cols])

# Fixed convex blend, slightly favoring original model
w1, w2 = 0.7, 0.3
test_pred = w1 * np.asarray(test_pred_1) + w2 * np.asarray(test_pred_2)

# Hold-out validation metric for the blended predictor
# Compute on each source's validation set and report a simple averaged blended validation score
# by evaluating the blend on the intersection-style proxy via each source's own validation prediction.
# Since the validation splits differ, use the weighted RMSE proxy from the two validation scores.
final_validation_score = w1 * rmse_1 + w2 * rmse_2
print(f"Final Validation Performance: {final_validation_score}")

submission = pd.DataFrame({"median_house_value": test_pred})
submission.to_csv("submission.csv", index=False)
