import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

# Load training data only; ablation study evaluates on a hold-out validation split.
train_path = os.path.join("./input", "train.csv")
train_df = pd.read_csv(train_path)

target_col = "median_house_value"
feature_cols = [
    "longitude",
    "latitude",
    "housing_median_age",
    "total_rooms",
    "total_bedrooms",
    "population",
    "households",
    "median_income",
]

# Fixed validation split for all ablations
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].reset_index(drop=True)
valid_part = train_df.iloc[valid_idx].reset_index(drop=True)

# DataOps setup
train_data = skrub.var("data", train_part)
valid_data = skrub.var("data", valid_part)

X_train = train_data[feature_cols].skb.mark_as_X()
y_train = train_data[target_col].skb.mark_as_y()
X_valid = valid_data[feature_cols].skb.mark_as_X()
y_valid = valid_data[target_col].skb.mark_as_y()

# Baseline preprocessing block
base_vectorizer = skrub.TableVectorizer(
    drop_null_fraction=1.0,
    drop_if_constant=False,
    drop_if_unique=False,
)

# Ablation 1: baseline as in original script
X_train_base = X_train.skb.apply(base_vectorizer)
X_valid_base = X_valid.skb.apply(base_vectorizer)

base_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=3000,
    depth=8,
    learning_rate=0.03,
    verbose=0,
    random_seed=42,
)

base_pred_graph = X_train_base.skb.apply(base_model, y=y_train)
base_learner = base_pred_graph.skb.make_learner(fitted=True)
base_valid_pred = base_learner.predict({"data": valid_part})
base_rmse = mean_squared_error(valid_part[target_col], base_valid_pred) ** 0.5
print(f"Ablation[baseline] RMSE: {base_rmse}")

# Ablation 2: disable the vectorizer and feed raw numeric columns directly to CatBoost
raw_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=3000,
    depth=8,
    learning_rate=0.03,
    verbose=0,
    random_seed=42,
)

raw_pred_graph = X_train.skb.apply(raw_model, y=y_train)
raw_learner = raw_pred_graph.skb.make_learner(fitted=True)
raw_valid_pred = raw_learner.predict({"data": valid_part})
raw_rmse = mean_squared_error(valid_part[target_col], raw_valid_pred) ** 0.5
print(f"Ablation[no_vectorizer] RMSE: {raw_rmse}")

# Ablation 3: simplify the CatBoost model depth to test model complexity contribution
simple_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=3000,
    depth=4,
    learning_rate=0.03,
    verbose=0,
    random_seed=42,
)

simple_pred_graph = X_train_base.skb.apply(simple_model, y=y_train)
simple_learner = simple_pred_graph.skb.make_learner(fitted=True)
simple_valid_pred = simple_learner.predict({"data": valid_part})
simple_rmse = mean_squared_error(valid_part[target_col], simple_valid_pred) ** 0.5
print(f"Ablation[depth_4] RMSE: {simple_rmse}")

results = {
    "baseline": base_rmse,
    "no_vectorizer": raw_rmse,
    "depth_4": simple_rmse,
}

best_variant = min(results, key=results.get)
best_score = results[best_variant]

# Contribution analysis: compare each ablation to baseline.
deltas = {
    "no_vectorizer": raw_rmse - base_rmse,
    "depth_4": simple_rmse - base_rmse,
}

# Positive delta means worse than baseline.
most_contributing_part = min(deltas, key=lambda k: deltas[k])

print(f"Baseline RMSE: {base_rmse}")
print(f"No-vectorizer delta vs baseline: {deltas['no_vectorizer']}")
print(f"Depth-4 delta vs baseline: {deltas['depth_4']}")
print(f"Best ablation variant: {best_variant} | RMSE: {best_score}")
print(f"Part contributing most to overall performance: {most_contributing_part}")

# Keep the requested exact validation print line for the baseline.
final_validation_score = base_rmse
print(f"Final Validation Performance: {final_validation_score}")
