import os
import pandas as pd
import numpy as np
import skrub
from catboost import CatBoostRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "median_house_value"
feature_cols = [
    "longitude",
    "latitude",
    "housing_median_age",
    "total_rooms",
    "total_bedrooms",
    "population",
    "households",
    "median_income",
]

data = skrub.var("data", train_df)
X = data[feature_cols].skb.mark_as_X()
y = data[target_col].skb.mark_as_y()

test_data = skrub.var("data", test_df)

# DataOps-native feature preparation; keep it simple and directly aligned with the model.
# CatBoost can consume numeric features directly, so we use a TableVectorizer as a safe
# DataOps preprocessing layer for numeric pass-through and future-proofing.
vectorizer = skrub.TableVectorizer(
    drop_null_fraction=1.0,
    drop_if_constant=False,
    drop_if_unique=False,
)

X_vec = X.skb.apply(vectorizer)

cat_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=3000,
    depth=8,
    learning_rate=0.03,
    verbose=0,
    random_seed=42,
)

pred = X_vec.skb.apply(cat_model, y=y)

# Hold-out validation using a simple split on the source dataframe.
train_idx, valid_idx = train_test_split(np.arange(len(train_df)), test_size=0.2, random_state=42)

train_part = train_df.iloc[train_idx].reset_index(drop=True)
valid_part = train_df.iloc[valid_idx].reset_index(drop=True)

train_data = skrub.var("data", train_part)
valid_data = skrub.var("data", valid_part)

X_train = train_data[feature_cols].skb.mark_as_X()
y_train = train_data[target_col].skb.mark_as_y()
X_valid = valid_data[feature_cols].skb.mark_as_X()
y_valid = valid_data[target_col].skb.mark_as_y()

X_train_vec = X_train.skb.apply(vectorizer)
X_valid_vec = X_valid.skb.apply(vectorizer)

eval_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=3000,
    depth=8,
    learning_rate=0.03,
    verbose=0,
    random_seed=42,
)

eval_model.fit(train_part[feature_cols], train_part[target_col], eval_set=(valid_part[feature_cols], valid_part[target_col]), use_best_model=True)
valid_pred = eval_model.predict(valid_part[feature_cols])
final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

# Fit final model on all training data and predict test
final_learner = pred.skb.make_learner(fitted=True)
test_pred = final_learner.predict({"data": test_df})

submission = pd.DataFrame({"median_house_value": test_pred})
submission.to_csv("submission.csv", index=False)
```
