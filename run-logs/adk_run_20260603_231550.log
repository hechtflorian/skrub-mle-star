import warnings

import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostRegressor
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

warnings.filterwarnings("ignore")

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "median_house_value"
feature_cols = [
    "longitude",
    "latitude",
    "housing_median_age",
    "total_rooms",
    "total_bedrooms",
    "population",
    "households",
    "median_income",
]

train_part, valid_part = train_test_split(train_df, test_size=0.2, random_state=42)

# Main DataOps workflow
train_data = skrub.var("data", train_part)
valid_data = skrub.var("data", valid_part)
full_data = skrub.var("data", train_df)
test_data = skrub.var("data", test_df)

# Base numeric feature set, kept as the primary path
X_train = train_data[feature_cols].skb.mark_as_X()
y_train = train_data[target_col].skb.mark_as_y()
X_valid = valid_data[feature_cols].skb.mark_as_X()
y_valid = valid_data[target_col].skb.mark_as_y()
full_X = full_data[feature_cols].skb.mark_as_X()
full_y = full_data[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer(
    drop_null_fraction=1.0,
    drop_if_constant=False,
    drop_if_unique=False,
)

# Model 1: CatBoost baseline from the base solution
cat_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=3000,
    depth=8,
    learning_rate=0.03,
    verbose=0,
    random_seed=42,
)

cat_pred_graph = X_train.skb.apply(vectorizer).skb.apply(cat_model, y=y_train)
cat_learner = cat_pred_graph.skb.make_learner(fitted=True)
cat_valid_pred = np.asarray(cat_learner.predict({"data": valid_part})).ravel()

# Model 2: Reference solution model added for ensembling
hgb_vectorizer = skrub.TableVectorizer()
hgb_model = HistGradientBoostingRegressor(random_state=42)

hgb_pred_graph = X_train.skb.apply(hgb_vectorizer).skb.apply(hgb_model, y=y_train)
hgb_learner = hgb_pred_graph.skb.make_learner(fitted=True)
hgb_valid_pred = np.asarray(hgb_learner.predict({"data": valid_part})).ravel()

# Simple average ensemble
valid_pred = 0.5 * cat_valid_pred + 0.5 * hgb_valid_pred
y_valid_np = valid_part[target_col].to_numpy().ravel()
final_validation_score = mean_squared_error(y_valid_np, valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

# Refit both models on the full training data and ensemble test predictions
cat_full_graph = full_X.skb.apply(vectorizer).skb.apply(cat_model, y=full_y)
cat_full_learner = cat_full_graph.skb.make_learner(fitted=True)
cat_test_pred = np.asarray(cat_full_learner.predict({"data": test_df})).ravel()

hgb_full_graph = full_X.skb.apply(hgb_vectorizer).skb.apply(hgb_model, y=full_y)
hgb_full_learner = hgb_full_graph.skb.make_learner(fitted=True)
hgb_test_pred = np.asarray(hgb_full_learner.predict({"data": test_df})).ravel()

test_pred = 0.5 * cat_test_pred + 0.5 * hgb_test_pred

submission = pd.DataFrame({target_col: test_pred})
submission.to_csv("submission.csv", index=False)
