import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

random_state = 42
target_col = "Personality"
cat_cols = ["Stage_fear", "Drained_after_socializing"]

train_df = pd.read_csv("./input/train.csv")

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col],
)

train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

for c in cat_cols:
    train_part[c] = train_part[c].astype("string").fillna("missing")
    valid_part[c] = valid_part[c].astype("string").fillna("missing")

train_part[target_col] = train_part[target_col].map({"Introvert": 0, "Extrovert": 1})
valid_part[target_col] = valid_part[target_col].map({"Introvert": 0, "Extrovert": 1})

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=["id", target_col], errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

model = CatBoostClassifier(
    iterations=500,
    depth=6,
    learning_rate=0.05,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_state=random_state,
)

predictor = X_train.skb.apply(model, y=y_train, cat_features=cat_cols)
val_learner = predictor.skb.make_learner(fitted=True)

valid_features = valid_part.drop(columns=["id", target_col], errors="ignore")
valid_pred = val_learner.predict({"data": valid_features})
valid_pred = np.asarray(valid_pred).reshape(-1)

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
