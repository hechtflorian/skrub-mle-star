    candidate_float_cols = [
        col
        for col in out.columns
        if col != target_col and str(out[col].dtype).startswith("float")
    ]

    casted = 0
    for col in candidate_float_cols:
        non_null = out[col].dropna()
        if len(non_null) == 0:
            continue
        rounded = non_null.round()
        if ((non_null - rounded).abs() < 1e-8).all() and non_null.nunique() <= 20:
