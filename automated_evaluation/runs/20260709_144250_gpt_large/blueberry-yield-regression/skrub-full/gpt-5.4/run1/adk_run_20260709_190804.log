data_train = skrub.var("data", train_part)

def add_biological_ratio_features(df):
    out = df.copy()

    def has_cols(*cols):
        return all(col in out.columns for col in cols)

    def safe_div(numer, denom):
        return (
            (numer / denom.replace(0, np.nan))
            .replace([np.inf, -np.inf], np.nan)
            .fillna(0.0)
        )

    if has_cols("bumbles", "andrena", "osmia"):
        out["pollinator_total"] = out["bumbles"] + out["andrena"] + out["osmia"]

    if has_cols("pollinator_total", "clonesize"):
        out["pollinator_per_clonesize"] = safe_div(
            out["pollinator_total"], out["clonesize"]
        )

    if has_cols("honeybee", "clonesize"):
        out["honeybee_per_clonesize"] = safe_div(out["honeybee"], out["clonesize"])

    if has_cols("honeybee", "pollinator_total"):
        out["honeybee_to_pollinator_total_ratio"] = safe_div(
            out["honeybee"], out["pollinator_total"]
        )

    if has_cols("MaxUpperTRange", "MinLowerTRange"):
        out["temperature_range_spread"] = (
            out["MaxUpperTRange"] - out["MinLowerTRange"]
        )

    if has_cols("RainingDays", "AverageRainingDays"):
        out["rain_intensity_ratio"] = safe_div(
            out["RainingDays"], out["AverageRainingDays"]
        )

    return out

