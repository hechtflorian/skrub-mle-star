import numpy as np
import pandas as pd
import skrub
from sklearn.base import BaseEstimator, TransformerMixin
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error
from xgboost import XGBRegressor


class CovidOrdinalDateFeatures(BaseEstimator, TransformerMixin):
    def __init__(self):
        pass

    def fit(self, X, y=None):
        return self

    def transform(self, X):
        X = X.copy()
        date = pd.to_datetime(X["Date"])
        X["DateOrdinal"] = date.map(pd.Timestamp.toordinal).astype(float)
        X["Month"] = date.dt.month.astype(float)
        X["Day"] = date.dt.day.astype(float)
        X["DayOfWeek"] = date.dt.dayofweek.astype(float)
        return X


def rmsle(y_true, y_pred):
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    y_pred = np.maximum(y_pred, 0.0)
    return mean_squared_log_error(y_true, y_pred) ** 0.5


def build_predictor(X, y):
    feature_builder = CovidOrdinalDateFeatures()
    model = XGBRegressor(
        n_estimators=200,
        max_depth=6,
        learning_rate=0.05,
        subsample=0.8,
        colsample_bytree=0.8,
        objective="reg:squarederror",
        random_state=42,
        n_jobs=1,
        verbosity=0,
    )
    predictor = (
        X.skb.apply(feature_builder)
        .skb.apply(skrub.TableVectorizer())
        .skb.apply(model, y=np.log1p(y))
    )
    return predictor


def fit_and_predict(train_part, valid_part, target_col):
    data_train = skrub.var("data", train_part)
    X_train = data_train.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    predictor = build_predictor(X_train, y_train)
    learner = predictor.skb.make_learner(fitted=True)
    pred_log = learner.predict({"data": valid_part})
    pred = np.expm1(np.asarray(pred_log, dtype=float))
    pred = np.maximum(pred, 0.0)
    return pred


def main():
    train_df = pd.read_csv("./input/train.csv")

    random_state = 42
    train_idx, valid_idx = train_test_split(
        np.arange(len(train_df)), test_size=0.2, random_state=random_state
    )
    train_part = train_df.iloc[train_idx].copy()
    valid_part = train_df.iloc[valid_idx].copy()

    confirmed_pred = fit_and_predict(train_part, valid_part, "ConfirmedCases")
    fatalities_pred = fit_and_predict(train_part, valid_part, "Fatalities")

    confirmed_score = rmsle(valid_part["ConfirmedCases"], confirmed_pred)
    fatalities_score = rmsle(valid_part["Fatalities"], fatalities_pred)
    final_validation_score = (confirmed_score + fatalities_score) / 2.0

    print(f"Final Validation Performance: {final_validation_score}")


if __name__ == "__main__":
    main()
