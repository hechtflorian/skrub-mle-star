import glob
import os
import numpy as np
import pandas as pd
import skrub
from lightgbm import LGBMRegressor
from sklearn.metrics import mean_squared_log_error

RANDOM_STATE = 42

def rmsle_sum(y_true_cases, y_pred_cases, y_true_fatal, y_pred_fatal):
    score_cases = mean_squared_log_error(
        np.clip(y_true_cases, 0, None),
        np.clip(y_pred_cases, 0, None)
    ) ** 0.5
    score_fatal = mean_squared_log_error(
        np.clip(y_true_fatal, 0, None),
        np.clip(y_pred_fatal, 0, None)
    ) ** 0.5
    return (score_cases + score_fatal) / 2.0

def build_features(df, min_date):
    out = df.copy()
    out["Province_State"] = out["Province_State"].fillna("")
    out["Country_Region"] = out["Country_Region"].fillna("")
    out["Region"] = out["Country_Region"] + "_" + out["Province_State"]
    out["Date"] = pd.to_datetime(out["Date"])
    out = out.sort_values(["Region", "Date"]).reset_index(drop=True)
    out["day"] = (out["Date"] - min_date).dt.days
    out["month"] = out["Date"].dt.month
    out["dayofweek"] = out["Date"].dt.dayofweek
    out["dayofmonth"] = out["Date"].dt.day
    out["weekofyear"] = out["Date"].dt.isocalendar().week.astype(int)

    for lag in [1, 2, 3, 7]:
        out[f"cc_lag_{lag}"] = out.groupby("Region")["ConfirmedCases"].shift(lag)
        out[f"ft_lag_{lag}"] = out.groupby("Region")["Fatalities"].shift(lag)

    out["cc_growth_1"] = out["cc_lag_1"] - out["cc_lag_2"]
    out["ft_growth_1"] = out["ft_lag_1"] - out["ft_lag_2"]

    lag_cols = [c for c in out.columns if "lag" in c or "growth" in c]
    out[lag_cols] = out[lag_cols].fillna(0.0)
    return out

def make_target_frame(feature_df, target_col):
    cols = ["Region", "Date", "day", "month", "dayofweek", "dayofmonth", "weekofyear"]
    cols += [c for c in feature_df.columns if "lag" in c or "growth" in c]
    cols += [target_col]
    return feature_df[cols].copy()

train_candidates = sorted(glob.glob("./input/**/*.csv", recursive=True))
train_path = [p for p in train_candidates if os.path.basename(p).lower() == "train.csv"][0]
train_df = pd.read_csv(train_path)

train_df["Date"] = pd.to_datetime(train_df["Date"])
max_date = train_df["Date"].max()
valid_days = 10

train_part = train_df[train_df["Date"] <= (max_date - pd.Timedelta(days=valid_days))].copy()
valid_part = train_df[train_df["Date"] > (max_date - pd.Timedelta(days=valid_days))].copy()

min_date = train_part["Date"].min()
train_feat = build_features(train_part, min_date)
valid_feat = build_features(valid_part, min_date)

cases_train_df = make_target_frame(train_feat, "ConfirmedCases")
fatal_train_df = make_target_frame(train_feat, "Fatalities")

case_feature_cols = [c for c in cases_train_df.columns if c != "ConfirmedCases"]
fatal_feature_cols = [c for c in fatal_train_df.columns if c != "Fatalities"]

data_cases = skrub.var("data", cases_train_df)
X_cases = data_cases[case_feature_cols].skb.mark_as_X()
y_cases = data_cases["ConfirmedCases"].skb.mark_as_y()

data_fatal = skrub.var("data", fatal_train_df)
X_fatal = data_fatal[fatal_feature_cols].skb.mark_as_X()
y_fatal = data_fatal["Fatalities"].skb.mark_as_y()

case_model = X_cases.skb.apply(
    LGBMRegressor(
        n_estimators=500,
        learning_rate=0.05,
        num_leaves=31,
        random_state=RANDOM_STATE,
        verbose=-1
    ),
    y=np.log1p(y_cases)
)

fatal_model = X_fatal.skb.apply(
    LGBMRegressor(
        n_estimators=500,
        learning_rate=0.05,
        num_leaves=31,
        random_state=RANDOM_STATE,
        verbose=-1
    ),
    y=np.log1p(y_fatal)
)

case_learner = case_model.skb.make_learner(fitted=True)
fatal_learner = fatal_model.skb.make_learner(fitted=True)

valid_case_input = valid_feat[case_feature_cols].copy()
valid_fatal_input = valid_feat[fatal_feature_cols].copy()

pred_cases = np.expm1(case_learner.predict({"data": valid_case_input})).clip(0)
pred_fatal = np.expm1(fatal_learner.predict({"data": valid_fatal_input})).clip(0)

final_validation_score = rmsle_sum(
    valid_feat["ConfirmedCases"].values,
    pred_cases,
    valid_feat["Fatalities"].values,
    pred_fatal
)

print(f"Final Validation Performance: {final_validation_score}")
```
