import numpy as np
import pandas as pd
import skrub
from lightgbm import LGBMRegressor
from sklearn.model_selection import train_test_split

warnings.filterwarnings("ignore")


INPUT_DIR = "./input"
RANDOM_STATE = 42
VALID_SIZE = 0.2


def find_file(filename: str) -> str:
    for root, _, files in os.walk(INPUT_DIR):
        if filename in files:
            return os.path.join(root, filename)
    raise FileNotFoundError(f"Could not find {filename} under {INPUT_DIR}")


def rmsle_from_log_targets(y_true_raw, pred_raw) -> float:
    y_true = np.asarray(y_true_raw, dtype=float)
    pred = np.asarray(pred_raw, dtype=float)
    pred = np.clip(pred, 0.0, None)
    return float(np.sqrt(np.mean((np.log1p(y_true) - np.log1p(pred)) ** 2)))


def make_graph_baseline(train_part: pd.DataFrame, target_col: str):
    data_train = skrub.var("data", train_part)
    X_train = data_train.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.apply(np.log1p).skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()
    model = LGBMRegressor(
        n_estimators=300,
        learning_rate=0.05,
        num_leaves=31,
        subsample=0.9,
        colsample_bytree=0.9,
        random_state=RANDOM_STATE,
        verbose=-1,
    )

    pred_log = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
    return pred_log


def evaluate_variant(train_df: pd.DataFrame, target_col: str) -> float:
    train_idx, valid_idx = train_test_split(
        np.arange(len(train_df)),
        test_size=VALID_SIZE,
        random_state=RANDOM_STATE,
    )
    train_part = train_df.iloc[train_idx].copy()
    valid_part = train_df.iloc[valid_idx].copy()

    pred_log = make_graph_baseline(train_part, target_col)
    learner = pred_log.skb.make_learner(fitted=True)
    valid_pred_log = learner.predict({"data": valid_part})
    valid_pred = np.expm1(np.asarray(valid_pred_log, dtype=float))
    score = rmsle_from_log_targets(valid_part[target_col], valid_pred)
    return score


def evaluate_variant_both_targets(train_df: pd.DataFrame) -> Tuple[float, float, float]:
    cc_score = evaluate_variant(train_df, "ConfirmedCases")
    ft_score = evaluate_variant(train_df, "Fatalities")
    final_score = (cc_score + ft_score) / 2.0
    return cc_score, ft_score, final_score


def main():
    train_path = find_file("train.csv")
    train_df = pd.read_csv(train_path)

    train_df["Date"] = pd.to_datetime(train_df["Date"], errors="coerce")

    cc_score, ft_score, final_validation_score = evaluate_variant_both_targets(train_df)

    print(f"ConfirmedCases Validation RMSLE: {cc_score}")
    print(f"Fatalities Validation RMSLE: {ft_score}")
    print(f"Final Validation Performance: {final_validation_score}")


if __name__ == "__main__":
    main()
