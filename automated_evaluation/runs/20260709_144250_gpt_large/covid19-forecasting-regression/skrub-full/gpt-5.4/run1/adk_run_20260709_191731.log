            pred_blend = log_space_blend(pred_full, pred_recent, w_full)
            score = rmsle(valid_part[target_col], pred_blend)

            if score < best_score:
                best_score = score
                best_pred = pred_blend

    return best_pred, best_score


def predict_target_full_train(train_df, test_df, target_col, random_state):
    pred_full = train_and_predict_target(
        train_df, test_df, target_col, random_state=random_state
    )

    best_pred = pred_full
    best_score = None

    recent_fractions = [0.50, 0.65, 0.80]
    blend_weights = [0.25, 0.50, 0.75]

    for frac in recent_fractions:
        recent_part = make_recent_subset(train_df, frac)
        pred_recent = train_and_predict_target(
            recent_part, test_df, target_col, random_state=random_state
        )

        for w_full in blend_weights:
            pred_blend = log_space_blend(pred_full, pred_recent, w_full)

            if best_score is None:
                best_pred = pred_blend

    if best_score is None:
        return best_pred

    return best_pred


def main():
    train_path = "./input/train.csv"
    test_path = "./input/test.csv"
    train_df = pd.read_csv(train_path)

    train_idx, valid_idx = train_test_split(
        np.arange(len(train_df)), test_size=0.2, random_state=42
    )
    train_part = train_df.iloc[train_idx].copy()
