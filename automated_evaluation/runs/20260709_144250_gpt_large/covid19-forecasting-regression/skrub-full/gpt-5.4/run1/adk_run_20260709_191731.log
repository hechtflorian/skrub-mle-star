import os
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error

subprocess = __import__("subprocess")
sys = __import__("sys")

if __import__("importlib").util.find_spec("lightgbm") is None:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "lightgbm"])
if __import__("importlib").util.find_spec("xgboost") is None:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "xgboost"])

from lightgbm import LGBMRegressor
from xgboost import XGBRegressor

INPUT_DIR = "./input"


def find_file(filename: str) -> str:
    for root, _, files in os.walk(INPUT_DIR):
        if filename in files:
            return os.path.join(root, filename)
    raise FileNotFoundError(f"Could not find {filename} under {INPUT_DIR}")


def rmsle(y_true, y_pred):
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    y_pred = np.clip(y_pred, 0, None)
    return mean_squared_log_error(y_true, y_pred) ** 0.5


def add_basic_features(df):
    out = df.copy()
    out["Date"] = pd.to_datetime(out["Date"])
    out["year"] = out["Date"].dt.year
    out["month"] = out["Date"].dt.month
    out["day"] = out["Date"].dt.day
    out["dayofweek"] = out["Date"].dt.dayofweek
    out["dayofyear"] = out["Date"].dt.dayofyear
    return out


def build_lgbm_predictor(data_train, target_col, random_state=42):
    X_train = data_train.drop(columns=["ConfirmedCases", "Fatalities"], errors="ignore").skb.mark_as_X()
    y_train = np.log1p(data_train[target_col]).astype(float)

    vectorizer = skrub.TableVectorizer()
    predictor = X_train.skb.apply(vectorizer).skb.apply(
        LGBMRegressor(
            n_estimators=300,
            learning_rate=0.05,
            num_leaves=31,
            subsample=0.9,
            colsample_bytree=0.9,
            random_state=random_state,
            verbose=-1,
        ),
        y=y_train,
    )
    return predictor


def build_xgb_predictor(data_train, target_col, random_state=42):
    X_train = data_train.drop(columns=["ConfirmedCases", "Fatalities"], errors="ignore").skb.mark_as_X()
    y_train = np.log1p(data_train[target_col]).astype(float)

    vectorizer = skrub.TableVectorizer()
    predictor = X_train.skb.apply(vectorizer).skb.apply(
        XGBRegressor(
            n_estimators=300,
            max_depth=6,
            learning_rate=0.05,
            subsample=0.9,
            colsample_bytree=0.9,
            objective="reg:squarederror",
            random_state=random_state,
            n_jobs=1,
            verbosity=0,
        ),
        y=y_train,
    )
    return predictor


def fit_and_predict_ensemble(train_part, valid_part, target_col, random_state=42):
    data_train = skrub.var("data", train_part)

    lgbm_predictor = build_lgbm_predictor(data_train, target_col, random_state=random_state)
    xgb_predictor = build_xgb_predictor(data_train, target_col, random_state=random_state + 100)

    lgbm_learner = lgbm_predictor.skb.make_learner(fitted=True)
    xgb_learner = xgb_predictor.skb.make_learner(fitted=True)

    pred_lgbm_log = lgbm_learner.predict({"data": valid_part})
    pred_xgb_log = xgb_learner.predict({"data": valid_part})

    pred_lgbm = np.expm1(np.asarray(pred_lgbm_log, dtype=float))
    pred_xgb = np.expm1(np.asarray(pred_xgb_log, dtype=float))

    pred_lgbm = np.clip(pred_lgbm, 0, None)
    pred_xgb = np.clip(pred_xgb, 0, None)

    pred = 0.5 * pred_lgbm + 0.5 * pred_xgb
    pred = np.clip(pred, 0, None)
    return pred


def main():
    train_path = find_file("train.csv")
    train_df = pd.read_csv(train_path)
    train_df = add_basic_features(train_df)

    train_idx, valid_idx = train_test_split(
        np.arange(len(train_df)), test_size=0.2, random_state=42
    )
    train_part = train_df.iloc[train_idx].copy()
    valid_part = train_df.iloc[valid_idx].copy()

    pred_cases = fit_and_predict_ensemble(train_part, valid_part, "ConfirmedCases", random_state=42)
    pred_fatal = fit_and_predict_ensemble(train_part, valid_part, "Fatalities", random_state=43)

    score_cases = rmsle(valid_part["ConfirmedCases"], pred_cases)
    score_fatal = rmsle(valid_part["Fatalities"], pred_fatal)
    final_validation_score = (score_cases + score_fatal) / 2.0

    print(f"Final Validation Performance: {final_validation_score}")


if __name__ == "__main__":
    main()
