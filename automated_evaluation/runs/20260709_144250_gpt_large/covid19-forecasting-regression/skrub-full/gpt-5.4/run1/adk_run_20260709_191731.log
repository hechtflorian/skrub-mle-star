    fatalities_pred = fit_and_predict(train_part, valid_part, "Fatalities")

    confirmed_score = rmsle(valid_part["ConfirmedCases"], confirmed_pred)
    fatalities_score = rmsle(valid_part["Fatalities"], fatalities_pred)
