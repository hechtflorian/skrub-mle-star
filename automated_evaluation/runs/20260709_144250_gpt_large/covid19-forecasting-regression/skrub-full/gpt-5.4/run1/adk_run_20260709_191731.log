        X = X.copy()
        date = pd.to_datetime(X["Date"])
        X["DateOrdinal"] = date.map(pd.Timestamp.toordinal).astype(float)
        X["Month"] = date.dt.month.astype(float)
        X["Day"] = date.dt.day.astype(float)
        X["DayOfWeek"] = date.dt.dayofweek.astype(float)
        return X


def rmsle(y_true, y_pred):
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    y_pred = np.maximum(y_pred, 0.0)
    return mean_squared_log_error(y_true, y_pred) ** 0.5


def build_predictor(X, y):
    feature_builder = CovidOrdinalDateFeatures()
    model = XGBRegressor(
        n_estimators=200,
        max_depth=6,
        learning_rate=0.05,
        subsample=0.8,
        colsample_bytree=0.8,
        objective="reg:squarederror",
