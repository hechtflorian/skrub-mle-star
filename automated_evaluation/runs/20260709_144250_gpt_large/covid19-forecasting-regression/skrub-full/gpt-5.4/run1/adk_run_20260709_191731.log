warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error

try:
    from lightgbm import LGBMRegressor
except ModuleNotFoundError:
    import subprocess
    import sys
    subprocess.check_call([sys.executable, "-m", "pip", "install", "lightgbm"])
    from lightgbm import LGBMRegressor


RANDOM_STATE = 42
TEST_SIZE = 0.2
METRIC_LABEL = "RMSLE"


def rmsle(y_true, y_pred):
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    y_pred = np.clip(y_pred, 0, None)
    return mean_squared_log_error(y_true, y_pred) ** 0.5


def add_date_parts(df):
    out = df.copy()
    dt = pd.to_datetime(out["Date"], errors="coerce")
    out["Year"] = dt.dt.year.fillna(0).astype(int)
    out["Month"] = dt.dt.month.fillna(0).astype(int)
    out["Day"] = dt.dt.day.fillna(0).astype(int)
    out["DayOfWeek"] = dt.dt.dayofweek.fillna(0).astype(int)
    out["DayOfYear"] = dt.dt.dayofyear.fillna(0).astype(int)
    return out


def build_estimator(random_state):
    return LGBMRegressor(
        n_estimators=300,
        learning_rate=0.05,
        num_leaves=31,
        subsample=0.9,
        colsample_bytree=0.9,
        random_state=random_state,
        verbose=-1,
    )


def make_graph_baseline(data_train, target_col, random_state):
    X_train = data_train.drop(columns=["ConfirmedCases", "Fatalities"], errors="ignore").skb.mark_as_X()
    y_train = np.log1p(data_train[target_col]).astype(float)
    vectorizer = skrub.TableVectorizer()
    return X_train.skb.apply(vectorizer).skb.apply(build_estimator(random_state), y=y_train)


def make_graph_no_id(data_train, target_col, random_state):
    X_train = (
        data_train
        .drop(columns=["ConfirmedCases", "Fatalities", "Id"], errors="ignore")
        .skb.mark_as_X()
    )
    y_train = np.log1p(data_train[target_col]).astype(float)
    vectorizer = skrub.TableVectorizer()
    return X_train.skb.apply(vectorizer).skb.apply(build_estimator(random_state), y=y_train)


def make_graph_with_date_parts(data_train, target_col, random_state):
    data_fe = data_train.skb.apply_func(add_date_parts)
    X_train = data_fe.drop(columns=["ConfirmedCases", "Fatalities"], errors="ignore").skb.mark_as_X()
    y_train = np.log1p(data_fe[target_col]).astype(float)
    vectorizer = skrub.TableVectorizer()
    return X_train.skb.apply(vectorizer).skb.apply(build_estimator(random_state), y=y_train)


def evaluate_variant(train_part, valid_part, target_col, target_random_state, variant_name, graph_builder):
    data_train = skrub.var("data", train_part)
    pred_graph = graph_builder(data_train, target_col, target_random_state)
    learner = pred_graph.skb.make_learner(fitted=True)
    pred_log = learner.predict({"data": valid_part})
    pred = np.expm1(np.asarray(pred_log, dtype=float))
    pred = np.clip(pred, 0, None)
    score = rmsle(valid_part[target_col], pred)
    return score


def evaluate_variant_both_targets(train_part, valid_part, variant_name, graph_builder):
    score_cases = evaluate_variant(
        train_part, valid_part, "ConfirmedCases", 42, variant_name, graph_builder
    )
    score_fatal = evaluate_variant(
        train_part, valid_part, "Fatalities", 43, variant_name, graph_builder
    )
    final_score = (score_cases + score_fatal) / 2.0
    print(f"Ablation[{variant_name}] {METRIC_LABEL}: {final_score}")
    return final_score


def main():
    train_df = pd.read_csv("./input/train.csv")

    train_idx, valid_idx = train_test_split(
        np.arange(len(train_df)), test_size=TEST_SIZE, random_state=RANDOM_STATE
    )
    train_part = train_df.iloc[train_idx].copy()
    valid_part = train_df.iloc[valid_idx].copy()

    scores = {}
    scores["baseline"] = evaluate_variant_both_targets(
        train_part, valid_part, "baseline", make_graph_baseline
    )
    scores["drop_id"] = evaluate_variant_both_targets(
        train_part, valid_part, "drop_id", make_graph_no_id
    )
    scores["date_parts"] = evaluate_variant_both_targets(
        train_part, valid_part, "date_parts", make_graph_with_date_parts
    )

    baseline_score = scores["baseline"]
    impacts = {k: v - baseline_score for k, v in scores.items() if k != "baseline"}
    most_impactful = max(impacts, key=lambda k: abs(impacts[k]))
    print(
        f"Most impactful ablation: {most_impactful} | delta_vs_baseline: {impacts[most_impactful]}"
    )


if __name__ == "__main__":
    main()
