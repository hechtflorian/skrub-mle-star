import warnings
warnings.filterwarnings("ignore")

import glob
import os

import numpy as np
import pandas as pd
import skrub
from sklearn.metrics import mean_squared_log_error
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import OrdinalEncoder
from xgboost import XGBRegressor


def rmsle(y_true, y_pred):
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    y_pred = np.clip(y_pred, 0, None)
    return mean_squared_log_error(y_true, y_pred) ** 0.5


class CovidOrdinalDateFeatures:
    def fit(self, X, y=None):
        X_df = pd.DataFrame(X).copy()
        X_df["Province_State"] = X_df["Province_State"].fillna("")
        X_df["Country_Region"] = X_df["Country_Region"].fillna("")
        X_df["Region"] = X_df["Country_Region"].astype(str) + "_" + X_df["Province_State"].astype(str)
        X_df["Date"] = pd.to_datetime(X_df["Date"])
        self.min_date_ = X_df["Date"].min()
        self.encoder_ = OrdinalEncoder(handle_unknown="use_encoded_value", unknown_value=-1)
        self.encoder_.fit(X_df[["Region"]])
        return self

    def transform(self, X):
        X_df = pd.DataFrame(X).copy()
        X_df["Province_State"] = X_df["Province_State"].fillna("")
        X_df["Country_Region"] = X_df["Country_Region"].fillna("")
        X_df["Region"] = X_df["Country_Region"].astype(str) + "_" + X_df["Province_State"].astype(str)
        X_df["Date"] = pd.to_datetime(X_df["Date"])
        out = pd.DataFrame(index=X_df.index)
        out["region_id"] = self.encoder_.transform(X_df[["Region"]]).astype(float).ravel()
        out["day"] = (X_df["Date"] - self.min_date_).dt.days.astype(float)
        out["month"] = X_df["Date"].dt.month.astype(float)
        out["dayofweek"] = X_df["Date"].dt.dayofweek.astype(float)
        return out


def build_predictor(train_part, target_col, random_state):
    data = skrub.var("data", train_part)
    X = data[["Province_State", "Country_Region", "Date"]].skb.mark_as_X()
    y = data[target_col].skb.mark_as_y()

    feature_builder = CovidOrdinalDateFeatures()
    model = XGBRegressor(
        n_estimators=400,
        max_depth=6,
        learning_rate=0.05,
        subsample=0.9,
        colsample_bytree=0.9,
        objective="reg:squarederror",
        random_state=random_state,
        verbosity=0,
        n_jobs=1,
    )

    predictor = X.skb.apply(feature_builder).skb.apply(model, y=np.log1p(y))
    return predictor


def main():
    train_candidates = sorted(glob.glob("./input/**/*.csv", recursive=True))
    train_path = [p for p in train_candidates if os.path.basename(p).lower() == "train.csv"][0]
    train_df = pd.read_csv(train_path)

    train_idx, valid_idx = train_test_split(
        np.arange(len(train_df)),
        test_size=0.2,
        random_state=42,
    )
    train_part = train_df.iloc[train_idx].copy()
    valid_part = train_df.iloc[valid_idx].copy()

    predictor_cases = build_predictor(train_part, "ConfirmedCases", random_state=42)
    learner_cases = predictor_cases.skb.make_learner(fitted=True)
    pred_cases_log = learner_cases.predict({"data": valid_part})
    pred_cases = np.expm1(np.asarray(pred_cases_log, dtype=float)).clip(0, None)

    predictor_fatal = build_predictor(train_part, "Fatalities", random_state=43)
    learner_fatal = predictor_fatal.skb.make_learner(fitted=True)
    pred_fatal_log = learner_fatal.predict({"data": valid_part})
    pred_fatal = np.expm1(np.asarray(pred_fatal_log, dtype=float)).clip(0, None)

    score_cases = rmsle(valid_part["ConfirmedCases"].to_numpy(), pred_cases)
    score_fatal = rmsle(valid_part["Fatalities"].to_numpy(), pred_fatal)
    final_validation_score = (score_cases + score_fatal) / 2.0

    print(f"Final Validation Performance: {final_validation_score}")


if __name__ == "__main__":
    main()
```
