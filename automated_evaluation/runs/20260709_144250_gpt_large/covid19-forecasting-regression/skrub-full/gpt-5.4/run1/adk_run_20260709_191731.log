    pred_fatal, score_fatal = select_best_target_ensemble(
        train_part, valid_part, "Fatalities", random_state=43
    )

    final_validation_score = (score_cases + score_fatal) / 2.0
    print(f"Final Validation Performance: {final_validation_score}")

    test_df = pd.read_csv(test_path)

    submission = pd.DataFrame({
        "ForecastId": test_df["ForecastId"],
        "ConfirmedCases": predict_target_full_train(
            train_df, test_df, "ConfirmedCases", random_state=42
        ),
        "Fatalities": predict_target_full_train(
            train_df, test_df, "Fatalities", random_state=43
        ),
    })

    submission["ConfirmedCases"] = np.clip(
        np.asarray(submission["ConfirmedCases"], dtype=float), 0, None
    )
    submission["Fatalities"] = np.clip(
        np.asarray(submission["Fatalities"], dtype=float), 0, None
    )

    os.makedirs("./final", exist_ok=True)
    submission.to_csv("./final/submission.csv", index=False)


if __name__ == "__main__":
    main()
