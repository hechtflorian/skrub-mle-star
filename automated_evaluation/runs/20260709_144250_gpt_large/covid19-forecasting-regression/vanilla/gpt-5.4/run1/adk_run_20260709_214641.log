    if q1 == q2:
        q1, q2 = np.quantile(logv, [0.25, 0.75])
    if q1 == q2:
        return np.where(logv <= q1, "cold", "hot")
    sev = np.where(logv <= q1, "cold", np.where(logv <= q2, "mid", "hot"))
    return sev

