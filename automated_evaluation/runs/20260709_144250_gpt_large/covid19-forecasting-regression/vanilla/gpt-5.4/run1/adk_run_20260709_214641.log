        feat["cases_growth_1_7"] = feat["log_cases_lag1"] - feat["log_cases_lag7"]
        feat["fatal_growth_1_2"] = feat["log_fatal_lag1"] - feat["log_fatal_lag2"]
        feat["fatal_growth_1_7"] = feat["log_fatal_lag1"] - feat["log_fatal_lag7"]

