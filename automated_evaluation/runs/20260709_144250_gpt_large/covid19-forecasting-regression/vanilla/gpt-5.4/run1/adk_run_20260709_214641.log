    pred_day_df = pd.DataFrame(pred_rows)
    valid_preds_collect.append(pred_day_df[["geo", "Date", "ConfirmedCases", "Fatalities"]])
    valid_sim = pd.concat([valid_sim, pred_day_df], ignore_index=True, sort=False)

