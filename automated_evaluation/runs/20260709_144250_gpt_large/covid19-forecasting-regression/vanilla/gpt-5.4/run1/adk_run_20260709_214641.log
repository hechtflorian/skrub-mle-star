        prev_fatal_val = prev_fatal.iloc[-1] if len(prev_fatal) > 0 else 0.0
        pred_fatal = max(prev_fatal_val, prev_fatal_val + pred_fatal_inc)
        pred_fatal = min(pred_fatal, pred_cases)

