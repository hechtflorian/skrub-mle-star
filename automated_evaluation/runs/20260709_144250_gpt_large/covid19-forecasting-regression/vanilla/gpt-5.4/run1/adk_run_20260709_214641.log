def assign_severity_buckets(last_train_cases_series):
    logv = np.log1p(last_train_cases_series.fillna(0).values.astype(float))
    uniq = np.unique(logv)
    if len(uniq) < 3:
        bins = [-np.inf, np.quantile(logv, 0.5), np.inf]
