            feat[f"log_cases_lag{lag}"] = get_lag(hist_cases, lag)
            feat[f"log_fatal_lag{lag}"] = get_lag(hist_fatal, lag)
            feat[f"log_inc_cases_lag{lag}"] = get_lag(hist_inc_cases, lag)
