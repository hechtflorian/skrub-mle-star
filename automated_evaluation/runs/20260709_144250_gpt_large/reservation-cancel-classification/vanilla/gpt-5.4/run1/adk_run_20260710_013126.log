ensure_package("xgboost")
ensure_package("catboost")
ensure_package("torch")

import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score
from sklearn.preprocessing import LabelEncoder
from sklearn.linear_model import LogisticRegression, Ridge
from xgboost import XGBClassifier
from catboost import CatBoostClassifier

TABPFN_IMPORTABLE = False
tabpfn_spec = None
try:
    import importlib.util
    tabpfn_spec = importlib.util.find_spec("tabpfn")
except ImportError:
    tabpfn_spec = None
if tabpfn_spec is not None:
    ensure_package("tabpfn")
    from tabpfn import TabPFNClassifier
    import torch
    TABPFN_IMPORTABLE = True


def preprocess_for_xgb_tabpfn(train_df, test_df, target_col, id_col):
    features = [c for c in train_df.columns if c not in [id_col, target_col]]

    X = train_df[features].copy()
    y = train_df[target_col].copy()
    X_test = test_df[features].copy()

    object_cols = [c for c in features if X[c].dtype == "object" or X_test[c].dtype == "object"]

    for c in object_cols:
        le = LabelEncoder()
        combined = pd.concat([X[c].astype(str), X_test[c].astype(str)], axis=0)
        le.fit(combined)
        X[c] = le.transform(X[c].astype(str))
        X_test[c] = le.transform(X_test[c].astype(str))

    for c in features:
        needs_fill = X[c].isnull().any() or X_test[c].isnull().any()
        if needs_fill:
            fill_value = X[c].median() if pd.api.types.is_numeric_dtype(X[c]) else "missing"
            X[c] = X[c].fillna(fill_value)
            X_test[c] = X_test[c].fillna(fill_value)

    X = X.apply(pd.to_numeric, errors="coerce")
    X_test = X_test.apply(pd.to_numeric, errors="coerce")

    for c in features:
        needs_fill = X[c].isnull().any() or X_test[c].isnull().any()
        if needs_fill:
            fill_value = X[c].median() if pd.api.types.is_numeric_dtype(X[c]) else 0
            X[c] = X[c].fillna(fill_value)
            X_test[c] = X_test[c].fillna(fill_value)

    return X, y, X_test, features


def preprocess_for_catboost(train_df, test_df, target_col, id_col):
    features = [c for c in train_df.columns if c not in [id_col, target_col]]

    X = train_df[features].copy()
    y = train_df[target_col].copy()
    X_test = test_df[features].copy()

    for c in features:
        if X[c].dtype == "object" or X_test[c].dtype == "object":
            X[c] = X[c].astype(str).fillna("missing")
            X_test[c] = X_test[c].astype(str).fillna("missing")
        else:
            fill_value = X[c].median()
            X[c] = X[c].fillna(fill_value)
            X_test[c] = X_test[c].fillna(fill_value)

    cat_cols = [c for c in features if X[c].dtype == "object"]
    cat_idx = [features.index(c) for c in cat_cols]

    return X, y, X_test, features, cat_idx


def fit_xgboost_model(X_train, y_train, X_valid, y_valid, X_full, y_full, X_test):
    xgb_params = dict(
        n_estimators=3000,
        max_depth=5,
        learning_rate=0.02,
        subsample=0.8,
        colsample_bytree=0.8,
        min_child_weight=3,
        gamma=0.1,
        reg_alpha=0.1,
        reg_lambda=2.0,
        objective="binary:logistic",
        eval_metric="auc",
        n_jobs=-1,
        tree_method="hist"
    )

    seeds = [42, 52, 62]
    valid_pred = np.zeros(len(X_valid), dtype=float)
    test_pred = np.zeros(len(X_test), dtype=float)

    for seed in seeds:
        model = XGBClassifier(
            **xgb_params,
            random_state=seed
        )
        model.fit(
            X_train,
            y_train,
            eval_set=[(X_valid, y_valid)],
            verbose=False
        )

        best_iteration = getattr(model, "best_iteration", None)
        if best_iteration is not None:
            valid_pred += model.predict_proba(X_valid, iteration_range=(0, best_iteration + 1))[:, 1] / len(seeds)
        else:
            valid_pred += model.predict_proba(X_valid)[:, 1] / len(seeds)

        best_n_estimators = (best_iteration + 1) if best_iteration is not None else xgb_params["n_estimators"]

        full_model = XGBClassifier(
            **{**xgb_params, "n_estimators": best_n_estimators},
            random_state=seed
        )
        full_model.fit(X_full, y_full, verbose=False)
        test_pred += full_model.predict_proba(X_test)[:, 1] / len(seeds)

    score = roc_auc_score(y_valid, valid_pred)
    return score, valid_pred, test_pred


def fit_catboost_model(X_train, y_train, X_valid, y_valid, X_full, y_full, X_test, cat_idx):
    model = CatBoostClassifier(
        iterations=4000,
        learning_rate=0.03,
        depth=6,
        l2_leaf_reg=5.0,
        random_strength=0.5,
        bagging_temperature=0.5,
        loss_function="Logloss",
        eval_metric="AUC",
        random_seed=42,
        verbose=200
    )

    model.fit(
        X_train,
        y_train,
        cat_features=cat_idx,
        eval_set=(X_valid, y_valid),
        use_best_model=True,
        early_stopping_rounds=200
    )

    valid_pred = model.predict_proba(X_valid)[:, 1]
    score = roc_auc_score(y_valid, valid_pred)

    best_iteration = model.get_best_iteration()
    full_iterations = best_iteration + 1 if best_iteration is not None and best_iteration >= 0 else 2000

    full_model = CatBoostClassifier(
        iterations=full_iterations,
        learning_rate=0.03,
        depth=6,
        l2_leaf_reg=5.0,
        random_strength=0.5,
        bagging_temperature=0.5,
        loss_function="Logloss",
        eval_metric="AUC",
        random_seed=42,
        verbose=False
    )

    full_model.fit(
        X_full,
        y_full,
        cat_features=cat_idx,
        verbose=False
    )
    test_pred = full_model.predict_proba(X_test)[:, 1]
    return score, valid_pred, test_pred


def fit_tabpfn_model(X_train, y_train, X_valid, y_valid, X_full, y_full, X_test):
    device = "cuda" if torch.cuda.is_available() else "cpu"
    model = TabPFNClassifier(device=device)
    model.fit(X_train, y_train)

    valid_pred = model.predict_proba(X_valid)[:, 1]
    score = roc_auc_score(y_valid, valid_pred)

    model.fit(X_full, y_full)
    test_pred = model.predict_proba(X_test)[:, 1]
    return score, valid_pred, test_pred


def rank_normalize(arr):
    s = pd.Series(arr)
    r = s.rank(method="average")
    if len(r) <= 1:
        return np.zeros(len(arr), dtype=float)
    return ((r - 1) / (len(r) - 1)).to_numpy(dtype=float)


def generate_weight_combinations(n_models, step):
    units = int(round(1.0 / step))
    combos = []

    def backtrack(idx, remaining, current):
        if idx == n_models - 1:
            current.append(remaining)
            combos.append(np.array(current, dtype=float) / units)
            current.pop()
            return
        for v in range(remaining + 1):
            current.append(v)
            backtrack(idx + 1, remaining - v, current)
            current.pop()

    backtrack(0, units, [])
    return combos


def search_convex_blend(pred_matrix_valid, pred_matrix_test, y_valid, step):
    n_models = pred_matrix_valid.shape[1]
    combos = generate_weight_combinations(n_models, step)
    best_score = -1.0
    best_valid_pred = None
    best_test_pred = None
    best_weights = None

    for w in combos:
        valid_pred = pred_matrix_valid.dot(w)
        score = roc_auc_score(y_valid, valid_pred)
        if score > best_score:
            best_score = score
            best_valid_pred = valid_pred
            best_test_pred = pred_matrix_test.dot(w)
            best_weights = w.copy()

    return {
        "name": "convex_blend",
        "score": best_score,
        "valid_pred": best_valid_pred,
        "test_pred": best_test_pred,
        "weights": best_weights
    }


def build_meta_features(valid_preds_dict, test_preds_dict):
    model_names = list(valid_preds_dict.keys())

    Xv_cols = []
    Xt_cols = []

    for name in model_names:
        Xv_cols.append(valid_preds_dict[name])
        Xt_cols.append(test_preds_dict[name])

    rank_valid = {}
    rank_test = {}
    for name in model_names:
        rank_valid[name] = rank_normalize(valid_preds_dict[name])
        rank_test[name] = rank_normalize(test_preds_dict[name])
        Xv_cols.append(rank_valid[name])
        Xt_cols.append(rank_test[name])

    pair_names = []
    for i in range(len(model_names)):
        for j in range(i + 1, len(model_names)):
            if len(pair_names) >= 2:
                break
            a, b = model_names[i], model_names[j]
            raw_avg_v = (valid_preds_dict[a] + valid_preds_dict[b]) / 2.0
            raw_avg_t = (test_preds_dict[a] + test_preds_dict[b]) / 2.0
            rank_avg_v = (rank_valid[a] + rank_valid[b]) / 2.0
            rank_avg_t = (rank_test[a] + rank_test[b]) / 2.0
            Xv_cols.append(raw_avg_v)
            Xt_cols.append(raw_avg_t)
            Xv_cols.append(rank_avg_v)
            Xt_cols.append(rank_avg_t)
            pair_names.append((a, b))
        if len(pair_names) >= 2:
            break

    X_valid_meta = np.column_stack(Xv_cols)
    X_test_meta = np.column_stack(Xt_cols)

    raw_valid_matrix = np.column_stack([valid_preds_dict[name] for name in model_names])
    raw_test_matrix = np.column_stack([test_preds_dict[name] for name in model_names])
    rank_valid_matrix = np.column_stack([rank_valid[name] for name in model_names])
    rank_test_matrix = np.column_stack([rank_test[name] for name in model_names])

    return X_valid_meta, X_test_meta, raw_valid_matrix, raw_test_matrix, rank_valid_matrix, rank_test_matrix, model_names


def fit_logistic_meta(X_valid_meta, X_test_meta, y_valid):
    best = None
    for C in [0.05, 0.1, 0.2, 0.5, 1.0, 2.0]:
        try:
            model = LogisticRegression(
                C=C,
                solver="liblinear",
                max_iter=1000,
                random_state=42
            )
            model.fit(X_valid_meta, y_valid)
            valid_pred = model.predict_proba(X_valid_meta)[:, 1]
            test_pred = model.predict_proba(X_test_meta)[:, 1]
            score = roc_auc_score(y_valid, valid_pred)
            candidate = {
                "name": f"logistic_C_{C}",
                "score": score,
                "valid_pred": valid_pred,
                "test_pred": test_pred
            }
            if best is None or candidate["score"] > best["score"]:
                best = candidate
        except Exception:
            continue
    return best


def fit_ridge_meta(X_valid_meta, X_test_meta, y_valid):
    best = None
    for alpha in [0.1, 0.5, 1.0, 2.0, 5.0, 10.0]:
        try:
            model = Ridge(alpha=alpha, random_state=42)
            model.fit(X_valid_meta, y_valid)
            valid_pred = np.clip(model.predict(X_valid_meta), 0.0, 1.0)
            test_pred = np.clip(model.predict(X_test_meta), 0.0, 1.0)
            score = roc_auc_score(y_valid, valid_pred)
            candidate = {
                "name": f"ridge_alpha_{alpha}",
                "score": score,
                "valid_pred": valid_pred,
                "test_pred": test_pred
            }
            if best is None or candidate["score"] > best["score"]:
                best = candidate
        except Exception:
            continue
    return best


def main():
    train_path = os.path.join(".", "input", "train.csv")
    test_path = os.path.join(".", "input", "test.csv")

    train = pd.read_csv(train_path)
    test = pd.read_csv(test_path)

    target = "booking_status"
    id_col = "id"

    X_num, y, X_test_num, _ = preprocess_for_xgb_tabpfn(train, test, target, id_col)
    X_cat, _, X_test_cat, features_cat, cat_idx = preprocess_for_catboost(train, test, target, id_col)

    train_idx, valid_idx = train_test_split(
        np.arange(len(train)),
        test_size=0.2,
        random_state=42,
        stratify=y
    )

    X_train_num = X_num.iloc[train_idx]
    X_valid_num = X_num.iloc[valid_idx]
    y_train = y.iloc[train_idx]
    y_valid = y.iloc[valid_idx]
    X_train_cat = X_cat.iloc[train_idx]
    X_valid_cat = X_cat.iloc[valid_idx]

    model_scores = []
    valid_preds_dict = {}
    test_preds_dict = {}

    xgb_score, xgb_valid_pred, xgb_test_pred = fit_xgboost_model(
        X_train_num, y_train, X_valid_num, y_valid, X_num, y, X_test_num
    )
    model_scores.append(xgb_score)
    valid_preds_dict["xgb"] = xgb_valid_pred
    test_preds_dict["xgb"] = xgb_test_pred

    cat_score, cat_valid_pred, cat_test_pred = fit_catboost_model(
        X_train_cat, y_train, X_valid_cat, y_valid, X_cat, y, X_test_cat, cat_idx
    )
    model_scores.append(cat_score)
    valid_preds_dict["cat"] = cat_valid_pred
    test_preds_dict["cat"] = cat_test_pred

    tabpfn_enabled = TABPFN_IMPORTABLE and (os.environ.get("TABPFN_TOKEN", "").strip() != "")
    if tabpfn_enabled:
        tab_score, tab_valid_pred, tab_test_pred = fit_tabpfn_model(
            X_train_num, y_train, X_valid_num, y_valid, X_num, y, X_test_num
        )
        model_scores.append(tab_score)
        valid_preds_dict["tabpfn"] = tab_valid_pred
        test_preds_dict["tabpfn"] = tab_test_pred

    X_valid_meta, X_test_meta, raw_valid_matrix, raw_test_matrix, rank_valid_matrix, rank_test_matrix, model_names = build_meta_features(
        valid_preds_dict, test_preds_dict
    )

    n_models = len(model_names)
    step = 0.05 if n_models <= 2 else 0.1

    raw_blend = search_convex_blend(raw_valid_matrix, raw_test_matrix, y_valid, step)
    raw_blend["name"] = "convex_raw"

    rank_blend = search_convex_blend(rank_valid_matrix, rank_test_matrix, y_valid, step)
    rank_blend["name"] = "convex_rank"

    logistic_candidate = fit_logistic_meta(X_valid_meta, X_test_meta, y_valid)
    ridge_candidate = fit_ridge_meta(X_valid_meta, X_test_meta, y_valid)

    candidates = [raw_blend, rank_blend]
    if logistic_candidate is not None:
        candidates.append(logistic_candidate)
    if ridge_candidate is not None:
        candidates.append(ridge_candidate)

    best_single_name = None
    best_single_score = -1.0
    for name in model_names:
        score = roc_auc_score(y_valid, valid_preds_dict[name])
        if score > best_single_score:
            best_single_score = score
            best_single_name = name

    best_convex = max([raw_blend, rank_blend], key=lambda x: x["score"])
    best_candidate = max(candidates, key=lambda x: x["score"])

    if best_candidate["name"].startswith("logistic"):
        if (best_candidate["score"] - best_single_score) < 0.0002:
            best_candidate = best_convex

    final_validation_score = roc_auc_score(y_valid, best_candidate["valid_pred"])
    print(f"Final Validation Performance: {final_validation_score}")

    submission = pd.DataFrame({
        "id": test[id_col],
        "booking_status": best_candidate["test_pred"]
    })
    submission.to_csv("submission_ensemble.csv", index=False)


if __name__ == "__main__":
    main()
