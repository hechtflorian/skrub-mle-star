learner_3_full = predictor_3_full.skb.make_learner(fitted=True)

test_p1 = np.maximum(np.asarray(learner_1_full.predict({"data": test_df}), dtype=float).ravel(), 0)
test_p2 = np.maximum(np.asarray(learner_2_full.predict({"data": test_df}), dtype=float).ravel(), 0)
test_p3 = np.maximum(np.asarray(learner_3_full.predict({"data": test_df}), dtype=float).ravel(), 0)

test_cand_A = log_blend([test_p1, test_p2, test_p3], (0.65, 0.25, 0.10))
test_cand_B = log_blend([test_p1, test_p2, test_p3], (0.25, 0.55, 0.20))
test_cand_C = log_blend([test_p1, test_p2, test_p3], (0.25, 0.20, 0.55))
test_cand_D = np.maximum(
