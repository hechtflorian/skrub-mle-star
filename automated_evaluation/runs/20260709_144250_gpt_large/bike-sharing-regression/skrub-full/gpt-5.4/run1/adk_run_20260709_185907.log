import os
import glob
import numpy as np
import pandas as pd
import skrub
from lightgbm import LGBMRegressor
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error
from sklearn.base import BaseEstimator, TransformerMixin

random_state = 42
target_col = "count"


class DateTimeFeatures(BaseEstimator, TransformerMixin):
    def fit(self, X, y=None):
        return self

    def transform(self, X):
        X = X.copy()
        dt = pd.to_datetime(X["datetime"])
        X["year"] = dt.dt.year
        X["month"] = dt.dt.month
        X["day"] = dt.dt.day
        X["hour"] = dt.dt.hour
        X["weekday"] = dt.dt.weekday
        return X.drop(columns=["datetime"], errors="ignore")


def rmsle(y_true, y_pred):
    y_true = np.asarray(y_true)
    y_pred = np.asarray(y_pred)
    y_pred = np.clip(y_pred, 0, None)
    return mean_squared_log_error(y_true, y_pred) ** 0.5


input_dir = "./input"
train_candidates = sorted(glob.glob(os.path.join(input_dir, "**", "train.csv"), recursive=True))
train_path = train_candidates[0]
train_df = pd.read_csv(train_path)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(
    columns=[target_col, "casual", "registered"], errors="ignore"
).skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

feature_builder = DateTimeFeatures()
model = LGBMRegressor(
    n_estimators=1200,
    learning_rate=0.03,
    num_leaves=31,
    subsample=0.9,
    colsample_bytree=0.9,
    random_state=42,
    verbose=-1,
)

predictor = X_train.skb.apply(feature_builder).skb.apply(model, y=np.log1p(y_train))
val_learner = predictor.skb.make_learner(fitted=True)

valid_pred_log = val_learner.predict({"data": valid_part})
valid_pred = np.expm1(valid_pred_log)
valid_pred = np.clip(valid_pred, 0, None)

final_validation_score = rmsle(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
