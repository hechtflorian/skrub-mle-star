    train_zero_ratio = (X[p_cols] == 0).mean(axis=0)
    sparse_p_cols = train_zero_ratio[train_zero_ratio >= 0.5].index.tolist()
    dense_p_cols = [c for c in p_cols if c not in sparse_p_cols]

    for df in (X, X_test):
