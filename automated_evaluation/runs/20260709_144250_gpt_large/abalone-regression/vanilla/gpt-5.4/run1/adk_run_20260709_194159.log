    if test_pred_col is None:
        possible_pred_cols = [c for c in test_pred_df.columns if "prediction" in c.lower()]
        if len(possible_pred_cols) > 0:
            test_pred_col = possible_pred_cols[0]
        else:
            numeric_cols = [c for c in test_pred_df.columns if pd.api.types.is_numeric_dtype(test_pred_df[c])]
            if len(numeric_cols) == 0:
                raise ValueError(
                    f"Could not find prediction column in test predictions. Columns: {list(test_pred_df.columns)}"
                )
            test_pred_col = numeric_cols[-1]

test_pred = np.clip(np.asarray(test_pred_df[test_pred_col]).reshape(-1), 0, None)

submission = pd.DataFrame(
    {
        "id": test_df["id"],
        "Rings": test_pred,
    }
)
submission.to_csv("submission_fttransformer.csv", index=False)

print(f"Final Validation Performance: {final_validation_score}")
