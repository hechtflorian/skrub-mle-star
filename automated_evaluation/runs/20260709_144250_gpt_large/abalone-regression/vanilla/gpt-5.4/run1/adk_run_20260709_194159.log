import numpy as np
import pandas as pd
import torch

from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error

from pytorch_tabular import TabularModel
from pytorch_tabular.models.ft_transformer.config import FTTransformerConfig
from pytorch_tabular.config import DataConfig, TrainerConfig, OptimizerConfig

SEED = 42
random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)
if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)

DATA_DIR = "./input"
TRAIN_PATH = os.path.join(DATA_DIR, "train.csv")
TEST_PATH = os.path.join(DATA_DIR, "test.csv")

train = pd.read_csv(TRAIN_PATH)
test = pd.read_csv(TEST_PATH)

target_col = "Rings"
features = [
    "Sex",
    "Length",
    "Diameter",
    "Height",
    "Whole weight",
    "Whole weight.1",
    "Whole weight.2",
    "Shell weight",
]
cat_cols = ["Sex"]
num_cols = [c for c in features if c not in cat_cols]

df = train[features + [target_col]].copy()
df[target_col] = df[target_col].clip(lower=0)

train_df, val_df = train_test_split(df, test_size=0.2, random_state=SEED)

data_config = DataConfig(
    target=[target_col],
    continuous_cols=num_cols,
    categorical_cols=cat_cols,
)

model_config = FTTransformerConfig(
    task="regression",
    learning_rate=1e-3,
    input_embed_dim=32,
    num_heads=8,
    num_attn_blocks=4,
    batch_size=1024,
    seed=SEED,
)

trainer_config = TrainerConfig(
    auto_lr_find=False,
    batch_size=1024,
    max_epochs=50,
    accelerator="auto",
    seed=SEED,
)

optimizer_config = OptimizerConfig()

model = TabularModel(
    data_config=data_config,
    model_config=model_config,
    optimizer_config=optimizer_config,
    trainer_config=trainer_config,
)

model.fit(train=train_df, validation=val_df)

val_pred_df = model.predict(val_df[features])

pred_col = "prediction"
if pred_col not in val_pred_df.columns:
    possible_pred_cols = [c for c in val_pred_df.columns if "prediction" in c.lower()]
    if len(possible_pred_cols) == 0:
        raise ValueError(f"Could not find prediction column in validation predictions. Columns: {list(val_pred_df.columns)}")
    pred_col = possible_pred_cols[0]

val_pred = np.clip(val_pred_df[pred_col].values, 0, None)
val_true = val_df[target_col].values
final_validation_score = np.sqrt(mean_squared_log_error(val_true, val_pred))

test_pred_df = model.predict(test[features])

test_pred_col = pred_col
if test_pred_col not in test_pred_df.columns:
    possible_pred_cols = [c for c in test_pred_df.columns if "prediction" in c.lower()]
    if len(possible_pred_cols) == 0:
        raise ValueError(f"Could not find prediction column in test predictions. Columns: {list(test_pred_df.columns)}")
    test_pred_col = possible_pred_cols[0]

test_pred = np.clip(test_pred_df[test_pred_col].values, 0, None)

submission = pd.DataFrame({
    "id": test["id"],
    "Rings": test_pred
})
submission.to_csv("submission_fttransformer.csv", index=False)

print(f"Final Validation Performance: {final_validation_score}")
