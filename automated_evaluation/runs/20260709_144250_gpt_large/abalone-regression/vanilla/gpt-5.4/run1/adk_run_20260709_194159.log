import numpy as np
import pandas as pd
import torch

from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error

from pytorch_tabular import TabularModel
from pytorch_tabular.models.ft_transformer.config import FTTransformerConfig
from pytorch_tabular.config import DataConfig, TrainerConfig, OptimizerConfig

SEED = 42
random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)
if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)

DATA_DIR = "./input"
TRAIN_PATH = os.path.join(DATA_DIR, "train.csv")
TEST_PATH = os.path.join(DATA_DIR, "test.csv")

train = pd.read_csv(TRAIN_PATH)
test = pd.read_csv(TEST_PATH)

target_col = "Rings"
features = [
    "Sex",
    "Length",
    "Diameter",
    "Height",
    "Whole weight",
    "Whole weight.1",
    "Whole weight.2",
    "Shell weight",
]
cat_cols = ["Sex"]
num_cols = [c for c in features if c not in cat_cols]

missing_train = [c for c in features + [target_col] if c not in train.columns]
missing_test = [c for c in features if c not in test.columns]
if missing_train:
    raise ValueError(f"Missing columns in train.csv: {missing_train}")
if missing_test:
    raise ValueError(f"Missing columns in test.csv: {missing_test}")

df = train[features + [target_col]].copy()
test_df = test[["id"] + features].copy()

df[target_col] = pd.to_numeric(df[target_col], errors="coerce").fillna(0).clip(lower=0)

for c in num_cols:
    df[c] = pd.to_numeric(df[c], errors="coerce")
    test_df[c] = pd.to_numeric(test_df[c], errors="coerce")

for c in cat_cols:
    df[c] = df[c].fillna("Unknown").astype(str)
    test_df[c] = test_df[c].fillna("Unknown").astype(str)

num_fill_values = {c: df[c].median() for c in num_cols}
df[num_cols] = df[num_cols].fillna(num_fill_values)
test_df[num_cols] = test_df[num_cols].fillna(num_fill_values)

train_df, val_df = train_test_split(df, test_size=0.2, random_state=SEED)

data_config = DataConfig(
    target=[target_col],
    continuous_cols=num_cols,
    categorical_cols=cat_cols,
)

ft_sig = inspect.signature(FTTransformerConfig.__init__)
allowed_ft_params = set(ft_sig.parameters.keys()) - {"self"}

ft_candidate_params = {
    "task": "regression",
    "learning_rate": 1e-3,
    "input_embed_dim": 32,
    "num_heads": 8,
    "num_attn_blocks": 4,
    "seed": SEED,
}

ft_filtered_params = {k: v for k, v in ft_candidate_params.items() if k in allowed_ft_params}
model_config = FTTransformerConfig(**ft_filtered_params)

trainer_sig = inspect.signature(TrainerConfig.__init__)
allowed_trainer_params = set(trainer_sig.parameters.keys()) - {"self"}

trainer_candidate_params = {
    "auto_lr_find": False,
    "batch_size": 1024,
    "max_epochs": 50,
    "accelerator": "auto",
    "seed": SEED,
}

trainer_filtered_params = {k: v for k, v in trainer_candidate_params.items() if k in allowed_trainer_params}
trainer_config = TrainerConfig(**trainer_filtered_params)

optimizer_config = OptimizerConfig()

model = TabularModel(
    data_config=data_config,
    model_config=model_config,
    optimizer_config=optimizer_config,
    trainer_config=trainer_config,
)

model.fit(train=train_df, validation=val_df)

val_pred_df = model.predict(val_df[features])

pred_col = None
candidate_cols = [
    "prediction",
    f"{target_col}_prediction",
    f"{target_col}_0_prediction",
    target_col,
]
for c in candidate_cols:
    if c in val_pred_df.columns:
        pred_col = c
        break

if pred_col is None:
    possible_pred_cols = [c for c in val_pred_df.columns if "prediction" in c.lower()]
    if len(possible_pred_cols) > 0:
        pred_col = possible_pred_cols[0]
    else:
        numeric_cols = [c for c in val_pred_df.columns if pd.api.types.is_numeric_dtype(val_pred_df[c])]
        if len(numeric_cols) == 0:
            raise ValueError(
                f"Could not find prediction column in validation predictions. Columns: {list(val_pred_df.columns)}"
            )
        pred_col = numeric_cols[-1]

val_pred = np.clip(np.asarray(val_pred_df[pred_col]).reshape(-1), 0, None)
val_true = np.asarray(val_df[target_col]).reshape(-1)
final_validation_score = np.sqrt(mean_squared_log_error(val_true, val_pred))

test_pred_df = model.predict(test_df[features])

test_pred_col = pred_col
if test_pred_col not in test_pred_df.columns:
    candidate_cols = [
        "prediction",
        f"{target_col}_prediction",
        f"{target_col}_0_prediction",
