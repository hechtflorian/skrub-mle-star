from skrub import selectors as s

vectorizer_lgbm = skrub.TableVectorizer()

cat_preprocessor = skrub.ApplyToCols(
    skrub.ToCategorical(),
    cols=s.string() | s.categorical(),
)

lgbm_model = LGBMClassifier(
    n_estimators=700,
    learning_rate=0.03,
    num_leaves=64,
    subsample=0.8,
    colsample_bytree=0.8,
    objective="binary",
    random_state=random_state,
    verbose=-1,
)

cat_model = CatBoostClassifier(
    loss_function="Logloss",
    eval_metric="AUC",
    iterations=1200,
    learning_rate=0.03,
    depth=6,
    l2_leaf_reg=5,
    random_seed=random_state,
    verbose=0,
)

lgbm_predictor = X_train.skb.apply(vectorizer_lgbm).skb.apply(lgbm_model, y=y_train)
cat_predictor = X_train.skb.apply(cat_preprocessor).skb.apply(cat_model, y=y_train)

lgbm_learner = lgbm_predictor.skb.make_learner(fitted=True)
cat_learner = cat_predictor.skb.make_learner(fitted=True)

valid_pred_lgbm = np.asarray(lgbm_learner.predict({"data": valid_part}), dtype=float).ravel()
valid_pred_cat = np.asarray(cat_learner.predict({"data": valid_part}), dtype=float).ravel()

lgbm_weight = 0.7
cat_weight = 0.3
valid_pred = lgbm_weight * valid_pred_lgbm + cat_weight * valid_pred_cat
```
