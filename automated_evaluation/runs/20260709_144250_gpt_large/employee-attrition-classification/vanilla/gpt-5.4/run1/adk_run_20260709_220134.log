def prepare_data(X_in, fill_cats=True, fill_nums=True):
    X_out = X_in.copy()
    if fill_cats:
        for c in cat_cols:
            if c in X_out.columns:
                X_out[c] = X_out[c].fillna("Missing")
    if fill_nums:
