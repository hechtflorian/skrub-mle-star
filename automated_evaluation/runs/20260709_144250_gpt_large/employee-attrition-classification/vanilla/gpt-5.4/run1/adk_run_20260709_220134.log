)

lgb_model.fit(X_train_lgb, y_train)

valid_pred_cat = cat_model.predict_proba(X_valid_cb)[:, 1]
valid_pred_lgb = lgb_model.predict_proba(X_valid_lgb)[:, 1]
valid_pred = 0.5 * valid_pred_cat + 0.5 * valid_pred_lgb
