import os
import random
import numpy as np
import pandas as pd
import torch
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score
from catboost import CatBoostClassifier

random.seed(42)
np.random.seed(42)
torch.manual_seed(42)
if torch.cuda.is_available():
    torch.cuda.manual_seed_all(42)

train_path = os.path.join(".", "input", "train.csv")
train = pd.read_csv(train_path)

target = "Attrition"

X = train.drop(columns=[target]).copy()
y = train[target].copy()

cat_cols = X.select_dtypes(include=["object", "category"]).columns.tolist()
num_cols = [c for c in X.columns if c not in cat_cols]

def prepare_data(X_in, fill_cats=True, fill_nums=True):
    X_out = X_in.copy()
    if fill_cats:
        for c in cat_cols:
            X_out[c] = X_out[c].fillna("Missing")
    if fill_nums:
        for c in num_cols:
            med = X_out[c].median()
            X_out[c] = X_out[c].fillna(med)
    return X_out

def run_experiment(name, X_data, use_cat_features=True, use_best_model=True):
    X_train, X_valid, y_train, y_valid = train_test_split(
        X_data,
        y,
        test_size=0.2,
        random_state=42,
        stratify=y
    )

    model = CatBoostClassifier(
        iterations=1200,
        learning_rate=0.03,
        depth=6,
        loss_function="Logloss",
        eval_metric="AUC",
        verbose=0,
        random_state=42
    )

    fit_kwargs = {
        "X": X_train,
        "y": y_train,
        "eval_set": (X_valid, y_valid),
        "use_best_model": use_best_model
    }

    if use_cat_features:
        fit_kwargs["cat_features"] = cat_cols

    model.fit(**fit_kwargs)
    valid_pred = model.predict_proba(X_valid)[:, 1]
    score = roc_auc_score(y_valid, valid_pred)
    print(f"{name}: AUC={score:.6f}")
    return score

results = {}

X_base = prepare_data(X, fill_cats=True, fill_nums=True)
results["baseline_full_pipeline"] = run_experiment(
    "baseline_full_pipeline",
    X_base,
    use_cat_features=True,
    use_best_model=True
)

results["ablation_no_best_model"] = run_experiment(
    "ablation_no_best_model",
    X_base,
    use_cat_features=True,
    use_best_model=False
)

X_no_missing = X.copy()
results["ablation_no_missing_imputation"] = run_experiment(
