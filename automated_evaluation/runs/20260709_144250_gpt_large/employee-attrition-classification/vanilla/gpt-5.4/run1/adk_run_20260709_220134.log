        X_full[c] = X_full[c].fillna("Missing").astype("category")
        X_test_full[c] = X_test_full[c].fillna("Missing").astype("category")
    else:
        med = X_full[c].median()
        X_full[c] = X_full[c].fillna(med)
        X_test_full[c] = X_test_full[c].fillna(med)

final_model = LGBMClassifier(
    n_estimators=800,
    learning_rate=0.03,
    num_leaves=31,
    subsample=0.8,
