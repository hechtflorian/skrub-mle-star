def add_domain_features(df):
    out = df.copy()
    cols = set(out.columns)

    if {"Weight", "Height"}.issubset(cols):
        height_sq = (out["Height"] ** 2).replace(0, np.nan)
        bmi = (out["Weight"] / height_sq).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        out["BMI"] = bmi

        out["log_Weight"] = np.log1p(np.clip(out["Weight"], a_min=0, a_max=None))

        if "Age" in cols:
            out["Age_BMI"] = out["Age"] * bmi

    return out


data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(add_domain_features)

X_train = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()
cat_model = CatBoostClassifier(
    random_state=random_state,
    verbose=0,
)

lgbm_vectorizer = skrub.TableVectorizer()
lgbm_model = LGBMClassifier(
    objective="multiclass",
    num_class=7,
    n_estimators=700,
    learning_rate=0.05,
    num_leaves=31,
