X_train_cat = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

X_train_lgbm = data_train[feature_cols].skb.mark_as_X()

vectorizer = skrub.TableVectorizer()
