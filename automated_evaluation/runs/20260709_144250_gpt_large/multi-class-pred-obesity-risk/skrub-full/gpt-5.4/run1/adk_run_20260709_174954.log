import os
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from lightgbm import LGBMClassifier
from catboost import CatBoostClassifier


RANDOM_STATE = 42
TARGET_COL = "NObeyesdad"
INPUT_DIR = "./input"


def load_data():
    train_path = os.path.join(INPUT_DIR, "train.csv")
    test_path = os.path.join(INPUT_DIR, "test.csv")
    train_df = pd.read_csv(train_path)
    test_df = pd.read_csv(test_path)
    return train_df, test_df


def predictor_lgbm(train_part, valid_part, target_col=TARGET_COL):
    data_train = skrub.var("data", train_part)
    X_train = data_train.drop(["id"]).drop(columns=target_col).skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()

    predictor = (
        X_train
        .skb.apply(vectorizer)
        .skb.apply(
            LGBMClassifier(
                n_estimators=500,
                learning_rate=0.05,
                num_leaves=31,
                subsample=0.9,
                colsample_bytree=0.9,
                random_state=RANDOM_STATE,
                verbose=-1,
            ),
            y=y_train,
        )
    )

    learner = predictor.skb.make_learner(fitted=True)
    pred_valid = learner.predict({"data": valid_part})
    score = accuracy_score(valid_part[target_col], pred_valid)
    return score, learner


def predictor_cat(train_part, valid_part, target_col=TARGET_COL):
    data_train = skrub.var("data", train_part)
    X_train = data_train.drop(["id"]).drop(columns=target_col).skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()

    predictor = (
        X_train
        .skb.apply(vectorizer)
        .skb.apply(
            CatBoostClassifier(
                iterations=500,
                learning_rate=0.05,
                depth=8,
                random_state=RANDOM_STATE,
                verbose=0,
            ),
            y=y_train,
        )
    )

    learner = predictor.skb.make_learner(fitted=True)
    pred_valid = learner.predict({"data": valid_part})
    score = accuracy_score(valid_part[target_col], pred_valid)
    return score, learner


def main():
    train_df, _ = load_data()

    train_idx, valid_idx = train_test_split(
        np.arange(len(train_df)),
        test_size=0.2,
        random_state=RANDOM_STATE,
        stratify=train_df[TARGET_COL],
    )
    train_part = train_df.iloc[train_idx].copy()
    valid_part = train_df.iloc[valid_idx].copy()

    lgbm_score, _ = predictor_lgbm(train_part, valid_part, TARGET_COL)
    cat_score, _ = predictor_cat(train_part, valid_part, TARGET_COL)

    final_validation_score = max(lgbm_score, cat_score)
    print(f"Final Validation Performance: {final_validation_score}")


if __name__ == "__main__":
    main()
```
