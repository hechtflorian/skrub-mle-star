import warnings
warnings.filterwarnings("ignore")

from pathlib import Path

import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split
from sklearn.base import BaseEstimator, TransformerMixin


class SpaceshipFeatureEngineer(BaseEstimator, TransformerMixin):
    def fit(self, X, y=None):
        return self

    def transform(self, X):
        df = X.copy()

        cabin_parts = df["Cabin"].fillna("Unknown/0/U").str.split("/", expand=True)
        df["Deck"] = cabin_parts[0]
        df["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        df["Side"] = cabin_parts[2]

        df["Group"] = df["PassengerId"].astype(str).str.split("_").str[0]

        spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
        for col in spend_cols:
            df[col] = pd.to_numeric(df[col], errors="coerce")

        df["Spent"] = df[spend_cols].fillna(0).sum(axis=1)
        df["NoSpending"] = df["Spent"] == 0

        features = [
            "HomePlanet", "CryoSleep", "Destination", "Age", "VIP",
            "RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck",
            "Deck", "CabinNum", "Side", "Group", "Spent", "NoSpending"
        ]

        return df[features]


input_dir = Path("./input")
train_path = input_dir / "train.csv"
train_df = pd.read_csv(train_path)

target_col = "Transported"
random_state = 42

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col]
)

train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

feature_builder = SpaceshipFeatureEngineer()

model = CatBoostClassifier(
    iterations=800,
    depth=8,
    learning_rate=0.03,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_state=42
)

predictor = (
    X_train
    .skb.apply(feature_builder)
    .skb.apply(
        model,
        y=y_train,
        cat_features=[
            "HomePlanet", "CryoSleep", "Destination", "VIP",
            "Deck", "Side", "Group", "NoSpending"
        ],
    )
)

val_learner = predictor.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part}).astype(bool)

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
