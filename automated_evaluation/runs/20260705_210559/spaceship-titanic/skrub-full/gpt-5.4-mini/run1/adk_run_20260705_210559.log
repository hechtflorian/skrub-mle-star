import numpy as np
import pandas as pd
import skrub
import skrub.selectors as s
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split
from catboost import CatBoostClassifier

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_family_signals(df):
    out = df.copy()

    # PassengerId family/group signal
    if "PassengerId" in out.columns:
        pid = out["PassengerId"].astype(str)
        group_code = pid.str.split("_").str[0].fillna("")
        out["PassengerGroupSize"] = group_code.map(group_code.value_counts()).fillna(1).astype(float)

    # Name-derived family indicators
    if "Name" in out.columns:
        name = out["Name"].astype(str)
        surname = name.str.split(",").str[0].fillna("").str.strip()
        out["SurnameGroupSize"] = surname.map(surname.value_counts()).fillna(1).astype(float)
        out["HasTitle"] = name.str.contains(r"\b(Mr|Mrs|Miss|Master|Dr|Rev|Col|Major|Capt|Sir|Lady|Countess|Jonkheer|Don|Dona)\b", regex=True, na=False).astype(float)

    # Cabin-derived structure
    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype(str)
        cabin_clean = cabin.replace("nan", np.nan)
        cabin_letters = cabin_clean.str.extract(r"([A-Za-z])", expand=False).fillna("Unknown")
        out["CabinDeckGroupSize"] = cabin_letters.map(cabin_letters.value_counts()).fillna(1).astype(float)
        out["HasCabin"] = cabin_clean.notna().astype(float)

    # Strong numeric interactions / missingness-aware signals
    numeric_candidates = [
        "Age",
        "Fare",
        "RoomService",
        "FoodCourt",
        "ShoppingMall",
        "Spa",
        "VRDeck",
        "Pclass",
        "SibSp",
        "Parch",
        "FamilySize",
        "CryoSleep",
        "VIP",
    ]
    spend_cols = [c for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if c in out.columns]
    if spend_cols:
        spend_frame = out[spend_cols].apply(pd.to_numeric, errors="coerce")
        total_spend = spend_frame.sum(axis=1, min_count=1)
        out["TotalSpend"] = total_spend.fillna(0.0)
        out["LogSpend"] = np.log1p(out["TotalSpend"].clip(lower=0))
        if "Age" in out.columns:
            age = pd.to_numeric(out["Age"], errors="coerce").replace(0, np.nan)
            out["SpendPerPerson"] = (out["TotalSpend"] / age).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        else:
            out["SpendPerPerson"] = out["TotalSpend"]
        out["AnySpend"] = (out["TotalSpend"] > 0).astype(float)
    else:
        out["TotalSpend"] = 0.0
        out["LogSpend"] = 0.0
        out["SpendPerPerson"] = 0.0
        out["AnySpend"] = 0.0

    return out


data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(add_family_signals)

X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_fe[target_col].skb.mark_as_y()

# Drop raw identifiers after FE; route only cleaned residual block into vectorizer
X_clean = X_train.skb.apply(skrub.DropCols(cols=s.cols("PassengerId", "Name", "Cabin")))

# Explicit selector-based routing on post-FE frame
low_card_cols = s.categorical() & s.cardinality_below(20)
high_card_drop_cols = s.string() & ~s.cardinality_below(20)
numeric_cols = s.numeric()

X_low = X_clean.skb.select(low_card_cols)
X_num = X_clean.skb.select(numeric_cols)
X_drop = X_clean.skb.select(high_card_drop_cols)

vectorizer = skrub.TableVectorizer(
    low_cardinality="passthrough",
    high_cardinality="drop",
)

X_residual = X_low.skb.concat([X_num], axis=1)

model = CatBoostClassifier(
    iterations=400,
    learning_rate=0.04,
    depth=6,
    l2_leaf_reg=7.0,
    loss_function="Logloss",
    eval_metric="Accuracy",
    random_seed=random_state,
    verbose=0,
)

pred = X_residual.skb.apply(vectorizer).skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
