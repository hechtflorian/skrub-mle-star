    df["Side"] = cabin[2]

    passenger_group = df["PassengerId"].astype(str).str.split("_").str[0]
    group_sizes = passenger_group.map(passenger_group.value_counts())
    df["GroupSize"] = group_sizes.fillna(1).astype(float)

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df["Spent"] = df[spend_cols].fillna(0).sum(axis=1)
    df["IsAlone"] = (df["GroupSize"] == 1).astype(int)

    df["Age"] = pd.to_numeric(df["Age"], errors="coerce")
    df["Cabin"] = df["Cabin"].fillna("Unknown/0/U")
    df["Name"] = df["Name"].fillna("Unknown")
    return df

train_idx, valid_idx = train_test_split(
