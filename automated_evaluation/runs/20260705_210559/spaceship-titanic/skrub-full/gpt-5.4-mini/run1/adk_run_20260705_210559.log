    n_estimators=600,
    max_depth=4,
    learning_rate=0.05,
    subsample=0.8,
    colsample_bytree=0.8,
    reg_lambda=1.0,
    eval_metric="logloss",
    random_state=random_state,
    n_jobs=-1,
    verbosity=0,
)

pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

