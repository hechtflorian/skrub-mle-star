import numpy as np
import pandas as pd
import skrub
import skrub.selectors as s
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split
from catboost import CatBoostClassifier

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_family_signals(df):
    out = df.copy()

    # PassengerId family/group signal
    if "PassengerId" in out.columns:
        pid_num = pd.to_numeric(out["PassengerId"], errors="coerce")
        out["PassengerGroup"] = (pid_num // 3).fillna(-1).astype("int64")
        out["PassengerGroupSizeHint"] = out.groupby("PassengerGroup")["PassengerGroup"].transform("size")
    else:
        out["PassengerGroup"] = -1
        out["PassengerGroupSizeHint"] = 1

    # Cabin deck/family signal
    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        out["CabinDeck"] = cabin.str.extract(r"^([A-Za-z])", expand=False).fillna("Unknown")
        out["CabinNumber"] = pd.to_numeric(cabin.str.extract(r"(\d+)", expand=False), errors="coerce")
        out["CabinHasDeck"] = cabin.notna().astype("int64")
    else:
        out["CabinDeck"] = "Unknown"
        out["CabinNumber"] = np.nan
        out["CabinHasDeck"] = 0

    # Name family-signal block
    if "Name" in out.columns:
        name = out["Name"].astype("string")
        out["Surname"] = name.str.split(",").str[0].fillna("Unknown")
        out["HasTitleInName"] = name.str.contains(r"\b(Mr|Mrs|Miss|Master|Dr|Rev|Col|Major|Mlle|Ms|Mme|Lady|Sir|Countess|Jonkheer|Don|Dona)\b", regex=True, na=False).astype("int64")
    else:
        out["Surname"] = "Unknown"
        out["HasTitleInName"] = 0

    # Strong numeric interaction / missingness-aware spend features
    spend_cols = [c for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if c in out.columns]
    if spend_cols:
        spend = out[spend_cols].apply(pd.to_numeric, errors="coerce").fillna(0.0)
        out["TotalSpend"] = spend.sum(axis=1)
        out["LogSpend"] = np.log1p(out["TotalSpend"].clip(lower=0))
        person_cols = [c for c in ["PassengerGroupSizeHint", "Age"] if c in out.columns]
        denom = pd.to_numeric(out["PassengerGroupSizeHint"], errors="coerce").replace(0, np.nan) if "PassengerGroupSizeHint" in out.columns else pd.Series(np.nan, index=out.index)
        out["SpendPerPerson"] = (out["TotalSpend"] / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        out["AnySpend"] = (out["TotalSpend"] > 0).astype("int64")
    else:
        out["TotalSpend"] = 0.0
        out["LogSpend"] = 0.0
        out["SpendPerPerson"] = 0.0
        out["AnySpend"] = 0

    # Extra interaction that often helps Titanic-style family/group effects
    if "Age" in out.columns:
        out["AgeMissing"] = out["Age"].isna().astype("int64")

    return out


data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(add_family_signals)

X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_fe[target_col].skb.mark_as_y()

# Route on the post-FE frame: drop raw identifiers, then split into low-cardinality categoricals and numerics.
X_clean = X_train.skb.apply(skrub.DropCols(cols=s.cols("PassengerId")))

low_card_selector = (s.categorical() | s.string()) & (
    s.cardinality_below(40) | s.cols("CabinDeck", "Surname")
)
numeric_selector = s.numeric()

X_low = X_clean.skb.select(low_card_selector)
X_num = X_clean.skb.select(numeric_selector)
X_residual = X_low.skb.concat([X_num], axis=1)

vectorizer = skrub.TableVectorizer(
    low_cardinality=skrub.ToCategorical(),
    high_cardinality=skrub.StringEncoder(),
)

model = CatBoostClassifier(
    iterations=400,
    learning_rate=0.04,
    depth=5,
    l2_leaf_reg=6.0,
    loss_function="Logloss",
    eval_metric="Accuracy",
    random_seed=random_state,
    verbose=0,
)

pred = X_residual.skb.apply(vectorizer).skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
