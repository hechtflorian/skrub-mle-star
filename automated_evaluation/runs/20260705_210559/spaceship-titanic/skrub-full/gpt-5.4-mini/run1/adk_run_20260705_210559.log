import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from catboost import CatBoostClassifier

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_winning_features(df):
    out = df.copy()

    if "Cabin" in out.columns:
        cabin = out["Cabin"].fillna("").astype(str).str.strip()
        cabin = cabin.replace({"": np.nan, "nan": np.nan, "None": np.nan})
        cabin_parts = cabin.str.extract(r"^\s*([A-Za-z]?)(\d*)([A-Za-z]?)\s*$")
        out["CabinDeck"] = cabin_parts[0].replace("", np.nan)
        out["CabinNumber"] = pd.to_numeric(cabin_parts[1], errors="coerce").fillna(-1)
        out["CabinSide"] = cabin_parts[2].replace("", np.nan)

    if "Name" in out.columns:
        name = out["Name"].fillna("").astype(str)
        last_first = name.str.extract(r"^\s*([^,]+),\s*(.+?)\s*$")
        out["LastName"] = last_first[0].fillna(name.str.split().str[0])
        out["FirstName"] = last_first[1].fillna("")

    expense_cols = [c for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if c in out.columns]
    if expense_cols:
        out["TotalSpend"] = out[expense_cols].apply(pd.to_numeric, errors="coerce").fillna(0).sum(axis=1)
        out["NoSpend"] = (out["TotalSpend"] <= 0).astype(int)

    return out


data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(add_winning_features)

X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()

model = CatBoostClassifier(
    iterations=300,
    learning_rate=0.05,
    depth=6,
    loss_function="Logloss",
    eval_metric="Accuracy",
    random_seed=random_state,
    verbose=0,
)

pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
