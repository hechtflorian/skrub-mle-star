import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

random_state = 42
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col].astype(int),
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def add_features(df):
    out = df.copy()
    cabin = out["Cabin"].fillna("Unknown/0/U").astype(str).str.split("/", expand=True)
    out["Deck"] = cabin[0]
    out["Num"] = pd.to_numeric(cabin[1], errors="coerce")
    out["Side"] = cabin[2]
    pid_group = out["PassengerId"].astype(str).str.split("_").str[0]
    group_sizes = pid_group.map(pid_group.value_counts())
    out["GroupSize"] = group_sizes.fillna(1).astype(float)
    spent_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out["Spent"] = out[spent_cols].fillna(0).sum(axis=1)
    out["IsAlone"] = (out["GroupSize"] == 1).astype(int)
    out["AgeGroup"] = pd.cut(
        out["Age"].fillna(-1),
        bins=[-np.inf, 0, 12, 18, 25, 40, 60, np.inf],
        labels=["Unknown", "Child", "Teen", "YoungAdult", "Adult", "MidAge", "Senior"],
    ).astype(str)
    out["NoSpend"] = (out["Spent"] == 0).astype(int)
    out["CryoSpend"] = (
        out["CryoSleep"].fillna(False).astype(bool) & (out["Spent"] == 0)
    ).astype(int)
    return out

data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(add_features)

X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_fe[target_col].astype(int).skb.mark_as_y()

vectorizer = skrub.TableVectorizer()
model = CatBoostClassifier(
    iterations=1200,
    learning_rate=0.03,
    depth=6,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=random_state,
)

pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred).reshape(-1)
valid_pred = (valid_pred > 0.5).astype(int)

final_validation_score = accuracy_score(valid_part[target_col].astype(int), valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
