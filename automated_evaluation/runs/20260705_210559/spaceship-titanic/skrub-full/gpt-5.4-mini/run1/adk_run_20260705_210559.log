import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from catboost import CatBoostClassifier

# Assume train_df, target_col, random_state are defined in the existing script context.

test_size = 0.2
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=test_size, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

metric_label = "accuracy"

def make_graph(data_train, use_fe=False):
    if use_fe:
        def fe_func(df):
            out = df.copy()
            cabin = out["Cabin"].astype("string").str.split("/", expand=True)
            out["CabinDeck"] = cabin[0]
            out["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
            out["CabinSide"] = cabin[2]
            out["NameLen"] = out["Name"].astype("string").str.len()
            out["GroupSize"] = out["PassengerId"].astype("string").str.split("_", expand=True)[0]
            out["RoomService"] = pd.to_numeric(out["RoomService"], errors="coerce").fillna(0)
            out["FoodCourt"] = pd.to_numeric(out["FoodCourt"], errors="coerce").fillna(0)
            out["ShoppingMall"] = pd.to_numeric(out["ShoppingMall"], errors="coerce").fillna(0)
            out["Spa"] = pd.to_numeric(out["Spa"], errors="coerce").fillna(0)
            out["VRDeck"] = pd.to_numeric(out["VRDeck"], errors="coerce").fillna(0)
            out["TotalSpend"] = (
                out["RoomService"] + out["FoodCourt"] + out["ShoppingMall"] + out["Spa"] + out["VRDeck"]
            )
            return out

        data_train = data_train.skb.apply_func(fe_func)

    X = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_train[target_col].skb.mark_as_y()

    encoder = skrub.TableVectorizer()
    model = CatBoostClassifier(
        iterations=300,
        depth=6,
        learning_rate=0.08,
        loss_function="Logloss",
        verbose=0,
        random_seed=random_state,
    )
    return X.skb.apply(encoder).skb.apply(model, y=y)

def score_variant(variant_name, build_graph):
    data_train = skrub.var("data", train_part)
    pred = build_graph(data_train)
    learner = pred.skb.make_learner(fitted=True)
    valid_pred = learner.predict({"data": valid_part})
    score = accuracy_score(valid_part[target_col], valid_pred)
    print(f"Ablation[{variant_name}] {metric_label}: {score}")
    return score

scores = {}
scores["baseline"] = score_variant("baseline", lambda d: make_graph(d, use_fe=False))
scores["feature_engineering"] = score_variant("feature_engineering", lambda d: make_graph(d, use_fe=True))
scores["baseline_repeat"] = score_variant("baseline_repeat", lambda d: make_graph(d, use_fe=False))

best_variant = max(scores, key=scores.get)
final_validation_score = scores[best_variant]
print(f"Best ablation variant: {best_variant} | {metric_label}: {final_validation_score}")
print(f"Final Validation Performance: {final_validation_score}")
```
