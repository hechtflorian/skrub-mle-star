# Rebuild preprocessing using ONLY the training split for any fitted statistics
train_df_full = train_df.copy()
test_df_full = test_df.copy()

y = train_df_full["Transported"].astype(int)
X = train_df_full.drop(columns=["Transported"])
test_ids = test_df_full["PassengerId"].copy()

# Split raw training data first
X_train_raw, X_val_raw, y_train, y_val = train_test_split(
    X, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y
)

# Preprocess separately, but fit nothing on validation/test
X_train_proc = preprocess(X_train_raw)
X_val_proc = preprocess(X_val_raw)
test_proc = preprocess(test_df_full)

# Align columns across splits
all_cols = sorted(set(X_train_proc.columns) | set(X_val_proc.columns) | set(test_proc.columns))
for df in [X_train_proc, X_val_proc, test_proc]:
    for c in all_cols:
        if c not in df.columns:
            df[c] = np.nan
    df = df[all_cols]

X_train_proc = X_train_proc[all_cols].copy()
X_val_proc = X_val_proc[all_cols].copy()
test_proc = test_proc[all_cols].copy()

# Determine feature types from TRAIN only
categorical_cols = [c for c in X_train_proc.columns if X_train_proc[c].dtype == "object" or str(X_train_proc[c].dtype).startswith("string")]
numeric_cols = [c for c in X_train_proc.columns if c not in categorical_cols]

# Fit imputers/encoders on TRAIN ONLY via pipeline for sklearn models
numeric_transformer = Pipeline(steps=[
    ("imputer", SimpleImputer(strategy="median"))
])

categorical_transformer = Pipeline(steps=[
    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("onehot", OneHotEncoder(handle_unknown="ignore"))
])

preprocessor = ColumnTransformer(
    transformers=[
        ("num", numeric_transformer, numeric_cols),
        ("cat", categorical_transformer, categorical_cols),
    ]
)

# Prepare CatBoost data without leaking validation/test statistics into training
# - fill categoricals with train-derived missing token only
# - fill numerics with train-only medians
X_train_cb = X_train_proc.copy()
X_val_cb = X_val_proc.copy()
test_cb = test_proc.copy()

# Fit train-only medians for numeric columns
train_numeric_medians = {}
for c in numeric_cols:
    X_train_cb[c] = pd.to_numeric(X_train_cb[c], errors="coerce")
    X_val_cb[c] = pd.to_numeric(X_val_cb[c], errors="coerce")
    test_cb[c] = pd.to_numeric(test_cb[c], errors="coerce")
    train_numeric_medians[c] = X_train_cb[c].median()
    X_train_cb[c] = X_train_cb[c].fillna(train_numeric_medians[c])
    X_val_cb[c] = X_val_cb[c].fillna(train_numeric_medians[c])
    test_cb[c] = test_cb[c].fillna(train_numeric_medians[c])

for c in categorical_cols:
    X_train_cb[c] = X_train_cb[c].fillna("missing").astype("object")
    X_val_cb[c] = X_val_cb[c].fillna("missing").astype("object")
    test_cb[c] = test_cb[c].fillna("missing").astype("object")

cat_cols_train = [c for c in X_train_cb.columns if X_train_cb[c].dtype == "object"]
cat_cols_cb = [c for c in test_cb.columns if test_cb[c].dtype == "object"]

train_pool = Pool(X_train_cb, y_train, cat_features=cat_cols_train)
val_pool = Pool(X_val_cb, y_val, cat_features=cat_cols_train)
test_pool = Pool(test_cb, cat_features=cat_cols_cb)

cat_model = CatBoostClassifier(
    iterations=1200,
    learning_rate=0.03,
    depth=6,
    loss_function="Logloss",
    eval_metric="Accuracy",
    random_seed=RANDOM_STATE,
    verbose=False,
    od_type="Iter",
    od_wait=80,
    allow_writing_files=False,
)

# Train ONLY on training split, validate on validation split
cat_model.fit(train_pool, eval_set=val_pool, use_best_model=True)

cat_val_pred = (cat_model.predict_proba(val_pool)[:, 1] >= 0.5).astype(int)
cat_val_score = accuracy_score(y_val, cat_val_pred)

models = [
    ("rf", RandomForestClassifier(
        n_estimators=400,
        max_depth=None,
        min_samples_split=4,
        min_samples_leaf=2,
        random_state=RANDOM_STATE,
        n_jobs=-1
    )),
    ("lr", LogisticRegression(
        max_iter=2000,
        C=1.0,
        solver="liblinear",
        random_state=RANDOM_STATE
    )),
    ("gb", GradientBoostingClassifier(random_state=RANDOM_STATE))
]

# Cross-validate ONLY on the training split
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)

val_scores = [cat_val_score]
test_probas = [cat_model.predict_proba(test_pool)[:, 1]]

for _, clf in models:
    pipe = Pipeline(steps=[
        ("preprocessor", preprocessor),
        ("model", clf)
    ])
    cv_score = cross_val_score(pipe, X_train_raw, y_train, cv=skf, scoring="accuracy", n_jobs=-1).mean()
    val_scores.append(cv_score)

    # Fit ONLY on training split before predicting test
    pipe.fit(X_train_raw, y_train)

    if hasattr(pipe.named_steps["model"], "predict_proba"):
        proba = pipe.predict_proba(test_df_full)[:, 1]
    else:
        proba = pipe.decision_function(test_df_full)
        proba = (proba - proba.min()) / (proba.max() - proba.min() + 1e-9)

    test_probas.append(proba)

weights = np.array(val_scores, dtype=float)
weights = weights / weights.sum()

ensemble_proba = np.zeros(len(test_df_full), dtype=float)
for w, p in zip(weights, test_probas):
    ensemble_proba += w * p

# Validation score computed without training on validation samples
final_validation_score = float(np.mean(val_scores))
print(f"Final Validation Performance: {final_validation_score}")

preds = (ensemble_proba >= 0.5).astype(bool)
submission = pd.DataFrame({
    "PassengerId": test_ids,
    "Transported": preds
})
submission.to_csv(SUBMISSION_PATH, index=False)
print(f"Saved submission to {SUBMISSION_PATH}")
print(submission.head())
