from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import accuracy_score
import numpy as np
import pandas as pd
from catboost import CatBoostClassifier, Pool

# -------------------------------------------------------------------
# Feature engineering: high-signal grouped categorical features
# -------------------------------------------------------------------
train_df = train_df.copy()
test_df = test_df.copy()

for df in [train_df, test_df]:
    # Passenger group from PassengerId
    if "PassengerId" in df.columns:
        df["PassengerGroup"] = df["PassengerId"].astype(str).str.split("_").str[0]

    # Surname from Name
    if "Name" in df.columns:
        df["Surname"] = df["Name"].astype(str).str.split().str[-1]
    else:
        df["Surname"] = "Unknown"

    # Cabin decomposition and grouped cabin features
    if "Cabin" in df.columns:
        cabin_split = df["Cabin"].astype(str).str.split("/", expand=True)
        df["CabinDeck"] = cabin_split[0]
        df["CabinNum"] = cabin_split[1]
        df["CabinSide"] = cabin_split[2]
    else:
        df["CabinDeck"] = "Unknown"
        df["CabinNum"] = "Unknown"
        df["CabinSide"] = "Unknown"

    # High-signal grouped categories
    if "HomePlanet" in df.columns and "CryoSleep" in df.columns:
        df["HomePlanet_CryoSleep"] = df["HomePlanet"].astype(str) + "_" + df["CryoSleep"].astype(str)
    else:
        df["HomePlanet_CryoSleep"] = "Unknown"

    df["CabinDeck_CabinSide"] = df["CabinDeck"].astype(str) + "_" + df["CabinSide"].astype(str)
    df["PassengerGroup_Surname"] = df["PassengerGroup"].astype(str) + "_" + df["Surname"].astype(str)

# -------------------------------------------------------------------
# Prepare features / target
# -------------------------------------------------------------------
y = train_df["Transported"].astype(int).values
X = train_df.drop(columns=["Transported"])
X_test = test_df.copy()

# Ensure categorical features are treated as strings / category-like for CatBoost
cat_cols = [c for c in X.columns if X[c].dtype == "object"]
for c in cat_cols:
    X[c] = X[c].astype(str).fillna("Unknown")
    X_test[c] = X_test[c].astype(str).fillna("Unknown")

# Also include engineered categorical columns if not already captured
for c in ["PassengerGroup", "Surname", "CabinDeck", "CabinSide", "HomePlanet_CryoSleep", "CabinDeck_CabinSide", "PassengerGroup_Surname"]:
    if c in X.columns and c not in cat_cols:
        cat_cols.append(c)

cat_features = [X.columns.get_loc(c) for c in cat_cols if c in X.columns]

# -------------------------------------------------------------------
# Small candidate search over regularization settings with 3-fold CV
# -------------------------------------------------------------------
skf = StratifiedKFold(n_splits=3, shuffle=True, random_state=RANDOM_STATE)

param_candidates = [
    {"l2_leaf_reg": 3.0, "random_strength": 1.0},
    {"l2_leaf_reg": 5.0, "random_strength": 1.5},
    {"l2_leaf_reg": 8.0, "random_strength": 2.0},
]

best_score = -np.inf
best_params = None
best_threshold = 0.5
best_oof = None
best_test_pred = None

for params in param_candidates:
    oof_pred = np.zeros(len(X), dtype=float)
    test_pred = np.zeros(len(X_test), dtype=float)

    for fold, (tr_idx, va_idx) in enumerate(skf.split(X, y), 1):
        X_tr, X_va = X.iloc[tr_idx].copy(), X.iloc[va_idx].copy()
        y_tr, y_va = y[tr_idx], y[va_idx]

        train_pool = Pool(X_tr, y_tr, cat_features=cat_features)
        val_pool = Pool(X_va, y_va, cat_features=cat_features)
        test_pool = Pool(X_test, cat_features=cat_features)

        model = CatBoostClassifier(
            iterations=1200,
            learning_rate=0.03,
            depth=6,
            loss_function="Logloss",
            eval_metric="Accuracy",
            random_seed=RANDOM_STATE + fold,
            verbose=False,
            od_type="Iter",
            od_wait=80,
            allow_writing_files=False,
            **params,
        )

        model.fit(train_pool, eval_set=val_pool, use_best_model=True)

        oof_pred[va_idx] = model.predict_proba(val_pool)[:, 1]
        test_pred += model.predict_proba(test_pool)[:, 1] / skf.n_splits

    # Optimize threshold on out-of-fold predictions
    thresholds = np.linspace(0.2, 0.8, 121)
    scores = [accuracy_score(y, (oof_pred >= t).astype(int)) for t in thresholds]
    idx = int(np.argmax(scores))
    threshold = float(thresholds[idx])
    score = float(scores[idx])

    if score > best_score:
        best_score = score
        best_params = params
        best_threshold = threshold
        best_oof = oof_pred.copy()
        best_test_pred = test_pred.copy()

print(f"Best CV Accuracy: {best_score}")
print(f"Best threshold: {best_threshold}")
print(f"Best params: {best_params}")

# -------------------------------------------------------------------
# Train final model on full data with best settings and average folds' test probs
# -------------------------------------------------------------------
final_test_pred = np.zeros(len(X_test), dtype=float)

for fold, (tr_idx, va_idx) in enumerate(skf.split(X, y), 1):
    X_tr, X_va = X.iloc[tr_idx].copy(), X.iloc[va_idx].copy()
    y_tr, y_va = y[tr_idx], y[va_idx]

    train_pool = Pool(X_tr, y_tr, cat_features=cat_features)
    val_pool = Pool(X_va, y_va, cat_features=cat_features)
    test_pool = Pool(X_test, cat_features=cat_features)

    model = CatBoostClassifier(
        iterations=1200,
        learning_rate=0.03,
        depth=6,
        loss_function="Logloss",
        eval_metric="Accuracy",
        random_seed=RANDOM_STATE + fold,
        verbose=False,
        od_type="Iter",
        od_wait=80,
        allow_writing_files=False,
        **best_params,
    )

    model.fit(train_pool, eval_set=val_pool, use_best_model=True)
    final_test_pred += model.predict_proba(test_pool)[:, 1] / skf.n_splits

submission = pd.DataFrame({
    "PassengerId": test_ids,
    "Transported": (final_test_pred >= best_threshold).astype(bool)
})
submission.to_csv(SUBMISSION_PATH, index=False)
print(f"Saved submission to {SUBMISSION_PATH}")
