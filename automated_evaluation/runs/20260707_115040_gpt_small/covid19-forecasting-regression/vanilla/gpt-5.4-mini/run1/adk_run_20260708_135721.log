def add_increment_features(train, test):
    # Preserve original row order for later reconstruction
    train = train.copy()
    test = test.copy()

    # Combine for consistent feature engineering
    train["_is_train"] = 1
    test["_is_train"] = 0
    test["ConfirmedCases"] = np.nan
    test["Fatalities"] = np.nan
    full = pd.concat([train, test], axis=0, ignore_index=True)

    full = full.sort_values(["Country_Region", "Province_State", "Date"]).reset_index(drop=True)

    group_cols = ["Country_Region", "Province_State"]
    for target in ["ConfirmedCases", "Fatalities"]:
        # Daily increments from cumulative series
        full[f"new_{target}"] = full.groupby(group_cols)[target].diff().fillna(0)
        full[f"new_{target}"] = full[f"new_{target}"].clip(lower=0)

        # Lagged differences
        full[f"{target}_lag1"] = full.groupby(group_cols)[target].shift(1)
        full[f"new_{target}_lag1"] = full.groupby(group_cols)[f"new_{target}"].shift(1)

        # Short-window rolling means on increments (shifted to avoid leakage)
        full[f"new_{target}_roll3_mean"] = (
            full.groupby(group_cols)[f"new_{target}"]
            .shift(1)
            .rolling(window=3, min_periods=1)
            .mean()
            .reset_index(level=group_cols, drop=True)
        )
        full[f"new_{target}_roll7_mean"] = (
            full.groupby(group_cols)[f"new_{target}"]
            .shift(1)
            .rolling(window=7, min_periods=1)
            .mean()
            .reset_index(level=group_cols, drop=True)
        )

    # Fill initial missing values
    for c in [
        "ConfirmedCases_lag1", "Fatalities_lag1",
        "new_ConfirmedCases_lag1", "new_Fatalities_lag1",
        "new_ConfirmedCases_roll3_mean", "new_ConfirmedCases_roll7_mean",
        "new_Fatalities_roll3_mean", "new_Fatalities_roll7_mean",
    ]:
        full[c] = full[c].fillna(0)

    train_out = full[full["_is_train"] == 1].drop(columns=["_is_train"]).copy()
    test_out = full[full["_is_train"] == 0].drop(columns=["_is_train", "ConfirmedCases", "Fatalities"]).copy()
    return train_out, test_out


def cat_train_predict(train_part, valid_part, test_df, feature_cols, target_col):
    # Train on daily increments instead of cumulative counts
    group_cols = ["Country_Region", "Province_State"]

    train_part = train_part.sort_values(group_cols + ["Date"]).copy()
    valid_part = valid_part.sort_values(group_cols + ["Date"]).copy()
    test_df = test_df.sort_values(group_cols + ["Date"]).copy()

    # Build increment targets from cumulative values
    train_inc = train_part.groupby(group_cols)[target_col].diff().fillna(0).clip(lower=0)
    valid_inc = valid_part.groupby(group_cols)[target_col].diff().fillna(0).clip(lower=0)

    # Log1p transform of increment target
    y_train = np.log1p(train_inc)
    y_valid = np.log1p(valid_inc)

    X_train = train_part[feature_cols]
    X_valid = valid_part[feature_cols]
    X_test = test_df[feature_cols]

    model = CatBoostRegressor(
        loss_function="RMSE",
        iterations=4000,
        depth=5,
        learning_rate=0.03,
        l2_leaf_reg=6.0,
        random_seed=RANDOM_STATE,
        verbose=False,
        od_type="Iter",
        od_wait=200,
        allow_writing_files=False,
    )
    model.fit(
        X_train,
        y_train,
        eval_set=(X_valid, y_valid),
        use_best_model=True,
        verbose=False,
    )

    valid_inc_pred = np.expm1(model.predict(X_valid))
    test_inc_pred = np.expm1(model.predict(X_test))

    valid_inc_pred = np.maximum(valid_inc_pred, 0)
    test_inc_pred = np.maximum(test_inc_pred, 0)

    # Reconstruct cumulative predictions by grouped cumulative sum
    valid_pred = pd.Series(valid_part[target_col].groupby([valid_part["Country_Region"], valid_part["Province_State"]]).cumcount(), index=valid_part.index)
    test_pred = pd.Series(test_df[target_col].groupby([test_df["Country_Region"], test_df["Province_State"]]).cumcount(), index=test_df.index)

    valid_pred = pd.Series(valid_inc_pred, index=valid_part.index)
    test_pred = pd.Series(test_inc_pred, index=test_df.index)

    valid_pred = (
        valid_part[["Country_Region", "Province_State"]]
        .assign(_inc=valid_pred.values)
        .groupby(["Country_Region", "Province_State"])["_inc"]
        .cumsum()
    )
    test_pred = (
        test_df[["Country_Region", "Province_State"]]
        .assign(_inc=test_pred.values)
        .groupby(["Country_Region", "Province_State"])["_inc"]
        .cumsum()
    )

    # Monotonic clipping for cumulative counts
    valid_pred = np.maximum(valid_pred.values, 0)
    test_pred = np.maximum(test_pred.values, 0)

    return valid_pred, test_pred


def main():
    train = pd.read_csv(TRAIN_PATH)
    test = pd.read_csv(TEST_PATH)

    if len(train) > SUBSAMPLE_MAX_ROWS:
        train = train.sample(SUBSAMPLE_MAX_ROWS, random_state=RANDOM_STATE).copy()

    train, test = prepare_data(train, test)
    train, test = encode_categoricals(train, test)

    train = train.sort_values(["Country_Region", "Province_State", "Date"]).reset_index(drop=True)
    test = test.sort_values(["Country_Region", "Province_State", "Date"]).reset_index(drop=True)

    # Add low-cost increment-oriented features
    train, test = add_increment_features(train, test)

    feature_cols = [
        "Province_State",
        "Country_Region",
        "province_missing",
        "country_missing",
        "year",
        "month",
        "day",
        "dow",
        "dayofyear",
        "weekofyear",
        "is_month_start",
        "is_month_end",
        "days_since_start",
        "region_count",
        "country_count",
        "region_freq",
        "country_freq",
        "log_region_count",
        "log_country_count",
        "ConfirmedCases_lag1",
        "Fatalities_lag1",
        "new_ConfirmedCases_lag1",
        "new_Fatalities_lag1",
        "new_ConfirmedCases_roll3_mean",
        "new_ConfirmedCases_roll7_mean",
        "new_Fatalities_roll3_mean",
        "new_Fatalities_roll7_mean",
    ]

    for c in feature_cols:
        train[c] = pd.to_numeric(train[c], errors="coerce").fillna(0)
        test[c] = pd.to_numeric(test[c], errors="coerce").fillna(0)

    tr_idx, va_idx = make_holdout_split(train, val_days=VALIDATION_DAYS)
    train_part = train.loc[tr_idx].copy()
    valid_part = train.loc[va_idx].copy()

    valid_pred = pd.DataFrame(index=valid_part.index)
    test_pred = pd.DataFrame(index=test.index)

    for target in ["ConfirmedCases", "Fatalities"]:
        cat_valid, cat_test = cat_train_predict(train_part, valid_part, test, feature_cols, target)

        # Enforce monotonicity within each region over time
        valid_order = valid_part.sort_values(["Country_Region", "Province_State", "Date"]).index
        test_order = test.sort_values(["Country_Region", "Province_State", "Date"]).index

        valid_series = pd.Series(cat_valid, index=valid_part.index).sort_index()
        test_series = pd.Series(cat_test, index=test.index).sort_index()

        valid_pred[target] = valid_series
        test_pred[target] = test_series

    y_true_valid = valid_part[["ConfirmedCases", "Fatalities"]].copy()
    y_pred_valid = valid_pred[["ConfirmedCases", "Fatalities"]].copy()

    rmsle_cases = rmsle(y_true_valid["ConfirmedCases"], y_pred_valid["ConfirmedCases"])
    rmsle_fatal = rmsle(y_true_valid["Fatalities"], y_pred_valid["Fatalities"])
    final_validation_score = float((rmsle_cases + rmsle_fatal) / 2.0)

    submission = pd.DataFrame({
        "ForecastId": test["ForecastId"].values,
        "ConfirmedCases": test_pred["ConfirmedCases"].values,
        "Fatalities": test_pred["Fatalities"].values,
    })
    submission = submission.sort_values("ForecastId").reset_index(drop=True)
    submission["ConfirmedCases"] = submission["ConfirmedCases"].clip(lower=0)
    submission["Fatalities"] = submission["Fatalities"].clip(lower=0)
    submission.to_csv(SUB_PATH, index=False)

    print(f"Final Validation Performance: {final_validation_score}")
