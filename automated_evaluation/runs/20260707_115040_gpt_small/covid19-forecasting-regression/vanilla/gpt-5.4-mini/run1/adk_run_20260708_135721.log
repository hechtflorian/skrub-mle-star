        "ConfirmedCases": np.maximum(test_pred_df["ConfirmedCases"].values, 0),
        "Fatalities": np.maximum(test_pred_df["Fatalities"].values, 0),
    })
    submission = submission.sort_values("ForecastId").reset_index(drop=True)
    submission.to_csv(SUB_PATH, index=False)

    print(f"Final Validation Performance: {score}")


