import numpy as np
import pandas as pd
import skrub
import skrub.selectors as s
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.preprocessing import OneHotEncoder
from catboost import CatBoostClassifier
from lightgbm import LGBMClassifier

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_structural_features(df):
    out = df.copy()

    if "Name" in out.columns:
        name_parts = out["Name"].astype("string").str.split(",", n=1, expand=True)
        out["Surname"] = name_parts[0].str.strip()
        out["GivenName"] = np.where(
            name_parts.shape[1] > 1,
            name_parts[1].astype("string").str.strip().str.split(" ", n=1).str[0],
            pd.NA,
        )

    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string").replace(
            {"<NA>": pd.NA, "nan": pd.NA, "None": pd.NA, "": pd.NA}
        )
        out["CabinDeck"] = cabin.str[0]
        out["CabinSide"] = cabin.str[-1]
        out["CabinNumber"] = cabin.str.extract(r"(\d+)", expand=False)

    if "Age" in out.columns:
        out["AgeGroup"] = pd.cut(
            out["Age"],
            bins=[-np.inf, 12, 18, 35, 50, 65, np.inf],
            labels=["child", "teen", "young_adult", "adult", "senior", "elder"],
        ).astype("object")

    spend_cols = [c for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if c in out.columns]
    if spend_cols:
        spend_block = out[spend_cols].apply(pd.to_numeric, errors="coerce").fillna(0.0)
        spend_sum = spend_block.sum(axis=1)
        out["AnySpend"] = (spend_sum > 0).astype(int)
        out["TotalSpend"] = spend_sum
        out["ZeroSpendFlag"] = (spend_sum == 0).astype(int)
        out["LogTotalSpend"] = np.log1p(spend_sum)

    return out


def build_graph(data_train, use_fe=True, use_routing=True):
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    if use_fe:
        X_train = X_train.skb.apply_func(add_structural_features)
        X_train = X_train.skb.apply(skrub.DropCols(cols=s.cols("PassengerId")), errors="ignore")

    if use_routing:
        numeric_block = X_train.skb.select(s.numeric())
        low_card_block = X_train.skb.select((s.categorical() | s.string()) & s.cardinality_below(25))
        high_card_block = X_train.skb.select(s.string() & ~s.cardinality_below(25))

        numeric_vec = numeric_block.skb.apply(skrub.TableVectorizer())
        low_vec = low_card_block.skb.apply(
            skrub.TableVectorizer(
                low_cardinality=OneHotEncoder(handle_unknown="ignore", sparse_output=False),
                high_cardinality="drop",
            )
        )
        high_vec = high_card_block.skb.apply(
            skrub.TableVectorizer(
                low_cardinality="passthrough",
                high_cardinality=skrub.StringEncoder(),
            )
        )
        X_proc = numeric_vec.skb.concat([low_vec, high_vec], axis=1)
    else:
        X_proc = X_train.skb.apply(skrub.TableVectorizer())

    cat_model = CatBoostClassifier(
        loss_function="Logloss",
        iterations=500,
        learning_rate=0.05,
        depth=6,
        random_seed=random_state,
        verbose=0,
    )
    lgbm_model = LGBMClassifier(
        random_state=random_state,
        n_estimators=300,
        learning_rate=0.05,
        num_leaves=31,
        subsample=0.8,
        colsample_bytree=0.8,
        verbose=-1,
    )

    cat_pred = X_proc.skb.apply(cat_model, y=y_train)
    lgbm_pred = X_proc.skb.apply(lgbm_model, y=y_train)
    return cat_pred, lgbm_pred


data_train = skrub.var("data", train_part)
cat_pred, lgbm_pred = build_graph(data_train, use_fe=True, use_routing=True)

cat_learner = cat_pred.skb.make_learner(fitted=True)
lgbm_learner = lgbm_pred.skb.make_learner(fitted=True)

valid_cat = np.asarray(cat_learner.predict({"data": valid_part})).reshape(-1).astype(float)
valid_lgbm = np.asarray(lgbm_learner.predict({"data": valid_part})).reshape(-1).astype(float)

valid_blend = 0.55 * valid_cat + 0.45 * valid_lgbm
valid_label = valid_blend >= 0.5

final_validation_score = accuracy_score(valid_part[target_col].astype(bool), valid_label)
print(f"Final Validation Performance: {final_validation_score}")
