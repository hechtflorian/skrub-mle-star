import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

random_state = 42
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")

def add_features(df):
    out = df.copy()

    cabin = out["Cabin"].fillna("X/0/X").astype(str).str.split("/", expand=True)
    out["Deck"] = cabin[0]
    out["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
    out["Side"] = cabin[2]

    name_split = out["Name"].fillna("Unknown Unknown").astype(str).str.split(" ", n=1, expand=True)
    out["FirstName"] = name_split[0]
    out["LastName"] = name_split[1].fillna("Unknown")

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out[spend_cols] = out[spend_cols].fillna(0)
    out["TotalSpending"] = out[spend_cols].sum(axis=1)
    out["HasSpending"] = (out["TotalSpending"] > 0).astype(int)
    out["NoSpending"] = (out["TotalSpending"] == 0).astype(int)

    out["Age"] = pd.to_numeric(out["Age"], errors="coerce")
    out["AgeBin"] = pd.cut(
        out["Age"],
        bins=[-np.inf, 12, 18, 25, 35, 50, np.inf],
        labels=["child", "teen", "young_adult", "adult", "mid_age", "senior"],
    ).astype(str)

    out["CabinNum"] = out["CabinNum"].fillna(-1)
    out["PassengerGroup"] = out["PassengerId"].astype(str).str.split("_").str[0]
    out["GroupSize"] = out["PassengerGroup"].map(out["PassengerGroup"].value_counts()).fillna(1).astype(int)

    out["SpendingPerAge"] = (out["TotalSpending"] / out["Age"].replace(0, np.nan)).replace([np.inf, -np.inf], np.nan).fillna(0)
    return out

train_df = skrub.var("data", train_df).skb.apply_func(add_features)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df.get_value() if hasattr(train_df, "get_value") else pd.read_csv("./input/train.csv"))),
    test_size=0.2,
    random_state=random_state,
    stratify=pd.read_csv("./input/train.csv")[target_col].astype(int),
)

# Rebind using DataFrame slices for honest holdout
base_train_df = pd.read_csv("./input/train.csv")
train_part = base_train_df.iloc[train_idx].copy()
valid_part = base_train_df.iloc[valid_idx].copy()

data = skrub.var("data", train_part)
data = data.skb.apply_func(add_features)

X = data.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y = data[target_col].skb.mark_as_y()

cat_cols = [
    "PassengerId", "HomePlanet", "CryoSleep", "Destination", "VIP",
    "Deck", "Side", "FirstName", "LastName", "AgeBin", "PassengerGroup"
]

def build_catboost_model():
    return CatBoostClassifier(
        iterations=1500,
        depth=6,
        learning_rate=0.03,
        loss_function="Logloss",
        eval_metric="Accuracy",
        verbose=0,
        random_seed=random_state
    )

model = build_catboost_model()
pred_graph = X.skb.apply(model, y=y)
learner = pred_graph.skb.make_learner(fitted=True)

valid_data = skrub.var("data", valid_part).skb.apply_func(add_features)
valid_X = valid_data.drop(columns=[target_col], errors="ignore").skb.mark_as_X()

valid_pred = learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred).astype(int).ravel()
valid_true = valid_part[target_col].astype(int).to_numpy()

final_validation_score = accuracy_score(valid_true, valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
