import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.linear_model import LogisticRegression

random_state = 42
test_size = 0.2
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")


def add_features(df):
    out = df.copy()

    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        parts = cabin.str.split("/", expand=True)
        if parts.shape[1] >= 3:
            out["CabinDeck"] = parts[0]
            out["CabinNum"] = pd.to_numeric(parts[1], errors="coerce")
            out["CabinSide"] = parts[2]
        else:
            out["CabinDeck"] = pd.NA
            out["CabinNum"] = np.nan
            out["CabinSide"] = pd.NA

    if "Name" in out.columns:
        out["NameLength"] = out["Name"].astype("string").str.len()
        out["Surname"] = out["Name"].astype("string").str.split().str[-1]

    spend_cols = [c for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if c in out.columns]
    if spend_cols:
        spend = out[spend_cols].fillna(0.0)
        out["TotalSpend"] = spend.sum(axis=1)
        out["NoSpend"] = (out["TotalSpend"] == 0).astype(int)

    if "Age" in out.columns:
        out["AgeGroup"] = pd.cut(
            out["Age"],
            bins=[-np.inf, 12, 18, 30, 50, np.inf],
            labels=["child", "teen", "young_adult", "adult", "senior"],
        )

    return out


train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=test_size, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(add_features)

X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Removed unsupported errors="ignore" from skrub Namespace.apply.
X_train = X_train.skb.apply(skrub.DropCols(cols=skrub.selectors.cols("PassengerId")))

vectorizer = skrub.TableVectorizer()
model = LogisticRegression(max_iter=1000)

pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
learner = pred.skb.make_learner(fitted=True)

valid_part_fe = add_features(valid_part)
valid_pred = learner.predict({"data": valid_part_fe})
valid_pred = np.asarray(valid_pred).astype(bool)

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
