import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from lightgbm import LGBMClassifier
from catboost import CatBoostClassifier

random_state = 42
test_size = 0.2
target_col = "NObeyesdad"

train_path = os.path.join("./input", "train.csv")
train_df = pd.read_csv(train_path)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=test_size,
    random_state=random_state,
    stratify=train_df[target_col],
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

vectorizer_lgbm = skrub.TableVectorizer()
vectorizer_cat = skrub.TableVectorizer()

lgbm_model = LGBMClassifier(
    n_estimators=1200,
    learning_rate=0.03,
    num_leaves=63,
    subsample=0.85,
    colsample_bytree=0.85,
    random_state=random_state,
    n_jobs=1,
    verbose=-1,
)

cat_model = CatBoostClassifier(
    loss_function="MultiClass",
    iterations=400,
    learning_rate=0.1,
    depth=6,
    random_seed=random_state,
    verbose=0,
)

pred_lgbm = X_train.skb.apply(vectorizer_lgbm).skb.apply(lgbm_model, y=y_train)
pred_cat = X_train.skb.apply(vectorizer_cat).skb.apply(cat_model, y=y_train)

learner_lgbm = pred_lgbm.skb.make_learner(fitted=True)
learner_cat = pred_cat.skb.make_learner(fitted=True)

def _safe_predict_and_proba(learner, df):
    labels = np.asarray(learner.predict({"data": df}))
    proba = None
    try:
        raw = learner.predict_proba({"data": df})
        if raw is not None:
            raw = np.asarray(raw)
            if raw.ndim == 2 and raw.shape[0] == len(df):
                proba = raw
    except Exception:
        proba = None
    return labels, proba

def _top_margin(proba, labels):
    if proba is None or proba.ndim != 2 or proba.shape[0] == 0:
        return np.zeros(len(labels), dtype=float), np.zeros(len(labels), dtype=float)
    if proba.shape[1] == 1:
        top1 = proba[:, 0]
        top2 = np.zeros_like(top1)
        return top1, top2
    part = np.partition(proba, -2, axis=1)
    top1 = part[:, -1]
    top2 = part[:, -2]
    return top1, top2

def _rank_score_from_proba_or_labels(labels, proba, n_classes, class_labels):
    scores = np.zeros((len(labels), n_classes), dtype=float)
    label_to_idx = {c: i for i, c in enumerate(class_labels)}

    if proba is not None and proba.ndim == 2 and proba.shape[1] == n_classes:
        for i in range(len(labels)):
            order = np.argsort(-proba[i], kind="mergesort")
            for rank, cls_idx in enumerate(order):
                scores[i, cls_idx] += (n_classes - rank)
    else:
        for i, lab in enumerate(labels):
            scores[i, label_to_idx.get(lab, 0)] += n_classes

    return scores

valid_pred_lgbm, valid_proba_lgbm = _safe_predict_and_proba(learner_lgbm, valid_part)
valid_pred_cat, valid_proba_cat = _safe_predict_and_proba(learner_cat, valid_part)

all_classes = []
for arr in [valid_pred_lgbm, valid_pred_cat]:
    for v in np.asarray(arr).ravel():
        if v not in all_classes:
            all_classes.append(v)

if valid_proba_lgbm is not None and valid_proba_cat is not None:
    if valid_proba_lgbm.shape[1] == valid_proba_cat.shape[1]:
        n_classes = valid_proba_cat.shape[1]
        class_labels = list(range(n_classes))
        prob_order_ok = True
    else:
        prob_order_ok = False
else:
    prob_order_ok = False

final_pred = []
if prob_order_ok:
    cat_top1, cat_top2 = _top_margin(valid_proba_cat, valid_pred_cat)
    lgbm_top1, lgbm_top2 = _top_margin(valid_proba_lgbm, valid_pred_lgbm)
    cat_margin = cat_top1 - cat_top2
    lgbm_margin = lgbm_top1 - lgbm_top2

    for i in range(len(valid_part)):
        if valid_pred_cat[i] == valid_pred_lgbm[i]:
            final_pred.append(valid_pred_cat[i])
            continue

        if abs(cat_top1[i] - lgbm_top1[i]) < 0.05:
            blended = 0.55 * valid_proba_cat[i] + 0.45 * valid_proba_lgbm[i]
            final_pred.append(class_labels[int(np.argmax(blended))])
            continue

        cat_scores = _rank_score_from_proba_or_labels(
            np.array([valid_pred_cat[i]]),
            valid_proba_cat[i:i+1],
            n_classes,
            class_labels,
        )[0]
        lgbm_scores = _rank_score_from_proba_or_labels(
            np.array([valid_pred_lgbm[i]]),
            valid_proba_lgbm[i:i+1],
            n_classes,
            class_labels,
        )[0]
        combined = 0.55 * cat_scores + 0.45 * lgbm_scores
        cat_idx = class_labels.index(valid_pred_cat[i]) if valid_pred_cat[i] in class_labels else int(np.argmax(valid_proba_cat[i]))
        lgbm_idx = class_labels.index(valid_pred_lgbm[i]) if valid_pred_lgbm[i] in class_labels else int(np.argmax(valid_proba_lgbm[i]))
        combined[cat_idx] += 0.15 * float(cat_margin[i])
        combined[lgbm_idx] += 0.10 * float(lgbm_margin[i])
        final_pred.append(class_labels[int(np.argmax(combined))])
else:
    class_labels = all_classes if all_classes else list(np.unique(train_df[target_col]))
    n_classes = len(class_labels)
    for i in range(len(valid_part)):
        if valid_pred_cat[i] == valid_pred_lgbm[i]:
            final_pred.append(valid_pred_cat[i])
            continue

        cat_scores = _rank_score_from_proba_or_labels(
            np.array([valid_pred_cat[i]]),
            valid_proba_cat[i:i+1] if valid_proba_cat is not None else None,
            n_classes,
            class_labels,
        )[0]
        lgbm_scores = _rank_score_from_proba_or_labels(
            np.array([valid_pred_lgbm[i]]),
            valid_proba_lgbm[i:i+1] if valid_proba_lgbm is not None else None,
            n_classes,
            class_labels,
        )[0]

        combined = 0.55 * cat_scores + 0.45 * lgbm_scores

        if valid_proba_cat is not None and valid_proba_cat.ndim == 2 and valid_proba_cat.shape[1] > 1:
            cat_part = valid_proba_cat[i]
            cat_margin = np.partition(cat_part, -2)[-1] - np.partition(cat_part, -2)[-2]
        else:
            cat_margin = 0.0
        if valid_proba_lgbm is not None and valid_proba_lgbm.ndim == 2 and valid_proba_lgbm.shape[1] > 1:
            lgbm_part = valid_proba_lgbm[i]
            lgbm_margin = np.partition(lgbm_part, -2)[-1] - np.partition(lgbm_part, -2)[-2]
        else:
            lgbm_margin = 0.0

        cat_idx = class_labels.index(valid_pred_cat[i]) if valid_pred_cat[i] in class_labels else 0
        lgbm_idx = class_labels.index(valid_pred_lgbm[i]) if valid_pred_lgbm[i] in class_labels else 0
        combined[cat_idx] += 0.15 * float(cat_margin)
        combined[lgbm_idx] += 0.10 * float(lgbm_margin)
        final_pred.append(class_labels[int(np.argmax(combined))])

final_validation_score = accuracy_score(valid_part[target_col], final_pred)
print(f"Final Validation Performance: {final_validation_score}")
