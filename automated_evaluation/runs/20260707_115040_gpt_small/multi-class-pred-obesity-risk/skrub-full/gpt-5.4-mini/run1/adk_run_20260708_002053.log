    return labels, proba

def _top_margin(proba):
    if proba is None or proba.ndim != 2 or proba.shape[1] < 2:
        return np.zeros(len(valid_part), dtype=float)
    part = np.partition(proba, -2, axis=1)
    return part[:, -1] - part[:, -2]

def _label_to_index_map(class_labels):
    return {c: i for i, c in enumerate(class_labels)}

def _score_from_pred_or_proba(labels, proba, class_labels):
    n_classes = len(class_labels)
    scores = np.zeros((len(labels), n_classes), dtype=float)
    idx_map = _label_to_index_map(class_labels)
    if proba is not None and proba.ndim == 2 and proba.shape[1] == n_classes:
        for i in range(len(labels)):
            order = np.argsort(-proba[i], kind="mergesort")
            for rank, cls_idx in enumerate(order):
                scores[i, cls_idx] += float(n_classes - rank)
    else:
        for i, lab in enumerate(labels):
            scores[i, idx_map.get(lab, 0)] += float(n_classes)
    return scores

