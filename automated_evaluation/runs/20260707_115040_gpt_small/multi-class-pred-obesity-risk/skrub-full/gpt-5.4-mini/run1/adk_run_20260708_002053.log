    )[0]
    lgbm_scores = _score_from_pred_or_proba(
        np.array([valid_pred_lgbm[i]]),
        valid_proba_lgbm[i:i+1] if valid_proba_lgbm is not None else None,
        class_labels,
    )[0]

    combined = 0.55 * cat_scores + 0.45 * lgbm_scores

    cat_idx = class_labels.index(valid_pred_cat[i]) if valid_pred_cat[i] in class_labels else 0
    lgbm_idx = class_labels.index(valid_pred_lgbm[i]) if valid_pred_lgbm[i] in class_labels else 0

    combined[cat_idx] += 0.15 * float(cat_margin_all[i])
    combined[lgbm_idx] += 0.10 * float(lgbm_margin_all[i])

    final_pred.append(class_labels[int(np.argmax(combined))])

final_validation_score = accuracy_score(valid_part[target_col], final_pred)
print(f"Final Validation Performance: {final_validation_score}")
