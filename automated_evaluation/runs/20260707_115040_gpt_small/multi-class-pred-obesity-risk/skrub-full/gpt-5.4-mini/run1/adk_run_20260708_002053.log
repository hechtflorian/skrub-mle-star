import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import log_loss
from catboost import CatBoostClassifier

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path) if "train_df" not in globals() else train_df
test_df = pd.read_csv(test_path) if "test_df" not in globals() else test_df
random_state = 42 if "random_state" not in globals() else random_state
target_col = "NObeyesdad"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def add_light_numeric_features(df):
    out = df.copy()
    if "id" in out.columns:
        out = out.drop(columns=["id"])

    num_cols = out.select_dtypes(include=[np.number]).columns.tolist()
    if len(num_cols) >= 2:
        out["numeric_sum"] = out[num_cols].sum(axis=1)
        out["numeric_mean"] = out[num_cols].mean(axis=1)

    return out

data_train = skrub.var("data", train_part).skb.apply_func(add_light_numeric_features)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

cat_model = CatBoostClassifier(
    loss_function="MultiClass",
    iterations=500,
    learning_rate=0.08,
    depth=6,
    subsample=0.85,
    random_seed=random_state,
    verbose=0,
)

vectorizer_cat = skrub.TableVectorizer()

pred_cat = X_train.skb.apply(vectorizer_cat).skb.apply(cat_model, y=y_train)
learner_cat = pred_cat.skb.make_learner(fitted=True)

valid_pred_cat = learner_cat.predict({"data": valid_part})
valid_pred_cat = np.asarray(valid_pred_cat)

valid_true = valid_part[target_col].to_numpy()
if valid_pred_cat.ndim > 1:
    final_validation_score = log_loss(valid_true, valid_pred_cat)
else:
    final_validation_score = log_loss(valid_true, valid_pred_cat, labels=np.unique(valid_true))

print(f"Final Validation Performance: {final_validation_score}")
```
