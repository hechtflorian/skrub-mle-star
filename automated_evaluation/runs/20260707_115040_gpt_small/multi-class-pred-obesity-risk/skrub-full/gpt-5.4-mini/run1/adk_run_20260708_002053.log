    if valid_pred_lgbm.ndim > 1:
        valid_pred_lgbm = valid_pred_lgbm.argmax(axis=1)
    if valid_pred_cat.ndim > 1:
        valid_pred_cat = valid_pred_cat.argmax(axis=1)

    valid_pred = [p1 if p1 == p2 else p1 for p1, p2 in zip(valid_pred_lgbm, valid_pred_cat)]
    return pd.Series(valid_pred, index=valid_part.index)


def ratio_feature_graph(data_train):
