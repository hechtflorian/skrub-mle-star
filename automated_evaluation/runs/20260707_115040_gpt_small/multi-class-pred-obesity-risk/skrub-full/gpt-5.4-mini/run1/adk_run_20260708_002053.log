import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import log_loss

# Keep the same split protocol and validate on train_part only
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# Lightweight numeric refinement: drop noisy unique id and add only a tiny
# derived numeric block if the relevant columns exist.
def add_light_numeric_features(df):
    out = df.copy()

    # Drop high-cardinality noise column if present
    if "id" in out.columns:
        out = out.drop(columns=["id"])

    # Very small, justified derived features: use only when the paired numerics exist
    numeric_cols = out.select_dtypes(include=[np.number]).columns.tolist()
    if len(numeric_cols) >= 2:
        # Add a single global summary feature that is cheap and often helpful
        out["numeric_sum"] = out[numeric_cols].sum(axis=1)
        out["numeric_mean"] = out[numeric_cols].mean(axis=1)

    return out

data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(add_light_numeric_features)

X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Keep CatBoost as the main model and remove the underperforming LightGBM leg
# Keep subsampling behavior in the model configuration.
cat_model = CatBoostClassifier(
    loss_function="MultiClass",
    iterations=500,
    learning_rate=0.08,
    depth=6,
    random_seed=random_state,
    subsample=0.85,
    verbose=0,
)

vectorizer_cat = skrub.TableVectorizer()

pred_cat = X_train.skb.apply(vectorizer_cat).skb.apply(cat_model, y=y_train)
learner_cat = pred_cat.skb.make_learner(fitted=True)

# Apply the same lightweight preprocessing at inference time through the bound graph
valid_pred_cat = learner_cat.predict({"data": valid_part})
valid_pred_cat = np.asarray(valid_pred_cat)

if valid_pred_cat.ndim > 1:
    valid_pred_cat = valid_pred_cat.argmax(axis=1)

final_validation_score = log_loss(valid_part[target_col], valid_pred_cat)
print(f"Final Validation Performance: {final_validation_score}")
```
