import numpy as np
import skrub
from sklearn.model_selection import train_test_split
from sklearn.impute import SimpleImputer

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def add_structural_obesity_features(df):
    out = df.copy()
    cols = set(out.columns)

    if "id" in out.columns:
        out = out.drop(columns=["id"])

    if {"Weight", "Height"}.issubset(cols):
        height = out["Height"].replace(0, np.nan)
        bmi = (out["Weight"] / (height ** 2)).replace([np.inf, -np.inf], np.nan)
        out["bmi"] = bmi.fillna(0.0)

    if {"Weight", "Height"}.issubset(cols):
        out["weight_height_interaction"] = (out["Weight"] * out["Height"]).replace(
            [np.inf, -np.inf], np.nan
        ).fillna(0.0)

    guarded_ratio_pairs = [
        ("Weight", "Height", "weight_per_height"),
        ("FCVC", "NCP", "fcvc_per_ncp"),
        ("FAF", "TUE", "faf_per_tue"),
    ]
    for numer_col, denom_col, out_name in guarded_ratio_pairs:
        if {numer_col, denom_col}.issubset(cols):
            denom = out[denom_col].replace(0, np.nan)
            out[out_name] = (
                (out[numer_col] / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)
            )

    if {"Age", "Weight"}.issubset(cols):
        out["age_weight_interaction"] = (out["Age"] * out["Weight"]).replace(
            [np.inf, -np.inf], np.nan
        ).fillna(0.0)

    return out

data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(add_structural_obesity_features)

X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_fe[target_col].skb.mark_as_y()

vectorizer_cat = skrub.TableVectorizer(
    high_cardinality=skrub.StringEncoder(),
)

cat_model = CatBoostClassifier(
    loss_function="MultiClass",
    iterations=600,
    learning_rate=0.08,
    depth=6,
    random_seed=random_state,
    verbose=0,
)

pred_cat = X_train.skb.apply(vectorizer_cat).skb.apply(cat_model, y=y_train)
learner_cat = pred_cat.skb.make_learner(fitted=True)

valid_pred_cat = learner_cat.predict({"data": valid_part})
valid_pred_cat = np.asarray(valid_pred_cat)

if valid_pred_cat.ndim > 1:
    valid_pred_cat = valid_pred_cat.argmax(axis=1)

final_validation_score = accuracy_score(valid_part[target_col], valid_pred_cat)
print(f"Final Validation Performance: {final_validation_score}")
