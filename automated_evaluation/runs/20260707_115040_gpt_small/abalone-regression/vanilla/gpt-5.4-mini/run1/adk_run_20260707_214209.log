# Competition-aware target: train on raw Rings, use native CatBoost categoricals, and learn OOF blend weights.
from sklearn.model_selection import KFold
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_log_error

SEED = globals().get("SEED", 42)
N_SPLITS = 3
TARGET = "Rings"

# -------------------------
# Preprocessing
# -------------------------
cat_cols = [c for c in train.columns if c not in [TARGET, "id"] and train[c].dtype == "object"]

# LightGBM on one-hot encoded features
X_lgb = pd.get_dummies(train.drop(columns=[TARGET]), columns=cat_cols, dummy_na=True)
X_test_lgb = pd.get_dummies(test, columns=cat_cols, dummy_na=True)
X_lgb, X_test_lgb = X_lgb.align(X_test_lgb, join="left", axis=1, fill_value=0)

# CatBoost on raw categorical features
X_cat = train.drop(columns=[TARGET]).copy()
X_test_cat = test.copy()
for c in cat_cols:
    X_cat[c] = X_cat[c].astype("string").fillna("missing")
    X_test_cat[c] = X_test_cat[c].astype("string").fillna("missing")

y = train[TARGET].astype(float).reset_index(drop=True)

# -------------------------
# CV setup
# -------------------------
kf = KFold(n_splits=N_SPLITS, shuffle=True, random_state=SEED)

oof_lgb = np.zeros(len(X_lgb), dtype=float)
oof_cat = np.zeros(len(X_cat), dtype=float)
test_lgb = np.zeros(len(X_test_lgb), dtype=float)
test_cat = np.zeros(len(X_test_cat), dtype=float)

for fold, (tr_idx, va_idx) in enumerate(kf.split(X_lgb), 1):
    X_tr_lgb, X_va_lgb = X_lgb.iloc[tr_idx], X_lgb.iloc[va_idx]
    X_tr_cat, X_va_cat = X_cat.iloc[tr_idx], X_cat.iloc[va_idx]
    y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]

    # LightGBM: raw target with count-like objective
    lgb_model = lgb.LGBMRegressor(
        objective="poisson",
        n_estimators=10000,
        learning_rate=0.02,
        num_leaves=31,
        subsample=0.8,  # keep subsampling
        colsample_bytree=0.8,
        random_state=SEED + fold,
        n_jobs=-1
    )
    lgb_model.fit(
        X_tr_lgb,
        y_tr,
        eval_set=[(X_va_lgb, y_va)],
        eval_metric="rmse",
        callbacks=[lgb.early_stopping(200, verbose=False)]
    )
    pred_lgb_va = np.clip(lgb_model.predict(X_va_lgb, num_iteration=lgb_model.best_iteration_), 0, None)
    oof_lgb[va_idx] = pred_lgb_va
    test_lgb += np.clip(lgb_model.predict(X_test_lgb, num_iteration=lgb_model.best_iteration_), 0, None) / N_SPLITS

    # CatBoost: native categorical support
    cat_model = CatBoostRegressor(
        loss_function="RMSE",
        iterations=10000,
        learning_rate=0.03,
        depth=8,
        subsample=0.8,  # keep subsampling
        random_seed=SEED + fold,
        verbose=False,
        od_type="Iter",
        od_wait=200
    )
    cat_model.fit(
        X_tr_cat,
        y_tr,
        cat_features=cat_cols,
        eval_set=(X_va_cat, y_va),
        use_best_model=True,
        verbose=False
    )
    pred_cat_va = np.clip(cat_model.predict(X_va_cat), 0, None)
    oof_cat[va_idx] = pred_cat_va
    test_cat += np.clip(cat_model.predict(X_test_cat), 0, None) / N_SPLITS

# -------------------------
# Learn blend from OOF predictions
# -------------------------
meta = LinearRegression(positive=True)
meta.fit(np.column_stack([oof_lgb, oof_cat]), y.values)
blend = np.clip(meta.coef_.astype(float), 0, None)
blend = blend / blend.sum() if blend.sum() > 0 else np.array([0.5, 0.5], dtype=float)

print(f"OOF blend weights -> LGB: {blend[0]:.4f}, Cat: {blend[1]:.4f}")

# -------------------------
# OOF validation
# -------------------------
oof_pred = blend[0] * oof_lgb + blend[1] * oof_cat
oof_pred = np.clip(np.rint(oof_pred), 0, None)
oof_score = np.sqrt(mean_squared_log_error(y.values, oof_pred))
print(f"Final OOF Validation Performance: {oof_score}")

# -------------------------
# Final test predictions
# -------------------------
test_pred = blend[0] * test_lgb + blend[1] * test_cat
test_pred = np.clip(np.rint(test_pred), 0, None).astype(int)

submission = pd.DataFrame({"id": test["id"], "Rings": test_pred})
submission.to_csv("submission.csv", index=False)
