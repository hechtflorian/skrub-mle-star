# Competition-aware target: train on raw Rings, ensemble via OOF-learned weights, and round only at the end.
from sklearn.model_selection import KFold
from sklearn.metrics import mean_squared_log_error
from sklearn.linear_model import LinearRegression

SEED = globals().get("SEED", 42)
N_SPLITS = 3

# -------------------------
# Preprocessing
# -------------------------
target_col = "Rings"
cat_cols = [c for c in train.columns if train[c].dtype == "object" and c != target_col and c != "id"]
feature_cols = [c for c in train.columns if c not in [target_col]]

# LGBM uses one-hot encoded data
X_lgb = pd.get_dummies(train.drop(columns=[target_col]), columns=cat_cols, dummy_na=True)
X_test_lgb = pd.get_dummies(test, columns=cat_cols, dummy_na=True)
X_lgb, X_test_lgb = X_lgb.align(X_test_lgb, join="left", axis=1, fill_value=0)

# CatBoost uses raw categorical columns natively
X_cat = train.drop(columns=[target_col]).copy()
X_test_cat = test.copy()

for c in cat_cols:
    X_cat[c] = X_cat[c].astype("string").fillna("missing")
    X_test_cat[c] = X_test_cat[c].astype("string").fillna("missing")

y = train[target_col].astype(float)

# -------------------------
# CV setup
# -------------------------
kf = KFold(n_splits=N_SPLITS, shuffle=True, random_state=SEED)

oof_lgb = np.zeros(len(X_lgb), dtype=float)
oof_cat = np.zeros(len(X_cat), dtype=float)
test_lgb = np.zeros(len(X_test_lgb), dtype=float)
test_cat = np.zeros(len(X_test_cat), dtype=float)

# -------------------------
# Fold training
# -------------------------
for fold, (tr_idx, va_idx) in enumerate(kf.split(X_lgb), 1):
    X_tr_lgb, X_va_lgb = X_lgb.iloc[tr_idx], X_lgb.iloc[va_idx]
    X_tr_cat, X_va_cat = X_cat.iloc[tr_idx], X_cat.iloc[va_idx]
    y_tr, y_va = y.iloc[tr_idx], y.iloc[va_idx]

    # LightGBM: raw target regression with count-like objective
    lgb_model = lgb.LGBMRegressor(
        objective="poisson",
        n_estimators=10000,
        learning_rate=0.02,
        num_leaves=31,
        subsample=0.8,          # keep subsampling
        colsample_bytree=0.8,
        random_state=SEED + fold,
        n_jobs=-1
    )

    lgb_model.fit(
        X_tr_lgb,
        y_tr,
        eval_set=[(X_va_lgb, y_va)],
        eval_metric="rmse",
        callbacks=[lgb.early_stopping(200, verbose=False)]
    )

    pred_lgb_va = lgb_model.predict(X_va_lgb, num_iteration=lgb_model.best_iteration_)
    pred_lgb_va = np.clip(pred_lgb_va, 0, None)
    oof_lgb[va_idx] = pred_lgb_va
    test_lgb += np.clip(lgb_model.predict(X_test_lgb, num_iteration=lgb_model.best_iteration_), 0, None) / N_SPLITS

    # CatBoost: native categorical handling on raw columns
    cat_model = CatBoostRegressor(
        loss_function="RMSE",
        iterations=10000,
        learning_rate=0.03,
        depth=8,
        subsample=0.8,          # keep subsampling
        random_seed=SEED + fold,
        verbose=False,
        od_type="Iter",
        od_wait=200
    )

    cat_model.fit(
        X_tr_cat,
        y_tr,
        cat_features=cat_cols,
        eval_set=(X_va_cat, y_va),
        use_best_model=True,
        verbose=False
    )

    pred_cat_va = np.clip(cat_model.predict(X_va_cat), 0, None)
    oof_cat[va_idx] = pred_cat_va
    test_cat += np.clip(cat_model.predict(X_test_cat), 0, None) / N_SPLITS

# -------------------------
# OOF-based blending
# -------------------------
# Learn blend weights from OOF predictions, then clip to non-negative and normalize
blend_meta = LinearRegression(positive=True)
blend_meta.fit(
    np.column_stack([oof_lgb, oof_cat]),
    y.values
)
blend_weights = blend_meta.coef_.astype(float)
blend_weights = np.clip(blend_weights, 0, None)
if blend_weights.sum() == 0:
    blend_weights = np.array([0.5, 0.5], dtype=float)
else:
    blend_weights = blend_weights / blend_weights.sum()

print(f"OOF blend weights: LGB={blend_weights[0]:.4f}, Cat={blend_weights[1]:.4f}")

# -------------------------
# Validation score on OOF
# -------------------------
oof_pred = blend_weights[0] * oof_lgb + blend_weights[1] * oof_cat
oof_pred = np.clip(oof_pred, 0, None)

# fold-wise rounding / integer-like calibration at the very end only
oof_pred_int = np.rint(oof_pred).clip(0, None)
oof_true = y.values.astype(float)

