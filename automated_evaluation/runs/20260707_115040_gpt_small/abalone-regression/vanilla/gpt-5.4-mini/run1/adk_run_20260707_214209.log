        eval_metric="rmse",
        callbacks=[lgb.early_stopping(200, verbose=False)]
    )
    lgb_va_pred = np.clip(lgb_model.predict(X_va_lgb, num_iteration=lgb_model.best_iteration_), 0, None)
    lgb_test_pred = np.clip(lgb_model.predict(X_test_lgb, num_iteration=lgb_model.best_iteration_), 0, None)
