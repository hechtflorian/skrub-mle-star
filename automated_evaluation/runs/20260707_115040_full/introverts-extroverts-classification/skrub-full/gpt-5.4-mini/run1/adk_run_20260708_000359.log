import os
import warnings
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import OneHotEncoder
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.base import BaseEstimator, TransformerMixin

warnings.filterwarnings("ignore")


random_state = 42
target_col = "Personality"

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")
train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)


class DataFramePreprocessor(BaseEstimator, TransformerMixin):
    def __init__(self):
        self.numeric_cols = None
        self.categorical_cols = None
        self.pipeline = None

    def fit(self, X, y=None):
        X = pd.DataFrame(X).copy()
        self.numeric_cols = X.select_dtypes(include=[np.number]).columns.tolist()
        self.categorical_cols = [c for c in X.columns if c not in self.numeric_cols]

        numeric_pipe = Pipeline(
            steps=[
                ("imputer", SimpleImputer(strategy="median")),
            ]
        )
        categorical_pipe = Pipeline(
            steps=[
                ("imputer", SimpleImputer(strategy="most_frequent")),
                ("onehot", OneHotEncoder(handle_unknown="ignore")),
            ]
        )

        self.pipeline = ColumnTransformer(
            transformers=[
                ("num", numeric_pipe, self.numeric_cols),
                ("cat", categorical_pipe, self.categorical_cols),
            ]
        )
        self.pipeline.fit(X, y)
        return self

    def transform(self, X):
        X = pd.DataFrame(X).copy()
        return self.pipeline.transform(X)


def prepare_xy(df):
    data_train = skrub.var("data", df)
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()
    return X_train, y_train


train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

X_train, y_train = prepare_xy(train_part)

cat_model = LogisticRegression(max_iter=2000, random_state=random_state)
lgb_model = RandomForestClassifier(
    n_estimators=300,
    random_state=random_state,
    n_jobs=-1,
)

pred_cat = X_train.skb.apply(DataFramePreprocessor()).skb.apply(cat_model, y=y_train)
pred_lgb = X_train.skb.apply(DataFramePreprocessor()).skb.apply(lgb_model, y=y_train)

learner_cat = pred_cat.skb.make_learner(fitted=True)
learner_lgb = pred_lgb.skb.make_learner(fitted=True)

valid_pred_cat = learner_cat.predict({"data": valid_part})
valid_pred_lgb = learner_lgb.predict({"data": valid_part})

label_to_num = {"Introvert": 0.0, "Extrovert": 1.0}
num_to_label = {0.0: "Introvert", 1.0: "Extrovert"}

valid_pred_cat_num = np.array([label_to_num.get(v, np.nan) for v in valid_pred_cat], dtype=float)
valid_pred_lgb_num = np.array([label_to_num.get(v, np.nan) for v in valid_pred_lgb], dtype=float)

valid_blend = (valid_pred_cat_num + valid_pred_lgb_num) / 2.0
valid_pred = np.where(valid_blend >= 0.5, "Extrovert", "Introvert")

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")

# Fit on full training data for final test prediction
full_X = skrub.var("data", train_df).drop(columns=target_col, errors="ignore").skb.mark_as_X()
full_y = skrub.var("data", train_df)[target_col].skb.mark_as_y()

full_pred_cat = full_X.skb.apply(DataFramePreprocessor()).skb.apply(cat_model, y=full_y)
full_pred_lgb = full_X.skb.apply(DataFramePreprocessor()).skb.apply(lgb_model, y=full_y)

full_learner_cat = full_pred_cat.skb.make_learner(fitted=True)
full_learner_lgb = full_pred_lgb.skb.make_learner(fitted=True)

test_pred_cat = full_learner_cat.predict({"data": test_df})
test_pred_lgb = full_learner_lgb.predict({"data": test_df})

test_pred_cat_num = np.array([label_to_num.get(v, np.nan) for v in test_pred_cat], dtype=float)
test_pred_lgb_num = np.array([label_to_num.get(v, np.nan) for v in test_pred_lgb], dtype=float)

test_blend = (test_pred_cat_num + test_pred_lgb_num) / 2.0
test_pred = np.where(test_blend >= 0.5, "Extrovert", "Introvert")

submission = pd.DataFrame({"id": test_df["id"], "Personality": test_pred})
submission.to_csv("submission.csv", index=False)
