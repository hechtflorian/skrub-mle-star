import numpy as np
import pandas as pd
import skrub
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

# Holdout split
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=test_size, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)

# Post-cleaning preprocessing with selector-routed preprocessing
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

from skrub import Cleaner, DropCols, ApplyToCols
import skrub.selectors as s

# Explicitly drop id, then clean constants
X_clean = X_train.skb.apply(DropCols(cols=s.cols("id")))
X_clean = X_clean.skb.apply(Cleaner(drop_if_constant=True))

# Optional fixed structural redundancy ablation:
# drop one structurally similar numeric column only if it exists
redundant_numeric_pair = [("mean", "std"), ("age", "age_dup")]
for left_col, right_col in redundant_numeric_pair:
    if left_col in train_part.columns and right_col in train_part.columns:
        X_clean = X_clean.skb.apply(DropCols(cols=s.cols(right_col)))
        break

# Split numeric and object columns after cleaning, using post-FE selectors
# Numeric branch: add lightweight null indicators, then vectorize
def add_numeric_null_flags(df):
    out = df.copy()
    num_cols = out.select_dtypes(include=[np.number]).columns
    for col in num_cols:
        if out[col].isna().any():
            out[f"{col}__is_null"] = out[col].isna().astype(np.int8)
    return out

X_num = X_clean.skb.select(s.numeric()).skb.apply_func(add_numeric_null_flags)
X_obj = X_clean.skb.select(s.string() | s.categorical())

# Treat object/binary-like fields as categorical-like inputs, not generic text
# TableVectorizer handles the transformed frame on each routed path
num_vectorizer = skrub.TableVectorizer()
obj_vectorizer = skrub.TableVectorizer(
    low_cardinality=skrub.ToCategorical(),
    high_cardinality=skrub.StringEncoder(),
)

X_num_vec = X_num.skb.apply(num_vectorizer)
X_obj_vec = X_obj.skb.apply(obj_vectorizer)

# Combine routed features back together
X_prepared = X_num_vec.skb.concat([X_obj_vec], axis=1)

model = CatBoostClassifier(
    loss_function="Logloss",
    verbose=0,
    random_seed=random_state,
)

pred = X_prepared.skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
