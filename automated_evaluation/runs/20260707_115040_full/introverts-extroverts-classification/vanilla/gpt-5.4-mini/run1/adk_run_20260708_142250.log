test_pred = (test_ensemble_proba >= best_threshold).astype(int)

submission = pd.DataFrame({
    "id": test["id"],
    "Personality": pd.Series(test_pred).map(inv_target_map)
})
submission.to_csv("submission.csv", index=False)
