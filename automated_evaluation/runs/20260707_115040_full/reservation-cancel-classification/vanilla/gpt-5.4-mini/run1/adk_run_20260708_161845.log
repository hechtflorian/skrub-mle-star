import os
import numpy as np
import pandas as pd
import lightgbm as lgb
from catboost import CatBoostClassifier
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score

TRAIN_PATH = "./input/train.csv"
TEST_PATH = "./input/test.csv"
SUBMISSION_PATH = "submission.csv"

train_df = pd.read_csv(TRAIN_PATH)
test_df = pd.read_csv(TEST_PATH)

target_col = "booking_status"
id_col = "id"

X = train_df.drop(columns=[target_col]).copy()
y = train_df[target_col].astype(int).copy()
X_test = test_df.copy()

# Identify categorical columns
cat_cols = X.select_dtypes(include=["object"]).columns.tolist()
for col in X.columns:
    if col != id_col and X[col].nunique(dropna=False) <= 20 and col not in cat_cols:
        cat_cols.append(col)

# Remove id from features
X = X.drop(columns=[id_col]).copy()
X_test_ids = X_test[id_col].copy()
X_test = X_test.drop(columns=[id_col]).copy()

# Ensure consistent categorical handling
for c in cat_cols:
    if c in X.columns:
        X[c] = X[c].astype("object").fillna("missing")
        X_test[c] = X_test[c].astype("object").fillna("missing")

# Simple leakage-safe target encoding for LightGBM only
# Use low/medium-cardinality categorical columns
te_cols = [c for c in cat_cols if c in X.columns and X[c].nunique(dropna=False) <= 100]
global_mean = y.mean()
n_splits = 5
skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=42)

oof_lgb = np.zeros(len(X), dtype=float)
oof_cat = np.zeros(len(X), dtype=float)
test_lgb = np.zeros(len(X_test), dtype=float)
test_cat = np.zeros(len(X_test), dtype=float)

fold_auc_lgb = []
fold_auc_cat = []

# Light target encoding smoothing
def make_target_encoding(train_col, train_y, valid_col, test_col, prior, min_samples_leaf=20, smoothing=10):
    stats = pd.DataFrame({"col": train_col, "target": train_y})
    agg = stats.groupby("col")["target"].agg(["mean", "count"])
    smooth = (agg["count"] * agg["mean"] + smoothing * prior) / (agg["count"] + smoothing)
    valid_enc = valid_col.map(smooth).fillna(prior).astype(float)
    test_enc = test_col.map(smooth).fillna(prior).astype(float)
    return valid_enc, test_enc

for fold, (tr_idx, va_idx) in enumerate(skf.split(X, y), 1):
    X_tr = X.iloc[tr_idx].copy()
    X_va = X.iloc[va_idx].copy()
    y_tr = y.iloc[tr_idx].copy()
    y_va = y.iloc[va_idx].copy()

    # Prepare LightGBM inputs with target encoding for selected categorical columns
    X_tr_lgb = X_tr.copy()
    X_va_lgb = X_va.copy()
    X_test_lgb = X_test.copy()

    # Native categorical for remaining categorical support
    for c in cat_cols:
        if c in X_tr_lgb.columns:
            X_tr_lgb[c] = X_tr_lgb[c].astype("category")
            X_va_lgb[c] = X_va_lgb[c].astype("category")
            X_test_lgb[c] = X_test_lgb[c].astype("category")

    # Apply leakage-safe target encoding only to selected columns for LGB
    # Replace the raw column with encoded numeric feature
    for c in te_cols:
        tr_enc, te_enc = make_target_encoding(
            X_tr[c], y_tr, X_va[c], X_test[c], prior=global_mean
        )
        X_tr_lgb[f"{c}_te"] = tr_enc.values
        X_va_lgb[f"{c}_te"] = te_enc.values
        X_test_lgb[f"{c}_te"] = te_enc.index.map(lambda _: global_mean) if False else X_test[c].map(
            pd.DataFrame({"col": X_tr[c], "target": y_tr}).groupby("col")["target"].mean()
        ).fillna(global_mean).astype(float).values

        # Drop original categorical column from LGB to avoid duplicate signal
        if c in X_tr_lgb.columns:
            X_tr_lgb = X_tr_lgb.drop(columns=[c])
            X_va_lgb = X_va_lgb.drop(columns=[c])
            X_test_lgb = X_test_lgb.drop(columns=[c])

    lgb_cat_features = [c for c in cat_cols if c in X_tr_lgb.columns]

    # LightGBM model
    lgb_model = lgb.LGBMClassifier(
        n_estimators=3000,
        learning_rate=0.03,
        num_leaves=63,
        subsample=0.8,
        colsample_bytree=0.8,
        class_weight="balanced",
        random_state=42 + fold,
        n_jobs=-1
    )

    lgb_model.fit(
        X_tr_lgb,
        y_tr,
        eval_set=[(X_va_lgb, y_va)],
        eval_metric="auc",
        callbacks=[lgb.early_stopping(150, verbose=False), lgb.log_evaluation(200)]
    )

    lgb_va_pred = lgb_model.predict_proba(X_va_lgb)[:, 1]
    lgb_test_pred_fold = lgb_model.predict_proba(X_test_lgb)[:, 1]
    lgb_auc = roc_auc_score(y_va, lgb_va_pred)
    fold_auc_lgb.append(lgb_auc)
    oof_lgb[va_idx] = lgb_va_pred
    test_lgb += lgb_test_pred_fold / n_splits

    # CatBoost model with native categoricals
    cat_model = CatBoostClassifier(
        iterations=2000,
        learning_rate=0.03,
        depth=8,
        loss_function="Logloss",
        eval_metric="AUC",
        verbose=200,
        random_seed=42 + fold,
        auto_class_weights="Balanced",
        od_type="Iter",
        od_wait=150
    )

    cat_model.fit(
        X_tr,
        y_tr,
        cat_features=[c for c in cat_cols if c in X_tr.columns],
        eval_set=(X_va, y_va),
        use_best_model=True
    )

    cat_va_pred = cat_model.predict_proba(X_va)[:, 1]
    cat_test_pred_fold = cat_model.predict_proba(X_test)[:, 1]
    cat_auc = roc_auc_score(y_va, cat_va_pred)
    fold_auc_cat.append(cat_auc)
    oof_cat[va_idx] = cat_va_pred
    test_cat += cat_test_pred_fold / n_splits

# Fold-wise AUC weighting
lgb_weight = np.clip(np.mean(fold_auc_lgb), 0.50, 0.99)
cat_weight = np.clip(np.mean(fold_auc_cat), 0.50, 0.99)
model_w_sum = lgb_weight + cat_weight
lgb_weight /= model_w_sum
cat_weight /= model_w_sum

# Light calibration on OOF scores
# Blend per-model OOF predictions, then use fold-based weights
oof_blend = lgb_weight * oof_lgb + cat_weight * oof_cat
final_validation_score = roc_auc_score(y, oof_blend)
print(f"Fold AUC LGB: {np.mean(fold_auc_lgb):.6f} ± {np.std(fold_auc_lgb):.6f}")
print(f"Fold AUC CAT: {np.mean(fold_auc_cat):.6f} ± {np.std(fold_auc_cat):.6f}")
print(f"Final OOF Performance: {final_validation_score:.6f}")

# Weighted test blend
test_pred = lgb_weight * test_lgb + cat_weight * test_cat

submission = pd.DataFrame({
    id_col: X_test_ids,
    target_col: test_pred
})
submission.to_csv(SUBMISSION_PATH, index=False)
