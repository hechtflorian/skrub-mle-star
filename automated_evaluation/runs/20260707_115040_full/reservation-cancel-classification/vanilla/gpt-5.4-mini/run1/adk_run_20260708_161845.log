import os
import numpy as np
import pandas as pd
import lightgbm as lgb
from catboost import CatBoostClassifier
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from scipy.stats import rankdata

TRAIN_PATH = "./input/train.csv"
TEST_PATH = "./input/test.csv"
SUBMISSION_PATH = "submission.csv"

train_df = pd.read_csv(TRAIN_PATH)
test_df = pd.read_csv(TEST_PATH)

target_col = "booking_status"
id_col = "id"

X = train_df.drop(columns=[target_col]).copy()
y = train_df[target_col].astype(int).copy()
X_test = test_df.copy()

# Identify categorical columns
cat_cols = X.select_dtypes(include=["object"]).columns.tolist()
for col in X.columns:
    if col != id_col and X[col].nunique(dropna=False) <= 20 and col not in cat_cols:
        cat_cols.append(col)

# Remove id from features
X = X.drop(columns=[id_col])
X_test = X_test.drop(columns=[id_col])

# 5-fold OOF setup
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

oof_lgb = np.zeros(len(X))
oof_cat = np.zeros(len(X))
test_lgb = np.zeros(len(X_test))
test_cat = np.zeros(len(X_test))

lgb_oof_scores = []
cat_oof_scores = []

for fold, (tr_idx, va_idx) in enumerate(skf.split(X, y), 1):
    X_tr = X.iloc[tr_idx].copy()
    X_va = X.iloc[va_idx].copy()
    y_tr = y.iloc[tr_idx]
    y_va = y.iloc[va_idx]

    # Prepare copies for LightGBM and CatBoost
    X_tr_lgb = X_tr.copy()
    X_va_lgb = X_va.copy()
    X_te_lgb = X_test.copy()

    for c in cat_cols:
        if c in X_tr_lgb.columns:
            X_tr_lgb[c] = X_tr_lgb[c].astype("category")
            X_va_lgb[c] = X_va_lgb[c].astype("category")
            X_te_lgb[c] = X_te_lgb[c].astype("category")

    # LightGBM model
    lgb_model = lgb.LGBMClassifier(
        n_estimators=5000,
        learning_rate=0.02,
        num_leaves=63,
        subsample=0.8,
        colsample_bytree=0.8,
        class_weight="balanced",
        random_state=42,
        n_jobs=-1
    )

    lgb_model.fit(
        X_tr_lgb,
        y_tr,
        eval_set=[(X_va_lgb, y_va)],
        eval_metric="auc",
        callbacks=[lgb.early_stopping(200), lgb.log_evaluation(200)]
    )

    # CatBoost model
    cat_model = CatBoostClassifier(
        iterations=3000,
        learning_rate=0.03,
        depth=8,
        loss_function="Logloss",
        eval_metric="AUC",
        verbose=200,
        random_seed=42,
        auto_class_weights="Balanced"
    )

    cat_model.fit(
        X_tr,
        y_tr,
        cat_features=[c for c in cat_cols if c in X_tr.columns],
        eval_set=(X_va, y_va),
        use_best_model=True
    )

    # Validation predictions
    lgb_va_pred = lgb_model.predict_proba(X_va_lgb)[:, 1]
    cat_va_pred = cat_model.predict_proba(X_va)[:, 1]

    oof_lgb[va_idx] = lgb_va_pred
    oof_cat[va_idx] = cat_va_pred

    lgb_oof_scores.append(roc_auc_score(y_va, lgb_va_pred))
    cat_oof_scores.append(roc_auc_score(y_va, cat_va_pred))

    # Test predictions
    lgb_test_pred = lgb_model.predict_proba(X_te_lgb)[:, 1]
    cat_test_pred = cat_model.predict_proba(X_test)[:, 1]

    test_lgb += lgb_test_pred / skf.n_splits
    test_cat += cat_test_pred / skf.n_splits

# Individual OOF AUCs
auc_lgb = roc_auc_score(y, oof_lgb)
auc_cat = roc_auc_score(y, oof_cat)

# Rank transforms
r_lgb = rankdata(oof_lgb, method="average") / len(oof_lgb)
r_cat = rankdata(oof_cat, method="average") / len(oof_cat)

r_test_lgb = rankdata(test_lgb, method="average") / len(test_lgb)
r_test_cat = rankdata(test_cat, method="average") / len(test_cat)

# Determine weights from OOF AUCs
if abs(auc_lgb - auc_cat) < 1e-6:
    w_lgb = 0.5
else:
    denom = auc_lgb + auc_cat
    w_lgb = auc_lgb / denom if denom != 0 else 0.5
w_cat = 1.0 - w_lgb

# Rank-based blend
oof_blend_rank = w_lgb * r_lgb + w_cat * r_cat
test_blend_rank = w_lgb * r_test_lgb + w_cat * r_test_cat

# Raw-probability blend
oof_blend_raw = w_lgb * oof_lgb + w_cat * oof_cat
test_blend_raw = w_lgb * test_lgb + w_cat * test_cat

# Evaluate both blends on OOF
auc_blend_rank = roc_auc_score(y, oof_blend_rank)
auc_blend_raw = roc_auc_score(y, oof_blend_raw)

# If rank-blending is not better, revert to raw blend
if auc_blend_rank > max(auc_lgb, auc_cat, auc_blend_raw):
    final_oof = oof_blend_rank
    final_test = 0.5 * test_blend_raw + 0.5 * test_blend_rank
    final_validation_score = auc_blend_rank
else:
    final_oof = oof_blend_raw
    final_test = test_blend_raw
    final_validation_score = auc_blend_raw

print(f"Final Validation Performance: {final_validation_score}")

submission = pd.DataFrame({
    id_col: test_df[id_col],
    target_col: final_test
})
submission.to_csv(SUBMISSION_PATH, index=False)
