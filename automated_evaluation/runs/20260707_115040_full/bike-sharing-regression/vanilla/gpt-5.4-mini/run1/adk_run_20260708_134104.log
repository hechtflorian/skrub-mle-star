y_full = train["count"].astype(float)

y_full_lgb = np.log1p(y_full) if best_config["lgb_log1p"] else y_full
y_full_hgb = np.log1p(y_full) if best_config["hgb_log1p"] else y_full

lgbm_model = LGBMRegressor(
