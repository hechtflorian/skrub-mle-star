def add_datetime_features(df: pd.DataFrame) -> pd.DataFrame:
    dt = pd.to_datetime(df["datetime"])
    df = df.copy()
    df["hour"] = dt.dt.hour
    df["day"] = dt.dt.day
    df["month"] = dt.dt.month
    df["year"] = dt.dt.year
    df["weekday"] = dt.dt.weekday
    df["dayofyear"] = dt.dt.dayofyear
    df["weekofyear"] = dt.dt.isocalendar().week.astype(int)
    df["weekend"] = (df["weekday"] >= 5).astype(int)

    # Low-cost calendar regime features
    df["is_month_start"] = dt.dt.is_month_start.astype(int)
    df["is_month_end"] = dt.dt.is_month_end.astype(int)
    df["is_quarter_start"] = dt.dt.is_quarter_start.astype(int)
    df["is_quarter_end"] = dt.dt.is_quarter_end.astype(int)

    # Simple peak-hour regime, slightly different by season and workingday
    peak_weekday = df["hour"].isin([7, 8, 9, 17, 18, 19])
    peak_weekend = df["hour"].isin([10, 11, 12, 13, 14, 15, 16, 17])
    df["is_peak_hour"] = (
        ((df["workingday"] == 1) & peak_weekday) |
        ((df["workingday"] == 0) & peak_weekend)
    ).astype(int)

    return df

