    from xgboost import XGBRegressor
    HAS_XGBOOST = True
except ModuleNotFoundError:
    HAS_XGBOOST = False
    try:
        subprocess.check_call([sys.executable, "-m", "pip", "install", "xgboost", "-q"])
        from xgboost import XGBRegressor
        HAS_XGBOOST = True
    except Exception:
        HAS_XGBOOST = False

INPUT_DIR = "./input"
