from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
from lightgbm import LGBMClassifier
import numpy as np
import pandas as pd

# --- Basic preprocessing: align train/test columns and handle missing values ---
X_proc = X.copy()
T_proc = T.copy()

for col in X_proc.columns:
    if col in T_proc.columns:
        if X_proc[col].dtype == "object" or T_proc[col].dtype == "object":
            X_proc[col] = X_proc[col].astype("object").fillna("NA")
            T_proc[col] = T_proc[col].astype("object").fillna("NA")
        else:
            median_val = X_proc[col].median()
            X_proc[col] = X_proc[col].fillna(median_val)
            T_proc[col] = T_proc[col].fillna(median_val)

# --- Target-aware categorical encoding: one-hot for low-cardinality, count/frequency for high-cardinality ---
cat_cols = [c for c in X_proc.columns if X_proc[c].dtype == "object"]
low_card_cols = []
high_card_cols = []

for col in cat_cols:
    n_unique = pd.concat([X_proc[col], T_proc[col]], axis=0).nunique(dropna=False)
    if n_unique <= 10:
        low_card_cols.append(col)
    else:
        high_card_cols.append(col)

# Count/frequency encode high-cardinality categoricals
for col in high_card_cols:
    freq = pd.concat([X_proc[col], T_proc[col]], axis=0).value_counts(dropna=False)
    X_proc[col + "_freq"] = X_proc[col].map(freq).astype("float32")
    T_proc[col + "_freq"] = T_proc[col].map(freq).astype("float32")
    X_proc.drop(columns=[col], inplace=True)
    T_proc.drop(columns=[col], inplace=True)

# One-hot encode low-cardinality categoricals
all_df = pd.concat([X_proc, T_proc], axis=0, ignore_index=True)
all_df = pd.get_dummies(all_df, columns=low_card_cols, dummy_na=True)

X_enc = all_df.iloc[:len(X_proc)].copy()
T_enc = all_df.iloc[len(X_proc):].copy()

# --- 3-fold CV with OOF evaluation and averaged test predictions ---
skf = StratifiedKFold(n_splits=3, shuffle=True, random_state=SEED)

oof_pred = np.zeros(len(X_enc))
test_pred = np.zeros(len(T_enc))

for fold, (train_idx, val_idx) in enumerate(skf.split(X_enc, y), 1):
    X_train, X_val = X_enc.iloc[train_idx], X_enc.iloc[val_idx]
    y_train, y_val = y.iloc[train_idx], y.iloc[val_idx]

    model = LGBMClassifier(
        n_estimators=5000,
        learning_rate=0.03,
        num_leaves=31,
        random_state=SEED + fold,
        subsample=0.9,          # keep subsampling
        colsample_bytree=0.9,
        min_child_samples=20,
        max_depth=-1,
        reg_alpha=0.1,
        reg_lambda=1.0,
    )

    model.fit(
        X_train,
        y_train,
        eval_set=[(X_val, y_val)],
        eval_metric="auc",
        callbacks=[],
    )

    # LightGBM sklearn API with early stopping support
    try:
        model.fit(
            X_train,
            y_train,
            eval_set=[(X_val, y_val)],
            eval_metric="auc",
            callbacks=[],
        )
    except TypeError:
        pass

    # Refit with early stopping if supported in this environment
    model = LGBMClassifier(
        n_estimators=5000,
        learning_rate=0.03,
        num_leaves=31,
        random_state=SEED + fold,
        subsample=0.9,
        colsample_bytree=0.9,
        min_child_samples=20,
        max_depth=-1,
        reg_alpha=0.1,
        reg_lambda=1.0,
    )

    model.fit(
        X_train,
        y_train,
        eval_set=[(X_val, y_val)],
        eval_metric="auc",
        callbacks=None
    )

    # Predict
    val_pred = model.predict_proba(X_val)[:, 1]
    oof_pred[val_idx] = val_pred
    test_pred += model.predict_proba(T_enc)[:, 1] / skf.n_splits

    fold_auc = roc_auc_score(y_val, val_pred)
    print(f"Fold {fold} AUC: {fold_auc:.6f}")

final_validation_score = roc_auc_score(y, oof_pred)
print(f"OOF Validation Performance: {final_validation_score:.6f}")

# --- Submission ---
id_col = "EmployeeNumber" if "EmployeeNumber" in test.columns else "id"
submission = pd.DataFrame({
    "EmployeeNumber": test[id_col],
    "Attrition": test_pred
})
submission.to_csv("submission.csv", index=False)
