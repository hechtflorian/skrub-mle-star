import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error
from catboost import CatBoostRegressor

random_state = 42
target_col = "Rings"

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")

# Holdout split for honest validation
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y = data_train[target_col].skb.mark_as_y()

# Keep the DataOps structure intact; only fix the missing-column drop
# by guarding it with errors="ignore".
X_num = X.skb.apply(skrub.DropCols(cols=skrub.selectors.cols("Weight"), errors="ignore"))

pred = X_num.skb.apply(
    CatBoostRegressor(
        loss_function="RMSE",
        iterations=300,
        learning_rate=0.05,
        depth=6,
        random_seed=random_state,
        verbose=0,
    ),
    y=y,
)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = np.asarray(val_learner.predict({"data": valid_part}))
valid_pred = np.clip(valid_pred, 0, None)

final_validation_score = mean_squared_log_error(
    valid_part[target_col], valid_pred
) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")
