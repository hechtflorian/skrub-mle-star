import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error
from catboost import CatBoostRegressor

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_structural_features(df):
    out = df.copy()

    # Drop identifier if present; keep Length as requested.
    if "id" in out.columns:
        out = out.drop(columns=["id"])

    required = {"Length", "Diameter", "Height", "Weight"}
    if required.issubset(out.columns):
        length = out["Length"].replace(0, np.nan)
        diameter = out["Diameter"].replace(0, np.nan)
        height = out["Height"].replace(0, np.nan)
        weight = out["Weight"].replace(0, np.nan)

        out["Length_x_Diameter"] = (out["Length"] * out["Diameter"]).replace(
            [np.inf, -np.inf], np.nan
        )
        out["Diameter_per_Length"] = (
            (out["Diameter"] / length).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        )
        out["Weight_per_Length"] = (
            (out["Weight"] / length).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        )
        out["Weight_per_Diameter"] = (
            (out["Weight"] / diameter).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        )
        out["Weight_per_VolumeProxy"] = (
            (out["Weight"] / (length * diameter * height).replace(0, np.nan))
            .replace([np.inf, -np.inf], np.nan)
            .fillna(0.0)
        )

    return out


data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(add_structural_features)

X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_fe[target_col].skb.mark_as_y()

# Route post-FE data so numeric features are kept as numeric and Sex is explicitly categorical.
sex_col = skrub.selectors.cols("Sex")
numeric_cols = skrub.selectors.numeric()
other_categorical_cols = skrub.selectors.categorical() - sex_col

X_num = X_train.skb.select(numeric_cols)
X_sex = X_train.skb.select(sex_col)
X_cat_other = X_train.skb.select(other_categorical_cols)

# Light redundancy cleanup: remove one highly redundant raw weight column while keeping ratios.
# Here we drop Weight after deriving weight-per-size features.
X_num = X_num.skb.apply(skrub.DropCols(cols=skrub.selectors.cols("Weight")))

# Keep Sex categorical; pass other categoricals through a lightweight vectorizer.
cat_vectorizer = skrub.TableVectorizer(low_cardinality=skrub.ToCategorical(), high_cardinality="drop")

X_cat_other_vec = X_cat_other.skb.apply(cat_vectorizer)

X_model = X_num.skb.concat([X_sex, X_cat_other_vec], axis=1)

cat_model = CatBoostRegressor(
    loss_function="RMSE",
    depth=8,
    learning_rate=0.05,
    iterations=3000,
    random_seed=random_state,
    verbose=0,
    subsample=0.8,
    random_strength=1.0,
    l2_leaf_reg=3.0,
)

pred_cat = X_model.skb.apply(cat_model, y=y_train)
learner_cat = pred_cat.skb.make_learner(fitted=True)

valid_pred_cat = np.asarray(learner_cat.predict({"data": valid_part}), dtype=float).ravel()
final_validation_score = mean_squared_error(valid_part[target_col], valid_pred_cat) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")
