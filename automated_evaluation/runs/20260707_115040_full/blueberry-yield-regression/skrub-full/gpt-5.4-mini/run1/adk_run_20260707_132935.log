import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_absolute_error
from catboost import CatBoostRegressor

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_structural_numeric_features(df):
    out = df.copy()
    num_cols = out.select_dtypes(include=[np.number]).columns.tolist()

    # Keep the feature block small and bounded: only use a few strongest numeric columns
    # to reduce obvious redundancy and add simple interactions/ratios.
    if len(num_cols) >= 2:
        corr = out[num_cols].corr(numeric_only=True).abs()
        np.fill_diagonal(corr.values, 0.0)

        used = set()
        pair_budget = 3
        for _ in range(pair_budget):
            if corr.size == 0:
                break
            flat_idx = np.unravel_index(np.nanargmax(corr.values), corr.shape)
            i, j = flat_idx
            if not np.isfinite(corr.values[i, j]) or corr.values[i, j] <= 0:
                break

            col_a = corr.index[i]
            col_b = corr.columns[j]
            key = tuple(sorted((col_a, col_b)))
            if key in used:
                corr.values[i, j] = 0.0
                corr.values[j, i] = 0.0
                continue
            used.add(key)

            a = out[col_a].astype(float)
            b = out[col_b].astype(float)
            denom_b = b.replace(0, np.nan)
            denom_a = a.replace(0, np.nan)

            out[f"{col_a}_x_{col_b}"] = (a * b).replace([np.inf, -np.inf], np.nan).fillna(0.0)
            out[f"{col_a}_plus_{col_b}"] = (a + b).replace([np.inf, -np.inf], np.nan).fillna(0.0)
            out[f"{col_a}_div_{col_b}"] = (a / denom_b).replace([np.inf, -np.inf], np.nan).fillna(0.0)
            out[f"{col_b}_div_{col_a}"] = (b / denom_a).replace([np.inf, -np.inf], np.nan).fillna(0.0)

            corr.values[i, j] = 0.0
            corr.values[j, i] = 0.0

    return out


def build_cat_graph(data_train):
    data_fe = data_train.skb.apply_func(add_structural_numeric_features)
    X = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_fe[target_col].skb.mark_as_y()

    cat_model = CatBoostRegressor(
        depth=8,
        learning_rate=0.05,
        iterations=5000,
        loss_function="MAE",
        random_seed=random_state,
        verbose=0,
    )

    return X.skb.apply(skrub.TableVectorizer()).skb.apply(cat_model, y=y)


def score_variant(variant_name, build_graph):
    data_train = skrub.var("data", train_part)
    pred_graph = build_graph(data_train)
    learner = pred_graph.skb.make_learner(fitted=True)
    valid_pred = np.asarray(learner.predict({"data": valid_part}), dtype=float).ravel()
    score = mean_absolute_error(valid_part[target_col], valid_pred)
    print(f"Ablation[{variant_name}] MAE: {score}")
    return score


scores = {}
scores["baseline_fe_catboost"] = score_variant("baseline_fe_catboost", build_cat_graph)
scores["catboost_no_fe"] = score_variant(
    "catboost_no_fe",
    lambda data_train: data_train.drop(columns=target_col, errors="ignore")
    .skb.mark_as_X()
    .skb.apply(skrub.TableVectorizer())
    .skb.apply(
        CatBoostRegressor(
            depth=8,
            learning_rate=0.05,
            iterations=5000,
            loss_function="MAE",
            random_seed=random_state,
            verbose=0,
        ),
        y=data_train[target_col].skb.mark_as_y(),
    ),
)
scores["catboost_shallow_fe"] = score_variant(
    "catboost_shallow_fe",
    lambda data_train: data_train.skb.apply_func(
        lambda df: df.copy().assign(
            **(
                {
                    f"{col}_sq": df[col].astype(float) ** 2
                    for col in df.select_dtypes(include=[np.number]).columns[:2]
                }
                if len(df.select_dtypes(include=[np.number]).columns) >= 2
                else {}
            )
        )
    )
    .drop(columns=target_col, errors="ignore")
    .skb.mark_as_X()
    .skb.apply(skrub.TableVectorizer())
    .skb.apply(
        CatBoostRegressor(
            depth=8,
            learning_rate=0.05,
            iterations=5000,
            loss_function="MAE",
            random_seed=random_state,
            verbose=0,
        ),
        y=data_train[target_col].skb.mark_as_y(),
    ),
)

best_variant = min(scores, key=scores.get)
best_score = scores[best_variant]
print(f"Best ablation variant: {best_variant} | MAE: {best_score}")

data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(add_structural_numeric_features)
X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_fe[target_col].skb.mark_as_y()

cat_model = CatBoostRegressor(
    depth=8,
    learning_rate=0.05,
    iterations=5000,
    loss_function="MAE",
    random_seed=random_state,
    verbose=0,
)

cat_pred_graph = X_train.skb.apply(skrub.TableVectorizer()).skb.apply(cat_model, y=y_train)
cat_learner = cat_pred_graph.skb.make_learner(fitted=True)
cat_valid_pred = np.asarray(cat_learner.predict({"data": valid_part}), dtype=float).ravel()

valid_final_score = mean_absolute_error(valid_part[target_col], cat_valid_pred)
final_validation_score = valid_final_score
print(f"Final Validation Performance: {final_validation_score}")
