        depth=6,
        random_seed=random_state,
        verbose=0,
    ),
    y=y_train,
)
xgb_pred_graph = X_train.skb.apply(
    XGBRegressor(
        objective="reg:squarederror",
        n_estimators=500,
        learning_rate=0.05,
        max_depth=6,
        subsample=0.9,
        colsample_bytree=0.9,
        reg_lambda=1.0,
        random_state=random_state,
        verbosity=0,
        n_jobs=1,
    ),
    y=y_train,
)

cat_learner = cat_pred_graph.skb.make_learner(fitted=True)
xgb_learner = xgb_pred_graph.skb.make_learner(fitted=True)

cat_valid_pred = score_pred(cat_learner, valid_part)
xgb_valid_pred = score_pred(xgb_learner, valid_part)

valid_pred = 0.5 * cat_valid_pred + 0.5 * xgb_valid_pred
final_validation_score = mean_absolute_error(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
