import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostRegressor
from sklearn.model_selection import train_test_split

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_weather_redundancy_features(df):
    out = df.copy()

    # Small structural ablation centered on near-duplicate weather variables.
    # We keep this bounded and guarded so it remains robust even if some columns
    # are absent in a given version of the dataset.
    pair_specs = [
        ("temp_c", "temperature_c", "temp_c_over_temperature_c"),
        ("temp_c", "dew_point_c", "temp_c_minus_dew_point_c"),
        ("humidity", "relative_humidity", "humidity_over_relative_humidity"),
        ("wind_speed", "wind_gust", "wind_gust_over_wind_speed"),
        ("pressure", "sea_level_pressure", "pressure_minus_sea_level_pressure"),
    ]

    for col_a, col_b, feat_name in pair_specs:
        if col_a in out.columns and col_b in out.columns:
            a = pd.to_numeric(out[col_a], errors="coerce")
            b = pd.to_numeric(out[col_b], errors="coerce")

            if "over" in feat_name:
                denom = b.replace(0, np.nan)
                feat = (a / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)
                feat = feat.clip(-1e3, 1e3)
            else:
                feat = (a - b).replace([np.inf, -np.inf], np.nan).fillna(0.0)
                feat = feat.clip(-1e3, 1e3)

            out[feat_name] = feat

    # If both raw and derived weather columns are present, we can optionally
    # drop one column from a near-duplicate pair to test redundancy removal.
    redundant_drop_candidates = [
        ("temp_c", "temperature_c"),
        ("humidity", "relative_humidity"),
        ("pressure", "sea_level_pressure"),
    ]
    for keep_col, drop_col in redundant_drop_candidates:
        if keep_col in out.columns and drop_col in out.columns:
            out = out.drop(columns=[drop_col])
            break

    return out


def score_variant(variant_name, build_graph):
    data_train = skrub.var("data", train_part)
    pred_graph = build_graph(data_train)
    learner = pred_graph.skb.make_learner(fitted=True)
    valid_pred = np.asarray(learner.predict({"data": valid_part}), dtype=float).ravel()
    final_validation_score = np.mean(np.abs(valid_part[target_col].to_numpy() - valid_pred))
    print(f"Ablation[{variant_name}] MAE: {final_validation_score}")
    return final_validation_score


def baseline_graph(data_train):
    X = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_train[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()
    cat_model = CatBoostRegressor(
        depth=8,
        learning_rate=0.05,
        iterations=5000,
        loss_function="MAE",
        random_seed=random_state,
        verbose=0,
    )
    return X.skb.apply(vectorizer).skb.apply(cat_model, y=y)


def reduced_graph(data_train):
    data_fe = data_train.skb.apply_func(add_weather_redundancy_features)
    X = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_fe[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()
    cat_model = CatBoostRegressor(
        depth=8,
        learning_rate=0.05,
        iterations=5000,
        loss_function="MAE",
        random_seed=random_state,
        verbose=0,
    )
    return X.skb.apply(vectorizer).skb.apply(cat_model, y=y)


def augmented_graph(data_train):
    def add_weather_ratios(df):
        out = df.copy()

        ratio_specs = [
            ("temp_c", "temperature_c", "temp_c_over_temperature_c_bounded"),
            ("humidity", "temperature_c", "humidity_over_temperature_c_bounded"),
            ("wind_gust", "wind_speed", "wind_gust_over_wind_speed_bounded"),
        ]

        for numer_col, denom_col, feat_name in ratio_specs:
            if numer_col in out.columns and denom_col in out.columns:
                numer = pd.to_numeric(out[numer_col], errors="coerce")
                denom = pd.to_numeric(out[denom_col], errors="coerce").replace(0, np.nan)
                feat = (numer / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)
                out[feat_name] = feat.clip(-50.0, 50.0)

        return out

    data_fe = data_train.skb.apply_func(add_weather_ratios)
    X = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_fe[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()
    cat_model = CatBoostRegressor(
        depth=8,
        learning_rate=0.05,
        iterations=5000,
        loss_function="MAE",
        random_seed=random_state,
        verbose=0,
    )
    return X.skb.apply(vectorizer).skb.apply(cat_model, y=y)


scores = {}
scores["baseline"] = score_variant("baseline", baseline_graph)
scores["reduced"] = score_variant("reduced", reduced_graph)
scores["augmented"] = score_variant("augmented", augmented_graph)

best_variant = min(scores, key=scores.get)
best_score = scores[best_variant]
print(f"Best ablation variant: {best_variant} | MAE: {best_score}")
