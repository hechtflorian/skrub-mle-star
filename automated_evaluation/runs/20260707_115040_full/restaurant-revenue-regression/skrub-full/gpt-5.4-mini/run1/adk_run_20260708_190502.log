import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error
from catboost import CatBoostRegressor

random_state = 42
target_col = "revenue"

train_path = "./input/train.csv"
test_path = "./input/test.csv"

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

# Minimal feature engineering: keep existing logic intact, only make it runnable.
for df in (train_df, test_df):
    df["Open Date"] = pd.to_datetime(df["Open Date"], format="%m/%d/%Y", errors="coerce")
    df["Open Year"] = df["Open Date"].dt.year
    df["Open Month"] = df["Open Date"].dt.month
    df["Open Day"] = df["Open Date"].dt.day
    df["Open DayOfWeek"] = df["Open Date"].dt.dayofweek
    df["Open AgeDays"] = (pd.Timestamp("2015-01-01") - df["Open Date"]).dt.days
    df.drop(columns=["Open Date"], inplace=True)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

cat_cols = ["City", "City Group", "Type"]
for c in cat_cols:
    if c not in train_part.columns:
        cat_cols.remove(c)

# Keep the DataOps structure, but do not pass unsupported cat_features through skrub.apply().
# CatBoost handles categorical columns natively when the estimator sees a pandas DataFrame.
model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=500,
    depth=6,
    learning_rate=0.05,
    random_seed=random_state,
    verbose=0,
)

pred = X_train.skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_features = valid_part.drop(columns=[target_col], errors="ignore")
valid_pred = val_learner.predict({"data": valid_part})

final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

# Fit on full training data for submission
full_data = skrub.var("data", train_df)
X_full = full_data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = full_data[target_col].skb.mark_as_y()

full_pred = X_full.skb.apply(
    CatBoostRegressor(
        loss_function="RMSE",
        iterations=500,
        depth=6,
        learning_rate=0.05,
        random_seed=random_state,
        verbose=0,
    ),
    y=y_full,
)

full_learner = full_pred.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df.drop(columns=[target_col], errors="ignore")})

submission = pd.DataFrame({"Id": test_df["Id"], "Prediction": np.asarray(test_pred)})
submission.to_csv("submission.csv", index=False)
```
