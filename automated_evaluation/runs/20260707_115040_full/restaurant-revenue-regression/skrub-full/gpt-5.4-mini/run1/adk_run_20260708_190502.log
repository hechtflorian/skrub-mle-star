import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error
from catboost import CatBoostRegressor

random_state = 42
target_col = "revenue"

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

# Basic feature cleanup: keep the existing workflow but ensure categorical strings
# are handled correctly by CatBoost through one-hot encoding inside TableVectorizer.
train_df["Open Date"] = pd.to_datetime(train_df["Open Date"], errors="coerce")
test_df["Open Date"] = pd.to_datetime(test_df["Open Date"], errors="coerce")

for df in (train_df, test_df):
    df["Open Year"] = df["Open Date"].dt.year
    df["Open Month"] = df["Open Date"].dt.month
    df["Open Day"] = df["Open Date"].dt.day
    df["Open DayOfWeek"] = df["Open Date"].dt.dayofweek

train_df = train_df.drop(columns=["Open Date"])
test_df = test_df.drop(columns=["Open Date"])

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Smallest functional fix: explicitly encode string/categorical columns before CatBoost.
# This preserves the skrub DataOps chain and prevents raw strings like "Kocaeli"
# from reaching CatBoost as numeric features.
vectorizer = skrub.TableVectorizer(low_cardinality="passthrough", high_cardinality=skrub.StringEncoder())

model = CatBoostRegressor(
    loss_function="RMSE",
    random_seed=random_state,
    verbose=0,
)

pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_X = valid_part.drop(columns=target_col, errors="ignore")
valid_pred = val_learner.predict({"data": valid_X})

final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")
```
