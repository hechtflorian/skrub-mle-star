import glob
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error
from catboost import CatBoostRegressor

random_state = 42
target_col = "revenue"

train_path = glob.glob(os.path.join("./input", "train.csv"))[0]
train_df = pd.read_csv(train_path)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def rmse(y_true, y_pred):
    return mean_squared_error(y_true, y_pred) ** 0.5


def score_variant(variant_name, build_graph):
    data_train = skrub.var("data", train_part)
    pred = build_graph(data_train)
    learner = pred.skb.make_learner(fitted=True)
    valid_pred = learner.predict({"data": valid_part})
    score = rmse(valid_part[target_col], valid_pred)
    print(f"Ablation[{variant_name}] RMSE: {score}")
    return score


def baseline_graph(data_train):
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer(
        low_cardinality="drop",
        high_cardinality="drop",
    )
    model = CatBoostRegressor(
        loss_function="RMSE",
        random_seed=random_state,
        verbose=0,
    )
    return X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)


def keep_low_card_graph(data_train):
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer(
        low_cardinality="drop",
        high_cardinality=skrub.StringEncoder(),
    )
    model = CatBoostRegressor(
        loss_function="RMSE",
        random_seed=random_state,
        verbose=0,
    )
    return X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)


def keep_high_card_graph(data_train):
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer(
        low_cardinality=skrub.ToCategorical(),
        high_cardinality="drop",
    )
    model = CatBoostRegressor(
        loss_function="RMSE",
        random_seed=random_state,
        verbose=0,
    )
    return X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)


def datetime_engineered_graph(data_train):
    def add_date_parts(df):
        out = df.copy()
        if "Open Date" in out.columns:
            dt = pd.to_datetime(out["Open Date"], errors="coerce")
            out["open_year"] = dt.dt.year.fillna(0).astype(int)
            out["open_month"] = dt.dt.month.fillna(0).astype(int)
            out["open_day"] = dt.dt.day.fillna(0).astype(int)
            out["open_age_days"] = (
                pd.Timestamp("2014-01-01") - dt
            ).dt.days.fillna(0).astype(float)
        return out

    data_fe = data_train.skb.apply_func(add_date_parts)
    X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_fe[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer(
        low_cardinality="drop",
        high_cardinality="drop",
    )
    model = CatBoostRegressor(
        loss_function="RMSE",
        random_seed=random_state,
        verbose=0,
    )
    return X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)


scores = {}
scores["baseline"] = score_variant("baseline", baseline_graph)
scores["keep_low_card"] = score_variant("keep_low_card", keep_low_card_graph)
scores["keep_high_card"] = score_variant("keep_high_card", keep_high_card_graph)
scores["datetime_engineered"] = score_variant("datetime_engineered", datetime_engineered_graph)

best_variant = min(scores, key=scores.get)
best_score = scores[best_variant]
print(f"Best ablation variant: {best_variant} | RMSE: {best_score}")
