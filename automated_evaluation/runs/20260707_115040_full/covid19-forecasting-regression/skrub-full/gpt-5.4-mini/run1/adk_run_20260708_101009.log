import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error
from catboost import CatBoostRegressor

random_state = 42

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_cols = ["ConfirmedCases", "Fatalities"]

# Keep a true holdout split for validation
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# Shared preprocessing: make Date categorical/string-safe and keep CatBoost from treating strings as numeric.
def preprocess_df(df):
    out = df.copy()
    if "Date" in out.columns:
        out["Date"] = pd.to_datetime(out["Date"], errors="coerce")
        out["Year"] = out["Date"].dt.year
        out["Month"] = out["Date"].dt.month
        out["Day"] = out["Date"].dt.day
        out["DayOfWeek"] = out["Date"].dt.dayofweek
        out["DateOrdinal"] = out["Date"].map(lambda x: x.toordinal() if pd.notna(x) else np.nan)
        out = out.drop(columns=["Date"])
    return out

train_part = preprocess_df(train_part)
valid_part = preprocess_df(valid_part)
test_df = preprocess_df(test_df)

# DataOps graphs
data_train = skrub.var("data", train_part)

X_train = data_train.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
y_cases = data_train["ConfirmedCases"].skb.mark_as_y()
y_fatalities = data_train["Fatalities"].skb.mark_as_y()

# Smallest change: explicitly mark categorical features for CatBoost.
categorical_features = [
    col for col in X_train.columns
    if col in train_part.columns and train_part[col].dtype == "object"
]

case_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=500,
    learning_rate=0.05,
    depth=8,
    random_seed=random_state,
    verbose=0,
    cat_features=categorical_features,
)

fatal_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=500,
    learning_rate=0.05,
    depth=8,
    random_seed=random_state,
    verbose=0,
    cat_features=categorical_features,
)

case_pred_graph = X_train.skb.apply(case_model, y=y_cases)
fatal_pred_graph = X_train.skb.apply(fatal_model, y=y_fatalities)

case_learner = case_pred_graph.skb.make_learner(fitted=True)
fatal_learner = fatal_pred_graph.skb.make_learner(fitted=True)

valid_case_pred = np.maximum(0, np.asarray(case_learner.predict({"data": valid_part})).ravel())
valid_fatal_pred = np.maximum(0, np.asarray(fatal_learner.predict({"data": valid_part})).ravel())

final_validation_score = (
    mean_squared_log_error(valid_part["ConfirmedCases"], valid_case_pred) ** 0.5
    + mean_squared_log_error(valid_part["Fatalities"], valid_fatal_pred) ** 0.5
) / 2.0

print(f"Final Validation Performance: {final_validation_score}")

# Train on full training data and predict test
full_train_df = preprocess_df(train_df.copy())
full_data = skrub.var("data", full_train_df)
full_X = full_data.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
full_y_cases = full_data["ConfirmedCases"].skb.mark_as_y()
full_y_fatalities = full_data["Fatalities"].skb.mark_as_y()

full_categorical_features = [
    col for col in full_X.columns
    if col in full_train_df.columns and full_train_df[col].dtype == "object"
]

full_case_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=500,
    learning_rate=0.05,
    depth=8,
    random_seed=random_state,
    verbose=0,
    cat_features=full_categorical_features,
)

full_fatal_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=500,
    learning_rate=0.05,
    depth=8,
    random_seed=random_state,
    verbose=0,
    cat_features=full_categorical_features,
)

full_case_pred_graph = full_X.skb.apply(full_case_model, y=full_y_cases)
full_fatal_pred_graph = full_X.skb.apply(full_fatal_model, y=full_y_fatalities)

full_case_learner = full_case_pred_graph.skb.make_learner(fitted=True)
full_fatal_learner = full_fatal_pred_graph.skb.make_learner(fitted=True)

test_case_pred = np.maximum(0, np.asarray(full_case_learner.predict({"data": test_df})).ravel())
test_fatal_pred = np.maximum(0, np.asarray(full_fatal_learner.predict({"data": test_df})).ravel())

submission = pd.DataFrame(
    {
        "ForecastId": test_df["ForecastId"],
        "ConfirmedCases": test_case_pred,
        "Fatalities": test_fatal_pred,
    }
)

submission.to_csv("submission.csv", index=False)
```
