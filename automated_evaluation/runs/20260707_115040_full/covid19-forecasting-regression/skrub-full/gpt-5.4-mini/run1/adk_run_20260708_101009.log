y_confirmed = data_train["ConfirmedCases"].skb.mark_as_y()
y_fatalities = data_train["Fatalities"].skb.mark_as_y()

vectorizer_1 = skrub.TableVectorizer()
vectorizer_2 = skrub.TableVectorizer()

pred_confirmed = X_train.skb.apply_func(build_features).skb.apply(
    vectorizer_1
).skb.apply(RandomForestRegressor(n_estimators=200, random_state=random_state), y=y_confirmed)

pred_fatalities = X_train.skb.apply_func(build_features).skb.apply(
    vectorizer_2
).skb.apply(RandomForestRegressor(n_estimators=200, random_state=random_state), y=y_fatalities)

learner_1 = pred_confirmed.skb.make_learner(fitted=True)
learner_2 = pred_fatalities.skb.make_learner(fitted=True)

valid_features = build_features(valid_part)
valid_pred_confirmed = np.maximum(np.asarray(learner_1.predict({"data": valid_features})), 0)
valid_pred_fatalities = np.maximum(np.asarray(learner_2.predict({"data": valid_features})), 0)

final_validation_score = (
    mean_squared_error(
        np.log1p(valid_part["ConfirmedCases"]),
        np.log1p(valid_pred_confirmed),
    ) ** 0.5
    + mean_squared_error(
        np.log1p(valid_part["Fatalities"]),
        np.log1p(valid_pred_fatalities),
    ) ** 0.5
) / 2.0

print(f"Final Validation Performance: {final_validation_score}")

# Full-data refit for test prediction
data_full = skrub.var("data", train_df)

X_full = data_full.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
