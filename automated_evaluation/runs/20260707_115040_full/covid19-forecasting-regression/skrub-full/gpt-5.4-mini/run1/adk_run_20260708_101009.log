pred_fatalities = learner_2.predict({"data": valid_features})

pred_confirmed = np.maximum(np.asarray(pred_confirmed), 0)
pred_fatalities = np.maximum(np.asarray(pred_fatalities), 0)

score_confirmed = mean_squared_log_error(valid_part["ConfirmedCases"], pred_confirmed) ** 0.5
score_fatalities = mean_squared_log_error(valid_part["Fatalities"], pred_fatalities) ** 0.5
final_validation_score = float((score_confirmed + score_fatalities) / 2.0)

print(f"Final Validation Performance: {final_validation_score}")

