import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error
from lightgbm import LGBMRegressor

# Reproducibility
random_state = 42
np.random.seed(random_state)

# Load data
train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")
train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

# Basic preprocessing helpers
def add_date_features(df):
    df = df.copy()
    df["Date"] = pd.to_datetime(df["Date"], errors="coerce")
    df["Year"] = df["Date"].dt.year
    df["Month"] = df["Date"].dt.month
    df["Day"] = df["Date"].dt.day
    df["DayOfWeek"] = df["Date"].dt.dayofweek
    df["DayOfYear"] = df["Date"].dt.dayofyear
    df["WeekOfYear"] = df["Date"].dt.isocalendar().week.astype("int64")
    df["IsMonthStart"] = df["Date"].dt.is_month_start.astype("int8")
    df["IsMonthEnd"] = df["Date"].dt.is_month_end.astype("int8")
    df = df.drop(columns=["Date"], errors="ignore")
    return df

# Train/validation split for honest holdout
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# Build DataOps graph on train_part only
data_train = skrub.var("data", train_part)

# Keep Id out of the feature set so prediction doesn't require it
X_train = data_train.drop(columns=["ConfirmedCases", "Fatalities", "Id"], errors="ignore").skb.mark_as_X()
y_cases = data_train["ConfirmedCases"].skb.mark_as_y()
y_fatal = data_train["Fatalities"].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()

model_cases = LGBMRegressor(
    n_estimators=300,
    learning_rate=0.05,
    num_leaves=31,
    random_state=random_state,
    verbose=-1,
)
model_fatal = LGBMRegressor(
    n_estimators=300,
    learning_rate=0.05,
    num_leaves=31,
    random_state=random_state,
    verbose=-1,
)

pred_cases = X_train.skb.apply(add_date_features).skb.apply(vectorizer).skb.apply(model_cases, y=y_cases)
pred_fatal = X_train.skb.apply(add_date_features).skb.apply(vectorizer).skb.apply(model_fatal, y=y_fatal)

val_learner_cases = pred_cases.skb.make_learner(fitted=True)
val_learner_fatal = pred_fatal.skb.make_learner(fitted=True)

valid_features = valid_part.drop(columns=["ConfirmedCases", "Fatalities", "Id"], errors="ignore").copy()
valid_pred_cases = np.clip(np.asarray(val_learner_cases.predict({"data": valid_features})), 0, None)
valid_pred_fatal = np.clip(np.asarray(val_learner_fatal.predict({"data": valid_features})), 0, None)

score_cases = mean_squared_log_error(valid_part["ConfirmedCases"], valid_pred_cases) ** 0.5
score_fatal = mean_squared_log_error(valid_part["Fatalities"], valid_pred_fatal) ** 0.5
final_validation_score = 0.5 * (score_cases + score_fatal)
print(f"Final Validation Performance: {final_validation_score}")

# Fit on full training data for submission
full_data = skrub.var("data", train_df)
full_X = full_data.drop(columns=["ConfirmedCases", "Fatalities", "Id"], errors="ignore").skb.mark_as_X()
full_y_cases = full_data["ConfirmedCases"].skb.mark_as_y()
full_y_fatal = full_data["Fatalities"].skb.mark_as_y()

full_pred_cases = full_X.skb.apply(add_date_features).skb.apply(vectorizer).skb.apply(model_cases, y=full_y_cases)
full_pred_fatal = full_X.skb.apply(add_date_features).skb.apply(vectorizer).skb.apply(model_fatal, y=full_y_fatal)

full_learner_cases = full_pred_cases.skb.make_learner(fitted=True)
full_learner_fatal = full_pred_fatal.skb.make_learner(fitted=True)

# Test-time data has no Id column; do not request it from the vectorizer.
test_features = test_df.drop(columns=["ForecastId", "Id"], errors="ignore")

test_pred_cases = np.clip(np.asarray(full_learner_cases.predict({"data": test_features})), 0, None)
test_pred_fatal = np.clip(np.asarray(full_learner_fatal.predict({"data": test_features})), 0, None)

submission = pd.DataFrame({
    "ForecastId": test_df["ForecastId"],
    "ConfirmedCases": test_pred_cases,
    "Fatalities": test_pred_fatal,
})

submission.to_csv("submission.csv", index=False)
