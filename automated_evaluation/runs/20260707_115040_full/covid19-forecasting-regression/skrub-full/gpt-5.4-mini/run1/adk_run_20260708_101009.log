import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error
from sklearn.ensemble import HistGradientBoostingRegressor

random_state = 0
target_cols = ["ConfirmedCases", "Fatalities"]

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")

def make_features(df):
    out = df.copy()
    out["Date"] = pd.to_datetime(out["Date"], errors="coerce")
    out["Year"] = out["Date"].dt.year
    out["Month"] = out["Date"].dt.month
    out["Day"] = out["Date"].dt.day
    out["DayOfWeek"] = out["Date"].dt.dayofweek
    out["DayOfYear"] = out["Date"].dt.dayofyear
    out["WeekOfYear"] = out["Date"].dt.isocalendar().week.astype("float")
    out["Country_Region"] = out["Country_Region"].fillna("Unknown")
    out["Province_State"] = out["Province_State"].fillna("Unknown")
    out = out.drop(columns=["Date"], errors="ignore")
    return out

train_df = make_features(train_df)
test_df = make_features(test_df)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

preds_valid = {}
preds_test = {}

for target_col in target_cols:
    data_train = skrub.var("data", train_part)
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = np.log1p(data_train[target_col]).skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()
    model = HistGradientBoostingRegressor(random_state=random_state)

    pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
    val_learner = pred.skb.make_learner(fitted=True)
    valid_pred = np.expm1(val_learner.predict({"data": valid_part}))
    preds_valid[target_col] = np.maximum(valid_pred, 0)

    data_full = skrub.var("data", train_df)
    X_full = data_full.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_full = np.log1p(data_full[target_col]).skb.mark_as_y()

    full_pred = X_full.skb.apply(vectorizer).skb.apply(model, y=y_full)
    full_learner = full_pred.skb.make_learner(fitted=True)
    test_pred = np.expm1(full_learner.predict({"data": test_df}))
    preds_test[target_col] = np.maximum(test_pred, 0)

final_validation_score = mean_squared_error(
    np.log1p(valid_part[target_cols].values),
    np.log1p(np.column_stack([preds_valid[c] for c in target_cols])),
) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

submission = pd.DataFrame(
    {
        "ForecastId": pd.read_csv("./input/test.csv")["ForecastId"],
        "ConfirmedCases": preds_test["ConfirmedCases"],
        "Fatalities": preds_test["Fatalities"],
    }
)
os.makedirs("./final", exist_ok=True)
submission.to_csv("./final/submission.csv", index=False)
```
