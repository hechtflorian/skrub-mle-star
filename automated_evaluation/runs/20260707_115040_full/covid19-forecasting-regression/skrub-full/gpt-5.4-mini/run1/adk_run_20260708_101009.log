import os
import warnings
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error
from catboost import CatBoostRegressor

warnings.filterwarnings("ignore")

random_state = 42
target_cols = ["ConfirmedCases", "Fatalities"]

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")

# Basic date features
def add_date_features(df):
    df = df.copy()
    df["Date"] = pd.to_datetime(df["Date"], errors="coerce")
    df["Year"] = df["Date"].dt.year
    df["Month"] = df["Date"].dt.month
    df["Day"] = df["Date"].dt.day
    df["DayOfWeek"] = df["Date"].dt.dayofweek
    df["DayOfYear"] = df["Date"].dt.dayofyear
    return df

train_df = add_date_features(train_df)
test_df = add_date_features(test_df)

# Fill missing categorical values so CatBoost does not see raw NaNs in categorical columns
for col in ["Province_State", "Country_Region"]:
    train_df[col] = train_df[col].astype("string").fillna("missing")
    test_df[col] = test_df[col].astype("string").fillna("missing")

# Split holdout
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
