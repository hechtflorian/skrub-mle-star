import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error
from catboost import CatBoostRegressor

# Load training data
train_df = pd.read_csv("./input/train.csv")

# Basic cleaning
train_df["Province_State"] = train_df["Province_State"].fillna("")
train_df["Country_Region"] = train_df["Country_Region"].fillna("")

# Time features
train_df["Date"] = pd.to_datetime(train_df["Date"])
train_df["day"] = train_df["Date"].dt.day
train_df["month"] = train_df["Date"].dt.month
train_df["dow"] = train_df["Date"].dt.dayofweek
train_df["doy"] = train_df["Date"].dt.dayofyear
train_df["country_province"] = train_df["Country_Region"].astype(str) + "_" + train_df["Province_State"].astype(str)
train_df["days_since_start"] = (train_df["Date"] - train_df["Date"].min()).dt.days

# Holdout split
random_state = 42
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# DataOps binding
data_train = skrub.var("data", train_part)

feature_cols = [
    "Country_Region",
    "Province_State",
    "day",
    "month",
    "dow",
    "doy",
    "days_since_start",
    "country_province",
]

X_train = data_train[feature_cols].skb.mark_as_X()
y_cases = data_train["ConfirmedCases"].skb.mark_as_y()
y_fat = data_train["Fatalities"].skb.mark_as_y()

case_model = CatBoostRegressor(
    loss_function="RMSE",
    verbose=0,
    random_seed=42,
    depth=6,
    learning_rate=0.1,
    iterations=400,
)
fat_model = CatBoostRegressor(
    loss_function="RMSE",
    verbose=0,
    random_seed=42,
    depth=6,
    learning_rate=0.1,
    iterations=400,
)

case_pred_graph = X_train.skb.apply(case_model, y=y_cases)
fat_pred_graph = X_train.skb.apply(fat_model, y=y_fat)

case_learner = case_pred_graph.skb.make_learner(fitted=True)
fat_learner = fat_pred_graph.skb.make_learner(fitted=True)

valid_features = valid_part[feature_cols].copy()
valid_cases = np.maximum(0, case_learner.predict({"data": valid_features}))
valid_fat = np.maximum(0, fat_learner.predict({"data": valid_features}))

valid_cases_true = np.maximum(0, valid_part["ConfirmedCases"].to_numpy())
valid_fat_true = np.maximum(0, valid_part["Fatalities"].to_numpy())

# Metric: RMSLE over the two targets
cases_msle = mean_squared_log_error(valid_cases_true, valid_cases)
fat_msle = mean_squared_log_error(valid_fat_true, valid_fat)
final_validation_score = float(((cases_msle + fat_msle) / 2.0) ** 0.5)

print(f"Final Validation Performance: {final_validation_score}")
```
