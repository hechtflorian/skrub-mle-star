import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from lightgbm import LGBMRegressor

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_structural_time_features(df):
    out = df.copy()

    if "Date" in out.columns:
        dt = pd.to_datetime(out["Date"], errors="coerce")
        out["Date_year"] = dt.dt.year
        out["Date_month"] = dt.dt.month
        out["Date_day"] = dt.dt.day
        out["Date_dayofweek"] = dt.dt.dayofweek
        out["Date_dayofyear"] = dt.dt.dayofyear
        out["Date_weekofyear"] = dt.dt.isocalendar().week.astype("float")
        out["Date_is_weekend"] = (dt.dt.dayofweek >= 5).astype("float")
        out["Date_is_month_start"] = dt.dt.is_month_start.astype("float")
        out["Date_is_month_end"] = dt.dt.is_month_end.astype("float")
        out["Date_month_sin"] = np.sin(2 * np.pi * dt.dt.month.fillna(0) / 12.0)
        out["Date_month_cos"] = np.cos(2 * np.pi * dt.dt.month.fillna(0) / 12.0)
        out["Date_dow_sin"] = np.sin(2 * np.pi * dt.dt.dayofweek.fillna(0) / 7.0)
        out["Date_dow_cos"] = np.cos(2 * np.pi * dt.dt.dayofweek.fillna(0) / 7.0)
        out["Date_ordinal"] = dt.map(lambda x: x.toordinal() if pd.notna(x) else np.nan).astype("float")

    if "ConfirmedCases" in out.columns and "Fatalities" in out.columns:
        cc = pd.to_numeric(out["ConfirmedCases"], errors="coerce")
        ft = pd.to_numeric(out["Fatalities"], errors="coerce")
        ratio = ft / cc.replace(0, np.nan)
        out["Fatalities_per_ConfirmedCases"] = ratio.replace([np.inf, -np.inf], np.nan).fillna(0.0)
        out["ConfirmedCases_log1p"] = np.log1p(cc.clip(lower=0))
        out["Fatalities_log1p"] = np.log1p(ft.clip(lower=0))

    return out


def encode_province_state(df):
    out = df.copy()
    if "Province_State" in out.columns:
        out["Province_State"] = out["Province_State"].astype("string")
    return out


def clean_redundant_columns(df):
    out = df.copy()
    drop_cols = []
    for col in out.columns:
        if col == "Date":
            continue
        if out[col].isna().mean() >= 0.995:
            drop_cols.append(col)
        elif out[col].nunique(dropna=True) <= 1:
            drop_cols.append(col)
    if drop_cols:
        out = out.drop(columns=drop_cols, errors="ignore")
    return out


data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(add_structural_time_features)
data_train = data_train.skb.apply_func(encode_province_state)
data_train = data_train.skb.apply_func(clean_redundant_columns)

X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer(
    low_cardinality=skrub.ToCategorical(),
    high_cardinality=skrub.StringEncoder(n_components=12),
)

model = LGBMRegressor(
    n_estimators=400,
    learning_rate=0.05,
    num_leaves=63,
    random_state=random_state,
    n_jobs=1,
    verbose=-1,
)

pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = rmsle(valid_part[target_col].values, valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
