).skb.apply(RandomForestRegressor(n_estimators=200, random_state=random_state), y=y_full_fatalities)

learner_1_full = full_pred_confirmed.skb.make_learner(fitted=True)
learner_2_full = full_pred_fatalities.skb.make_learner(fitted=True)

# Smallest fix: drop ForecastId before prediction because it was not seen at fit time
test_features = build_features(test_df).drop(columns=["ForecastId"], errors="ignore")

test_pred_confirmed = np.maximum(np.asarray(learner_1_full.predict({"data": test_features})), 0)
test_pred_fatalities = np.maximum(np.asarray(learner_2_full.predict({"data": test_features})), 0)

os.makedirs("./final", exist_ok=True)
submission = pd.DataFrame(
    {
        "ForecastId": test_df["ForecastId"],
        "ConfirmedCases": test_pred_confirmed,
        "Fatalities": test_pred_fatalities,
    }
)
