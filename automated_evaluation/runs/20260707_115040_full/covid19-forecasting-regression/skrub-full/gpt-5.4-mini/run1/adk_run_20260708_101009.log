import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error

random_state = 42
test_size = 0.2

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")

target_cols = ["ConfirmedCases", "Fatalities"]
target_col = target_cols[0]  # retained for pipeline shape; predictions are generated for both targets

def add_date_features(df):
    out = df.copy()
    out["Date"] = pd.to_datetime(out["Date"])
    out["year"] = out["Date"].dt.year
    out["month"] = out["Date"].dt.month
    out["day"] = out["Date"].dt.day
    out["dayofweek"] = out["Date"].dt.dayofweek
    out["dayofyear"] = out["Date"].dt.dayofyear
    out["weekofyear"] = out["Date"].dt.isocalendar().week.astype(int)
    out["is_weekend"] = (out["dayofweek"] >= 5).astype(int)
    out["days_since_start"] = (out["Date"] - out["Date"].min()).dt.days
    return out

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=test_size, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# ---------- Target 1: ConfirmedCases ----------
data_train_cc = skrub.var("data", train_part)
data_train_cc = data_train_cc.skb.apply_func(add_date_features)
X_train_cc = data_train_cc.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
y_train_cc = data_train_cc["ConfirmedCases"].skb.mark_as_y()

vectorizer_cc = skrub.TableVectorizer()
model_cc = sklearn.ensemble.HistGradientBoostingRegressor(random_state=random_state)

pred_cc = X_train_cc.skb.apply(vectorizer_cc).skb.apply(model_cc, y=y_train_cc)
val_learner_cc = pred_cc.skb.make_learner(fitted=True)
valid_pred_cc = np.maximum(0, np.asarray(val_learner_cc.predict({"data": valid_part}))).ravel()

# ---------- Target 2: Fatalities ----------
data_train_ft = skrub.var("data", train_part)
data_train_ft = data_train_ft.skb.apply_func(add_date_features)
X_train_ft = data_train_ft.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
y_train_ft = data_train_ft["Fatalities"].skb.mark_as_y()

vectorizer_ft = skrub.TableVectorizer()
model_ft = sklearn.ensemble.HistGradientBoostingRegressor(random_state=random_state)

pred_ft = X_train_ft.skb.apply(vectorizer_ft).skb.apply(model_ft, y=y_train_ft)
val_learner_ft = pred_ft.skb.make_learner(fitted=True)
valid_pred_ft = np.maximum(0, np.asarray(val_learner_ft.predict({"data": valid_part}))).ravel()

# Validation metric
valid_true = valid_part[target_cols].copy()
valid_true["ConfirmedCases"] = np.clip(valid_true["ConfirmedCases"], 0, None)
valid_true["Fatalities"] = np.clip(valid_true["Fatalities"], 0, None)

final_validation_score = (
    mean_squared_log_error(valid_true["ConfirmedCases"], valid_pred_cc) ** 0.5
    + mean_squared_log_error(valid_true["Fatalities"], valid_pred_ft) ** 0.5
) / 2
print(f"Final Validation Performance: {final_validation_score}")

# ---------- Submission training on full train_df ----------
data_full_cc = skrub.var("data", train_df)
data_full_cc = data_full_cc.skb.apply_func(add_date_features)
X_full_cc = data_full_cc.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
y_full_cc = data_full_cc["ConfirmedCases"].skb.mark_as_y()

full_pred_cc = X_full_cc.skb.apply(vectorizer_cc).skb.apply(model_cc, y=y_full_cc)
full_learner_cc = full_pred_cc.skb.make_learner(fitted=True)

data_full_ft = skrub.var("data", train_df)
data_full_ft = data_full_ft.skb.apply_func(add_date_features)
X_full_ft = data_full_ft.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
y_full_ft = data_full_ft["Fatalities"].skb.mark_as_y()

full_pred_ft = X_full_ft.skb.apply(vectorizer_ft).skb.apply(model_ft, y=y_full_ft)
full_learner_ft = full_pred_ft.skb.make_learner(fitted=True)

# IMPORTANT FIX:
# Drop ForecastId before prediction because it was not present during fit.
test_features = test_df.drop(columns=["ForecastId"], errors="ignore")
test_pred_cc = np.maximum(0, np.asarray(full_learner_cc.predict({"data": test_features}))).ravel()
test_pred_ft = np.maximum(0, np.asarray(full_learner_ft.predict({"data": test_features}))).ravel()

submission = pd.DataFrame(
    {
        "ForecastId": test_df["ForecastId"],
        "ConfirmedCases": test_pred_cc,
        "Fatalities": test_pred_ft,
    }
)

os.makedirs("./final", exist_ok=True)
submission.to_csv("./final/submission.csv", index=False)
```
