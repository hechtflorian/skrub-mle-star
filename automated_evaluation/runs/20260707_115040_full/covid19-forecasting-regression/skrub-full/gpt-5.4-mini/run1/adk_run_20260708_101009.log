import os
import re
import warnings
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error
from sklearn.ensemble import RandomForestRegressor

warnings.filterwarnings("ignore")

random_state = 42

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_cols = ["ConfirmedCases", "Fatalities"]

def add_date_features(df: pd.DataFrame) -> pd.DataFrame:
    out = df.copy()
    out["Date"] = pd.to_datetime(out["Date"])
    out["Year"] = out["Date"].dt.year
    out["Month"] = out["Date"].dt.month
    out["Day"] = out["Date"].dt.day
    out["DayOfYear"] = out["Date"].dt.dayofyear
    out["WeekOfYear"] = out["Date"].dt.isocalendar().week.astype(int)
    out["DayOfWeek"] = out["Date"].dt.dayofweek
    out["IsWeekend"] = (out["DayOfWeek"] >= 5).astype(int)
    out["DateOrdinal"] = out["Date"].map(pd.Timestamp.toordinal)
    out["Province_State"] = out["Province_State"].fillna("")
    out["Country_Region"] = out["Country_Region"].fillna("")
    return out

train_df = add_date_features(train_df)
test_df = add_date_features(test_df)

train_df["Province_State"] = train_df["Province_State"].fillna("")
train_df["Country_Region"] = train_df["Country_Region"].fillna("")
test_df["Province_State"] = test_df["Province_State"].fillna("")
test_df["Country_Region"] = test_df["Country_Region"].fillna("")

# Use an honest holdout split for validation
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def fit_leg_and_predict(train_part_df, valid_part_df, target_col, target_transform=None, inverse_target_transform=None):
    data_train = skrub.var("data", train_part_df)
    X_train = data_train.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    # Apply target transform on concrete arrays, not on skrub DataOp objects.
    y_train_pd = train_part_df[target_col].to_numpy()
    if target_transform is not None:
        y_fit = target_transform(y_train_pd)
    else:
        y_fit = y_train_pd

    X_fit = train_part_df.drop(columns=target_cols, errors="ignore")
    X_valid = valid_part_df.drop(columns=target_cols, errors="ignore")

    model = RandomForestRegressor(
        n_estimators=250,
        random_state=random_state,
        n_jobs=-1,
        min_samples_leaf=1,
    )
    model.fit(pd.get_dummies(X_fit, dummy_na=True), y_fit)

    valid_pred = model.predict(pd.get_dummies(X_valid, dummy_na=True))

    if inverse_target_transform is not None:
        valid_pred = inverse_target_transform(valid_pred)

    return valid_pred

def align_predictions(pred, floor=0.0):
    pred = np.asarray(pred, dtype=float)
    pred = np.maximum(pred, floor)
    return pred

# Train separate legs for each target
confirmed_pred = fit_leg_and_predict(
    train_part,
    valid_part,
    "ConfirmedCases",
    target_transform=np.log1p,
    inverse_target_transform=np.expm1,
)

fatal_pred = fit_leg_and_predict(
    train_part,
    valid_part,
    "Fatalities",
    target_transform=np.log1p,
    inverse_target_transform=np.expm1,
)

confirmed_pred = align_predictions(confirmed_pred)
fatal_pred = align_predictions(fatal_pred)

y_true_confirmed = np.maximum(valid_part["ConfirmedCases"].to_numpy(dtype=float), 0.0)
y_true_fatal = np.maximum(valid_part["Fatalities"].to_numpy(dtype=float), 0.0)

# RMSLE on both targets, averaged
score_confirmed = mean_squared_log_error(y_true_confirmed, confirmed_pred) ** 0.5
score_fatal = mean_squared_log_error(y_true_fatal, fatal_pred) ** 0.5
final_validation_score = float((score_confirmed + score_fatal) / 2.0)

print(f"Final Validation Performance: {final_validation_score}")
```
