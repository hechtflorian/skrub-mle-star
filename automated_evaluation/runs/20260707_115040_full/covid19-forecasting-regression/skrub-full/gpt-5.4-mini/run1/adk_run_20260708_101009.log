from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error
from lightgbm import LGBMRegressor

warnings.filterwarnings("ignore")

random_state = 42
test_size = 0.2
target_cols = ["ConfirmedCases", "Fatalities"]

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")

def make_features(df):
    df = df.copy()
    df["Date"] = pd.to_datetime(df["Date"])
    df["Year"] = df["Date"].dt.year
    df["Month"] = df["Date"].dt.month
    df["Day"] = df["Date"].dt.day
    df["DayOfWeek"] = df["Date"].dt.dayofweek
    df["DayOfYear"] = df["Date"].dt.dayofyear
    df["WeekOfYear"] = df["Date"].dt.isocalendar().week.astype(int)
    df["DaysSinceStart"] = (df["Date"] - pd.Timestamp("2020-01-01")).dt.days
    df["Province_State"] = df["Province_State"].fillna("")
    df["Country_Region"] = df["Country_Region"].fillna("")
    df["Region"] = df["Country_Region"] + "_" + df["Province_State"]
    df["HasProvince"] = (df["Province_State"] != "").astype(int)
    return df

train_df = make_features(train_df)
test_df = make_features(test_df)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=test_size, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
y_cases = data_train["ConfirmedCases"].skb.mark_as_y()
y_fatal = data_train["Fatalities"].skb.mark_as_y()

def sanitize_columns(df):
    out = df.copy()
    out.columns = [
        (
            str(c)
            .replace("[", "_")
            .replace("]", "_")
            .replace("{", "_")
            .replace("}", "_")
            .replace("(", "_")
            .replace(")", "_")
            .replace("'", "_")
            .replace('"', "_")
            .replace(":", "_")
            .replace(",", "_")
            .replace("<", "_")
            .replace(">", "_")
            .replace("/", "_")
            .replace("\\", "_")
            .replace(" ", "_")
        )
        for c in out.columns
    ]
    return out

vectorizer = skrub.TableVectorizer()

def make_target_model():
    return LGBMRegressor(
        n_estimators=300,
        learning_rate=0.05,
        num_leaves=31,
        random_state=random_state,
        verbose=-1,
    )

pred_cases = X_train.skb.apply(vectorizer).skb.apply_func(sanitize_columns).skb.apply(make_target_model(), y=y_cases)
pred_fatal = X_train.skb.apply(vectorizer).skb.apply_func(sanitize_columns).skb.apply(make_target_model(), y=y_fatal)

learner_cases = pred_cases.skb.make_learner(fitted=True)
learner_fatal = pred_fatal.skb.make_learner(fitted=True)

valid_pred_cases = np.maximum(0, np.asarray(learner_cases.predict({"data": valid_part})))
valid_pred_fatal = np.maximum(0, np.asarray(learner_fatal.predict({"data": valid_part})))

final_validation_score = (
    mean_squared_log_error(valid_part["ConfirmedCases"], valid_pred_cases) ** 0.5
    + mean_squared_log_error(valid_part["Fatalities"], valid_pred_fatal) ** 0.5
) / 2.0

print(f"Final Validation Performance: {final_validation_score}")

full_data = skrub.var("data", train_df)
X_full = full_data.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
y_full_cases = full_data["ConfirmedCases"].skb.mark_as_y()
y_full_fatal = full_data["Fatalities"].skb.mark_as_y()

full_pred_cases = X_full.skb.apply(vectorizer).skb.apply_func(sanitize_columns).skb.apply(make_target_model(), y=y_full_cases)
full_pred_fatal = X_full.skb.apply(vectorizer).skb.apply_func(sanitize_columns).skb.apply(make_target_model(), y=y_full_fatal)

full_learner_cases = full_pred_cases.skb.make_learner(fitted=True)
full_learner_fatal = full_pred_fatal.skb.make_learner(fitted=True)

test_pred_cases = np.maximum(0, np.asarray(full_learner_cases.predict({"data": test_df})))
test_pred_fatal = np.maximum(0, np.asarray(full_learner_fatal.predict({"data": test_df})))

submission = pd.DataFrame(
    {
        "ForecastId": test_df["ForecastId"],
        "ConfirmedCases": test_pred_cases,
        "Fatalities": test_pred_fatal,
    }
)
submission.to_csv("submission.csv", index=False)
