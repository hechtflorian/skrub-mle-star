import os
import json
import numpy as np
import pandas as pd
import skrub
from sklearn.ensemble import RandomForestRegressor
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error

random_state = 42
target_cols = ["ConfirmedCases", "Fatalities"]

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")

# Parse dates once, keep logic simple and fast
for df in (train_df, test_df):
    df["Date"] = pd.to_datetime(df["Date"], errors="coerce")
    df["Date_ordinal"] = df["Date"].map(lambda x: x.toordinal() if pd.notna(x) else np.nan)

train_df["Province_State"] = train_df["Province_State"].fillna("")
test_df["Province_State"] = test_df["Province_State"].fillna("")

# Light, fast feature engineering; keep DataOps structure
def fe(df):
    out = df.copy()
    out["Province_State"] = out["Province_State"].fillna("")
    out["Date"] = pd.to_datetime(out["Date"], errors="coerce")
    out["Date_ordinal"] = out["Date"].map(lambda x: x.toordinal() if pd.notna(x) else np.nan)
    return out

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# Use a much cheaper forest to avoid timeout while preserving the same workflow
def build_graph(bound_df):
    data_train = skrub.var("data", bound_df)
    data_train = data_train.skb.apply_func(fe)
    X_train = data_train.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_cols].skb.mark_as_y()
    vectorizer = skrub.TableVectorizer()
    model = RandomForestRegressor(
        n_estimators=50,
        random_state=random_state,
        n_jobs=-1,
    )
    pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
    return pred

# Train separate models for each target using the same structure
final_validation_scores = []
valid_preds = {}
for target_col in target_cols:
    train_part_t = train_part.drop(columns=[c for c in target_cols if c != target_col], errors="ignore")
    valid_part_t = valid_part.drop(columns=[c for c in target_cols if c != target_col], errors="ignore")

    data_train = skrub.var("data", train_part_t)
    data_train = data_train.skb.apply_func(fe)
    X_train = data_train.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()
    model = RandomForestRegressor(
        n_estimators=50,
        random_state=random_state,
        n_jobs=-1,
    )
    pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
    val_learner = pred.skb.make_learner(fitted=True)
    valid_pred = val_learner.predict({"data": valid_part_t})
    valid_pred = np.asarray(valid_pred).reshape(-1)
    valid_preds[target_col] = valid_pred

    score = mean_squared_error(valid_part_t[target_col].values, valid_pred) ** 0.5
    final_validation_scores.append(score)

final_validation_score = float(np.mean(final_validation_scores))
print(f"Final Validation Performance: {final_validation_score}")

# Fit on full training data and predict test data, preserving the same pipeline
