import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_log_error
from lightgbm import LGBMRegressor

random_state = 42
target_cols = ["ConfirmedCases", "Fatalities"]

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

def add_date_features(df):
    df = df.copy()
    df["Date"] = pd.to_datetime(df["Date"])
    df["Year"] = df["Date"].dt.year
    df["Month"] = df["Date"].dt.month
    df["Day"] = df["Date"].dt.day
    df["Dayofweek"] = df["Date"].dt.dayofweek
    df["Dayofyear"] = df["Date"].dt.dayofyear
    df["Weekofyear"] = df["Date"].dt.isocalendar().week.astype(int)
    return df

def prepare_features(df):
    df = add_date_features(df)
    return df

def make_target_model():
    return LGBMRegressor(
        n_estimators=300,
        learning_rate=0.05,
        num_leaves=31,
        random_state=random_state,
        n_jobs=-1,
        verbose=-1,
    )

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

train_part = prepare_features(train_part)
valid_part = prepare_features(valid_part)
test_df_feat = prepare_features(test_df)

for col in ["Province_State", "Country_Region"]:
    train_part[col] = train_part[col].fillna("missing").astype(str)
    valid_part[col] = valid_part[col].fillna("missing").astype(str)
    test_df_feat[col] = test_df_feat[col].fillna("missing").astype(str)

train_part = pd.get_dummies(train_part, columns=["Province_State", "Country_Region"], dummy_na=False)
valid_part = pd.get_dummies(valid_part, columns=["Province_State", "Country_Region"], dummy_na=False)
test_df_feat = pd.get_dummies(test_df_feat, columns=["Province_State", "Country_Region"], dummy_na=False)

feature_cols = [c for c in train_part.columns if c not in target_cols + ["Id", "ForecastId", "Date"]]
feature_cols = sorted(feature_cols)

train_part = train_part.reindex(columns=feature_cols + target_cols, fill_value=0)
valid_part = valid_part.reindex(columns=feature_cols + target_cols, fill_value=0)
test_df_feat = test_df_feat.reindex(columns=feature_cols + ["ForecastId", "Date"], fill_value=0)

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_cols, errors="ignore").skb.mark_as_X()

y_cases = data_train["ConfirmedCases"].skb.mark_as_y()
y_fatal = data_train["Fatalities"].skb.mark_as_y()

pred_cases = X_train.skb.apply(make_target_model(), y=y_cases)
pred_fatal = X_train.skb.apply(make_target_model(), y=y_fatal)

learner_cases = pred_cases.skb.make_learner(fitted=True)
learner_fatal = pred_fatal.skb.make_learner(fitted=True)

valid_X = valid_part.drop(columns=target_cols, errors="ignore")
pred_cases_valid = np.maximum(0, np.asarray(learner_cases.predict({"data": valid_X})))
pred_fatal_valid = np.maximum(0, np.asarray(learner_fatal.predict({"data": valid_X})))

# Keep cumulative predictions non-decreasing across time within each location
valid_eval = valid_part[["Country_Region", "Province_State", "Date"]].copy()
valid_eval["ConfirmedCases_pred"] = pred_cases_valid
valid_eval["Fatalities_pred"] = pred_fatal_valid
valid_eval["ConfirmedCases_pred"] = valid_eval.groupby(["Country_Region", "Province_State"])["ConfirmedCases_pred"].cummax()
valid_eval["Fatalities_pred"] = valid_eval.groupby(["Country_Region", "Province_State"])["Fatalities_pred"].cummax()

final_validation_score = (
    mean_squared_log_error(valid_part["ConfirmedCases"], valid_eval["ConfirmedCases_pred"]) ** 0.5
    + mean_squared_log_error(valid_part["Fatalities"], valid_eval["Fatalities_pred"]) ** 0.5
) / 2.0

print(f"Final Validation Performance: {final_validation_score}")

# Fit on full train for test-time inference using the same fixed preprocessing
full_train = prepare_features(train_df.copy())
full_test = test_df_feat.copy()

for col in ["Province_State", "Country_Region"]:
    full_train[col] = full_train[col].fillna("missing").astype(str)
    full_test[col] = full_test[col].fillna("missing").astype(str)

full_train = pd.get_dummies(full_train, columns=["Province_State", "Country_Region"], dummy_na=False)
full_test = pd.get_dummies(full_test, columns=["Province_State", "Country_Region"], dummy_na=False)

full_feature_cols = [c for c in full_train.columns if c not in target_cols + ["Id", "ForecastId", "Date"]]
full_feature_cols = sorted(full_feature_cols)

full_train = full_train.reindex(columns=full_feature_cols + target_cols, fill_value=0)
full_test = full_test.reindex(columns=full_feature_cols + ["ForecastId", "Date"], fill_value=0)

X_full = full_train.drop(columns=target_cols, errors="ignore").skb.mark_as_X()
y_full_cases = skrub.var("y_full_cases", full_train["ConfirmedCases"]).skb.mark_as_y()
y_full_fatal = skrub.var("y_full_fatal", full_train["Fatalities"]).skb.mark_as_y()

final_cases_learner = X_full.skb.apply(make_target_model(), y=y_full_cases).skb.make_learner(fitted=True)
final_fatal_learner = X_full.skb.apply(make_target_model(), y=y_full_fatal).skb.make_learner(fitted=True)

test_X = full_test.drop(columns=["ForecastId", "Date"], errors="ignore")
test_pred_cases = np.maximum(0, np.asarray(final_cases_learner.predict({"data": test_X})))
test_pred_fatal = np.maximum(0, np.asarray(final_fatal_learner.predict({"data": test_X})))

submission = pd.DataFrame(
    {
        "ForecastId": test_df["ForecastId"].values,
        "ConfirmedCases": test_pred_cases,
        "Fatalities": test_pred_fatal,
    }
)

submission.to_csv("submission.csv", index=False)
```
