valid_part = train_df.iloc[valid_idx].copy()

def preprocess_base(df):
    df = df.copy()
    if "Cabin" in df.columns:
        cabin_split = df["Cabin"].astype("string").str.split("/", expand=True)
        if cabin_split.shape[1] >= 3:
            df["CabinDeck"] = cabin_split[0]
            df["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
            df["CabinSide"] = cabin_split[2]
        df = df.drop(columns=["Cabin"], errors="ignore")
    if "Name" in df.columns:
        df["NameLen"] = df["Name"].astype("string").str.len()
        df = df.drop(columns=["Name"], errors="ignore")
    return df

def preprocess_no_name(df):
    df = df.copy()
    if "Cabin" in df.columns:
        cabin_split = df["Cabin"].astype("string").str.split("/", expand=True)
        if cabin_split.shape[1] >= 3:
            df["CabinDeck"] = cabin_split[0]
            df["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
            df["CabinSide"] = cabin_split[2]
        df = df.drop(columns=["Cabin"], errors="ignore")
    return df

def preprocess_no_cabin(df):
    df = df.copy()
    if "Name" in df.columns:
        df["NameLen"] = df["Name"].astype("string").str.len()
        df = df.drop(columns=["Name"], errors="ignore")
    return df

def preprocess_no_derived(df):
    df = df.copy()
    if "Cabin" in df.columns:
        df = df.drop(columns=["Cabin"], errors="ignore")
    if "Name" in df.columns:
        df = df.drop(columns=["Name"], errors="ignore")
    return df

def preprocess_with_impute(df):
    df = preprocess_base(df)
    num_cols = df.select_dtypes(include=[np.number]).columns
    obj_cols = df.select_dtypes(include=["object", "string", "category"]).columns
    if len(num_cols) > 0:
        df[num_cols] = SimpleImputer(strategy="median").fit_transform(df[num_cols])
    if len(obj_cols) > 0:
        df[obj_cols] = SimpleImputer(strategy="most_frequent").fit_transform(df[obj_cols])
    return df

def run_variant(variant_name, preprocess_fn, use_imputation=False):
    tr = preprocess_fn(train_part)
    va = preprocess_fn(valid_part)

    data_train = skrub.var("data", tr)
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    model = HistGradientBoostingClassifier(random_state=42)

    if use_imputation:
        pred = X_train.skb.apply(skrub.TableVectorizer()).skb.apply(model, y=y_train)
    else:
        pred = X_train.skb.apply(skrub.TableVectorizer()).skb.apply(model, y=y_train)

    val_learner = pred.skb.make_learner(fitted=True)
    valid_pred = np.asarray(val_learner.predict({"data": va})).astype(bool)
    score = accuracy_score(va[target_col], valid_pred)
    print(f"Ablation[{variant_name}] accuracy_score: {score}")
    return score

scores = {}

# Baseline
scores["baseline"] = run_variant("baseline", preprocess_base)

# Ablation 1: remove NameLen feature
scores["no_name_feature"] = run_variant("no_name_feature", preprocess_no_name)

# Ablation 2: remove Cabin-derived features
scores["no_cabin_features"] = run_variant("no_cabin_features", preprocess_no_cabin)

# Ablation 3: remove all derived cabin/name features
scores["no_derived_features"] = run_variant("no_derived_features", preprocess_no_derived)

best_variant = max(scores, key=scores.get)
best_score = scores[best_variant]
baseline_score = scores["baseline"]

delta = best_score - baseline_score
print(f"Best ablation variant: {best_variant} | accuracy_score: {best_score}")
print(f"Most important contribution relative to baseline: {best_variant} ({delta:+.6f})")
