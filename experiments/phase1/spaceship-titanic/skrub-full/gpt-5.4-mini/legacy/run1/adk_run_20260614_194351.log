import numpy as np
import pandas as pd
import skrub
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

# Honest holdout split
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

@skrub.deferred
def add_structural_features(df):
    out = df.copy()

    # Rich cabin features
    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin_split = cabin.str.split("/", expand=True)

        out["CabinDeck"] = cabin_split[0] if cabin_split.shape[1] >= 1 else pd.NA
        out["CabinNum"] = (
            pd.to_numeric(cabin_split[1], errors="coerce")
            if cabin_split.shape[1] >= 2
            else np.nan
        )
        out["CabinSide"] = cabin_split[2] if cabin_split.shape[1] >= 3 else pd.NA
        out["HasCabin"] = cabin.notna().astype("int8")
        out["CabinNumBin"] = pd.cut(
            out["CabinNum"],
            bins=[-np.inf, 99, 499, 999, 1999, np.inf],
            labels=["0_99", "100_499", "500_999", "1000_1999", "2000_plus"],
            include_lowest=True,
        ).astype("string")
        out = out.drop(columns=["Cabin"], errors="ignore")
    else:
        out["HasCabin"] = 0

    # Aggregate sparse spending columns
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    present_spend_cols = [c for c in spend_cols if c in out.columns]
    if present_spend_cols:
        spend = out[present_spend_cols].apply(pd.to_numeric, errors="coerce").fillna(0.0)
        out["TotalSpend"] = spend.sum(axis=1)
        out["WasSpending"] = (out["TotalSpend"] > 0).astype("int8")

    # Drop raw high-cardinality text after extracting useful structure
    out = out.drop(columns=["Name"], errors="ignore")

    return out

data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(add_structural_features)

X_train = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

# Keep remaining mixed types/missingness handling delegated to TableVectorizer
vectorizer = skrub.TableVectorizer()

# Reuse a strong fixed model; no tuning in this refinement step
model = HistGradientBoostingRegressor(
    learning_rate=0.05,
    max_depth=6,
    max_iter=300,
    random_state=42,
)

pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")
