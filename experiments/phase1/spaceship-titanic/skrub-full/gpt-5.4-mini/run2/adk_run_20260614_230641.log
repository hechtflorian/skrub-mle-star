import os
import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "Transported"

def prepare_df(df):
    df = df.copy()
    cabin_parts = df["Cabin"].astype("string").str.split("/", expand=True)
    df["CabinDeck"] = cabin_parts[0]
    df["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
    df["CabinSide"] = cabin_parts[2]
    name_parts = df["Name"].fillna("").astype(str).str.split(" ", n=1, expand=True)
    df["LastName"] = name_parts[1].fillna("")
    df["GroupId"] = df["PassengerId"].astype(str).str.split("_").str[0]
    df["GroupSize"] = df.groupby("GroupId")["PassengerId"].transform("size")
    df["IsAlone"] = (df["GroupSize"] == 1).astype(int)
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df["TotalSpend"] = df[spend_cols].fillna(0).sum(axis=1)
    df["NoSpend"] = (df["TotalSpend"] == 0).astype(int)
    df["AgeGroup"] = pd.cut(
        df["Age"],
        bins=[-np.inf, 12, 18, 35, 50, np.inf],
        labels=["child", "teen", "young_adult", "adult", "senior"],
    )
    df["CryoSleep"] = df["CryoSleep"].astype("object")
    df["VIP"] = df["VIP"].astype("object")
    df["Destination"] = df["Destination"].astype("object")
    df["HomePlanet"] = df["HomePlanet"].astype("object")
    return df.drop(columns=["Cabin", "Name"], errors="ignore")

train_df = prepare_df(train_df)
test_df = prepare_df(test_df)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()
model = CatBoostClassifier(
    iterations=2500,
    depth=6,
    learning_rate=0.03,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=42,
    allow_writing_files=False,
)

pred_graph = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
val_learner = pred_graph.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = accuracy_score(valid_part[target_col].astype(int), valid_pred.astype(int))

print(f"Final Validation Performance: {final_validation_score}")
```
