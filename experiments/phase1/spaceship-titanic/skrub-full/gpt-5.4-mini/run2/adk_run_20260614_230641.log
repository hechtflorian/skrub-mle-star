@skrub.deferred
def add_titanic_structural_features(df):
    out = df.copy()

    if "PassengerId" in out.columns:
        pid = pd.to_numeric(out["PassengerId"], errors="coerce")
        out["PassengerGroup"] = (pid // 4).fillna(-1).astype("int64")
        out["PassengerGroupParity"] = (pid % 2).fillna(-1).astype("int64")

    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string").fillna("")
        out["CabinDeck"] = cabin.str.extract(r"([A-Za-z])", expand=False).fillna("Unknown")
        out["CabinNumber"] = pd.to_numeric(cabin.str.extract(r"(\d+)", expand=False), errors="coerce").fillna(-1)
        out["CabinSide"] = cabin.str.extract(r"([A-Za-z]$)", expand=False).fillna("Unknown")

    if "Name" in out.columns:
        name = out["Name"].astype("string").fillna("")
        out["NameLength"] = name.str.len().fillna(0).astype("int64")
        out["NameHasTitle"] = name.str.contains(r"\b(Mr|Mrs|Miss|Master|Dr|Rev|Col|Major|Mlle|Mme|Sir|Lady|Countess|Jonkheer|Don|Dona)\b", case=False, regex=True).fillna(False)

    if "Ticket" in out.columns:
        ticket = out["Ticket"].astype("string").fillna("")
        out["TicketPrefix"] = ticket.str.replace(r"[\d\s./]+", "", regex=True).replace("", "NONE")
        out["TicketDigits"] = pd.to_numeric(ticket.str.extract(r"(\d+)", expand=False), errors="coerce").fillna(-1)

    if "FamilySize" not in out.columns and {"SibSp", "Parch"}.issubset(out.columns):
        sibsp = pd.to_numeric(out["SibSp"], errors="coerce").fillna(0)
        parch = pd.to_numeric(out["Parch"], errors="coerce").fillna(0)
        out["FamilySize"] = sibsp + parch + 1

    return out

data_train_fe = data_train.skb.apply_func(add_titanic_structural_features)
X_train_fe = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train_fe = data_train_fe[target_col].skb.mark_as_y()

