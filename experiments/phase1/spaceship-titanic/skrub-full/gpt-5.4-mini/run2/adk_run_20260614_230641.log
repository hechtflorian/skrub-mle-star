import numpy as np
import skrub
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

@skrub.deferred
def add_domain_features(df):
    out = df.copy()

    # Cabin-derived structural features
    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin = cabin.fillna("")
        cabin_clean = cabin.str.replace(r"\s+", "", regex=True)
        out["Deck"] = cabin_clean.str.extract(r"^([A-Za-z])", expand=False)
        out["CabinSide"] = cabin_clean.str.extract(r"([PS])$", expand=False)

    # PassengerId group and within-group signals
    if "PassengerId" in out.columns:
        pid = out["PassengerId"].astype("string").fillna("")
        pid_split = pid.str.split("_", n=1, expand=True)
        if pid_split.shape[1] >= 1:
            out["PassengerGroup"] = pid_split.iloc[:, 0]
        if pid_split.shape[1] >= 2:
            out["PassengerGroupNum"] = pd.to_numeric(pid_split.iloc[:, 1], errors="coerce")
            out["PassengerGroupSizeHint"] = pid_split.iloc[:, 1].str.len()
            out["PassengerIsFirst"] = (out["PassengerGroupNum"] == 1).astype("float")
        else:
            out["PassengerGroupNum"] = np.nan
            out["PassengerGroupSizeHint"] = np.nan
            out["PassengerIsFirst"] = np.nan

    # Expenditure features
    spend_cols = [
        col
        for col in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
        if col in out.columns
    ]
    if spend_cols:
        spend_block = out[spend_cols].apply(pd.to_numeric, errors="coerce").fillna(0.0)
        out["TotalSpend"] = spend_block.sum(axis=1)
        out["SpentAny"] = (spend_block.sum(axis=1) > 0).astype("int64")
        out["LogTotalSpend"] = np.log1p(out["TotalSpend"])

    # Keep Name only if routed through high-cardinality string handling; otherwise drop later
    if "Name" in out.columns:
        out["NameLength"] = out["Name"].astype("string").fillna("").str.len()

    return out

data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(add_domain_features)

X_train = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

# Reduce noise from high-cardinality text if it is not explicitly useful in the current path
X_train = X_train.skb.apply(skrub.DropCols(cols=skrub.selectors.cols("Name"), errors="ignore"))

# Post-FE vectorization on the full transformed table
vectorizer = skrub.TableVectorizer(
    low_cardinality=skrub.ToCategorical(),
    high_cardinality=skrub.GapEncoder(),
)
X_train_vec = X_train.skb.apply(vectorizer)

# Single stronger holdout path: fixed-parameter tree ensemble
model_rf = RandomForestClassifier(
    n_estimators=600,
    max_depth=18,
    min_samples_split=4,
    min_samples_leaf=2,
    max_features="sqrt",
    bootstrap=True,
    class_weight="balanced_subsample",
    random_state=42,
    n_jobs=-1,
)

learner_rf = X_train_vec.skb.apply(model_rf, y=y_train).skb.make_learner(fitted=True)

# Prepare validation path with the same feature block and vectorization
data_valid = skrub.var("data", valid_part)
data_valid_fe = data_valid.skb.apply_func(add_domain_features)
X_valid = data_valid_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
X_valid = X_valid.skb.apply(skrub.DropCols(cols=skrub.selectors.cols("Name"), errors="ignore"))
valid_pred = np.asarray(learner_rf.predict({"data": valid_part}))

if valid_pred.dtype != bool:
    if valid_pred.ndim > 1:
        valid_pred = valid_pred[:, 1]
    valid_pred = valid_pred.astype(float) >= 0.5

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
