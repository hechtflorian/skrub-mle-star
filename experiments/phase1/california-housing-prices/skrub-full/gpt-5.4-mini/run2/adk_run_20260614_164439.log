import os
import numpy as np
import pandas as pd
import skrub
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split
from sklearn.ensemble import HistGradientBoostingRegressor

# Load data
train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")
target_col = "median_house_value"

# Keep the existing helper, but make it DataOp-safe by returning a new object.
def add_ratio_features(df):
    return df.assign(
        rooms_per_household=df["total_rooms"] / (df["households"] + 1e-9),
        bedrooms_per_room=df["total_bedrooms"] / (df["total_rooms"] + 1e-9),
        population_per_household=df["population"] / (df["households"] + 1e-9),
    )

# Holdout split
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# DataOps graph built on train_part only for honest validation
data_train = skrub.var("data", train_part)

X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Apply deferred feature engineering inside the DataOps pipeline
X_train_fe = X_train.skb.apply(add_ratio_features)

model = HistGradientBoostingRegressor(random_state=42)

pred = X_train_fe.skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")
```
