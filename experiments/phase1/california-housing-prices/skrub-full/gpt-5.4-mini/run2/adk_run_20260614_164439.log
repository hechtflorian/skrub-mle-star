import subprocess

subprocess.check_call([sys.executable, "-m", "pip", "install", "catboost", "-q"])

import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

train_df = pd.read_csv("./input/train.csv")
target_col = "median_house_value"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def fit_eval_variant(train_df_part, valid_df_part, variant_name, feature_fn=None, model_kwargs=None):
    data_train = skrub.var("data", train_df_part)

    if feature_fn is not None:
        data_train = data_train.skb.apply_func(feature_fn)
        valid_env = {"data": valid_df_part}
        valid_features = feature_fn(valid_df_part)
    else:
        valid_env = {"data": valid_df_part}
        valid_features = valid_df_part

    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()
    model = CatBoostRegressor(
        loss_function="RMSE",
        iterations=500,
        learning_rate=0.05,
        depth=8,
        random_seed=42,
        verbose=0,
        **(model_kwargs or {}),
    )

    pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
    learner = pred.skb.make_learner(fitted=True)
    valid_pred = learner.predict(valid_env)
    rmse = mean_squared_error(valid_df_part[target_col], valid_pred) ** 0.5
    print(f"Ablation[{variant_name}] RMSE: {rmse}")
    return rmse


@skrub.deferred
def add_ratio_features(df):
    out = df.copy()
    if "households" in out.columns:
        denom = out["households"].replace(0, np.nan)
        out["rooms_per_household"] = (
            out["total_rooms"] / denom
        ).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        out["bedrooms_per_household"] = (
            out["total_bedrooms"] / denom
        ).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        out["population_per_household"] = (
            out["population"] / denom
        ).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    return out


baseline_rmse = fit_eval_variant(train_part, valid_part, "baseline")

drop_redundant_rmse = fit_eval_variant(
    train_part,
    valid_part,
    "drop_households",
    feature_fn=lambda df: df.drop(columns=["households"], errors="ignore"),
)

ratio_rmse = fit_eval_variant(
    train_part,
    valid_part,
    "add_ratios",
    feature_fn=add_ratio_features,
)

best_variant = min(
    [
        ("baseline", baseline_rmse),
        ("drop_households", drop_redundant_rmse),
        ("add_ratios", ratio_rmse),
    ],
    key=lambda x: x[1],
)

print(f"Best ablation variant: {best_variant[0]} | RMSE: {best_variant[1]}")
