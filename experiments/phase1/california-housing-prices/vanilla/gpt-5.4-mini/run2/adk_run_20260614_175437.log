from sklearn.model_selection import KFold
import numpy as np
import pandas as pd
from catboost import CatBoostRegressor

# Keep the strong depth, add robust ordered boosting + Bernoulli subsampling
base_params = dict(
    depth=8,
    learning_rate=0.05,
    iterations=10000,
    loss_function="RMSE",
    eval_metric="RMSE",
    boosting_type="Ordered",
    bootstrap_type="Bernoulli",
    subsample=0.8,
    random_seed=42,
    verbose=200,
    allow_writing_files=False
)

# Tiny but meaningful search over loss-related settings
param_grid = [
    {"border_count": 64, "l2_leaf_reg": 3},
    {"border_count": 64, "l2_leaf_reg": 10},
    {"border_count": 128, "l2_leaf_reg": 3},
    {"border_count": 128, "l2_leaf_reg": 10},
]

kf = KFold(n_splits=5, shuffle=True, random_state=42)

best_score = np.inf
best_params = None
best_oof = None
best_test_pred = None

for params in param_grid:
    oof_pred = np.zeros(len(X))
    test_pred = np.zeros(len(test))
    fold_scores = []

    for fold, (train_idx, val_idx) in enumerate(kf.split(X, y), 1):
        X_tr, X_val = X.iloc[train_idx], X.iloc[val_idx]
        y_tr, y_val = y.iloc[train_idx], y.iloc[val_idx]

        model = CatBoostRegressor(
            **base_params,
            **params
        )

        model.fit(
            X_tr,
            y_tr,
            eval_set=(X_val, y_val),
            use_best_model=True,
            verbose=200
        )

        oof_pred[val_idx] = model.predict(X_val)
        test_pred += model.predict(test) / kf.n_splits

        fold_rmse = root_mean_squared_error(y_val, oof_pred[val_idx])
        fold_scores.append(fold_rmse)
        print(f"Params {params} | Fold {fold} RMSE: {fold_rmse:.6f}")

    cv_rmse = root_mean_squared_error(y, oof_pred)
    print(f"Params {params} | CV RMSE: {cv_rmse:.6f} | Fold mean: {np.mean(fold_scores):.6f}")

    if cv_rmse < best_score:
        best_score = cv_rmse
        best_params = params
        best_oof = oof_pred.copy()
        best_test_pred = test_pred.copy()

print(f"Best params: {best_params} | Best CV RMSE: {best_score:.6f}")

# Train final fold-level models with the best CV-found settings and average their test predictions
final_test_pred = np.zeros(len(test))
for fold, (train_idx, val_idx) in enumerate(kf.split(X, y), 1):
    X_tr, X_val = X.iloc[train_idx], X.iloc[val_idx]
    y_tr, y_val = y.iloc[train_idx], y.iloc[val_idx]

    final_model = CatBoostRegressor(
        **base_params,
        **best_params
    )

    final_model.fit(
        X_tr,
        y_tr,
        eval_set=(X_val, y_val),
        use_best_model=True,
        verbose=200
    )

    final_test_pred += final_model.predict(test) / kf.n_splits

# OOF validation metric
oof_rmse = root_mean_squared_error(y, best_oof)
print(f"Final OOF RMSE: {oof_rmse:.6f}")

# Submission
submission = pd.DataFrame({"median_house_value": final_test_pred})
submission.to_csv("submission.csv", index=False)
