full_cat_learner = full_cat_graph.skb.make_learner(fitted=True)

test_pred_lgbm = full_lgbm_learner.predict({"data": test_df}).astype(float)
test_pred_cat = full_cat_learner.predict({"data": test_df}).astype(float)

test_gap = np.abs(test_pred_lgbm - test_pred_cat)
test_close_blend = w_best * test_pred_lgbm + (1.0 - w_best) * test_pred_cat
test_final_prob = np.where(
    test_gap >= gap_cut_best,
    np.where(test_pred_lgbm > test_pred_cat, test_pred_lgbm, test_pred_cat),
    test_close_blend,
)
test_pred = (test_final_prob >= threshold_best).astype(bool)

submission = pd.DataFrame(
    {
