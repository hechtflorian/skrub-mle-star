import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.impute import SimpleImputer
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import RobustScaler
from sklearn.ensemble import HistGradientBoostingClassifier

try:
    import skrub.selectors as s
except Exception:
    s = None


def add_features(df: pd.DataFrame) -> pd.DataFrame:
    out = df.copy()

    out = out.replace(r"^\s*$", np.nan, regex=True)

    cabin = out["Cabin"].fillna("U/U/U").astype(str).str.split("/", expand=True)
    out["CabinPresent"] = out["Cabin"].notna().astype(int)
    out["Deck"] = cabin[0].fillna("U").astype(str)
    out["CabinKnownDeck"] = (out["Deck"].ne("U")).astype(int)
    out["Num"] = pd.to_numeric(cabin[1], errors="coerce")
    out["CabinNumBucket"] = pd.cut(
        out["Num"],
        bins=[-np.inf, 0, 100, 300, 600, np.inf],
        labels=["missing_or_zero", "small", "mid", "large", "very_large"],
    ).astype("object")
    out["Side"] = cabin[2].fillna("U").astype(str)

    spending_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    for c in spending_cols:
        out[c] = pd.to_numeric(out[c], errors="coerce").replace([np.inf, -np.inf], np.nan)

    out["Spending"] = out[spending_cols].fillna(0).sum(axis=1)
    out["HasSpending"] = (out["Spending"] > 0).astype(int)
    out["LuxurySpending"] = out[["Spa", "VRDeck"]].fillna(0).sum(axis=1)
    out["BasicSpending"] = out[["RoomService", "FoodCourt", "ShoppingMall"]].fillna(0).sum(axis=1)
    out["NoSpending"] = (out["Spending"] == 0).astype(int)

    out["Age"] = pd.to_numeric(out["Age"], errors="coerce")
    out["AgeGroup"] = pd.cut(
        out["Age"],
        bins=[-1, 12, 18, 30, 50, 120],
        labels=["child", "teen", "young_adult", "adult", "senior"],
    ).astype("object")

    passenger_group = out["PassengerId"].astype(str).str.split("_").str[0]
    passenger_group_size = passenger_group.map(passenger_group.value_counts(dropna=False))
    out["PassengerGroup"] = passenger_group
    out["FamilySize"] = passenger_group_size.fillna(1).astype(float)
    out["IsSolo"] = (out["FamilySize"] <= 1).astype(int)

    out["NameLength"] = out["Name"].fillna("").astype(str).str.len()
    out["Surname"] = out["Name"].fillna("").astype(str).str.split().str[-1]
    out["FamilyNameKey"] = (
        out["Surname"].fillna("Unknown").astype(str)
        + "_"
        + out["PassengerGroup"].fillna("Unknown").astype(str)
    )
    return out


def _numeric_routing_step():
    if s is None:
        return None
    return skrub.ApplyToCols(
        make_pipeline(
            SimpleImputer(strategy="median"),
            RobustScaler(with_centering=True, with_scaling=True, quantile_range=(10.0, 90.0)),
        ),
        cols=s.numeric(),
        allow_reject=True,
    )


def build_graph(data_train, variant="clean_routed"):
    if variant == "baseline":
        X = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
        y = data_train[target_col].skb.mark_as_y()
        vectorizer = skrub.TableVectorizer()
        model = HistGradientBoostingClassifier(
            learning_rate=0.05,
            max_depth=6,
            max_iter=180,
            min_samples_leaf=20,
            l2_regularization=0.0,
            random_state=42,
        )
        return X.skb.apply(vectorizer).skb.apply(model, y=y)

    data_fe = data_train.skb.apply_func(add_features)
    X = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_fe[target_col].skb.mark_as_y()

    if variant == "clean_routed":
        X = X.skb.apply(skrub.DropCols(cols=["FamilyNameKey", "PassengerGroup"]))
    elif variant == "clean_no_identity":
        X = X.skb.apply(skrub.DropCols(cols=["FamilyNameKey", "PassengerGroup", "Surname"]))

    numeric_step = _numeric_routing_step()
    if numeric_step is not None:
        X = X.skb.apply(numeric_step)

    vectorizer = skrub.TableVectorizer(
        low_cardinality=skrub.ToCategorical(),
        high_cardinality=skrub.StringEncoder(),
    )

    model = HistGradientBoostingClassifier(
        learning_rate=0.05,
        max_depth=6,
        max_iter=180,
        min_samples_leaf=20,
        l2_regularization=0.0,
        random_state=42,
    )
    return X.skb.apply(vectorizer).skb.apply(model, y=y)


def score_variant(name, variant, train_part, valid_part, target_col, metric_fn):
    data_train = skrub.var("data", train_part)
    pred = build_graph(data_train, variant=variant)
    learner = pred.skb.make_learner(fitted=True)
    valid_pred = learner.predict({"data": valid_part})
    score = metric_fn(valid_part[target_col], valid_pred)
    print(f"Ablation[{name}] {metric_fn.__name__}: {score}")
    return score


train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

scores = {}
scores["baseline"] = score_variant(
    "baseline", "baseline", train_part, valid_part, target_col, metric_fn
)
scores["clean_routed"] = score_variant(
    "clean_routed", "clean_routed", train_part, valid_part, target_col, metric_fn
)
scores["clean_no_identity"] = score_variant(
    "clean_no_identity", "clean_no_identity", train_part, valid_part, target_col, metric_fn
)

best_variant = min(scores, key=scores.get)
best_score = scores[best_variant]
print(f"Best ablation variant: {best_variant} | {metric_fn.__name__}: {best_score}")

final_validation_score = best_score
print(f"Final Validation Performance: {final_validation_score}")
