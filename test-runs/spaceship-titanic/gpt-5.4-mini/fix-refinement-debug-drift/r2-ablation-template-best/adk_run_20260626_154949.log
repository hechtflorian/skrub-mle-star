import os
import numpy as np
import pandas as pd
import skrub
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

# Load data
train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")

target_col = "Transported"

# Preserve the original split size/random state
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# Build a small, robust preprocessing function that handles mixed types
def preprocess_df(df):
    out = df.copy()

    # Cabin-derived features
    if "Cabin" in out.columns:
        cabin_split = out["Cabin"].astype("string").str.split("/", expand=True)
        out["CabinDeck"] = cabin_split[0]
        out["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
        out["CabinSide"] = cabin_split[2]
        out = out.drop(columns=["Cabin"], errors="ignore")

    # Name-derived feature
    if "Name" in out.columns:
        out["NameLen"] = out["Name"].astype("string").fillna("").str.len()
        out = out.drop(columns=["Name"], errors="ignore")

    # Basic family/group indicator from PassengerId
    if "PassengerId" in out.columns:
        out["PassengerGroup"] = out["PassengerId"].astype("string").str.split("_").str[0]
        out = out.drop(columns=["PassengerId"], errors="ignore")

    return out

def build_graph(data_train):
    X = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_train[target_col].skb.mark_as_y()

    # Keep backbone estimator class unchanged
    model = RandomForestClassifier(
        n_estimators=300,
        random_state=42,
        n_jobs=-1,
        max_features="sqrt",
    )

    # Encode mixed types safely before RandomForest
    X = X.skb.apply_func(preprocess_df)
    encoder = skrub.TableVectorizer()
    pred = X.skb.apply(encoder).skb.apply(model, y=y)
    return pred

# Honest holdout validation: bind train_part only
data_train = skrub.var("data", train_part)
pred = build_graph(data_train)
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

# If predictions are probabilities, threshold them; otherwise use labels directly
valid_pred_arr = np.asarray(valid_pred)
if valid_pred_arr.dtype.kind in {"f", "c"}:
    valid_pred_labels = valid_pred_arr >= 0.5
else:
    valid_pred_labels = valid_pred_arr

# Convert to boolean to match target
valid_pred_labels = pd.Series(valid_pred_labels).astype(bool)

final_validation_score = accuracy_score(valid_part[target_col].astype(bool), valid_pred_labels)
print(f"Final Validation Performance: {final_validation_score}")
```
