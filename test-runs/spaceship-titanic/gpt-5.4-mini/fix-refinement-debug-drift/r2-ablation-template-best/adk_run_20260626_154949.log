import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.ensemble import RandomForestClassifier
from sklearn.impute import SimpleImputer
from sklearn.pipeline import make_pipeline

INPUT_DIR = "./input"
train_df = pd.read_csv(os.path.join(INPUT_DIR, "train.csv"))
test_df = pd.read_csv(os.path.join(INPUT_DIR, "test.csv"))
target_col = "Transported"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

lgbm_graph = X_train.skb.apply(
    make_pipeline(SimpleImputer(strategy="median"), RandomForestClassifier(
        n_estimators=300,
        max_depth=None,
        random_state=42,
        n_jobs=-1,
    )),
    y=y_train,
)

cat_graph = X_train.skb.apply(
    make_pipeline(SimpleImputer(strategy="most_frequent"), RandomForestClassifier(
        n_estimators=300,
        max_depth=None,
        random_state=42,
        n_jobs=-1,
    )),
    y=y_train,
)

lgbm_learner = lgbm_graph.skb.make_learner(fitted=True)
cat_learner = cat_graph.skb.make_learner(fitted=True)

lgbm_pred = np.asarray(lgbm_learner.predict({"data": valid_part}))
cat_pred = np.asarray(cat_learner.predict({"data": valid_part}))

pred = (lgbm_pred.astype(float) + cat_pred.astype(float)) / 2.0
final_pred = pred >= 0.5
final_validation_score = accuracy_score(valid_part[target_col], final_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
