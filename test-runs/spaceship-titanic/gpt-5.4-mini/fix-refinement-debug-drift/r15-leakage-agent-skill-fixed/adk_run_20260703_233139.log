import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

random_state = 42
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def preprocess(df):
    df = df.copy()

    cabin_split = df["Cabin"].astype("string").str.split("/", expand=True)
    if cabin_split.shape[1] == 3:
        df["Deck"] = cabin_split[0]
        df["Num"] = cabin_split[1]
        df["Side"] = cabin_split[2]
    else:
        df["Deck"] = np.nan
        df["Num"] = np.nan
        df["Side"] = np.nan

    name_split = df["Name"].astype("string").str.split(" ", n=1, expand=True)
    if name_split.shape[1] == 2:
        df["First"] = name_split[0]
        df["Last"] = name_split[1]
    else:
        df["First"] = np.nan
        df["Last"] = np.nan

    for c in ["HomePlanet", "CryoSleep", "Destination", "VIP", "Deck", "Side", "First", "Last"]:
        if c in df.columns:
            df[c] = df[c].fillna("Missing").astype(str)

    if "Num" in df.columns:
        df["Num"] = pd.to_numeric(df["Num"], errors="coerce").fillna(0)

    for c in ["Age", "RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]:
        if c in df.columns:
            df[c] = pd.to_numeric(df[c], errors="coerce").fillna(0)

    if "Cabin" in df.columns:
        df = df.drop(columns=["Cabin"])
    if "Name" in df.columns:
        df = df.drop(columns=["Name"])
    if "PassengerId" in df.columns:
        df = df.drop(columns=["PassengerId"])
    return df

data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(preprocess)

X_train = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

catboost_model = CatBoostClassifier(
    loss_function="Logloss",
    eval_metric="Accuracy",
    iterations=3000,
    depth=6,
    learning_rate=0.03,
    random_seed=random_state,
    verbose=0,
)

pred = X_train.skb.apply(catboost_model, y=y_train)
val_learner = pred.skb.make_learner(fitted=True)

valid_pred = np.asarray(val_learner.predict({"data": valid_part})).ravel()
if valid_pred.dtype != np.int64 and valid_pred.dtype != np.int32 and valid_pred.dtype != np.bool_:
    valid_pred = (valid_pred > 0.5).astype(int)
else:
    valid_pred = valid_pred.astype(int)

y_valid = valid_part[target_col].astype(int).to_numpy()
final_validation_score = accuracy_score(y_valid, valid_pred)

print(f"Final Validation Performance: {final_validation_score}")
