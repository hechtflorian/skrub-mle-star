data_train = skrub.var("data", train_part)

def feature_engineering(df):
    df = df.copy()

    # Robust cabin parsing + low-cost derived structure features
    cabin_raw = df["Cabin"].astype("string").fillna("")
    cabin_split = cabin_raw.str.split("/", n=2, expand=True)

    if cabin_split.shape[1] == 3:
        df["CabinDeck"] = cabin_split[0].replace("", np.nan)
        df["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
        df["CabinSide"] = cabin_split[2].replace("", np.nan)
    else:
        df["CabinDeck"] = np.nan
        df["CabinNum"] = np.nan
        df["CabinSide"] = np.nan

    df["CabinIsMissing"] = cabin_raw.eq("").astype("int8")
    df["CabinNumMissing"] = df["CabinNum"].isna().astype("int8")
    df["CabinNumMod2"] = (df["CabinNum"] % 2).fillna(-1).astype("float32")
    df["CabinNumLog1p"] = np.log1p(df["CabinNum"].clip(lower=0)).replace([np.inf, -np.inf], np.nan)

    # PassengerId structure features
    passenger_id = df["PassengerId"].astype("string").fillna("")
    pid_num = pd.to_numeric(passenger_id, errors="coerce")
    df["PassengerGroup"] = passenger_id.str.split("_", n=1).str[0].replace("", np.nan)
    df["PassengerNumber"] = pid_num
    df["PassengerGroupSizeHint"] = passenger_id.str.split("_", n=1).str[0].map(
        passenger_id.str.split("_", n=1).str[0].value_counts(dropna=False)
    ).astype("float32")
    df["PassengerNumberMod5"] = (pid_num % 5).fillna(-1).astype("float32")

    # Name structure features while preserving the raw Name column
    name = df["Name"].astype("string").fillna("")
    df["NameLength"] = name.str.len().astype("float32")
    df["NameWordCount"] = name.str.split().map(len).astype("float32")
    df["NameHasTitle"] = name.str.contains(r"\b(Mr|Mrs|Miss|Master|Dr|Rev|Col|Major|Capt|Sir|Mme|Mlle|Lady|Countess|Don|Dona|Jonkheer)\b", regex=True, na=False).astype("int8")
    df["NameHasComma"] = name.str.contains(",", na=False).astype("int8")
    df["NameHasDot"] = name.str.contains(r"\.", regex=True, na=False).astype("int8")

    # Small interaction between cabin and passenger structure
    if "CabinNum" in df.columns:
        df["CabinDeck_CabinSide"] = (
            df["CabinDeck"].astype("string").fillna("NA") + "_" + df["CabinSide"].astype("string").fillna("NA")
        )
    else:
        df["CabinDeck_CabinSide"] = np.nan

    return df

data_train = data_train.skb.apply_func(feature_engineering)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

vectorizer_cat = skrub.TableVectorizer()
vectorizer_lgbm = skrub.TableVectorizer()

model_cat = CatBoostClassifier(
    iterations=300,
    learning_rate=0.05,
    depth=6,
    loss_function="Logloss",
    random_seed=random_state,
    verbose=0,
)

model_lgbm = LGBMClassifier(
    n_estimators=300,
    learning_rate=0.05,
    num_leaves=31,
    random_state=random_state,
    n_jobs=1,
    verbose=-1,
)

pred_cat = X_train.skb.apply(vectorizer_cat).skb.apply(model_cat, y=y_train)
pred_lgbm = X_train.skb.apply(vectorizer_lgbm).skb.apply(model_lgbm, y=y_train)

learner_cat = pred_cat.skb.make_learner(fitted=True)
learner_lgbm = pred_lgbm.skb.make_learner(fitted=True)

def get_pred(learner, df):
    try:
        proba = learner.predict_proba({"data": df})
        proba = np.asarray(proba)
        if proba.ndim == 2 and proba.shape[1] > 1:
            return proba[:, 1]
        return proba.ravel()
    except Exception:
        pred = learner.predict({"data": df})
        pred = np.asarray(pred)
        if pred.dtype == bool:
            return pred.astype(int)
        return pred.ravel()

cat_valid_raw = get_pred(learner_cat, valid_part)
lgbm_valid_raw = get_pred(learner_lgbm, valid_part)

valid_pred = 0.5 * cat_valid_raw + 0.5 * lgbm_valid_raw
valid_pred = valid_pred >= 0.5

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
