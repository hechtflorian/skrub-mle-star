import pandas as pd
import skrub
from lightgbm import LGBMClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

random_state = 42
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col],
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def feature_engineering(df):
    df = df.copy()
    cabin = df["Cabin"].astype("string").str.split("/", expand=True)
    df["Deck"] = cabin[0]
    df["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
    df["Side"] = cabin[2]

    name = df["Name"].astype("string").str.split(" ", n=1, expand=True)
    df["FirstName"] = name[0]
    df["LastName"] = name[1]

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    spend = df[spend_cols].fillna(0)
    df["TotalSpend"] = spend.sum(axis=1)
    df["MeanSpend"] = spend.mean(axis=1)
    df["HasSpend"] = (df["TotalSpend"] > 0).astype(int)
    df["AgeBin"] = pd.cut(
        df["Age"],
        bins=[-np.inf, 12, 18, 25, 35, 50, 65, np.inf],
        labels=["child", "teen", "young", "adult", "mid", "senior", "elder"],
    )
    return df

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

X_train_fe = X_train.skb.apply_func(feature_engineering)

vectorizer = skrub.TableVectorizer(
    low_cardinality="passthrough",
    high_cardinality=skrub.StringEncoder(),
)

model = LGBMClassifier(
    n_estimators=3000,
    learning_rate=0.03,
    num_leaves=31,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=random_state,
    n_jobs=-1,
    verbose=-1,
)

pred = X_train_fe.skb.apply(vectorizer).skb.apply(model, y=y_train)
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred).astype(bool)

final_validation_score = accuracy_score(valid_part[target_col].astype(bool), valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
