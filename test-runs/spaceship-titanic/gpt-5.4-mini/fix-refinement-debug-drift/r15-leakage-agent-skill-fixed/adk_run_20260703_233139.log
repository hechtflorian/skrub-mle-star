        cabin_num = pd.Series(np.nan, index=df.index, dtype="float64")
        cabin_side = pd.Series(np.nan, index=df.index, dtype="object")

    df["CabinDeck"] = cabin_deck
    df["CabinNum"] = cabin_num
    df["CabinSide"] = cabin_side

    df["CabinIsMissing"] = cabin_raw.eq("").astype("int8")
    df["CabinNumMissing"] = cabin_num.isna().astype("int8")
    df["CabinNumMod2"] = (cabin_num % 2).astype("float32")
    df["CabinNumMod5"] = (cabin_num % 5).astype("float32")
    df["CabinNumLog1p"] = np.log1p(cabin_num.clip(lower=0)).replace([np.inf, -np.inf], np.nan)

    # PassengerId structure features
    passenger_id = df["PassengerId"].astype("string").fillna("")
    pid_split = passenger_id.str.split("_", n=1, expand=True)
    if pid_split.shape[1] == 2:
        pid_group = pid_split[0].replace("", np.nan)
        pid_num_raw = pd.to_numeric(pid_split[1], errors="coerce")
    else:
        pid_group = pd.Series(np.nan, index=df.index, dtype="object")
        pid_num_raw = pd.Series(np.nan, index=df.index, dtype="float64")

    df["PassengerGroup"] = pid_group
    df["PassengerNumber"] = pid_num_raw
    df["PassengerNumberMod2"] = (pid_num_raw % 2).astype("float32")
    df["PassengerNumberMod5"] = (pid_num_raw % 5).astype("float32")
    df["PassengerIdHasSeparator"] = passenger_id.str.contains("_", na=False).astype("int8")

    group_sizes = pid_group.map(pid_group.value_counts(dropna=False)).astype("float32")
    df["PassengerGroupSizeHint"] = group_sizes

    # Name structure features while preserving the raw Name column
    name = df["Name"].astype("string").fillna("")
    df["NameLength"] = name.str.len().astype("float32")
    df["NameWordCount"] = name.str.split().map(lambda x: len(x) if isinstance(x, list) else 0).astype("float32")
