import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

random_state = 42
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def preprocess(df):
    out = df.copy()

    cabin_split = out["Cabin"].astype(str).str.split("/", expand=True)
    if cabin_split.shape[1] >= 3:
        out["Deck"] = cabin_split[0]
        out["CabinNum"] = cabin_split[1]
        out["Side"] = cabin_split[2]
    else:
        out["Deck"] = np.nan
        out["CabinNum"] = np.nan
        out["Side"] = np.nan

    name_split = out["Name"].astype(str).str.split(" ", n=1, expand=True)
    if name_split.shape[1] >= 2:
        out["FirstName"] = name_split[0]
        out["LastName"] = name_split[1]
    else:
        out["FirstName"] = np.nan
        out["LastName"] = np.nan

    out["Group"] = out["PassengerId"].astype(str).str.split("_").str[0]
    out["GroupSize"] = out.groupby("Group")["PassengerId"].transform("count")
    out["CabinDeckSide"] = out["Deck"].astype(str) + "_" + out["Side"].astype(str)
    out["TotalSpend"] = out[["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]].fillna(0).sum(axis=1)
    out["NoSpend"] = (out["TotalSpend"] == 0).astype(int)
    out["AgeBin"] = pd.cut(out["Age"], bins=[-1, 12, 18, 25, 35, 50, 80, 200], labels=False)
    out["Solo"] = (out["GroupSize"] == 1).astype(int)

    cat_cols = ["HomePlanet", "CryoSleep", "Destination", "VIP", "Deck", "Side", "FirstName", "LastName", "Group", "CabinDeckSide"]
    for c in cat_cols:
        out[c] = out[c].fillna("Missing").astype(str)

    num_cols = ["Age", "RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck", "CabinNum", "GroupSize", "TotalSpend", "NoSpend", "AgeBin", "Solo"]
    for c in num_cols:
        out[c] = pd.to_numeric(out[c], errors="coerce").fillna(0)

    return out.drop(columns=["PassengerId", "Cabin", "Name"], errors="ignore")

data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(preprocess)

X_train = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

catboost_model = CatBoostClassifier(
    loss_function="Logloss",
    eval_metric="Accuracy",
    iterations=1200,
    depth=6,
    learning_rate=0.03,
    random_seed=random_state,
    verbose=0
)

pred = X_train.skb.apply(catboost_model, y=y_train)
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = np.asarray(val_learner.predict({"data": valid_part})).ravel().astype(int)

final_validation_score = accuracy_score(valid_part[target_col].astype(int), valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
