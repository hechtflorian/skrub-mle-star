    df["NameLength"] = df["Name"].fillna("").astype(str).str.len()
    df["IsMinor"] = (pd.to_numeric(df["Age"], errors="coerce") < 18).astype(float)
    return df.drop(columns=["PassengerId", "Name", "Cabin"], errors="ignore")

