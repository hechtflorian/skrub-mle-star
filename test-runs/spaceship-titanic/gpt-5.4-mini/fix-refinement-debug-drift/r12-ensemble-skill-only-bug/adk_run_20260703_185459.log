import os
import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

random_state = 42

train_path = "./input/train.csv"
test_path = "./input/test.csv"

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "Transported"

def add_features(df):
    out = df.copy()
    cabin = out["Cabin"].fillna("U/U/U").astype(str).str.split("/", expand=True)
    out["Deck"] = cabin[0]
    out["Num"] = pd.to_numeric(cabin[1], errors="coerce")
    out["Side"] = cabin[2]

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out["Spending"] = out[spend_cols].fillna(0).sum(axis=1)
    out["NoSpending"] = (out["Spending"] == 0).astype(int)

    out["Age"] = pd.to_numeric(out["Age"], errors="coerce")
    out["AgeBin"] = pd.cut(
        out["Age"],
        bins=[-1, 12, 18, 25, 35, 50, 65, 200],
        labels=["child", "teen", "young_adult", "adult", "mid_age", "senior", "elder"],
    ).astype("string")

    out["RoomService_log"] = np.log1p(pd.to_numeric(out["RoomService"], errors="coerce").fillna(0))
    out["FoodCourt_log"] = np.log1p(pd.to_numeric(out["FoodCourt"], errors="coerce").fillna(0))
    out["ShoppingMall_log"] = np.log1p(pd.to_numeric(out["ShoppingMall"], errors="coerce").fillna(0))
    out["Spa_log"] = np.log1p(pd.to_numeric(out["Spa"], errors="coerce").fillna(0))
    out["VRDeck_log"] = np.log1p(pd.to_numeric(out["VRDeck"], errors="coerce").fillna(0))

    out["HomePlanet"] = out["HomePlanet"].astype("string")
    out["CryoSleep"] = out["CryoSleep"].astype("string")
    out["Destination"] = out["Destination"].astype("string")
    out["VIP"] = out["VIP"].astype("string")
    out["Deck"] = out["Deck"].astype("string")
    out["Side"] = out["Side"].astype("string")
    out["AgeBin"] = out["AgeBin"].astype("string")
    return out

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(add_features)

X_train = data_train_fe.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer(
    low_cardinality="passthrough",
    high_cardinality=skrub.StringEncoder(),
)

clf = CatBoostClassifier(
    loss_function="Logloss",
    iterations=800,
    depth=6,
    learning_rate=0.05,
    random_seed=random_state,
    verbose=0,
    allow_writing_files=False,
)

pred_graph = X_train.skb.apply(vectorizer).skb.apply(clf, y=y_train)
val_learner = pred_graph.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

final_validation_score = accuracy_score(valid_part[target_col].astype(int), valid_pred.astype(int))
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
data_full_fe = data_full.skb.apply_func(add_features)
X_full = data_full_fe.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y_full = data_full_fe[target_col].skb.mark_as_y()

full_pred_graph = X_full.skb.apply(vectorizer).skb.apply(clf, y=y_full)
full_learner = full_pred_graph.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df})

submission = pd.DataFrame(
    {
        "PassengerId": test_df["PassengerId"],
        "Transported": test_pred.astype(bool),
    }
)
submission.to_csv("submission.csv", index=False)
```
