def prep_columns(df):
    out = df.copy()

    def _extract_name_parts(name_series):
        s = name_series.astype("string")

        # Surname: token before comma if present, else first token
        surname = s.str.extract(r"^\s*([^,]+)", expand=False)
        fallback_surname = s.str.split().str[0]
        surname = surname.fillna(fallback_surname)

        # Title: common Titanic-like title between comma and period
        title = s.str.extract(r",\s*([^\.]+)\.", expand=False)
        title = title.fillna("Unknown")

        # Safer text cues
        name_length = s.str.len()
        name_tokens = s.str.split().str.len()
        has_parentheses = s.str.contains(r"\(", regex=True, na=False).astype(float)
        has_quotes = s.str.contains(r"['\"]", regex=True, na=False).astype(float)

        return surname, title, name_length, name_tokens, has_parentheses, has_quotes

    if "Cabin" in out.columns:
        cabin_parts = out["Cabin"].astype("string").str.split("/", expand=True)
        out["CabinDeck"] = cabin_parts[0]
        out["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        out["CabinSide"] = cabin_parts[2]
        out = out.drop(columns=["Cabin"])

    if "Name" in out.columns:
        (
            out["NameSurname"],
            out["NameTitle"],
            out["NameLength"],
            out["NameTokens"],
            out["NameHasParentheses"],
            out["NameHasQuotes"],
        ) = _extract_name_parts(out["Name"])
        out = out.drop(columns=["Name"])

    bool_cols = [c for c in ["CryoSleep", "VIP"] if c in out.columns]
    for c in bool_cols:
        out[c] = out[c].astype("string").map({"True": 1, "False": 0}).astype(float)

    if "PassengerId" in out.columns:
        pid = out["PassengerId"].astype("string").str.split("_", expand=True)
        out["Group"] = pid[0]
        out["Person"] = pid[1]

    return out
```
