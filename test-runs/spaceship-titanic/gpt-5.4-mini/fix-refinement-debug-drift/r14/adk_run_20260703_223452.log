import os
import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

random_state = 42
target_col = "Transported"

train_path = "./input/train.csv"
test_path = "./input/test.csv"
if not os.path.exists(train_path):
    train_path = "./train.csv"
if not os.path.exists(test_path):
    test_path = "./test.csv"

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

def fe_func(df):
    out = df.copy()
    cabin = out["Cabin"].fillna("X/0/X").astype(str).str.split("/", expand=True)
    out["Deck"] = cabin[0]
    out["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
    out["Side"] = cabin[2]
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out["TotalSpent"] = out[spend_cols].fillna(0).sum(axis=1)
    out["IsAloneSpend"] = (out["TotalSpent"] == 0).astype(int)
    out["HasCabin"] = out["Cabin"].notna().astype(int)
    out["NameLen"] = out["Name"].fillna("").astype(str).str.len()
    return out

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state, stratify=train_df[target_col].astype(int)
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

X_proc = X_train.skb.apply_func(fe_func)

cat_cols = ["HomePlanet", "CryoSleep", "Destination", "VIP", "Deck", "Side"]
num_cols = ["Age", "RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck", "CabinNum", "TotalSpent", "IsAloneSpend", "HasCabin", "NameLen"]

def catboost_prep(df):
    out = df.copy()
    for c in cat_cols:
        out[c] = out[c].astype("string").fillna("missing")
    for c in num_cols:
        out[c] = pd.to_numeric(out[c], errors="coerce")
    return out

X_proc = X_proc.skb.apply_func(catboost_prep)

model = CatBoostClassifier(
    iterations=1500,
    depth=7,
    learning_rate=0.03,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=random_state,
)

pred_chain = X_proc.skb.apply(model, y=y_train)
learner = pred_chain.skb.make_learner(fitted=True)
valid_pred = learner.predict({"data": valid_part}).astype(int)

final_validation_score = accuracy_score(valid_part[target_col].astype(int), valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
