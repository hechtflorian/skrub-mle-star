import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score

data_train = skrub.var("data", train_part)

def add_titanic_features(df):
    out = df.copy()

    # Cabin expansion: deck / number / side
    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin_parts = cabin.str.extract(
            r"^\s*([A-Za-z]?)(\d*)([A-Za-z]?)\s*$", expand=True
        )
        out["deck"] = cabin_parts[0].replace("", pd.NA)
        out["number"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        out["side"] = cabin_parts[2].replace("", pd.NA)
        out = out.drop(columns=["Cabin"])

    # Family / group signals
    if "SibSp" in out.columns and "Parch" in out.columns:
        group_size = out["SibSp"].fillna(0) + out["Parch"].fillna(0) + 1
        out["group_size"] = group_size
        out["is_alone"] = (group_size == 1).astype(int)

    # Spending aggregates
    expense_cols = [c for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if c in out.columns]
    if expense_cols:
        spend = out[expense_cols].apply(pd.to_numeric, errors="coerce").fillna(0.0)
        out["total_spend"] = spend.sum(axis=1)
        out["spent_any"] = (out["total_spend"] > 0).astype(int)

    return out

data_fe = data_train.skb.apply_func(add_titanic_features)

# Keep PassengerId out of the model, while leaving the expanded Cabin-derived features in place.
X_train = data_fe.drop(columns=[target_col, "PassengerId"], errors="ignore").skb.mark_as_X()
y_train = data_fe[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer(
    low_cardinality=skrub.ToCategorical(),
    high_cardinality=skrub.StringEncoder(),
)

model = CatBoostClassifier(
    iterations=300,
    depth=6,
    learning_rate=0.05,
    loss_function="Logloss",
    eval_metric="Accuracy",
    random_seed=random_state,
    verbose=0,
)

pred_chain = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

val_learner = pred_chain.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

valid_pred = np.asarray(valid_pred)
if valid_pred.dtype != bool:
    unique_vals = set(np.unique(valid_pred).tolist())
    if unique_vals <= {0, 1}:
        valid_pred = valid_pred.astype(int).astype(bool)
    else:
        valid_pred = pd.Series(valid_pred).astype(str).isin(["True", "true", "1"]).to_numpy()

final_validation_score = accuracy_score(valid_part[target_col].values, valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
