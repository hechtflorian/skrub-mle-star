valid_part = train_df.iloc[valid_idx].copy()


def fe_func(df):
    out = df.copy()

    # Drop noisy name field early if present.
    if "Name" in out.columns:
        out = out.drop(columns=["Name"])

    # Parse Cabin into structured features.
    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin_missing = cabin.isna() | (cabin.fillna("").str.strip() == "")
        cabin_clean = cabin.fillna("").astype(str).str.strip()

        parts = cabin_clean.str.split(r"\s+", n=1, expand=True)
        cabin_first = parts[0].replace("", np.nan)

        deck = cabin_first.str.extract(r"^([A-Za-z]+)", expand=False)
        cabin_num = cabin_first.str.extract(r"([0-9]+)", expand=False)
        cabin_side = cabin_first.str.extract(r"([A-Za-z])$", expand=False)

        out["CabinDeck"] = deck.fillna("Unknown")
        out["CabinNum"] = pd.to_numeric(cabin_num, errors="coerce")
        out["CabinSide"] = cabin_side.fillna("Unknown")
        out["CabinMissing"] = cabin_missing.astype("int8")

        out = out.drop(columns=["Cabin"])

    # Age buckets are useful but keep them as categorical for downstream encoding.
    if "AgeGroup" not in out.columns and "Age" in out.columns:
        out["AgeGroup"] = pd.cut(
            out["Age"],
            bins=[-np.inf, 12, 18, 30, 50, np.inf],
            labels=["Child", "Teen", "YoungAdult", "Adult", "Senior"],
        )

    # Light numeric cleaning: clip heavy tails, normalize infinities, and keep missingness intact.
    numeric_cols = out.select_dtypes(include=[np.number]).columns
    for col in numeric_cols:
        s = pd.to_numeric(out[col], errors="coerce")
        finite = s.replace([np.inf, -np.inf], np.nan)
        if finite.notna().any():
            lo = finite.quantile(0.01)
            hi = finite.quantile(0.99)
            if pd.notna(lo) and pd.notna(hi):
                out[col] = finite.clip(lo, hi)
            else:
                out[col] = finite
        else:
            out[col] = finite

    return out


data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(fe_func)

X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_fe[target_col].skb.mark_as_y()

