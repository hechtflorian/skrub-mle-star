import os
import glob
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from lightgbm import LGBMClassifier

random_state = 42
target_col = "Transported"

train_path = glob.glob(os.path.join("./input", "train.csv"))[0]
train_df = pd.read_csv(train_path)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def add_features(df):
    out = df.copy()

    if "Cabin" in out.columns:
        cabin_parts = out["Cabin"].astype("string").str.split("/", expand=True)
        if cabin_parts.shape[1] >= 3:
            out["CabinDeck"] = cabin_parts[0]
            out["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
            out["CabinSide"] = cabin_parts[2]
        else:
            out["CabinDeck"] = pd.NA
            out["CabinNum"] = pd.NA
            out["CabinSide"] = pd.NA

    if "Name" in out.columns:
        out["LastName"] = out["Name"].astype("string").str.split().str[-1]
        out["NameLength"] = out["Name"].astype("string").str.len()

    if "Age" in out.columns:
        out["AgeGroup"] = pd.cut(
            out["Age"],
            bins=[-np.inf, 12, 18, 30, 50, np.inf],
            labels=["Child", "Teen", "YoungAdult", "Adult", "Senior"],
        )

    spend_cols = [c for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if c in out.columns]
    if spend_cols:
        spend = out[spend_cols].apply(pd.to_numeric, errors="coerce").fillna(0.0)
        out["TotalSpending"] = spend.sum(axis=1)
        out["NoSpending"] = (out["TotalSpending"] == 0).astype(int)
        out["SpendingStd"] = spend.std(axis=1).fillna(0.0)

    if "Age" in out.columns and "TotalSpending" in out.columns:
        out["SpendingPerAge"] = (out["TotalSpending"] / out["Age"].replace(0, np.nan)).replace(
            [np.inf, -np.inf], np.nan
        ).fillna(0.0)

    return out

data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(add_features)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

X_vec = X_train.skb.apply(skrub.TableVectorizer())

model = LGBMClassifier(
    n_estimators=800,
    learning_rate=0.03,
    num_leaves=31,
    subsample=0.9,
    colsample_bytree=0.8,
    random_state=random_state,
    n_jobs=-1,
)

pred = X_vec.skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
valid_pred_arr = np.asarray(valid_pred).reshape(-1)

if valid_pred_arr.dtype == bool:
    valid_pred_labels = valid_pred_arr
else:
    valid_pred_labels = valid_pred_arr >= 0.5

final_validation_score = accuracy_score(valid_part[target_col].astype(bool), valid_pred_labels.astype(bool))
print(f"Final Validation Performance: {final_validation_score}")
```
