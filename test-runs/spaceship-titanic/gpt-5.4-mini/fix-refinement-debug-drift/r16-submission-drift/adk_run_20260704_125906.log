        cols=skrub.selectors.numeric(),
    )
)

predictor = X_model.skb.apply(vectorizer).skb.apply(
    HistGradientBoostingClassifier(
        learning_rate=0.05,
        max_depth=6,
        max_leaf_nodes=31,
        min_samples_leaf=20,
