def fe_func(df):
    out = df.copy()

    # Cabin parsing block
    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin_missing = cabin.isna() | cabin.str.strip().eq("") | cabin.str.lower().isin(["nan", "none", "null"])
        cabin_clean = cabin.fillna("").astype(str).str.strip()

        out["CabinMissing"] = cabin_missing.astype("int8")

        cabin_split = cabin_clean.str.split("/", n=2, expand=True)
        out["CabinDeck"] = cabin_split[0].replace("", np.nan)
        if cabin_split.shape[1] > 1:
            out["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
        else:
            out["CabinNum"] = np.nan
        if cabin_split.shape[1] > 2:
            out["CabinSide"] = cabin_split[2].replace("", np.nan)
        else:
            out["CabinSide"] = np.nan

        # Fallback for common Titanic-style cabin format: Deck/Number/Side may be embedded differently.
        if out["CabinDeck"].isna().all():
            deck = cabin_clean.str.extract(r"^\s*([A-Za-z]+)", expand=False)
            num = cabin_clean.str.extract(r"(\d+)", expand=False)
            side = cabin_clean.str.extract(r"([PS])\s*$", expand=False)
            out["CabinDeck"] = deck
            out["CabinNum"] = pd.to_numeric(num, errors="coerce")
            out["CabinSide"] = side

    # Drop name as planned; retain noisiest free-text column removal.
    if "Name" in out.columns:
        out = out.drop(columns=["Name"])

    # Light numeric cleaning / outlier stabilization
    numeric_cols = out.select_dtypes(include=[np.number]).columns
    for col in numeric_cols:
        if col == target_col:
            continue
        s = out[col]
        if s.notna().any():
            lo = s.quantile(0.01)
            hi = s.quantile(0.99)
