import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from catboost import CatBoostClassifier

random_state = 42
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col].astype(int),
)

train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def preprocess(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()

    if "PassengerId" in df.columns:
        pid = df["PassengerId"].astype(str)
        grp = pid.str.split("_").str[0]
        num = pid.str.split("_").str[1].astype(float)
        df["PassengerGroup"] = grp
        df["PassengerNum"] = num
    else:
        df["PassengerGroup"] = "missing"
        df["PassengerNum"] = np.nan

    if "Cabin" in df.columns:
        cabin_parts = df["Cabin"].astype(str).str.split("/", expand=True)
        df["CabinDeck"] = cabin_parts[0]
        df["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        df["CabinSide"] = cabin_parts[2]
    else:
        df["CabinDeck"] = "missing"
        df["CabinNum"] = np.nan
        df["CabinSide"] = "missing"

    for col in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")
        else:
            df[col] = np.nan

    df["TotalSpend"] = df[["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]].sum(axis=1)
    df["NoSpend"] = (df["TotalSpend"].fillna(0) == 0).astype(int)

    if "Age" in df.columns:
        df["AgeGroup"] = pd.cut(
            df["Age"],
            bins=[-1, 12, 18, 30, 45, 60, 120],
            labels=["child", "teen", "young_adult", "adult", "mid", "senior"],
        ).astype(str)
    else:
        df["AgeGroup"] = "missing"

    if {"Age", "NoSpend"}.issubset(df.columns):
        df["Age_NoSpend"] = df["Age"].fillna(df["Age"].median()) * df["NoSpend"]

    if {"CryoSleep", "TotalSpend"}.issubset(df.columns):
        df["CryoSpendMismatch"] = (
            (df["CryoSleep"].astype(str).str.lower() == "true") & (df["TotalSpend"].fillna(0) > 0)
        ).astype(int)

    if {"HomePlanet", "Destination"}.issubset(df.columns):
        df["Route"] = df["HomePlanet"].astype(str) + "_" + df["Destination"].astype(str)

    for col in df.columns:
        if col == target_col:
            continue
        if df[col].dtype == "object":
            df[col] = df[col].fillna("missing")
        else:
            df[col] = df[col].fillna(df[col].median())

    return df

train_part = preprocess(train_part)
valid_part = preprocess(valid_part)

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

cat_cols = X_train.data.select_dtypes(include=["object", "category", "bool"]).columns.tolist()

model = CatBoostClassifier(
    iterations=1200,
    learning_rate=0.03,
    depth=6,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=random_state,
    allow_writing_files=False,
)

pred_graph = X_train.skb.apply(model, y=y_train)

learner = pred_graph.skb.make_learner(fitted=True)
valid_features = valid_part.drop(columns=[target_col], errors="ignore")
valid_pred = learner.predict({"data": valid_features})

if hasattr(valid_pred, "astype"):
    valid_pred = np.asarray(valid_pred).ravel()
else:
    valid_pred = np.asarray(valid_pred).ravel()

valid_pred_bool = valid_pred.astype(int).astype(bool)
final_validation_score = accuracy_score(valid_part[target_col].astype(bool), valid_pred_bool)

print(f"Final Validation Performance: {final_validation_score}")
```
