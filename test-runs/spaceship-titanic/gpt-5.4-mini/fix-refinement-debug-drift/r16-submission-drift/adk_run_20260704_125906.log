import os
import glob
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.impute import SimpleImputer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OrdinalEncoder
from catboost import CatBoostClassifier
from lightgbm import LGBMClassifier

random_state = 42
target_col = "Transported"

train_path = glob.glob(os.path.join("./input", "train.csv"))[0]
train_df = pd.read_csv(train_path)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# Shared feature engineering kept simple and DataOps-friendly
def preprocess(df):
    df = df.copy()

    if "AgeGroup" not in df.columns and "Age" in df.columns:
        df["AgeGroup"] = pd.cut(
            df["Age"],
            bins=[-np.inf, 12, 18, 30, 50, np.inf],
            labels=["Child", "Teen", "YoungAdult", "Adult", "Senior"],
        )

    if "Cabin" in df.columns:
        cabin_split = df["Cabin"].astype("string").str.split("/", expand=True)
        if cabin_split.shape[1] >= 3:
            df["CabinDeck"] = cabin_split[0]
            df["CabinNum"] = cabin_split[1]
            df["CabinSide"] = cabin_split[2]
        else:
            df["CabinDeck"] = np.nan
            df["CabinNum"] = np.nan
            df["CabinSide"] = np.nan

    if "Name" in df.columns:
        df["NameLength"] = df["Name"].astype("string").str.len()
        df["Surname"] = df["Name"].astype("string").str.split().str[-1]

    if {"RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"}.issubset(df.columns):
        df["TotalSpend"] = df[["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]].sum(axis=1)

    for col in df.columns:
        if col == target_col:
            continue
        if pd.api.types.is_numeric_dtype(df[col]):
            df[col] = df[col].fillna(df[col].median())
        else:
            mode_vals = df[col].mode(dropna=True)
            df[col] = df[col].fillna(mode_vals.iloc[0] if not mode_vals.empty else "Unknown")

    for col in df.columns:
        if pd.api.types.is_categorical_dtype(df[col]) or df[col].dtype == object:
            df[col] = df[col].astype("category").cat.codes.replace(-1, np.nan)

    return df

data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(preprocess)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Model leg 1: CatBoost backbone
cat_model = CatBoostClassifier(
    iterations=300,
    depth=6,
    learning_rate=0.08,
    loss_function="Logloss",
    random_seed=random_state,
    verbose=0,
)

# Model leg 2: reference solution-style sklearn preprocessing + LightGBM
lgbm_model = Pipeline(
    steps=[
        ("imputer", SimpleImputer(strategy="most_frequent")),
        ("encoder", OrdinalEncoder(handle_unknown="use_encoded_value", unknown_value=-1)),
        ("clf", LGBMClassifier(
            n_estimators=300,
            learning_rate=0.05,
            num_leaves=31,
            random_state=random_state,
            n_jobs=-1,
            verbose=-1,
        )),
    ]
)

# Keep DataOps main workflow with two legs and blend predictions
pred_cat = X_train.skb.apply(cat_model, y=y_train)
pred_lgb = X_train.skb.apply(lgbm_model, y=y_train)

learner_cat = pred_cat.skb.make_learner(fitted=True)
learner_lgb = pred_lgb.skb.make_learner(fitted=True)

def get_prob(learner, df):
    pred = np.asarray(learner.predict_proba({"data": df}))
    if pred.ndim == 2 and pred.shape[1] > 1:
        return pred[:, 1]
    return pred.ravel()

valid_prob_cat = get_prob(learner_cat, valid_part)
valid_prob_lgb = get_prob(learner_lgb, valid_part)

valid_prob_blend = 0.55 * valid_prob_cat + 0.45 * valid_prob_lgb
valid_pred_labels = valid_prob_blend >= 0.5

final_validation_score = accuracy_score(valid_part[target_col], valid_pred_labels)
print(f"Final Validation Performance: {final_validation_score}")
```
