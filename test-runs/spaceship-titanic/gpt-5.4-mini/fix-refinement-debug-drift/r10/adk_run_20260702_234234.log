def add_features(df):
    out = df.copy()

    cabin = out["Cabin"].fillna("U/U/U").astype(str).str.split("/", expand=True)
    out["Deck"] = cabin[0]
    out["Num"] = pd.to_numeric(cabin[1], errors="coerce")
    out["Side"] = cabin[2]

    for col in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]:
        out[col] = pd.to_numeric(out[col], errors="coerce")
        out[f"{col}WasSpent"] = (out[col].fillna(0) > 0).astype(float)

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out["TotalSpend"] = out[spend_cols].fillna(0).sum(axis=1)
    out["LogSpend"] = np.log1p(out["TotalSpend"])
    out["Spent"] = (out["TotalSpend"] > 0).astype(float)

    out["Age"] = pd.to_numeric(out["Age"], errors="coerce")
    out["SpendPerAge"] = (
        out["TotalSpend"] / (out["Age"].fillna(0) + 1)
    ).replace([np.inf, -np.inf], np.nan).fillna(0.0)

    out["AgeBucket"] = pd.cut(
        out["Age"],
        bins=[-1, 12, 18, 25, 35, 50, 80, 200],
        labels=False,
        include_lowest=True,
    )

    out["CabinGroup"] = pd.to_numeric(out["Num"], errors="coerce").floordiv(10)
    out["IsMiddleDeck"] = out["Deck"].isin(["B", "C", "D", "E"]).astype(float)
    out["HasCabin"] = out["Cabin"].notna().astype(float)

    out["CryoSleep"] = out["CryoSleep"].astype("object")
    out["VIP"] = out["VIP"].astype("object")

    return out.drop(columns=["Cabin", "Name"], errors="ignore")


data_train = skrub.var("data", train_part)
