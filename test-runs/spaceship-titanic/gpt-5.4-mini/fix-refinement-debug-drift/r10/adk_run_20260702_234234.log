import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")

def preprocess(df):
    out = df.copy()

    cabin = out["Cabin"].fillna("U/U/U").astype(str).str.split("/", expand=True)
    out["Deck"] = cabin[0]
    out["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
    out["Side"] = cabin[2]

    out["CryoSleep"] = out["CryoSleep"].astype("float").fillna(0)
    out["VIP"] = out["VIP"].astype("float").fillna(0)

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out[spend_cols] = out[spend_cols].fillna(0)

    out["TotalSpend"] = out[spend_cols].sum(axis=1)
    out["SpendCount"] = (out[spend_cols] > 0).sum(axis=1)
    out["NoSpend"] = (out["TotalSpend"] == 0).astype(int)

    out["Age"] = pd.to_numeric(out["Age"], errors="coerce")
    out["AgeGroup"] = pd.cut(
        out["Age"],
        bins=[-np.inf, 12, 18, 25, 40, 60, np.inf],
        labels=["child", "teen", "young_adult", "adult", "middle_age", "senior"],
    ).astype(str)

    out["HasCabin"] = out["Cabin"].notna().astype(int)
    out["CabinNum"] = out["CabinNum"].fillna(-1)

    out["Family"] = out["Name"].fillna("Unknown").astype(str).str.split().str[-1]
    out["LastNameLen"] = out["Family"].astype(str).str.len()

    out = out.drop(columns=["Cabin", "Name"], errors="ignore")
    return out

target_col = "Transported"
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=42,
    stratify=train_df[target_col],
)

train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(preprocess)

X_train = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

features_model = CatBoostClassifier(
    iterations=1000,
    depth=6,
    learning_rate=0.03,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=42,
    allow_writing_files=False,
)

pred_graph = X_train.skb.apply(features_model, y=y_train)

val_learner = pred_graph.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

valid_pred_bool = np.asarray(valid_pred).astype(bool)
final_validation_score = accuracy_score(valid_part[target_col].astype(bool), valid_pred_bool)
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
data_full_fe = data_full.skb.apply_func(preprocess)
X_full = data_full_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full_fe[target_col].skb.mark_as_y()

full_pred_graph = X_full.skb.apply(
    CatBoostClassifier(
        iterations=1000,
        depth=6,
        learning_rate=0.03,
        loss_function="Logloss",
        eval_metric="Accuracy",
        verbose=0,
        random_seed=42,
        allow_writing_files=False,
    ),
    y=y_full,
)

full_learner = full_pred_graph.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df})

submission = pd.DataFrame(
    {
        "PassengerId": test_df["PassengerId"],
        "Transported": np.asarray(test_pred).astype(bool),
    }
)
submission.to_csv("submission.csv", index=False)
```
