import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from catboost import CatBoostClassifier

random_state = 42
target_col = "Transported"
input_dir = "./input"

train_df = pd.read_csv(os.path.join(input_dir, "train.csv"))
test_df = pd.read_csv(os.path.join(input_dir, "test.csv"))

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def preprocess(df):
    df = df.copy()

    cabin = df["Cabin"].astype("string").fillna("U/U/U")
    cabin_parts = cabin.str.split("/", expand=True)
    df["Deck"] = cabin_parts[0].fillna("U")
    df["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
    df["Side"] = cabin_parts[2].fillna("U")

    for col in ["CryoSleep", "VIP"]:
        df[col] = df[col].astype("float").fillna(0)

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df[spend_cols] = df[spend_cols].fillna(0)
    df["TotalSpend"] = df[spend_cols].sum(axis=1)
    df["NoSpend"] = (df["TotalSpend"] == 0).astype(int)

    df["Age"] = df["Age"].fillna(df["Age"].median())
    df["IsMinor"] = (df["Age"] < 18).astype(int)

    if "Name" in df.columns:
        name = df["Name"].astype("string").fillna("")
        df["NameLen"] = name.str.len()
        df["Surname"] = name.str.split(" ", n=1).str[-1].fillna("")

    return df

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

model = CatBoostClassifier(
    iterations=500,
    depth=6,
    learning_rate=0.04,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=random_state,
    allow_writing_files=False,
)

pred = X_train.skb.apply_func(preprocess).skb.apply(
    model,
    y=y_train,
    cat_features=["HomePlanet", "Destination", "Deck", "Side", "Surname"],
)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred).ravel()
if valid_pred.dtype.kind not in "biufc":
    valid_pred = pd.Series(valid_pred).astype(str).map({"True": 1, "False": 0}).to_numpy()

final_validation_score = accuracy_score(
    valid_part[target_col].astype(int),
    (valid_pred > 0.5).astype(int),
)
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
X_full = data_full.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].skb.mark_as_y()

full_pred = X_full.skb.apply_func(preprocess).skb.apply(
    model,
    y=y_full,
    cat_features=["HomePlanet", "Destination", "Deck", "Side", "Surname"],
)

full_learner = full_pred.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df})
test_pred = np.asarray(test_pred).ravel()
if test_pred.dtype.kind not in "biufc":
    test_pred = pd.Series(test_pred).astype(str).map({"True": 1, "False": 0}).to_numpy()

test_labels = np.where(test_pred > 0.5, "True", "False")

submission = pd.DataFrame(
    {
        "PassengerId": test_df["PassengerId"],
        "Transported": test_labels,
    }
)
submission.to_csv("submission.csv", index=False)
