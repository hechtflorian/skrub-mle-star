test_df = pd.read_csv(os.path.join(INPUT_DIR, "test.csv"))
target_col = "Transported"

# ----------------------------
# Small feature engineering helper
# ----------------------------
def preprocess_df(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()

    if "PassengerId" in df.columns:
        pid = df["PassengerId"].astype(str).str.split("_", expand=True)
        df["PassengerGroup"] = pid[0]
        df["PassengerNum"] = pd.to_numeric(pid[1], errors="coerce")

    if "Cabin" in df.columns:
        cabin = df["Cabin"].astype(str).str.split("/", expand=True)
        df["CabinDeck"] = cabin[0]
        df["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
        df["CabinSide"] = cabin[2]

    if "Name" in df.columns:
        name_parts = df["Name"].astype(str).str.split(" ", n=1, expand=True)
        df["Surname"] = name_parts[1].fillna("Unknown")

    for col in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    if "Age" in df.columns:
        df["AgeGroup"] = pd.cut(
            df["Age"],
            bins=[-np.inf, 12, 18, 30, 45, 60, np.inf],
            labels=["Child", "Teen", "YoungAdult", "Adult", "Senior", "Elder"],
        ).astype(str)

    return df


# ----------------------------
# Holdout split
# ----------------------------
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# ----------------------------
# DataOps graph on train_part only for honest holdout validation
# ----------------------------
data_train = skrub.var("data", preprocess_df(train_part))
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# ----------------------------
# Backbone ensemble: restore LogisticRegression inside VotingClassifier
# ----------------------------
cat_model = CatBoostClassifier(
    iterations=250,
    learning_rate=0.05,
    depth=6,
    loss_function="Logloss",
    verbose=0,
    random_seed=42,
)
lgbm_model = LGBMClassifier(
    n_estimators=250,
    learning_rate=0.05,
    num_leaves=31,
    random_state=42,
    verbose=-1,
)
lr_model = LogisticRegression(max_iter=1000, random_state=42)

ensemble = VotingClassifier(
    estimators=[
        ("cat", cat_model),
        ("lgbm", lgbm_model),
        ("lr", lr_model),
    ],
    voting="soft",
)

pred = X_train.skb.apply(ensemble, y=y_train)
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": preprocess_df(valid_part)})
valid_pred = np.asarray(valid_pred)
if valid_pred.ndim > 1:
    valid_pred = valid_pred[:, 1] if valid_pred.shape[1] > 1 else valid_pred.ravel()
valid_labels = (valid_pred >= 0.5)

final_validation_score = accuracy_score(valid_part[target_col].astype(bool), valid_labels.astype(bool))
print(f"Final Validation Performance: {final_validation_score}")

# ----------------------------
# Train full model and create submission
# ----------------------------
data_full = skrub.var("data", preprocess_df(train_df))
X_full = data_full.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].skb.mark_as_y()

full_pred = X_full.skb.apply(ensemble, y=y_full)
full_learner = full_pred.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": preprocess_df(test_df)})
test_pred = np.asarray(test_pred)
if test_pred.ndim > 1:
    test_pred = test_pred[:, 1] if test_pred.shape[1] > 1 else test_pred.ravel()
test_labels = (test_pred >= 0.5)

submission = pd.DataFrame(
    {
        "PassengerId": test_df["PassengerId"],
        "Transported": test_labels.astype(bool),
    }
)
submission.to_csv("submission.csv", index=False)
