import json
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.linear_model import LogisticRegression
from lightgbm import LGBMClassifier
from catboost import CatBoostClassifier
from sklearn.ensemble import VotingClassifier

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")
target_col = "Transported"

def fe_func(df):
    out = df.copy()
    out["CabinDeck"] = out["Cabin"].astype(str).str.split("/").str[0]
    out["CabinNum"] = pd.to_numeric(out["Cabin"].astype(str).str.split("/").str[1], errors="coerce")
    out["CabinSide"] = out["Cabin"].astype(str).str.split("/").str[2]
    out["GroupSize"] = out["PassengerId"].astype(str).str.split("_").str[0].map(
        out["PassengerId"].astype(str).str.split("_").str[0].value_counts()
    )
    out["IsAlone"] = (out["GroupSize"] == 1).astype(float)
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out["TotalSpend"] = out[spend_cols].fillna(0).sum(axis=1)
    out["NoSpend"] = (out["TotalSpend"] == 0).astype(float)
    out["NameLength"] = out["Name"].astype(str).str.len()
    return out

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(fe_func)
X_train = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

n_estimators_lgbm = skrub.choose_int(120, 260, n_steps=4, name="lgbm_n_estimators")
learning_rate_lgbm = skrub.choose_float(0.02, 0.12, log=True, name="lgbm_learning_rate")
num_leaves_lgbm = skrub.choose_int(24, 64, n_steps=3, name="lgbm_num_leaves")

lgbm_model = LGBMClassifier(
    n_estimators=n_estimators_lgbm,
    learning_rate=learning_rate_lgbm,
    num_leaves=num_leaves_lgbm,
    random_state=42,
    verbose=-1,
)

cat_depth = skrub.choose_int(4, 8, n_steps=3, name="cat_depth")
cat_lr = skrub.choose_float(0.02, 0.12, log=True, name="cat_learning_rate")
cat_iters = skrub.choose_int(150, 300, n_steps=4, name="cat_iterations")

cat_model = CatBoostClassifier(
    iterations=cat_iters,
    depth=cat_depth,
    learning_rate=cat_lr,
    loss_function="Logloss",
    eval_metric="Accuracy",
    random_seed=42,
    verbose=0,
)

lr_model = LogisticRegression(max_iter=1000, solver="lbfgs")

voter = VotingClassifier(
    estimators=[
        ("lgbm", lgbm_model),
        ("cat", cat_model),
        ("lr", lr_model),
    ],
    voting="soft",
    weights=[2, 2, 1],
)

pred = X_train.skb.apply(skrub.TableVectorizer()).skb.apply(voter, y=y_train)

search = pred.skb.make_randomized_search(
    n_iter=4,
    n_jobs=1,
    random_state=42,
    fitted=True,
)
search.fit({"data": train_part})

valid_pred = search.best_learner_.predict({"data": valid_part})
valid_pred_bool = np.asarray(valid_pred).astype(bool)
final_validation_score = accuracy_score(valid_part[target_col], valid_pred_bool)
print(f"Final Validation Performance: {final_validation_score}")

best_params = search.best_params_
print("TUNING_BEST_PARAMS:", json.dumps(best_params, default=str))
