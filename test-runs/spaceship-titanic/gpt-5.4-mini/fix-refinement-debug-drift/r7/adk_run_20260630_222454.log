import os
import json
import warnings
import numpy as np
import pandas as pd
import skrub

from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import VotingClassifier
from sklearn.base import clone

from lightgbm import LGBMClassifier
from catboost import CatBoostClassifier

warnings.filterwarnings("ignore")

DATA_DIR = "./input"
TRAIN_PATH = os.path.join(DATA_DIR, "train.csv")
TEST_PATH = os.path.join(DATA_DIR, "test.csv")
TARGET_COL = "Transported"
RANDOM_STATE = 42

train_df = pd.read_csv(TRAIN_PATH)
test_df = pd.read_csv(TEST_PATH)

def preprocess_df(df):
    df = df.copy()
    if "PassengerId" in df.columns:
        parts = df["PassengerId"].astype(str).str.split("_", n=1, expand=True)
        df["PassengerGroup"] = pd.to_numeric(parts[0], errors="coerce")
        df["PassengerNumber"] = pd.to_numeric(parts[1], errors="coerce")
    if "Cabin" in df.columns:
        cabin_parts = df["Cabin"].astype(str).str.split("/", n=2, expand=True)
        df["CabinDeck"] = cabin_parts[0]
        df["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        df["CabinSide"] = cabin_parts[2]
    if "Name" in df.columns:
        df["NameLength"] = df["Name"].astype(str).str.len()
        df["Surname"] = df["Name"].astype(str).str.split().str[-1]
    for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]:
        if c in df.columns:
            df[c] = pd.to_numeric(df[c], errors="coerce")
    if "Age" in df.columns:
        df["AgeGroup"] = pd.cut(df["Age"], bins=[-1, 12, 18, 30, 50, 80, 200], labels=False)
    df = df.drop(columns=["PassengerId", "Cabin", "Name"], errors="ignore")
    return df

train_df = preprocess_df(train_df)
test_df = preprocess_df(test_df)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=RANDOM_STATE, stratify=train_df[TARGET_COL]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=TARGET_COL, errors="ignore").skb.mark_as_X()
y_train = data_train[TARGET_COL].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()

lgbm = LGBMClassifier(
    n_estimators=250,
    learning_rate=0.05,
    num_leaves=31,
    random_state=RANDOM_STATE,
    n_jobs=-1,
    verbose=-1,
)

cat = CatBoostClassifier(
    iterations=250,
    learning_rate=0.05,
    depth=6,
    loss_function="Logloss",
    random_seed=RANDOM_STATE,
    verbose=0,
)

lr = LogisticRegression(
    max_iter=1000,
    solver="liblinear",
    random_state=RANDOM_STATE,
)

voter = VotingClassifier(
    estimators=[("lgbm", lgbm), ("cat", cat), ("lr", lr)],
    voting="soft",
    n_jobs=None,
)

pred = X_train.skb.apply(vectorizer).skb.apply(voter, y=y_train)
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred)

if valid_pred.dtype.kind in "fc":
    valid_pred = (valid_pred >= 0.5).astype(bool)
else:
    valid_pred = pd.Series(valid_pred).astype(str).map({"True": True, "False": False}).to_numpy()

final_validation_score = accuracy_score(valid_part[TARGET_COL].astype(bool), valid_pred.astype(bool))
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
X_full = data_full.drop(columns=TARGET_COL, errors="ignore").skb.mark_as_X()
y_full = data_full[TARGET_COL].skb.mark_as_y()

full_pred = X_full.skb.apply(vectorizer).skb.apply(voter, y=y_full)
