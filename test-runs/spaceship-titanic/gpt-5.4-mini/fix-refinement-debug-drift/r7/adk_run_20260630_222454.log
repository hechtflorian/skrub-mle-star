import numpy as np
import pandas as pd
import skrub
from skrub import selectors as s
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import OrdinalEncoder

# Keep the same holdout split
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=42,
    stratify=train_df[target_col].astype(int),
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_features(df):
    out = df.copy()

    cabin = out["Cabin"].fillna("Missing/Missing/Missing").astype(str).str.split("/", expand=True)
    out["CabinDeck"] = cabin[0].fillna("Missing")
    out["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
    out["CabinSide"] = cabin[2].fillna("Missing")

    for col in ["CryoSleep", "VIP"]:
        if col in out.columns:
            out[col] = out[col].astype("object").where(out[col].notna(), "Missing")

    group = out["PassengerId"].astype(str).str.split("_", expand=True)
    out["GroupId"] = group[0].fillna("Missing")
    out["GroupNum"] = pd.to_numeric(group[1], errors="coerce")
    out["IsAlone"] = (out["GroupNum"] == 1).astype(int)

    name_parts = out["Name"].fillna("").astype(str).str.split(" ", n=1, expand=True)
    out["NameLength"] = out["Name"].fillna("").astype(str).str.len()
    out["SurnameLength"] = name_parts[0].fillna("").astype(str).str.len()
    out["HasName"] = out["Name"].notna().astype(int)

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    spend_filled = out[spend_cols].fillna(0)
    out["TotalSpending"] = spend_filled.sum(axis=1)
    out["HasAnySpending"] = (out["TotalSpending"] > 0).astype(int)
    out["SpendingMissingCount"] = out[spend_cols].isna().sum(axis=1)

    # Keep a compact numeric summary and a missingness indicator block, per plan
    out["AgeMissing"] = out["Age"].isna().astype(int)

    # Clean up noisy raw identifiers after extracting informative parts
    out = out.drop(columns=["Name", "Cabin", "PassengerId"], errors="ignore")

    return out


data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(add_features)

X_train = data_train_fe.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

# Routed preprocessing:
# - low-cardinality categoricals -> categorical-friendly encoder
# - high-cardinality string columns -> lightweight string encoder
# - numerics -> impute missing values
low_card_selector = (
    s.categorical()
    | (s.string() & s.cardinality_below(20))
    | s.cols("CryoSleep", "VIP", "CabinDeck", "CabinSide", "GroupId", "IsAlone", "HasAnySpending")
)

high_card_selector = (
    (s.string() & ~s.cardinality_below(20))
    | s.cols("NameLength", "SurnameLength")
)

numeric_selector = s.numeric()

low_card_pipe = skrub.ApplyToCols(
    OrdinalEncoder(handle_unknown="use_encoded_value", unknown_value=-1),
    cols=low_card_selector,
    allow_reject=True,
)

high_card_pipe = skrub.ApplyToCols(
    skrub.StringEncoder(),
    cols=high_card_selector,
    allow_reject=True,
)

numeric_pipe = skrub.ApplyToCols(
    SimpleImputer(strategy="median"),
    cols=numeric_selector,
    allow_reject=True,
)

cat_model = CatBoostClassifier(
    iterations=1200,
    learning_rate=0.03,
    depth=6,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=42,
    allow_writing_files=False,
)

lgb_model = LGBMClassifier(
    n_estimators=3000,
    learning_rate=0.03,
    num_leaves=64,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=42,
    verbose=-1,
)

cat_graph = (
    X_train.skb.apply(low_card_pipe)
    .skb.apply(high_card_pipe)
    .skb.apply(numeric_pipe)
    .skb.apply(cat_model, y=y_train)
)
lgb_graph = (
    X_train.skb.apply(low_card_pipe)
    .skb.apply(high_card_pipe)
    .skb.apply(numeric_pipe)
    .skb.apply(lgb_model, y=y_train)
)

