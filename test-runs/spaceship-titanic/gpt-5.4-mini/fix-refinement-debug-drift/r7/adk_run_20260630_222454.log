import numpy as np
import pandas as pd
import skrub

from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.linear_model import LogisticRegression
from lightgbm import LGBMClassifier
from catboost import CatBoostClassifier

# -----------------------
# Load data
# -----------------------
INPUT_DIR = "./input"
train_df = pd.read_csv(os.path.join(INPUT_DIR, "train.csv"))
test_df = pd.read_csv(os.path.join(INPUT_DIR, "test.csv"))

target_col = "Transported"

# -----------------------
# Basic preprocessing helper
# -----------------------
def fe_func(df):
    out = df.copy()

    # PassengerId structure features
    if "PassengerId" in out.columns:
        pid = out["PassengerId"].astype(str)
        parts = pid.str.split("_", n=1, expand=True)
        out["PassengerGroup"] = parts[0]
        out["PassengerNumber"] = pd.to_numeric(parts[1], errors="coerce")

    # Cabin split
    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin_parts = cabin.str.split("/", n=2, expand=True)
        out["CabinDeck"] = cabin_parts[0]
        out["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        out["CabinSide"] = cabin_parts[2]

    # Name split
    if "Name" in out.columns:
        name = out["Name"].astype("string")
        out["Surname"] = name.str.split().str[-1]
        out["NameLength"] = name.str.len()

    # Spending features
    spend_cols = [c for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if c in out.columns]
    if spend_cols:
        out["TotalSpend"] = out[spend_cols].sum(axis=1)
        out["ZeroSpend"] = (out[spend_cols].fillna(0).sum(axis=1) == 0).astype(int)

    # Missingness indicator
    out["MissingCount"] = out.isna().sum(axis=1)

    return out

# -----------------------
# Holdout split
# -----------------------
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# -----------------------
# DataOps graph
# -----------------------
data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(fe_func)

X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()

# Keep required backbone estimator set, adding LogisticRegression to the voting backbone
log_reg = LogisticRegression(max_iter=1000, random_state=42)
lgbm = LGBMClassifier(
    n_estimators=250,
    learning_rate=0.05,
    random_state=42,
    verbose=-1,
)
cat = CatBoostClassifier(
    iterations=250,
    learning_rate=0.05,
    depth=6,
    loss_function="Logloss",
    random_seed=42,
    verbose=0,
)

voting = skrub.choose_from(
    {
        "voting": skrub.VotingClassifier(
            estimators=[
                ("lgbm", lgbm),
                ("cat", cat),
                ("lr", log_reg),
            ],
            voting="soft",
        )
    },
    name="classifier_variant",
)

pred = X_train.skb.apply(vectorizer).skb.apply(voting, y=y_train)

# -----------------------
# Validation
# -----------------------
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred)
if valid_pred.dtype != bool and valid_pred.dtype != np.bool_:
    valid_pred = valid_pred.astype(str)
final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
