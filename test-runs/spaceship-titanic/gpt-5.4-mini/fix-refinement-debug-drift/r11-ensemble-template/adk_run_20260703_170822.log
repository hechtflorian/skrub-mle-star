import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from catboost import CatBoostClassifier

random_state = 42

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "Transported"

# Smallest safe fix: ensure CatBoost receives categorical columns as categorical,
# not as raw strings that get interpreted as numeric features.
categorical_cols = [
    "PassengerId",
    "HomePlanet",
    "CryoSleep",
    "Cabin",
    "Destination",
    "VIP",
    "Name",
]
categorical_cols = [c for c in categorical_cols if c in train_df.columns]

for col in categorical_cols:
    train_df[col] = train_df[col].astype("string")
    if col in test_df.columns:
        test_df[col] = test_df[col].astype("string")

# Keep the DataOps structure and the original apply call shape.
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Encode string/categorical columns with CatBoost by explicitly passing cat_features.
# This prevents CatBoost from trying to convert string IDs like "2513_01" to float.
model = CatBoostClassifier(
    loss_function="Logloss",
    iterations=300,
    learning_rate=0.05,
    depth=6,
    random_seed=random_state,
    verbose=0,
    cat_features=categorical_cols if categorical_cols else None,
)

pred = X_train.skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred_raw = val_learner.predict({"data": valid_part})

# CatBoost may output probabilities or class labels depending on the learner path.
valid_pred_raw = np.asarray(valid_pred_raw)
if valid_pred_raw.ndim > 1:
    valid_pred_raw = valid_pred_raw[:, -1]
valid_pred = (valid_pred_raw >= 0.5) if valid_pred_raw.dtype.kind in "fc" else valid_pred_raw.astype(bool)

# Ensure boolean labels for accuracy comparison
y_valid = valid_part[target_col].astype(bool).to_numpy()
final_validation_score = accuracy_score(y_valid, valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
