import json
import os
import numpy as np
import pandas as pd
import skrub
import lightgbm as lgb
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

random_state = 42
target_col = "Transported"

train_path = os.path.join("./input", "train.csv")
train_df = pd.read_csv(train_path)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col],
)

train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_features(df):
    out = df.copy()

    cabin = out["Cabin"].fillna("Z/0/Z").astype(str).str.split("/", expand=True)
    out["Deck"] = cabin[0]
    out["Num"] = cabin[1]
    out["Side"] = cabin[2]

    spend_cols = ["Spa", "VRDeck", "RoomService", "FoodCourt", "ShoppingMall"]
    for col in spend_cols:
        out[col] = pd.to_numeric(out[col], errors="coerce").fillna(0)

    out["TotalSpend"] = out[spend_cols].sum(axis=1)
    out["NoSpend"] = (out["TotalSpend"] == 0).astype(int)

    age = pd.to_numeric(out["Age"], errors="coerce")
    out["Age"] = age
    out["IsMinor"] = (age.fillna(age.median()) < 18).astype(int)

    out["CabinNum"] = pd.to_numeric(out["Num"], errors="coerce")
    out["CabinNum"] = out["CabinNum"].replace([np.inf, -np.inf], np.nan)

    out["HasName"] = out["Name"].notna().astype(int)

    group_key = out["PassengerId"].astype(str).str.split("_").str[0]
    out["GroupSize"] = group_key.map(group_key.value_counts())
    out["GroupSize"] = pd.to_numeric(out["GroupSize"], errors="coerce").fillna(1)

    return out


data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(add_features)

X_train = data_train_fe.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].skb.mark_as_y()

vectorizer_lgb = skrub.TableVectorizer()
vectorizer_cat = skrub.TableVectorizer()

lgb_model = lgb.LGBMClassifier(
    n_estimators=1000,
    learning_rate=skrub.choose_float(
        low=0.015,
        high=0.04,
        default=0.02,
        name="learning_rate",
    ),
    num_leaves=skrub.choose_int(
        low=24,
        high=40,
        default=31,
        name="num_leaves",
    ),
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=random_state,
    n_jobs=-1,
    verbosity=-1,
)

cat_model = CatBoostClassifier(
    iterations=700,
    depth=6,
    learning_rate=0.03,
    loss_function="Logloss",
    eval_metric="Accuracy",
    random_seed=random_state,
    verbose=0,
    allow_writing_files=False,
)

pred_lgb = X_train.skb.apply(vectorizer_lgb).skb.apply(lgb_model, y=y_train)
pred_cat = X_train.skb.apply(vectorizer_cat).skb.apply(cat_model, y=y_train)

search = pred_lgb.skb.make_randomized_search(
    n_iter=5,
    n_jobs=1,
    random_state=random_state,
    fitted=True,
)
search.fit({"data": train_part})

valid_pred_lgb = search.best_learner_.predict({"data": valid_part})
learner_cat = pred_cat.skb.make_learner(fitted=True)
valid_pred_cat = learner_cat.predict({"data": valid_part})

valid_pred_lgb = np.asarray(valid_pred_lgb).ravel()
valid_pred_cat = np.asarray(valid_pred_cat).ravel()

valid_blend = 0.55 * valid_pred_lgb + 0.45 * valid_pred_cat
valid_labels = (valid_blend > 0.5).astype(int)

final_validation_score = accuracy_score(valid_part[target_col].astype(int), valid_labels)
print(f"Final Validation Performance: {final_validation_score}")

raw_best = search.best_params_
best_params = {}
raw_values = list(raw_best.values()) if hasattr(raw_best, "values") else list(raw_best)
remaining = list(raw_values)

tune_plan = {
    "tunable_params": [
        {"name": "num_leaves", "kind": "choose_int", "low": 24, "high": 40, "default": 31},
        {"name": "learning_rate", "kind": "choose_float", "low": 0.015, "high": 0.04, "default": 0.02},
    ]
}

for spec in tune_plan["tunable_params"]:
    name = spec["name"]
    kind = spec["kind"]
    match = None
    if kind == "choose_int":
        for v in remaining:
            if spec["low"] <= int(round(float(v))) <= spec["high"]:
                match = v
                break
        best_params[name] = int(round(float(match if match is not None else spec["default"])))
    elif kind == "choose_float":
        for v in remaining:
            if spec["low"] <= float(v) <= spec["high"]:
                match = v
                break
        best_params[name] = float(match if match is not None else spec["default"])
    else:
        best_params[name] = spec.get("default")
    if match in remaining:
        remaining.remove(match)

print("TUNING_BEST_PARAMS:", json.dumps(best_params, default=str))
