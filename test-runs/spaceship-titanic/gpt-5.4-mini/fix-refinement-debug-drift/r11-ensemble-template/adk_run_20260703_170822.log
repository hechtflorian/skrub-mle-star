import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier, Pool
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

random_state = 42
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")

def feature_engineer(df):
    df = df.copy()
    cabin = df["Cabin"].fillna("Z/0/Z").astype(str).str.split("/", expand=True)
    df["Deck"] = cabin[0]
    df["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce").fillna(-1)
    df["Side"] = cabin[2]

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df[spend_cols] = df[spend_cols].fillna(0)
    df["TotalSpend"] = df[spend_cols].sum(axis=1)
    df["NoSpend"] = (df["TotalSpend"] == 0).astype(int)
    df["Age"] = pd.to_numeric(df["Age"], errors="coerce")
    df["AgeBin"] = pd.cut(
        df["Age"],
        bins=[-1, 12, 18, 25, 35, 50, 65, 200],
        labels=["child", "teen", "young_adult", "adult", "mid_age", "senior", "elder"],
    ).astype(str)
    df["IsAlone"] = df["PassengerId"].astype(str).str.split("_").str[1].fillna("0").astype(int).eq(1).astype(int)
    df["Group"] = df["PassengerId"].astype(str).str.split("_").str[0]
    df["FamilyName"] = df["Name"].fillna("Unknown").astype(str).str.split().str[-1]
    return df

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col].astype(int),
)

train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

X_train_fe = X_train.skb.apply_func(feature_engineer)
vectorizer = skrub.TableVectorizer()
model = CatBoostClassifier(
    iterations=1200,
    depth=6,
    learning_rate=0.03,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=random_state,
    allow_writing_files=False,
)

pred = X_train_fe.skb.apply(vectorizer).skb.apply(model, y=y_train)
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = accuracy_score(valid_part[target_col].astype(int), np.asarray(valid_pred).ravel().astype(int))
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
X_full = data_full.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].skb.mark_as_y()
X_full_fe = X_full.skb.apply_func(feature_engineer)

full_pred = X_full_fe.skb.apply(vectorizer).skb.apply(
    CatBoostClassifier(
        iterations=1200,
        depth=6,
        learning_rate=0.03,
        loss_function="Logloss",
        eval_metric="Accuracy",
        verbose=0,
        random_seed=random_state,
        allow_writing_files=False,
    ),
    y=y_full,
)
full_learner = full_pred.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df})

test_pred_bool = np.asarray(test_pred).ravel().astype(int).astype(bool)
submission = pd.DataFrame(
    {
        "PassengerId": test_df["PassengerId"],
        "Transported": test_pred_bool,
    }
)
submission["Transported"] = submission["Transported"].map({True: "True", False: "False"})
submission.to_csv("submission.csv", index=False)
```
