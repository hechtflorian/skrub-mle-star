    cabin = out["Cabin"].fillna("Z/0/Z").astype(str).str.split("/", expand=True)
    out["Deck"] = cabin[0]
    out["Num"] = cabin[1]
    out["Side"] = cabin[2]

    spend_cols = ["Spa", "VRDeck", "RoomService", "FoodCourt", "ShoppingMall"]
    for col in spend_cols:
        out[col] = pd.to_numeric(out[col], errors="coerce").fillna(0)

    out["TotalSpend"] = out[spend_cols].sum(axis=1)
    out["NoSpend"] = (out["TotalSpend"] == 0).astype(int)
    out["AnySpend"] = (out["TotalSpend"] > 0).astype(int)
    out["LuxurySpend"] = out["Spa"] + out["VRDeck"]

    age = pd.to_numeric(out["Age"], errors="coerce")
    out["Age"] = age
    out["IsMinor"] = (age.fillna(age.median()) < 18).astype(int)

    out["CabinNum"] = pd.to_numeric(out["Num"], errors="coerce")
    out["CabinNum"] = out["CabinNum"].replace([np.inf, -np.inf], np.nan)

    out["HasName"] = out["Name"].notna().astype(int)

    group_key = out["PassengerId"].astype(str).str.split("_").str[0]
    group_size = group_key.map(group_key.value_counts()).fillna(1).astype(float)
    out["IsSolo"] = (group_size == 1).astype(int)
    out["GroupSizeBin"] = pd.cut(
        group_size,
        bins=[0, 1, 2, 4, np.inf],
        labels=["solo", "pair", "small_group", "large_group"],
        include_lowest=True,
    ).astype(str)

    out = out.drop(columns=["GroupSize"], errors="ignore")
    return out


data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(add_features)

X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()
predictor = X_train.skb.apply(vectorizer).skb.apply(
    skrub.HistGradientBoostingClassifier(random_state=random_state), y=y_train
)

val_learner = predictor.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = metric_fn(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
