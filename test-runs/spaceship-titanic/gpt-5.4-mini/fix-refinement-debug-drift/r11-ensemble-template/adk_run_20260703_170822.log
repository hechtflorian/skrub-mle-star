    df["Group"] = df["PassengerId"].astype(str).str.split("_").str[0]
    df["GroupNum"] = pd.to_numeric(df["PassengerId"].astype(str).str.split("_").str[1], errors="coerce")
    df["NameLen"] = df["Name"].astype(str).str.len()
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
