    if existing_spend_cols:
        spend_data = df[existing_spend_cols].fillna(0)
        df["TotalSpending"] = spend_data.sum(axis=1)
        df["LogTotalSpending"] = np.log1p(df["TotalSpending"])
        df["SpendingFlag"] = (df["TotalSpending"] > 0).astype(int)
        df["NoSpend"] = (df["TotalSpending"] == 0).astype(int)
        df["AnyLuxurySpend"] = ((spend_data > 0).sum(axis=1) >= 2).astype(int)
    else:
        df["TotalSpending"] = 0.0
        df["LogTotalSpending"] = 0.0
        df["SpendingFlag"] = 0
        df["NoSpend"] = 1
        df["AnyLuxurySpend"] = 0

    if "Age" in df.columns:
        df["AgeMissing"] = df["Age"].isna().astype(int)
        df["AgeIsYoung"] = (df["Age"].fillna(np.inf) <= 18).astype(int)
        df["AgeGroup"] = pd.cut(
            df["Age"],
            bins=[-np.inf, 12, 18, 30, 50, np.inf],
            labels=["Child", "Teen", "YoungAdult", "Adult", "Senior"],
        )
    else:
        df["AgeMissing"] = 1
        df["AgeIsYoung"] = 0
        df["AgeGroup"] = np.nan

    if "Surname" in df.columns and "PassengerGroup" in df.columns:
        surname_counts = df.groupby("Surname", dropna=False)["Surname"].transform("size")
        group_counts = df.groupby("PassengerGroup", dropna=False)["PassengerGroup"].transform("size")
        df["FamilyProxy"] = ((surname_counts > 1) | (group_counts > 1)).astype(int)
    else:
        df["FamilyProxy"] = 0

    return df


