        df["CabinSide"] = cabin_parts[2]
    else:
        df["HasCabin"] = 0
        df["CabinDeck"] = np.nan
        df["CabinNum"] = np.nan
        df["CabinSide"] = np.nan

    if "Name" in df.columns:
        name = df["Name"].astype("string")
        df["HasName"] = name.notna() & name.ne("nan")
        df["Surname"] = name.str.split(" ", n=1).str[-1]
    else:
        df["HasName"] = 0
        df["Surname"] = np.nan

    if "Surname" in df.columns:
