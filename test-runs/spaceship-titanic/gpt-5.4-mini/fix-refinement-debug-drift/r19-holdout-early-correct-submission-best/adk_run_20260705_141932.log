import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import FunctionTransformer
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder
from sklearn.ensemble import RandomForestClassifier

random_state = 42
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")

def feature_engineer(df):
    out = df.copy()

    if "Cabin" in out.columns:
        cabin_parts = out["Cabin"].astype("string").str.split("/", expand=True)
        out["CabinDeck"] = cabin_parts[0].astype("object")
        out["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        out["CabinSide"] = cabin_parts[2].astype("object")

    if "PassengerId" in out.columns:
        out["Group"] = out["PassengerId"].astype("string").str.split("_", n=1, expand=True)[0].astype("object")
        out["GroupSize"] = out["Group"]

    # Replace pandas nullable missing values with np.nan for sklearn compatibility
    out = out.replace({pd.NA: np.nan})
    return out

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(feature_engineer)

X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
