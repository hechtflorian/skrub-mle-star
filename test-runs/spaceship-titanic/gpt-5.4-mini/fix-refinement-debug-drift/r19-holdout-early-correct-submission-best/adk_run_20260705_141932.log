import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

random_state = 42
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_features(df):
    out = df.copy()

    cabin = out["Cabin"].fillna("Missing/Missing/Missing").astype(str).str.split("/", expand=True)
    if cabin.shape[1] >= 3:
        out["Deck"] = cabin[0]
        out["CabinNum"] = cabin[1]
        out["Side"] = cabin[2]
    else:
        out["Deck"] = "Missing"
        out["CabinNum"] = "Missing"
        out["Side"] = "Missing"

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    for col in spend_cols:
        if col not in out.columns:
            out[col] = np.nan
    out["TotalSpent"] = out[spend_cols].fillna(0).sum(axis=1)
    out["ZeroSpent"] = (out["TotalSpent"] == 0).astype(int)
    out["HasCabin"] = out["Cabin"].notna().astype(int)

    if "Age" in out.columns:
        out["AgeBin"] = pd.cut(
            out["Age"],
            bins=[-np.inf, 12, 18, 30, 45, 60, np.inf],
            labels=["child", "teen", "young_adult", "adult", "mid_age", "senior"],
        ).astype("object")
    else:
        out["AgeBin"] = "Missing"

    return out


data = skrub.var("data", train_part)
data_fe = data.skb.apply_func(add_features)

X = data_fe.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y = data_fe[target_col].skb.mark_as_y()

cat_cols = ["HomePlanet", "CryoSleep", "Destination", "VIP", "Deck", "Side", "AgeBin"]

model = CatBoostClassifier(
    loss_function="Logloss",
    eval_metric="Accuracy",
    iterations=2000,
    learning_rate=0.03,
    depth=8,
    random_seed=random_state,
    verbose=0,
)

pred_graph = X.skb.apply(model, y=y, cat_features=cat_cols)
learner = pred_graph.skb.make_learner(fitted=True)

valid_pred = learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred).ravel()
if valid_pred.dtype != bool:
    valid_pred = valid_pred.astype(int).astype(bool)

final_validation_score = accuracy_score(valid_part[target_col].astype(int), valid_pred.astype(int))
print(f"Final Validation Performance: {final_validation_score}")
