import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from catboost import CatBoostClassifier

random_state = 42
target_col = "Transported"

train_path = os.path.join("./input", "train.csv")
train_df = pd.read_csv(train_path)

# Keep honest holdout binding: fit only on train_part, evaluate on valid_part.
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Smallest safe fix: ensure all object/string columns are converted to categorical
# before CatBoost sees them, so string IDs like "2513_01" are not parsed as floats.
X_train_df = train_part.drop(columns=target_col, errors="ignore")
cat_cols = X_train_df.select_dtypes(include=["object", "string"]).columns.tolist()
if cat_cols:
    for col in cat_cols:
        X_train_df[col] = X_train_df[col].astype("category")

def prepare_for_catboost(df):
    df = df.copy()
    for col in df.select_dtypes(include=["object", "string"]).columns:
        df[col] = df[col].astype("category")
    return df

model = CatBoostClassifier(
    loss_function="Logloss",
    random_seed=random_state,
    verbose=0,
    allow_writing_files=False,
)

pred_graph = X_train.skb.apply(
    model,
    y=y_train,
)

# Fit on the honest holdout training partition.
learner = pred_graph.skb.make_learner(fitted=False)
learner.fit({"data": train_part})

valid_X = prepare_for_catboost(valid_part.drop(columns=target_col, errors="ignore"))
valid_pred = learner.predict({"data": valid_part})

# CatBoost predict may return probabilities or class labels depending on the wrapper path.
if valid_pred.ndim > 1:
    valid_pred = valid_pred[:, 0]
if valid_pred.dtype != bool and valid_pred.dtype != np.bool_:
    # If probabilities are returned, threshold at 0.5; otherwise map common label outputs.
    if np.issubdtype(valid_pred.dtype, np.floating):
        valid_pred = valid_pred >= 0.5
    else:
        valid_pred = pd.Series(valid_pred).astype(str).str.lower().isin(["true", "1"]).to_numpy()

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
