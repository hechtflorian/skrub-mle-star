import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split

def feature_engineer(df):
    out = df.copy()

    # Passenger structure
    if "PassengerId" in out.columns:
        pid = out["PassengerId"].astype(str).str.split("_", n=1, expand=True)
        out["PassengerGroup"] = pd.to_numeric(pid[0], errors="coerce")
        out["PassengerNumber"] = pd.to_numeric(pid[1], errors="coerce")
        out["GroupSize"] = out["PassengerNumber"]
        out["IsAlone"] = (out["PassengerNumber"] == 1).astype("Int64")
    else:
        out["PassengerGroup"] = np.nan
        out["PassengerNumber"] = np.nan
        out["GroupSize"] = np.nan
        out["IsAlone"] = np.nan

    # Cabin structure
    if "Cabin" in out.columns:
        has_cabin = out["Cabin"].notna() & (out["Cabin"].astype(str).str.lower() != "nan")
        cabin = out["Cabin"].astype(str).str.split("/", n=2, expand=True)
        out["CabinDeck"] = cabin[0]
        out["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
        out["CabinSide"] = cabin[2]
        out["HasCabin"] = has_cabin.astype(int)
    else:
        out["CabinDeck"] = np.nan
        out["CabinNum"] = np.nan
        out["CabinSide"] = np.nan
        out["HasCabin"] = 0

    # Name structure
    if "Name" in out.columns:
        name_str = out["Name"].astype(str)
        has_name = out["Name"].notna() & (name_str.str.lower() != "nan")
        out["HasName"] = has_name.astype(int)
        out["Surname"] = name_str.str.split(" ", n=1).str[-1]
    else:
        out["HasName"] = 0
        out["Surname"] = np.nan

    # Family proxy from repeated surname if available
    if "Surname" in out.columns:
        surname_counts = out["Surname"].astype("string").map(
            out["Surname"].astype("string").value_counts(dropna=False)
        )
        out["FamilyProxy"] = (surname_counts.fillna(0) > 1).astype(int)
    else:
        out["FamilyProxy"] = 0

    # Spending structure
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    existing_spend_cols = [c for c in spend_cols if c in out.columns]
    if existing_spend_cols:
        spend_block = out[existing_spend_cols].fillna(0)
        out["TotalSpending"] = spend_block.sum(axis=1)
        out["LogTotalSpending"] = np.log1p(out["TotalSpending"].clip(lower=0))
        out["SpendingFlag"] = (out["TotalSpending"] > 0).astype(int)
        out["NoSpend"] = (out["TotalSpending"] <= 0).astype(int)
        out["AnyLuxurySpend"] = (
            spend_block[existing_spend_cols].gt(0).sum(axis=1) >= 2
        ).astype(int)
    else:
        out["TotalSpending"] = 0.0
        out["LogTotalSpending"] = 0.0
        out["SpendingFlag"] = 0
        out["NoSpend"] = 1
        out["AnyLuxurySpend"] = 0

    # Age features
    if "Age" in out.columns:
        out["AgeMissing"] = out["Age"].isna().astype(int)
        out["AgeIsYoung"] = ((out["Age"].fillna(np.inf) <= 18)).astype(int)
        out["AgeGroup"] = pd.cut(
            out["Age"],
            bins=[-np.inf, 12, 18, 30, 50, np.inf],
            labels=["Child", "Teen", "YoungAdult", "Adult", "Senior"],
        )
    else:
        out["AgeMissing"] = 1
        out["AgeIsYoung"] = 0
        out["AgeGroup"] = np.nan

    # Keep raw identifiers out of the vectorizer to avoid high-cardinality noise
    if "NameLen" in out.columns:
        out = out.drop(columns=["NameLen"])

    return out


train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
data_fe = data_train.skb.apply_func(feature_engineer)
X = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y = data_fe[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()
predictor = X.skb.apply(vectorizer).skb.apply(learner, y=y)

val_learner = predictor.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = metric_fn(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
