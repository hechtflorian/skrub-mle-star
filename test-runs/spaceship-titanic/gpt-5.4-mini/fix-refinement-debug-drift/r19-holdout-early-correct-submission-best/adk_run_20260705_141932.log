        df["Surname"] = name_str.str.split(" ", n=1).str[-1].where(~name_missing, np.nan)
        df["HasName"] = (~name_missing).astype(int)
    else:
        df["Surname"] = np.nan
        df["HasName"] = 0

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
