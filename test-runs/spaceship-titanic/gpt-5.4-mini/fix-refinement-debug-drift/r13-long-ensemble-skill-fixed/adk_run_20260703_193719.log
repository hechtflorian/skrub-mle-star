import numpy as np
import pandas as pd
import skrub

def add_features_ref(df):
    out = df.copy()

    # Cabin-derived signals
    cabin = out["Cabin"].fillna("Unknown/0/U").astype(str).str.split("/", expand=True)
    out["Deck"] = cabin[0]
    out["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
    out["Side"] = cabin[2]
    out["CabinKnown"] = out["Cabin"].notna().astype(int)
    out["CabinGroup"] = out["Deck"].astype(str).fillna("Unknown") + "_" + out["Side"].astype(str).fillna("U")
    out["CabinGroupKnown"] = ((out["Deck"] != "Unknown") & (out["Side"].notna())).astype(int)

    # Spending block: keep strong, robust signals only
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out[spend_cols] = out[spend_cols].fillna(0)
    out["TotalSpending"] = out[spend_cols].sum(axis=1)
    out["HasSpent"] = (out["TotalSpending"] > 0).astype(int)
    out["AnySpendMissing"] = out[spend_cols].isna().any(axis=1).astype(int)
    out["SpendNonZeroCount"] = (out[spend_cols] > 0).sum(axis=1)
    out["SpendMean"] = out[spend_cols].mean(axis=1)
    out["SpendStd"] = out[spend_cols].std(axis=1).fillna(0.0)
    out["SpendMax"] = out[spend_cols].max(axis=1)
    out["SpendMin"] = out[spend_cols].min(axis=1)
    out["LogTotalSpending"] = np.log1p(out["TotalSpending"])
    out["LogSpendNonZeroCount"] = np.log1p(out["SpendNonZeroCount"])

    # Group structure and consistency
    passenger_group = out["PassengerId"].astype(str).str.split("_").str[0]
    out["Group"] = passenger_group
    out["GroupSize"] = passenger_group.map(passenger_group.value_counts())
    out["Solo"] = (out["GroupSize"] == 1).astype(int)

    # Group-level missingness / spend rates
    group_size = out["GroupSize"].replace(0, np.nan)
    out["GroupMissingRate"] = out[["Age", "Cabin", "Name"]].isna().mean(axis=1)
    out["GroupSpenderRate"] = out.groupby("Group")["HasSpent"].transform("mean")
    out["GroupMissingRateById"] = out.groupby("Group")[["Age", "Cabin", "Name"]].transform(lambda x: x.isna().mean()).mean(axis=1)

    # Cabin-group consistency: same group/same cabin side/deck as a compact signal
    out["CabinGroupConsistency"] = (
        out.groupby("Group")["CabinGroup"].transform(lambda s: s.nunique(dropna=False) == 1)
    ).astype(int)
    out["DeckConsistency"] = (
        out.groupby("Group")["Deck"].transform(lambda s: s.nunique(dropna=False) == 1)
    ).astype(int)
    out["SideConsistency"] = (
