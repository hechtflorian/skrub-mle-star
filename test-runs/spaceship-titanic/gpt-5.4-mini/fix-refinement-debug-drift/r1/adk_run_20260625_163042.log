import warnings

warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from lightgbm import LGBMClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

# Load data
train_df = pd.read_csv("./input/train.csv")
target_col = "Transported"

# Same holdout split as the input solution
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=42,
    stratify=train_df[target_col],
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


@skrub.deferred
def add_features(df, use_fe=True, drop_redundant_group=False):
    out = df.copy()

    if use_fe:
        cabin_split = out["Cabin"].astype("string").str.split("/", expand=True)
        out["CabinDeck"] = cabin_split[0]
        out["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
        out["CabinSide"] = cabin_split[2]

        out["Group"] = out["PassengerId"].astype("string").str.split("_").str[0]
        out["GroupSize"] = out.groupby("Group")["PassengerId"].transform("count")
        if drop_redundant_group:
            out = out.drop(columns=["Group"], errors="ignore")

        spending_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
        out["Spending"] = out[spending_cols].fillna(0).sum(axis=1)
        out["ZeroSpending"] = (out["Spending"] == 0).astype(int)

        out["AgeGroup"] = pd.cut(
            out["Age"],
            bins=[-np.inf, 12, 18, 30, 50, np.inf],
            labels=["child", "teen", "young_adult", "adult", "senior"],
        ).astype("string")

        out["HasCabin"] = out["Cabin"].notna().astype(int)
        out["HasName"] = out["Name"].notna().astype(int)

        out["CryoSleep_or_ZeroSpending"] = (
            (out["CryoSleep"].fillna(False).astype(bool)) | (out["ZeroSpending"] == 1)
        ).astype(int)

        out["LuxurySpending"] = out[["Spa", "VRDeck"]].fillna(0).sum(axis=1)
        out["NonLuxurySpending"] = out[["RoomService", "FoodCourt", "ShoppingMall"]].fillna(0).sum(axis=1)

        denom = out["Age"].replace(0, np.nan)
        out["SpendingPerAge"] = (out["Spending"] / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)

    return out


def build_and_score(variant_name, use_fe=True, drop_redundant_group=False, use_catboost=True):
    data_train = skrub.var("data", train_part)
    data_train_fe = data_train.skb.apply_func(
        lambda df: add_features(df, use_fe=use_fe, drop_redundant_group=drop_redundant_group)
    )
    X_train = data_train_fe.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
    y_train = data_train_fe[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()

    if use_catboost:
        model = CatBoostClassifier(
            iterations=350,
            learning_rate=0.05,
            depth=6,
            loss_function="Logloss",
            random_seed=42,
            verbose=0,
        )
    else:
        model = LGBMClassifier(
            n_estimators=700,
            learning_rate=0.03,
            num_leaves=64,
            subsample=0.85,
            colsample_bytree=0.85,
            random_state=42,
            verbose=-1,
        )

    pred_chain = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
    learner = pred_chain.skb.make_learner(fitted=True)
    valid_pred = np.asarray(learner.predict({"data": valid_part})).ravel()

    if valid_pred.dtype != bool:
        valid_pred = valid_pred > 0.5

    score = accuracy_score(valid_part[target_col].values, valid_pred.astype(bool))
    print(f"Ablation[{variant_name}] accuracy_score: {score}")
    return score


scores = {}

# Baseline: original feature engineering + CatBoost backbone
scores["baseline"] = build_and_score(
    "baseline",
    use_fe=True,
    drop_redundant_group=False,
    use_catboost=True,
)

# Ablation 1: disable all manual feature engineering
scores["no_manual_fe"] = build_and_score(
    "no_manual_fe",
    use_fe=False,
    drop_redundant_group=False,
    use_catboost=True,
)

# Ablation 2: keep manual FE but drop redundant Group column after GroupSize is created
scores["drop_group"] = build_and_score(
    "drop_group",
    use_fe=True,
    drop_redundant_group=True,
    use_catboost=True,
)

# Ablation 3: swap CatBoost for LightGBM while keeping same FE
scores["lgbm_backbone"] = build_and_score(
    "lgbm_backbone",
    use_fe=True,
    drop_redundant_group=False,
    use_catboost=False,
)

best_variant = max(scores, key=scores.get)
best_score = scores[best_variant]
print(f"Best ablation variant: {best_variant} | accuracy_score: {best_score}")
