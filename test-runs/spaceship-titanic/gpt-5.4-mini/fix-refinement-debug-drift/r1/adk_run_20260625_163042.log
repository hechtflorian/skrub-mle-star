import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.ensemble import HistGradientBoostingClassifier

INPUT_DIR = "./input"
train_df = pd.read_csv(os.path.join(INPUT_DIR, "train.csv"))
test_df = pd.read_csv(os.path.join(INPUT_DIR, "test.csv"))

target_col = "Transported"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


@skrub.deferred
def add_features(df, use_fe=True, drop_redundant_group=False):
    if not use_fe:
        return df
    out = df.copy()

    if "Cabin" in out.columns:
        cabin = out["Cabin"].astype("string")
        cabin_split = cabin.str.split("/", expand=True)
        if cabin_split.shape[1] >= 3:
            out["CabinDeck"] = cabin_split[0]
            out["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
            out["CabinSide"] = cabin_split[2]

    if "PassengerId" in out.columns:
        out["Group"] = out["PassengerId"].astype("string").str.split("_", expand=True)[0]
        if drop_redundant_group:
            out = out.drop(columns=["PassengerId"], errors="ignore")

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    existing_spend_cols = [c for c in spend_cols if c in out.columns]
    if existing_spend_cols:
        for c in existing_spend_cols:
            out[c] = pd.to_numeric(out[c], errors="coerce").fillna(0)
        out["TotalSpend"] = out[existing_spend_cols].sum(axis=1)
        out["NoSpend"] = (out["TotalSpend"] == 0).astype(int)
        if "CryoSleep" in out.columns:
            cryo = out["CryoSleep"].astype("string").str.lower()
            out["Cryo_or_NoSpend"] = ((cryo == "true") | (out["NoSpend"] == 1)).astype(int)

    if "Age" in out.columns:
        out["Age"] = pd.to_numeric(out["Age"], errors="coerce")

    return out


def build_and_score(data_train, use_fe=True, drop_redundant_group=False):
    data_train_fe = data_train.skb.apply_func(
        add_features,
        use_fe=use_fe,
        drop_redundant_group=drop_redundant_group,
    )
    X_train = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train_fe[target_col].skb.mark_as_y()

    model = HistGradientBoostingClassifier(random_state=42)
    pred = X_train.skb.apply(skrub.TableVectorizer()).skb.apply(model, y=y_train)
    learner = pred.skb.make_learner(fitted=True)
    valid_pred = learner.predict({"data": valid_part})

    final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
    return final_validation_score, pred


data_train = skrub.var("data", train_part)
final_validation_score, pred = build_and_score(
    data_train, use_fe=True, drop_redundant_group=False
)
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
data_full_fe = data_full.skb.apply_func(
    add_features, use_fe=True, drop_redundant_group=False
)
X_full = data_full_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full_fe[target_col].skb.mark_as_y()
full_model = HistGradientBoostingClassifier(random_state=42)
full_pred = X_full.skb.apply(skrub.TableVectorizer()).skb.apply(full_model, y=y_full)
full_learner = full_pred.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df})

submission = pd.DataFrame(
    {
        "PassengerId": test_df["PassengerId"],
        "Transported": np.asarray(test_pred).astype(bool),
    }
)
submission.to_csv("submission.csv", index=False)
