[model_eval_agent_1_1]: ```python
import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")

def add_features(df):
    out = df.copy()
    cabin_split = out["Cabin"].astype(str).str.split("/", expand=True)
    out["CabinDeck"] = cabin_split[0]
    out["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
    out["CabinSide"] = cabin_split[2]
    out["Group"] = out["PassengerId"].astype(str).str.split("_").str[0]
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out["Spending"] = out[spend_cols].fillna(0).sum(axis=1)
    out["NoSpending"] = (out["Spending"] == 0).astype(int)
    out["AgeGroup"] = pd.cut(
        out["Age"],
        bins=[-1, 12, 18, 30, 45, 60, 200],
        labels=["child", "teen", "young_adult", "adult", "middle_aged", "senior"],
    ).astype(str)
    out["TotalLuxury"] = out[["FoodCourt", "Spa", "VRDeck"]].fillna(0).sum(axis=1)
    out["TotalService"] = out[["RoomService", "ShoppingMall"]].fillna(0).sum(axis=1)
    out["LuxuryRatio"] = (
        out["TotalLuxury"] / (out["Spending"].replace(0, np.nan))
    ).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    out["FamilySize"] = out["Group"].map(out["Group"].value_counts()).astype(float)
    out["CabinNum"] = out["CabinNum"].fillna(-1)
    out["Age"] = out["Age"].fillna(out["Age"].median())
    out["Spending"] = out["Spending"].fillna(0)
    out["TotalLuxury"] = out["TotalLuxury"].fillna(0)
    out["TotalService"] = out["TotalService"].fillna(0)
    out["LuxuryRatio"] = out["LuxuryRatio"].fillna(0)
    out["FamilySize"] = out["FamilySize"].fillna(1)
    return out

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42, stratify=train_df["Transported"]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(add_features)
X_train = data_train_fe.drop(columns=["Transported"], errors="ignore").skb.mark_as_X()
y_train = data_train_fe["Transported"].skb.mark_as_y()

cat_cols = ["HomePlanet", "CryoSleep", "Destination", "VIP", "CabinDeck", "CabinSide", "AgeGroup", "Group"]
cat_cols = [c for c in cat_cols if c in train_part.columns or c in add_features(train_part).columns]

model = CatBoostClassifier(
    iterations=2000,
    learning_rate=0.03,
    depth=6,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=42,
)

pred_graph = X_train.skb.apply(model, y=y_train, cat_features=cat_cols)
learner = pred_graph.skb.make_learner(fitted=True)

valid_pred = learner.predict({"data": valid_part})
valid_pred_bool = np.array(valid_pred).astype(int)
final_validation_score = accuracy_score(valid_part["Transported"].astype(int), valid_pred_bool)
print(f"Final Validation Performance: {final_validation_score}")

full_data = skrub.var("data", train_df)
full_data_fe = full_data.skb.apply_func(add_features)
X_full = full_data_fe.drop(columns=["Transported"], errors="ignore").skb.mark_as_X()
y_full = full_data_fe["Transported"].skb.mark_as_y()

full_pred_graph = X_full.skb.apply(model, y=y_full, cat_features=cat_cols)
full_learner = full_pred_graph.skb.make_learner(fitted=True)

test_pred = full_learner.predict({"data": test_df})
test_pred = np.array(test_pred).astype(bool)

submission = pd.DataFrame(
    {
        "PassengerId": test_df["PassengerId"],
        "Transported": test_pred,
    }
)
submission.to_csv("submission.csv", index=False)
```
