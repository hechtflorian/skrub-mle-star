import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

random_state = 42
target_col = "Transported"

train_df = pd.read_csv("./input/train.csv")

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col].astype(int),
)

train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def add_features(df):
    out = df.copy()
    cabin = out["Cabin"].fillna("M/0/S").astype("string")
    cabin_split = cabin.str.split("/", expand=True)
    out["Deck"] = cabin_split[0]
    out["Num"] = cabin_split[1]
    out["Side"] = cabin_split[2]

    spent_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out["Spent"] = out[spent_cols].fillna(0).sum(axis=1)
    out["IsChild"] = (out["Age"].fillna(-1) < 13).astype(int)
    out["IsSolo"] = out["Name"].notna().astype(int)

    for col in spent_cols + ["Age"]:
        out[col] = pd.to_numeric(out[col], errors="coerce")

    out["Num"] = pd.to_numeric(out["Num"], errors="coerce")
    out["SpentLog1p"] = np.log1p(out["Spent"].fillna(0))
    out["CabinGroup"] = out["PassengerId"].astype("string").str.split("_").str[0]
    return out

data_train = skrub.var("data", train_part)
data_train_fe = data_train.skb.apply_func(add_features)

X_train = data_train_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train_fe[target_col].astype(int).skb.mark_as_y()

model = CatBoostClassifier(
    iterations=1500,
    depth=6,
    learning_rate=0.03,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=random_state,
)

pred_graph = X_train.skb.apply(skrub.TableVectorizer()).skb.apply(model, y=y_train)
val_learner = pred_graph.skb.make_learner(fitted=True)

valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = accuracy_score(valid_part[target_col].astype(int), valid_pred.astype(int))

print(f"Final Validation Performance: {final_validation_score}")
```
