import numpy as np
import pandas as pd
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split
from sklearn.impute import SimpleImputer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder
from sklearn.compose import ColumnTransformer
from lightgbm import LGBMClassifier
import skrub

# Load data
train_df = pd.read_csv("./input/train.csv")

target_col = "Transported"
random_state = 42

# Feature engineering
def add_features(df):
    df = df.copy()

    # Parse Cabin into Deck / Num / Side
    cabin_split = df["Cabin"].astype("string").str.split("/", expand=True)
    df["CabinDeck"] = cabin_split[0]
    df["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
    df["CabinSide"] = cabin_split[2]

    # Split Name
    name_split = df["Name"].astype("string").str.split(" ", n=1, expand=True)
    df["FirstName"] = name_split[0]
    df["LastName"] = name_split[1]

    # Group family size by last name
    df["FamilySize"] = df.groupby("LastName")["PassengerId"].transform("count")

    # Total spend
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df["TotalSpend"] = df[spend_cols].fillna(0).sum(axis=1)
    df["ZeroSpender"] = (df["TotalSpend"] == 0).astype(int)

    # Age bins
    df["AgeBin"] = pd.cut(
        df["Age"],
        bins=[-np.inf, 12, 18, 25, 35, 50, np.inf],
        labels=False,
    )

    return df

train_df = add_features(train_df)

# Holdout split
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# DataOps binding
data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

features = [
    c for c in X_train.columns
    if c not in ["PassengerId"]
]

X_model = X_train[features]

# Basic preprocessing + model
categorical_cols = X_model.select_dtypes(include=["object", "string", "category", "bool"]).columns.tolist()
numeric_cols = [c for c in X_model.columns if c not in categorical_cols]

preprocess = ColumnTransformer(
    transformers=[
        ("num", SimpleImputer(strategy="median"), numeric_cols),
        ("cat", Pipeline([
            ("imputer", SimpleImputer(strategy="most_frequent")),
            ("ohe", OneHotEncoder(handle_unknown="ignore")),
        ]), categorical_cols),
    ],
    remainder="drop",
)

model = LGBMClassifier(
    n_estimators=300,
    learning_rate=0.05,
    random_state=random_state,
    verbose=-1,
)

pred = X_model.skb.apply(preprocess).skb.apply(model, y=y_train)

# Fit on train_part only and predict on valid_part with matching feature schema
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
