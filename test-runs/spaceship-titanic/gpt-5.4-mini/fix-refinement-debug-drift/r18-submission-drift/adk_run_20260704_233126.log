import numpy as np
import pandas as pd
import skrub
from sklearn.impute import SimpleImputer
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import FunctionTransformer
from lightgbm import LGBMClassifier

def add_features(df):
    df = df.copy()

    # Cabin parsing
    cabin = df["Cabin"].astype("string")
    cabin_parts = cabin.str.split("/", expand=True)
    df["CabinDeck"] = cabin_parts[0]
    df["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
    df["CabinSide"] = cabin_parts[2]

    # Safer name parsing
    name = df["Name"].astype("string").fillna("")
    name_split = name.str.rsplit(" ", n=1, expand=True)
    if name_split.shape[1] == 2:
        df["FirstName"] = name_split[0].replace("", pd.NA)
        df["Surname"] = name_split[1].replace("", pd.NA)
    else:
        df["FirstName"] = name.replace("", pd.NA)
        df["Surname"] = pd.NA

    # Passenger family / group features
    if "PassengerId" in df.columns:
        passenger_prefix = df["PassengerId"].astype("string").fillna("").str.split("_", n=1, expand=True)
        if passenger_prefix.shape[1] == 2:
            df["PassengerGroup"] = passenger_prefix[0]
            df["PassengerGroupNum"] = pd.to_numeric(passenger_prefix[1], errors="coerce")
        else:
            df["PassengerGroup"] = passenger_prefix[0]
            df["PassengerGroupNum"] = pd.NA
    else:
        df["PassengerGroup"] = pd.NA
        df["PassengerGroupNum"] = pd.NA

    if "Surname" in df.columns and "PassengerGroup" in df.columns:
        group_cols = ["PassengerGroup", "Surname"]
        df["FamilyGroupSize"] = df.groupby(group_cols)[group_cols[0]].transform("size")
        df["FamilyGroupCount"] = df.groupby("Surname")[["PassengerGroup"]].transform("nunique")
    else:
        df["FamilyGroupSize"] = 0
        df["FamilyGroupCount"] = 0

    # Spend features: robust log-scaled totals + activity indicators
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    spend = df[spend_cols].fillna(0)
    df["TotalSpend"] = spend.sum(axis=1)
    df["LogTotalSpend"] = np.log1p(df["TotalSpend"])
    df["SpendStd"] = spend.std(axis=1).fillna(0.0)
    df["NoSpend"] = (df["TotalSpend"] <= 0).astype(int)
    df["AnySpend"] = (spend.gt(0).any(axis=1)).astype(int)

    # Age grouping
    df["AgeGroup"] = pd.cut(
        df["Age"],
        bins=[0, 12, 18, 25, 35, 50, 80],
        labels=["child", "teen", "young_adult", "adult", "mid_age", "senior"],
        include_lowest=True,
    )

    # Light cleanup for common missing-string fields
    for col in ["HomePlanet", "CryoSleep", "Destination", "VIP", "CabinDeck", "CabinSide", "PassengerGroup"]:
        if col in df.columns:
            df[col] = df[col].astype("string")

    return df


data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

X_model = X_train.skb.apply_func(add_features)

# Controlled encoding setup after feature engineering:
# - low-cardinality categoricals routed separately
# - high-cardinality strings handled with a lighter string encoder
# This keeps Cabin / Name-derived / PassengerId-derived fields from all using the same default route.
vectorizer = skrub.TableVectorizer(
    low_cardinality=skrub.ToCategorical(),
    high_cardinality=skrub.StringEncoder(),
)

model = LGBMClassifier(
    n_estimators=300,
    learning_rate=0.05,
    num_leaves=31,
    random_state=random_state,
    n_jobs=-1,
    verbose=-1,
)

pred = X_model.skb.apply(vectorizer).skb.apply(
    SimpleImputer(strategy="median")
).skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

valid_pred = np.asarray(valid_pred).ravel()
if valid_pred.dtype != bool:
    valid_pred = valid_pred > 0.5

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
```
