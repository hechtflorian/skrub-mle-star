        df["Age"],
        bins=[0, 12, 18, 25, 35, 50, 80],
        labels=["child", "teen", "young_adult", "adult", "mid_age", "senior"],
        include_lowest=True,
    )
    return df


def add_features_minimal(df):
    df = df.copy()
    cabin = df["Cabin"].astype("string")
    cabin_parts = cabin.str.split("/", expand=True)
    df["CabinDeck"] = cabin_parts[0]
    df["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
    df["CabinSide"] = cabin_parts[2]

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df["TotalSpend"] = df[spend_cols].sum(axis=1)
    df["NoSpend"] = (df["TotalSpend"] == 0).astype(int)
    return df


def add_features_drop_cabin_num(df):
    df = df.copy()
    cabin = df["Cabin"].astype("string")
    cabin_parts = cabin.str.split("/", expand=True)
    df["CabinDeck"] = cabin_parts[0]
    df["CabinSide"] = cabin_parts[2]

    name = df["Name"].astype("string")
    split_name = name.str.split(" ", n=1, expand=True)
    df["FirstName"] = split_name[0]
    df["Surname"] = split_name[1]

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    df["TotalSpend"] = df[spend_cols].sum(axis=1)
    df["SpendingMean"] = df[spend_cols].mean(axis=1)
    df["NoSpend"] = (df["TotalSpend"] == 0).astype(int)

    df["FamilySize"] = df.groupby("Surname")["Surname"].transform("size")
    df["IsAlone"] = (df["FamilySize"] == 1).astype(int)
    df["AgeGroup"] = pd.cut(
        df["Age"],
        bins=[0, 12, 18, 25, 35, 50, 80],
        labels=["child", "teen", "young_adult", "adult", "mid_age", "senior"],
        include_lowest=True,
    )
    return df


def score_variant(variant_name, fe_func=None, drop_cols=None):
    data_train = skrub.var("data", train_part)
    if fe_func is not None:
        data_train = data_train.skb.apply_func(fe_func)

    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    if drop_cols:
        X_train = X_train.skb.drop(columns=drop_cols, errors="ignore")

    vectorizer = skrub.TableVectorizer()
    model = LGBMClassifier(
        n_estimators=300,
        learning_rate=0.05,
        num_leaves=31,
        random_state=random_state,
        n_jobs=-1,
        verbose=-1,
    )

    pred = X_train.skb.apply(vectorizer).skb.apply(
        SimpleImputer(strategy="median")
    ).skb.apply(model, y=y_train)

    learner = pred.skb.make_learner(fitted=True)
    valid_data = valid_part.copy()
    if fe_func is not None:
        valid_data = fe_func(valid_data)
    if drop_cols:
        valid_data = valid_data.drop(columns=drop_cols, errors="ignore")

    valid_pred = learner.predict({"data": valid_data})
    valid_pred = np.asarray(valid_pred).ravel()
    if valid_pred.dtype != bool:
        valid_pred = valid_pred > 0.5

    score = accuracy_score(valid_part[target_col], valid_pred)
    print(f"Ablation[{variant_name}] {metric_label}: {score}")
    return score


scores = {}
scores["baseline"] = score_variant("baseline", fe_func=add_features_full)
scores["no_family"] = score_variant("no_family", fe_func=add_features_no_family)
scores["minimal_features"] = score_variant("minimal_features", fe_func=add_features_minimal)
scores["drop_cabin_num"] = score_variant(
    "drop_cabin_num", fe_func=add_features_drop_cabin_num, drop_cols=["CabinNum"]
)

best_variant = max(scores, key=scores.get)
best_score = scores[best_variant]
print(f"Best ablation variant: {best_variant} | {metric_label}: {best_score}")
