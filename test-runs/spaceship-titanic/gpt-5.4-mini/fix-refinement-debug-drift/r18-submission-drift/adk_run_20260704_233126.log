import numpy as np
import pandas as pd
import skrub
from sklearn.impute import SimpleImputer
from sklearn.model_selection import train_test_split
from lightgbm import LGBMClassifier
from sklearn.metrics import accuracy_score

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=random_state
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def add_features(df):
    out = df.copy()

    # Safer cabin parsing
    cabin = out.get("Cabin")
    if cabin is not None:
        cabin = cabin.astype("string")
        cabin_parts = cabin.str.split("/", n=2, expand=True)
        if cabin_parts.shape[1] > 0:
            out["CabinDeck"] = cabin_parts[0]
        if cabin_parts.shape[1] > 1:
            out["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
        if cabin_parts.shape[1] > 2:
            out["CabinSide"] = cabin_parts[2]

    # Safer name parsing
    name = out.get("Name")
    if name is not None:
        name = name.astype("string")
        name_parts = name.str.rsplit(" ", n=1, expand=True)
        out["FirstName"] = name_parts[0]
        if name_parts.shape[1] > 1:
            out["Surname"] = name_parts[1]
        else:
            out["Surname"] = pd.NA

    # Robust spend features: log-scaled total spend + zero spend indicator
    spend_cols = [c for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"] if c in out.columns]
    if spend_cols:
        spend = out[spend_cols].fillna(0)
        total_spend = spend.sum(axis=1)
        out["TotalSpend"] = total_spend
        out["LogTotalSpend"] = np.log1p(total_spend.clip(lower=0))
        out["ZeroSpend"] = (total_spend <= 0).astype(int)
        out["AnySpend"] = (spend.gt(0).any(axis=1)).astype(int)

    # Family size from surname when available
    if "Surname" in out.columns:
        surname_for_group = out["Surname"].fillna("MissingSurname")
        out["FamilySize"] = surname_for_group.groupby(surname_for_group).transform("size")
        out["IsAlone"] = (out["FamilySize"] == 1).astype(int)

        # Family-level spend aggregate can help separate shared vs solo travelers
        if spend_cols:
            out["FamilySpend"] = out.groupby(surname_for_group)[spend_cols].transform("sum").sum(axis=1)
            out["LogFamilySpend"] = np.log1p(out["FamilySpend"].clip(lower=0))

    # Passenger group hints if PassengerId is present
    if "PassengerId" in out.columns:
        passenger_id = out["PassengerId"].astype("string")
        pid_prefix = passenger_id.str.split("_", n=1, expand=True)
        if pid_prefix.shape[1] > 0:
            out["PassengerGroup"] = pid_prefix[0]
        if pid_prefix.shape[1] > 1:
            out["PassengerGroupMember"] = pd.to_numeric(pid_prefix[1], errors="coerce")
        if "PassengerGroup" in out.columns:
            out["GroupSize"] = out.groupby("PassengerGroup")["PassengerGroup"].transform("size")

    # Age bucketing retained
    if "Age" in out.columns:
        out["AgeGroup"] = pd.cut(
            out["Age"],
            bins=[0, 12, 18, 25, 35, 50, 80],
            labels=["child", "teen", "young_adult", "adult", "mid_age", "senior"],
            include_lowest=True,
        )

    return out


data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

X_model = X_train.skb.apply_func(add_features)

# Controlled encoding setup after feature engineering:
# - low-cardinality categoricals routed separately
# - high-cardinality strings handled with a lighter string encoder
# - keep all post-FE columns in the same vectorizer, but explicitly control encoding
vectorizer = skrub.TableVectorizer(
    low_cardinality=skrub.ToCategorical(),
    high_cardinality=skrub.StringEncoder(),
)

model = LGBMClassifier(
    n_estimators=300,
    learning_rate=0.05,
    num_leaves=31,
    random_state=random_state,
    n_jobs=-1,
    verbose=-1,
)

pred = X_model.skb.apply(vectorizer).skb.apply(
    SimpleImputer(strategy="median")
).skb.apply(model, y=y_train)

val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

valid_pred = np.asarray(valid_pred).ravel()
if valid_pred.dtype != bool:
    valid_pred = valid_pred > 0.5

final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")
