    score = accuracy_score(valid_part[target_col].astype(int), valid_pred.astype(int))
    print(f"Ablation[{variant_name}] accuracy: {score}")
    return score

scores = {}
scores["default_vectorizer"] = score_variant("default_vectorizer", build_default_graph)
scores["routed_encoders"] = score_variant("routed_encoders", build_routed_graph)

