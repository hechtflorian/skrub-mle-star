random_state = 42
target_col = "Transported"

train_path = os.path.join("./input", "train.csv")
train_df = pd.read_csv(train_path)

def add_features(df):
    out = df.copy()

    # Explicit categorical missing handling
    cat_cols = ["HomePlanet", "CryoSleep", "Destination", "VIP"]
    for col in cat_cols:
        if col in out.columns:
            out[col] = out[col].fillna("Missing").astype(str)

    # Cabin parsing and raw cabin removal
    cabin_split = out["Cabin"].fillna("X/X/X").astype(str).str.split("/", expand=True)
    out["CabinDeck"] = cabin_split[0].fillna("X")
    out["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
    out["CabinSide"] = cabin_split[2].fillna("X")
    out["CabinKnown"] = (out["Cabin"].notna()).astype(int)
    out = out.drop(columns=["Cabin"], errors="ignore")

    # Group/family summaries instead of raw surname
    out["Group"] = out["PassengerId"].astype(str).str.split("_").str[0]
    out["GroupSize"] = out["Group"].map(out.groupby("Group").size()).astype(float)
    out["IsAlone"] = (out["GroupSize"] == 1).astype(int)
    out["FamilyNameKnown"] = out["Name"].notna().astype(int)

    # Spend cleaning and log normalization
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    for col in spend_cols:
        if col in out.columns:
            out[col] = out[col].fillna(0)

    out["TotalSpend"] = out[spend_cols].sum(axis=1)
    out["NoSpend"] = (out["TotalSpend"] == 0).astype(int)

    for col in spend_cols + ["TotalSpend"]:
        out[f"{col}_log1p"] = np.log1p(out[col].clip(lower=0))

    # Age features
    out["Age"] = out["Age"].fillna(out["Age"].median())
    out["AgeGroup"] = pd.cut(
        out["Age"],
        bins=[-1, 12, 18, 25, 35, 50, 65, 200],
        labels=False,
    )
    out["SpendPerAge"] = (
        out["TotalSpend"] / out["Age"].replace(0, np.nan)
    ).replace([np.inf, -np.inf], np.nan).fillna(0.0)

    out["Group"] = out["Group"].fillna("Missing").astype(str)
    return out

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col],
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def build_default_graph(data_train):
    data_fe = data_train.skb.apply_func(add_features)
    X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_fe[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()
    model = lgb.LGBMClassifier(
        n_estimators=1200,
        learning_rate=0.03,
        num_leaves=31,
        subsample=0.8,
        colsample_bytree=0.8,
        random_state=random_state,
        n_jobs=-1,
        verbose=-1,
    )
    return X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

def build_routed_graph(data_train):
    data_fe = data_train.skb.apply_func(add_features)
    X_train = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_fe[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer(
        low_cardinality=skrub.ToCategorical(),
        high_cardinality=skrub.StringEncoder(),
    )
    model = lgb.LGBMClassifier(
        n_estimators=1200,
        learning_rate=0.03,
        num_leaves=31,
        subsample=0.8,
        colsample_bytree=0.8,
        random_state=random_state,
        n_jobs=-1,
        verbose=-1,
    )
    return X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

def score_variant(variant_name, build_graph):
    data_train = skrub.var("data", train_part)
    pred = build_graph(data_train)
