import os
import numpy as np
import pandas as pd
import skrub
import lightgbm as lgb
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

random_state = 42
target_col = "Transported"

train_path = os.path.join("./input", "train.csv")
train_df = pd.read_csv(train_path)

def add_features(df):
    out = df.copy()

    # Structural cleanup for missingness / noisy text columns
    for col in ["HomePlanet", "CryoSleep", "Destination", "VIP", "Age"]:
        if col in out.columns:
            if out[col].dtype == "O":
                out[col] = out[col].fillna("Unknown")
            else:
                out[col] = out[col].fillna(out[col].median())

    cabin = out["Cabin"].fillna("Unknown/Unknown/Unknown").astype(str)
    cabin_parts = cabin.str.split("/", n=2, expand=True)
    out["CabinDeck"] = cabin_parts[0].fillna("Unknown").replace("", "Unknown")
    out["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
    out["CabinSide"] = cabin_parts[2].fillna("Unknown").replace("", "Unknown")

    pid = out["PassengerId"].astype(str)
    out["Group"] = pid.str.split("_").str[0]
    out["GroupMember"] = pd.to_numeric(pid.str.split("_").str[1], errors="coerce")
    group_sizes = out.groupby("Group")["PassengerId"].transform("size")
    out["GroupSize"] = group_sizes.fillna(1).astype(int)
    out["IsAlone"] = (out["GroupSize"] == 1).astype(int)

    # Prefer robust, low-noise name-derived signal over raw surname text
    name = out["Name"].fillna("Unknown").astype(str)
    out["NameLength"] = name.str.len().fillna(0).astype(int)
    out["HasTitle"] = name.str.contains(r"\b(Mr|Mrs|Miss|Dr|Master|Rev|Col|Major|Capt|Sir|Lady|Mme|Mlle)\b", regex=True, na=False).astype(int)

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    spend = out[spend_cols].fillna(0)
    out["TotalSpend"] = spend.sum(axis=1)
    out["NoSpend"] = (out["TotalSpend"] == 0).astype(int)
    out["SpendVar"] = spend.var(axis=1).fillna(0.0)
    out["SpendMax"] = spend.max(axis=1)
    out["LuxurySpend"] = spend[["Spa", "VRDeck"]].sum(axis=1)
    out["EssentialSpend"] = spend[["RoomService", "FoodCourt", "ShoppingMall"]].sum(axis=1)

    out["CabinKnown"] = out["Cabin"].notna().astype(int)
    out["CabinNumKnown"] = out["CabinNum"].notna().astype(int)
    out["CabinNum"] = out["CabinNum"].fillna(-1).astype(int)

    age = pd.to_numeric(out["Age"], errors="coerce")
    out["AgeMissing"] = age.isna().astype(int)
    out["Age"] = age.fillna(age.median())
    out["AgeGroup"] = pd.cut(out["Age"], bins=[-1, 12, 18, 25, 35, 50, 65, 200], labels=False).astype("float")
    out["AgeGroup"] = out["AgeGroup"].fillna(-1).astype(int)

    denom = out["Age"].replace(0, np.nan)
    out["SpendPerAge"] = (out["TotalSpend"] / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    out["CabinPerSpend"] = (out["CabinNum"].replace(-1, np.nan) / (out["TotalSpend"].replace(0, np.nan))).replace([np.inf, -np.inf], np.nan).fillna(0.0)

    # Mildly consolidate the most helpful categorical structure
    out["DeckSide"] = out["CabinDeck"].astype(str) + "_" + out["CabinSide"].astype(str)
    out["PlanetSleep"] = out["HomePlanet"].astype(str) + "_" + out["CryoSleep"].astype(str)

    return out

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col],
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
data_train = data_train.skb.apply_func(add_features)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

vectorizer_lgbm = skrub.TableVectorizer()
vectorizer_cat = skrub.TableVectorizer()

model_lgbm = lgb.LGBMClassifier(
    n_estimators=1200,
    learning_rate=0.03,
    num_leaves=31,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=random_state,
    n_jobs=-1,
    verbose=-1,
)

model_cat = CatBoostClassifier(
    iterations=300,
    depth=6,
    learning_rate=0.08,
    loss_function="Logloss",
    random_seed=random_state,
    verbose=0,
)

pred_lgbm = X_train.skb.apply(vectorizer_lgbm).skb.apply(model_lgbm, y=y_train)
pred_cat = X_train.skb.apply(vectorizer_cat).skb.apply(model_cat, y=y_train)

learner_lgbm = pred_lgbm.skb.make_learner(fitted=True)
learner_cat = pred_cat.skb.make_learner(fitted=True)

valid_features = add_features(valid_part.copy())

valid_pred_lgbm = learner_lgbm.predict({"data": valid_features})
valid_pred_cat = learner_cat.predict({"data": valid_features})

valid_pred_lgbm = np.asarray(valid_pred_lgbm)
valid_pred_cat = np.asarray(valid_pred_cat)

if valid_pred_lgbm.dtype != bool:
    if np.issubdtype(valid_pred_lgbm.dtype, np.floating):
        valid_pred_lgbm = valid_pred_lgbm >= 0.5
    else:
        valid_pred_lgbm = pd.Series(valid_pred_lgbm).astype(str).str.lower().isin(["true", "1", "yes"]).to_numpy()

if valid_pred_cat.dtype != bool:
    if np.issubdtype(valid_pred_cat.dtype, np.floating):
        valid_pred_cat = valid_pred_cat >= 0.5
    else:
        valid_pred_cat = pd.Series(valid_pred_cat).astype(str).str.lower().isin(["true", "1", "yes"]).to_numpy()

cat_only_pred = valid_pred_cat.astype(int)
blend_pred = ((valid_pred_lgbm.astype(float) + valid_pred_cat.astype(float)) / 2.0) >= 0.5

cat_only_score = accuracy_score(valid_part[target_col].astype(int), cat_only_pred)
blend_score = accuracy_score(valid_part[target_col].astype(int), blend_pred.astype(int))

if cat_only_score >= blend_score:
    final_validation_score = cat_only_score
else:
    final_validation_score = blend_score

print(f"Final Validation Performance: {final_validation_score}")
```
