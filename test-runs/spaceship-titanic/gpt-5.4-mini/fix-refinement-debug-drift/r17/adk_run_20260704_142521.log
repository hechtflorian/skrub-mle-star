import os
import numpy as np
import pandas as pd
import skrub
import lightgbm as lgb
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.preprocessing import OneHotEncoder

random_state = 42
target_col = "Transported"

train_path = os.path.join("./input", "train.csv")
train_df = pd.read_csv(train_path)

def add_features(df):
    out = df.copy()

    # Explicit categorical cleaning
    cat_cols = ["HomePlanet", "CryoSleep", "Destination", "VIP"]
    for col in cat_cols:
        if col in out.columns:
            out[col] = out[col].fillna("Missing").astype(str)

    # Robust cabin parsing, then drop raw Cabin later in the pipeline
    cabin_filled = out["Cabin"].fillna("Missing").astype(str)
    cabin_split = cabin_filled.str.split("/", expand=False)
    out["CabinDeck"] = cabin_split.str[0].fillna("Missing").astype(str)
    out["CabinNum"] = pd.to_numeric(cabin_split.str[1], errors="coerce")
    out["CabinSide"] = cabin_split.str[2].fillna("Missing").astype(str)

    # Group / family summary features
    out["Group"] = out["PassengerId"].astype(str).str.split("_").str[0]
    out["GroupSize"] = out.groupby("Group")["PassengerId"].transform("size").astype(float)
    out["IsAlone"] = (out["GroupSize"] == 1).astype(int)
    out["FamilyNameKnown"] = out["Name"].notna().astype(int)

    # Better-behaved spend features
    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    for col in spend_cols:
        if col in out.columns:
            out[col] = out[col].fillna(0)
            out[f"{col}Log1p"] = np.log1p(out[col].clip(lower=0))

    out["TotalSpend"] = out[spend_cols].fillna(0).sum(axis=1)
    out["TotalSpendLog1p"] = np.log1p(out["TotalSpend"].clip(lower=0))
    out["NoSpend"] = (out["TotalSpend"] == 0).astype(int)

    out["Age"] = pd.to_numeric(out["Age"], errors="coerce")
    out["AgeGroup"] = pd.cut(out["Age"], bins=[-1, 12, 18, 25, 35, 50, 65, 200], labels=False)
    out["SpendPerAge"] = (out["TotalSpend"] / out["Age"].replace(0, np.nan)).replace([np.inf, -np.inf], np.nan).fillna(0.0)

    out["CabinKnown"] = (out["Cabin"].notna()).astype(int)

    # Drop brittle / redundant raw string columns after extracting signal
    out = out.drop(columns=["Cabin", "Surname"], errors="ignore")
    return out

def make_default_graph(data_train):
    data_fe = data_train.skb.apply_func(add_features)
    X = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_fe[target_col].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer()
    pred = X.skb.apply(vectorizer).skb.apply(
        lgb.LGBMClassifier(
            n_estimators=1200,
            learning_rate=0.03,
            num_leaves=31,
            subsample=0.8,
            colsample_bytree=0.8,
            random_state=random_state,
            n_jobs=-1,
            verbose=-1,
        ),
        y=y,
    )
    return pred

def make_routed_graph(data_train):
    data_fe = data_train.skb.apply_func(add_features)
    X = data_fe.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data_fe[target_col].skb.mark_as_y()

    low_card = skrub.TableVectorizer(
        low_cardinality=OneHotEncoder(handle_unknown="ignore", sparse_output=True),
        high_cardinality=skrub.StringEncoder(),
    )
    pred = X.skb.apply(low_card).skb.apply(
        lgb.LGBMClassifier(
            n_estimators=1200,
            learning_rate=0.03,
            num_leaves=31,
            subsample=0.8,
            colsample_bytree=0.8,
            random_state=random_state,
            n_jobs=-1,
            verbose=-1,
        ),
        y=y,
    )
    return pred

def score_variant(variant_name, build_graph):
    data_train = skrub.var("data", train_part)
    pred = build_graph(data_train)
    learner = pred.skb.make_learner(fitted=True)
    valid_pred = learner.predict({"data": valid_part})
    valid_pred = np.asarray(valid_pred)

    if valid_pred.dtype != bool:
        if np.issubdtype(valid_pred.dtype, np.floating):
            valid_pred = valid_pred >= 0.5
        else:
            valid_pred = pd.Series(valid_pred).astype(str).str.lower().isin(["true", "1", "yes"]).to_numpy()

    score = accuracy_score(valid_part[target_col].astype(int), valid_pred.astype(int))
    print(f"Ablation[{variant_name}] accuracy: {score}")
    return score, learner

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=random_state,
    stratify=train_df[target_col],
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

scores = {}
learners = {}

scores["baseline"], learners["baseline"] = score_variant("baseline", make_default_graph)
scores["routed"], learners["routed"] = score_variant("routed", make_routed_graph)

best_variant = max(scores, key=scores.get)
best_score = scores[best_variant]
best_learner = learners[best_variant]

print(f"Best ablation variant: {best_variant} | accuracy: {best_score}")
final_validation_score = best_score
print(f"Final Validation Performance: {final_validation_score}")
```
