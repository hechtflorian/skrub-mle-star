    "simpler_model",
    vectorizer=skrub.TableVectorizer(),
    model_kwargs={"num_leaves": 31, "n_estimators": 1200},
)

best_variant = min(results, key=results.get)
best_score = results[best_variant]
baseline_score = results["baseline"]

print(f"Final Validation Performance: {baseline_score:.6f}")
print(f"Best ablation variant: {best_variant} | RMSE: {best_score:.6f}")

improvements = {k: baseline_score - v for k, v in results.items()}
most_important = max(
    (k for k in results if k != "baseline"),
    key=lambda k: abs(improvements[k]),
)
print(
    f"Most impactful change: {most_important} | "
    f"RMSE delta vs baseline: {improvements[most_important]:.6f}"
)
