import os
import pandas as pd
import numpy as np
import skrub
from xgboost import XGBRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "median_house_value"

data = skrub.var("data", train_df)
X = data.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y = data[target_col].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()
X_vec = X.skb.apply(vectorizer)

model = XGBRegressor(
    n_estimators=2000,
    learning_rate=0.03,
    max_depth=6,
    subsample=0.8,
    colsample_bytree=0.8,
    reg_lambda=1.0,
    random_state=42,
    tree_method="hist",
)

predictor = X_vec.skb.apply(model, y=y)
learner = predictor.skb.make_learner(fitted=True)

X_train, X_val, y_train, y_val = train_test_split(
    train_df.drop(columns=[target_col]),
    train_df[target_col],
    test_size=0.2,
    random_state=42,
)

val_learner = predictor.skb.make_learner(fitted=False)
val_learner.fit({"data": pd.concat([X_train, y_train], axis=1)})
val_pred = val_learner.predict({"data": X_val})
rmse = mean_squared_error(y_val, val_pred) ** 0.5

print(f"Final Validation Performance: {rmse}")

learner.fit({"data": train_df})
test_preds = learner.predict({"data": test_df})
submission = pd.DataFrame({target_col: test_preds})
submission.to_csv("submission.csv", index=False)
