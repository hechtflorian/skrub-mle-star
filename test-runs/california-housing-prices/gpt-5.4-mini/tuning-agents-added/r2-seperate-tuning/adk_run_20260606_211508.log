import os
import warnings
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")

try:
    import skrub
except Exception as e:
    raise ImportError("skrub is required for this solution") from e

from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

TARGET = "median_house_value"
INPUT_DIR = "./input"
TRAIN_PATH = os.path.join(INPUT_DIR, "train.csv")
TEST_PATH = os.path.join(INPUT_DIR, "test.csv")
SUBSAMPLE_N = 20000  # keep subsampling if exists


def load_data():
    train_df = pd.read_csv(TRAIN_PATH)
    test_df = pd.read_csv(TEST_PATH)
    return train_df, test_df


def build_pipeline(data_df, use_choices=False):
    data = skrub.var("data", data_df)

    # Keep DataOps structure intact
    X = data.drop(columns=TARGET, errors="ignore").skb.mark_as_X()
    y = data[TARGET].skb.mark_as_y()

    if use_choices:
        max_depth = skrub.choose_int(3, 12, name="max_depth")
        learning_rate = skrub.choose_float(0.01, 0.2, log=True, name="learning_rate")
        max_leaf_nodes = skrub.choose_int(15, 63, name="max_leaf_nodes")
        min_samples_leaf = skrub.choose_int(10, 80, name="min_samples_leaf")
        l2_regularization = skrub.choose_float(1e-6, 10.0, log=True, name="l2_regularization")
    else:
        max_depth = 8
        learning_rate = 0.08
        max_leaf_nodes = 31
        min_samples_leaf = 20
        l2_regularization = 0.1

    vectorizer = skrub.TableVectorizer(
        low_cardinality="passthrough",
        high_cardinality="passthrough",
    )

    model = HistGradientBoostingRegressor(
        max_depth=max_depth,
        learning_rate=learning_rate,
        max_leaf_nodes=max_leaf_nodes,
        min_samples_leaf=min_samples_leaf,
        l2_regularization=l2_regularization,
        random_state=42,
    )

    pred = X.skb.apply(vectorizer).skb.apply(model, y=y)
    return pred


def evaluate_holdout(train_df):
    train_part, val_part = train_test_split(train_df, test_size=0.2, random_state=42)

    pred = build_pipeline(train_part, use_choices=False)
    learner = pred.skb.make_learner(fitted=True)
    val_pred = learner.predict({"data": val_part})

    rmse = mean_squared_error(val_part[TARGET], val_pred) ** 0.5
    print(f"Final Validation Performance: {rmse}")
    return learner, rmse


def train_full_and_predict(train_df, test_df):
    data = skrub.var("data", train_df)
    X = data.drop(columns=TARGET, errors="ignore").skb.mark_as_X()
    y = data[TARGET].skb.mark_as_y()

    vectorizer = skrub.TableVectorizer(
        low_cardinality="passthrough",
        high_cardinality="passthrough",
    )

    model = HistGradientBoostingRegressor(
        max_depth=8,
        learning_rate=0.08,
        max_leaf_nodes=31,
        min_samples_leaf=20,
        l2_regularization=0.1,
        random_state=42,
    )

    pred = X.skb.apply(vectorizer).skb.apply(model, y=y)
    learner = pred.skb.make_learner(fitted=True)
    test_pred = learner.predict({"data": test_df})
    return test_pred


def main():
    train_df, test_df = load_data()

    # Keep subsampling for fast iteration if dataset is large
    if len(train_df) > SUBSAMPLE_N:
        preview_df = train_df.sample(n=SUBSAMPLE_N, random_state=42)
    else:
        preview_df = train_df

    _, final_validation_score = evaluate_holdout(preview_df)

    # Train on full data for predictions
    test_pred = train_full_and_predict(train_df, test_df)

    submission = pd.DataFrame({TARGET: test_pred})
    submission.to_csv("submission.csv", index=False)

    print(f"Final Validation Performance: {final_validation_score}")


if __name__ == "__main__":
    main()
