import pandas as pd
import numpy as np
import skrub
import lightgbm as lgb
from sklearn.metrics import mean_squared_error

train_path = os.path.join("./input", "train.csv")
train_df = pd.read_csv(train_path)

target_col = "median_house_value"

def fit_and_score(train_frame, variant_name, vectorizer=None, model_kwargs=None, feature_func=None):
    data = skrub.var("data", train_frame)

    if feature_func is not None:
        data = data.skb.apply_func(feature_func)

    X = data.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
    y = data[target_col].skb.mark_as_y()

    if vectorizer is None:
        vectorizer = skrub.TableVectorizer()

    X_vec = X.skb.apply(vectorizer)

    if model_kwargs is None:
        model_kwargs = {}

    model = lgb.LGBMRegressor(
        n_estimators=2000,
        learning_rate=0.03,
        num_leaves=64,
        subsample=0.8,
        colsample_bytree=0.8,
        random_state=42,
        **model_kwargs,
    )

    predictor = X_vec.skb.apply(model, y=y)
    learner = predictor.skb.make_learner(fitted=True)

    preds = learner.predict({"data": train_frame})
    rmse = mean_squared_error(train_frame[target_col], preds) ** 0.5
    print(f"Ablation[{variant_name}] RMSE: {rmse:.6f}")
    return rmse


def add_ratio_features(df):
    out = df.copy()
    denom_households = out["households"].replace(0, np.nan)
    denom_rooms = out["total_rooms"].replace(0, np.nan)

    out["rooms_per_household"] = (out["total_rooms"] / denom_households).replace(
        [np.inf, -np.inf], np.nan
    ).fillna(0.0)
    out["bedrooms_per_room"] = (out["total_bedrooms"] / denom_rooms).replace(
        [np.inf, -np.inf], np.nan
    ).fillna(0.0)
    out["population_per_household"] = (out["population"] / denom_households).replace(
        [np.inf, -np.inf], np.nan
    ).fillna(0.0)
    return out


results = {}

# Baseline: current solution
results["baseline"] = fit_and_score(
    train_df,
    "baseline",
    vectorizer=skrub.TableVectorizer(),
)

# Ablation 1: drop one redundant correlated feature (households)
data_drop = skrub.var("data", train_df)
X_drop = data_drop.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
y_drop = data_drop[target_col].skb.mark_as_y()

X_drop = X_drop.skb.apply(skrub.DropCols(cols=["households"]))
X_drop_vec = X_drop.skb.apply(skrub.TableVectorizer())
model_drop = lgb.LGBMRegressor(
    n_estimators=2000,
    learning_rate=0.03,
    num_leaves=64,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=42,
)
pred_drop = X_drop_vec.skb.apply(model_drop, y=y_drop)
learner_drop = pred_drop.skb.make_learner(fitted=True)
preds_drop = learner_drop.predict({"data": train_df})
results["drop_households"] = mean_squared_error(train_df[target_col], preds_drop) ** 0.5
print(f"Ablation[drop_households] RMSE: {results['drop_households']:.6f}")

# Ablation 2: add ratio features to address redundancy and scale relationships
results["ratio_features"] = fit_and_score(
    train_df,
    "ratio_features",
    vectorizer=skrub.TableVectorizer(),
    feature_func=add_ratio_features,
)

# Ablation 3: slightly simpler model to test whether model capacity is carrying performance
results["simpler_model"] = fit_and_score(
