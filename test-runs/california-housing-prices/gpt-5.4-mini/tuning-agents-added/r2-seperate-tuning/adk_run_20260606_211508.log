import os
import warnings
import numpy as np
import pandas as pd

from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error

import skrub

warnings.filterwarnings("ignore")


TARGET = "median_house_value"
TRAIN_PATH = os.path.join("./input", "train.csv")
TEST_PATH = os.path.join("./input", "test.csv")
SUBMISSION_PATH = "submission.csv"


def add_features(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()

    # Safe engineered features
    eps = 1e-6
    if "total_rooms" in df.columns and "households" in df.columns:
        df["rooms_per_household"] = df["total_rooms"] / (df["households"].replace(0, np.nan) + eps)
    if "total_bedrooms" in df.columns and "total_rooms" in df.columns:
        df["bedrooms_per_room"] = df["total_bedrooms"] / (df["total_rooms"].replace(0, np.nan) + eps)
    if "population" in df.columns and "households" in df.columns:
        df["population_per_household"] = df["population"] / (df["households"].replace(0, np.nan) + eps)
    if "population" in df.columns and "total_rooms" in df.columns:
        df["population_per_room"] = df["population"] / (df["total_rooms"].replace(0, np.nan) + eps)

    # Geospatial interaction
    if "longitude" in df.columns and "latitude" in df.columns:
        df["lon_lat_product"] = df["longitude"] * df["latitude"]
        df["abs_lon"] = df["longitude"].abs()
        df["abs_lat"] = df["latitude"].abs()

    # Mild transforms for skewed count features
    for col in ["total_rooms", "total_bedrooms", "population", "households"]:
        if col in df.columns:
            df[f"log1p_{col}"] = np.log1p(np.maximum(df[col].astype(float), 0))

    return df


def prepare_data(train_df: pd.DataFrame):
    data = skrub.var("data", train_df)

    data_fe = data.skb.apply_func(add_features)
    X = data_fe.drop(columns=TARGET, errors="ignore").skb.mark_as_X()
    y = data_fe[TARGET].skb.mark_as_y()

    # Keep the existing model, only using it in the DataOps graph
    model = HistGradientBoostingRegressor(
        learning_rate=0.05,
        max_depth=8,
        max_iter=300,
        min_samples_leaf=20,
        l2_regularization=0.0,
        random_state=42,
    )

    pred = X.skb.apply(skrub.TableVectorizer(),).skb.apply(model, y=y)
    return pred


def main():
    train_df = pd.read_csv(TRAIN_PATH)
    test_df = pd.read_csv(TEST_PATH)

    # Basic cleanup for missing target rows, if any
    train_df = train_df.dropna(subset=[TARGET]).reset_index(drop=True)

    # Holdout validation
    rng = np.random.RandomState(42)
    idx = np.arange(len(train_df))
    rng.shuffle(idx)
    split = int(len(idx) * 0.8)
    tr_idx, va_idx = idx[:split], idx[split:]

    train_part = train_df.iloc[tr_idx].reset_index(drop=True)
    valid_part = train_df.iloc[va_idx].reset_index(drop=True)

    # Build DataOps pipeline on training split
    pred = prepare_data(train_part)

    learner = pred.skb.make_learner(fitted=True)
    valid_pred = learner.predict({"data": valid_part})

    y_valid = valid_part[TARGET].values
    final_validation_score = mean_squared_error(y_valid, valid_pred) ** 0.5
    print(f"Final Validation Performance: {final_validation_score}")

    # Fit on full training data for test prediction
    full_pred = prepare_data(train_df)
    full_learner = full_pred.skb.make_learner(fitted=True)
    test_pred = full_learner.predict({"data": test_df})

    submission = pd.DataFrame({TARGET: test_pred})
    submission.to_csv(SUBMISSION_PATH, index=False)


if __name__ == "__main__":
    main()
