        out["rooms_per_person"] = (out["total_rooms"] / denom).replace(
            [np.inf, -np.inf], np.nan
        ).fillna(0.0)
    return out

@skrub.deferred
def ratio_plus_drop_households(df):
    # Fully deferred: operate on the dataframe-like object inside skrub's graph.
    out = add_house_feature_ratios(df)
    if "households" in out.columns:
        out = out.drop(columns=["households"])
    return out

def build_graph(data_df):
