import pandas as pd
import skrub
from catboost import CatBoostRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

# Load data
train_path = "./input/train.csv"
train_df = pd.read_csv(train_path)

target_col = "median_house_value"

# Keep the same validation split as the original solution
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def run_ablation(variant_name, feature_fn=None, vectorizer=None):
    if vectorizer is None:
        vectorizer = skrub.TableVectorizer()

    data_train = skrub.var("data", train_part)

    if feature_fn is not None:
        data_train = data_train.skb.apply_func(feature_fn)

    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    model = CatBoostRegressor(
        iterations=3000,
        learning_rate=0.03,
        depth=8,
        loss_function="RMSE",
        random_seed=42,
        verbose=0,
        allow_writing_files=False,
    )

    pred_graph = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
    val_learner = pred_graph.skb.make_learner(fitted=True)
    valid_pred = val_learner.predict({"data": valid_part})
    rmse = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
    print(f"Ablation[{variant_name}] RMSE: {rmse:.6f}")
    return rmse

@skrub.deferred
def add_house_feature_ratios(df):
    out = df.copy()
    if "total_rooms" in out.columns and "households" in out.columns:
        denom = out["households"].replace(0, np.nan)
        out["rooms_per_household"] = (
            out["total_rooms"] / denom
        ).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    if "population" in out.columns and "households" in out.columns:
        denom = out["households"].replace(0, np.nan)
        out["population_per_household"] = (
            out["population"] / denom
        ).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    if "total_bedrooms" in out.columns and "total_rooms" in out.columns:
        denom = out["total_rooms"].replace(0, np.nan)
        out["bedrooms_per_room"] = (
            out["total_bedrooms"] / denom
        ).replace([np.inf, -np.inf], np.nan).fillna(0.0)
    return out

@skrub.deferred
def drop_households(df):
    out = df.copy()
    if "households" in out.columns:
        out = out.drop(columns=["households"])
    return out

# Baseline: original feature engineering
scores = {}
scores["baseline_ratio_features"] = run_ablation(
    "baseline_ratio_features", feature_fn=add_house_feature_ratios
)

# Ablation 1: disable derived ratio features
scores["no_ratio_features"] = run_ablation(
    "no_ratio_features", feature_fn=None
)

# Ablation 2: keep ratios, but drop a highly correlated redundant column
# Correlation profile suggests households is strongly redundant with other count features.
def ratio_plus_drop_households(df):
    out = add_house_feature_ratios(df)
    if "households" in out.columns:
        out = out.drop(columns=["households"])
    return out

scores["ratios_drop_households"] = run_ablation(
    "ratios_drop_households", feature_fn=ratio_plus_drop_households
)

# Ablation 3: change encoding behavior using a smaller/faster high-cardinality encoder
# This tests whether the default TableVectorizer encoding choice is important.
fast_vectorizer = skrub.TableVectorizer(
    high_cardinality=skrub.MinHashEncoder(n_components=8)
)
scores["ratio_features_fast_encoding"] = run_ablation(
    "ratio_features_fast_encoding",
    feature_fn=add_house_feature_ratios,
    vectorizer=fast_vectorizer,
)

# Summarize impact relative to the baseline
baseline = scores["baseline_ratio_features"]
print("\nAblation impact vs baseline:")
for name, score in scores.items():
    delta = score - baseline
    print(f"{name}: RMSE={score:.6f} | delta_vs_baseline={delta:+.6f}")

best_variant = min(scores, key=scores.get)
best_score = scores[best_variant]
best_improvement = baseline - best_score

print(f"\nBest ablation variant: {best_variant} | RMSE: {best_score:.6f}")
print(
    f"Most important contributor (largest RMSE gain vs baseline): {best_variant} "
    f"with improvement {best_improvement:.6f}"
)
