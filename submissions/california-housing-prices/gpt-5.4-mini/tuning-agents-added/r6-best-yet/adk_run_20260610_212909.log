# -------------------------
data_train_1 = skrub.var("data", train_part)
data_train_fe_1 = data_train_1.skb.apply_func(add_house_feature_ratios)

X_train_1 = data_train_fe_1.drop(columns=target_col, errors="ignore").skb.mark_as_X()
