    # Apply the feature engineering inside the DataOps graph.
    data_fe = data.skb.apply_func(ratio_plus_drop_households)

    X = data_fe.drop(columns=TARGET_COL, errors="ignore").skb.mark_as_X()
    y = data_fe[TARGET_COL].skb.mark_as_y()

    # Keep the same backbone estimator class family in spirit: tree ensemble regressor.
    model = RandomForestRegressor(
