import os
import json
import warnings
import numpy as np
import pandas as pd
import skrub
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split
from catboost import CatBoostRegressor

warnings.filterwarnings("ignore")


def safe_int(v, default):
    try:
        if hasattr(v, "item"):
            v = v.item()
        return int(v)
    except Exception:
        return int(default)


def safe_float(v, default):
    try:
        if hasattr(v, "item"):
            v = v.item()
        return float(v)
    except Exception:
        return float(default)


def load_data():
    train_path = os.path.join("./input", "train.csv")
    test_path = os.path.join("./input", "test.csv")
    train_df = pd.read_csv(train_path)
    test_df = pd.read_csv(test_path)
    return train_df, test_df


train_df, test_df = load_data()
target_col = "median_house_value"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# Resolve tunable values to concrete Python scalars before passing to CatBoost.
# Keep DataOps structure, but avoid unresolved skrub choice objects in estimator kwargs.
iterations = 800
depth = 8
learning_rate = 0.05

# If any prior code path still produces choice-like values, force concrete resolution.
iterations = safe_int(iterations, 800)
depth = safe_int(depth, 8)
learning_rate = safe_float(learning_rate, 0.05)

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Keep the same backbone estimator/model class.
model = CatBoostRegressor(
    iterations=iterations,
    learning_rate=learning_rate,
    depth=depth,
    loss_function="RMSE",
    random_seed=42,
    verbose=False,
    subsample=0.8,
    bootstrap_type="Bernoulli",
)

pred = X_train.skb.apply(model, y=y_train)
val_learner = pred.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

# Submission-stage block only: refit on full train and predict test.
data_full = skrub.var("data", train_df)
X_full = data_full.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].skb.mark_as_y()

full_model = CatBoostRegressor(
    iterations=iterations,
    learning_rate=learning_rate,
    depth=depth,
    loss_function="RMSE",
    random_seed=42,
    verbose=False,
    subsample=0.8,
    bootstrap_type="Bernoulli",
)

full_pred = X_full.skb.apply(full_model, y=y_full)
full_learner = full_pred.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df})

submission = pd.DataFrame({target_col: test_pred})
