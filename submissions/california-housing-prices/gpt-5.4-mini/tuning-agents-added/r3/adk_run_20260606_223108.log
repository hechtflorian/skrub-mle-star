[ablation_agent_1]: import os
import pandas as pd
import numpy as np
import skrub
from lightgbm import LGBMRegressor
from sklearn.metrics import mean_squared_error

# Load data
train_path = os.path.join("./input", "train.csv")
train_df = pd.read_csv(train_path)

target = "median_house_value"

# Keep the same validation split as the original solution
train_idx = np.random.RandomState(42).permutation(len(train_df))
val_size = int(len(train_df) * 0.2)
val_idx = train_idx[:val_size]
fit_idx = train_idx[val_size:]

fit_df = train_df.iloc[fit_idx].reset_index(drop=True)
val_df = train_df.iloc[val_idx].reset_index(drop=True)

def run_ablation(name, vectorizer_kwargs=None, drop_cols=None, add_ratio=False):
    vectorizer_kwargs = vectorizer_kwargs or {}

    fit_data = skrub.var("data", fit_df)
    val_data = skrub.var("data", val_df)

    def add_features(df):
        out = df.copy()
        if add_ratio:
            denom = out["households"].replace(0, np.nan)
            out["rooms_per_household"] = (out["total_rooms"] / denom).replace(
                [np.inf, -np.inf], np.nan
            ).fillna(0.0)
            out["bedrooms_per_household"] = (out["total_bedrooms"] / denom).replace(
                [np.inf, -np.inf], np.nan
            ).fillna(0.0)
        return out

    fit_data = fit_data.skb.apply_func(add_features)
    val_data = val_data.skb.apply_func(add_features)

    X_fit = fit_data.drop(columns=target, errors="ignore").skb.mark_as_X()
    y_fit = fit_data[target].skb.mark_as_y()

    X_val = val_data.drop(columns=target, errors="ignore").skb.mark_as_X()
    y_val = val_df[target].values

    if drop_cols:
        X_fit = X_fit.skb.apply(lambda df: df.drop(columns=drop_cols, errors="ignore"))
        X_val = X_val.skb.apply(lambda df: df.drop(columns=drop_cols, errors="ignore"))

    vectorizer = skrub.TableVectorizer(**vectorizer_kwargs)
    X_fit_vec = X_fit.skb.apply(vectorizer)

    model = LGBMRegressor(
        n_estimators=2000,
        learning_rate=0.03,
        num_leaves=31,
        subsample=0.8,
        colsample_bytree=0.8,
        random_state=42,
    )

    predictor = X_fit_vec.skb.apply(model, y=y_fit)
    learner = predictor.skb.make_learner(fitted=True)
    _ = learner.predict({"data": fit_df})
    val_pred = learner.predict({"data": val_df})

