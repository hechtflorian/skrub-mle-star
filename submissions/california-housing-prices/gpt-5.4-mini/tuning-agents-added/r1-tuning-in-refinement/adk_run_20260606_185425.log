import os
import json
import warnings

import numpy as np
import pandas as pd
from sklearn.metrics import mean_squared_error

import skrub

warnings.filterwarnings("ignore")


def load_data():
    train_path = os.path.join("./input", "train.csv")
    test_path = os.path.join("./input", "test.csv")
    train_df = pd.read_csv(train_path)
    test_df = pd.read_csv(test_path)
    return train_df, test_df


def build_pred(train_df):
    target_col = "median_house_value"

    data = skrub.var("data", train_df)

    X = data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data[target_col].skb.mark_as_y()

    # Keep DataOps structure, but make sure CatBoost receives concrete values.
    # The bug came from passing skrub choice objects directly into CatBoost.
    # Use fixed numeric hyperparameters here to preserve the existing model
    # while avoiding JSON serialization failures during fit.
    model = skrub.CatBoostRegressor(
        iterations=800,
        depth=8,
        learning_rate=0.05,
        loss_function="RMSE",
        random_seed=42,
        verbose=False,
    )

    # Use a robust default TableVectorizer for numeric/tabular data.
    vectorizer = skrub.TableVectorizer()

    pred = X.skb.apply(vectorizer).skb.apply(model, y=y)
    return pred


def main():
