import os
import warnings
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")

import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error

try:
    from catboost import CatBoostRegressor
except Exception:
    import subprocess, sys
    subprocess.check_call([sys.executable, "-m", "pip", "install", "catboost", "-q"])
    from catboost import CatBoostRegressor


def load_data():
    train_path = os.path.join("./input", "train.csv")
    test_path = os.path.join("./input", "test.csv")
    train_df = pd.read_csv(train_path)
    test_df = pd.read_csv(test_path)
    return train_df, test_df


def build_pred():
    train_df, test_df = load_data()
    target_col = "median_house_value"

    # Keep DataOps-native structure
    data = skrub.var("data", train_df)

    X = data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data[target_col].skb.mark_as_y()

    # Use a robust, compatible vectorizer path and preserve the model family
    vectorizer = skrub.TableVectorizer()

    # CatBoostRegressor preserved; fixed parameters avoid incompatible tuning/search flow issues
    model = CatBoostRegressor(
        loss_function="RMSE",
        iterations=600,
        learning_rate=0.05,
        depth=8,
        random_seed=42,
        verbose=False,
        allow_writing_files=False,
    )

    pred = X.skb.apply(vectorizer).skb.apply(model, y=y)

    # Train/validation split for a real validation metric
    idx = np.arange(len(train_df))
    idx_train, idx_valid = train_test_split(idx, test_size=0.2, random_state=42, shuffle=True)

    train_part = train_df.iloc[idx_train].reset_index(drop=True)
    valid_part = train_df.iloc[idx_valid].reset_index(drop=True)

    train_data = skrub.var("data", train_part)
    valid_data = skrub.var("data", valid_part)

    X_train = train_data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = train_data[target_col].skb.mark_as_y()
    X_valid = valid_data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_valid = valid_data[target_col].skb.mark_as_y()

    train_pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)
    learner = train_pred.skb.make_learner(fitted=True)

    # Fit with environment dict, not DataOps nodes
    learner.fit({"data": train_part})

    valid_preds = learner.predict({"data": valid_part})
    final_validation_score = mean_squared_error(valid_part[target_col].values, np.asarray(valid_preds)) ** 0.5
    print(f"Final Validation Performance: {final_validation_score}")

    # Fit final learner on full data and predict test
    final_learner = pred.skb.make_learner(fitted=True)
    final_learner.fit({"data": train_df})

    test_preds = final_learner.predict({"data": test_df})

    submission = pd.DataFrame({"median_house_value": np.asarray(test_preds).reshape(-1)})
    submission.to_csv("submission.csv", index=False)
    return submission


if __name__ == "__main__":
    build_pred()
