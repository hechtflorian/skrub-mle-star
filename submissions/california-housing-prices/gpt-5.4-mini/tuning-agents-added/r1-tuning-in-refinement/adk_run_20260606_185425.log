import os
import warnings

warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import skrub
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split


INPUT_DIR = "./input"
TRAIN_PATH = os.path.join(INPUT_DIR, "train.csv")
TEST_PATH = os.path.join(INPUT_DIR, "test.csv")
TARGET_COL = "median_house_value"
RANDOM_STATE = 42


def rmse(y_true, y_pred):
    return mean_squared_error(y_true, y_pred) ** 0.5


class NumericFillnaTransformer:
    """
    Kept for compatibility with the original intent, but this class is NOT passed
    into skrub .skb.apply(). Instead, we use a scikit-learn-compatible transformer
    so skrub can fit/clone it correctly.
    """

    def fit(self, X, y=None):
        X = pd.DataFrame(X)
        self.fill_values_ = X.median(numeric_only=True)
        return self

    def transform(self, X):
        X = pd.DataFrame(X).copy()
        for col in X.columns:
            if col in self.fill_values_.index:
                X[col] = X[col].fillna(self.fill_values_[col])
        return X

    def get_params(self, deep=True):
        return {}


def main():
    train_df = pd.read_csv(TRAIN_PATH)
    test_df = pd.read_csv(TEST_PATH)

    # DataOps-native graph
    data = skrub.var("data", train_df)
    X = data.drop(columns=TARGET_COL, errors="ignore").skb.mark_as_X()
    y = data[TARGET_COL].skb.mark_as_y()

    # Use a sklearn-compatible transformer inside skrub.apply
    # This fixes the TypeError from passing a plain custom Python object.
    from sklearn.impute import SimpleImputer

    numeric_fill = SimpleImputer(strategy="median")

    # Preserve the DataOps structure while avoiding unsupported custom transformer usage
    X_proc = X.skb.apply(numeric_fill)

    model = HistGradientBoostingRegressor(
        learning_rate=0.05,
        max_depth=6,
        max_iter=300,
        min_samples_leaf=20,
        l2_regularization=0.0,
        random_state=RANDOM_STATE,
    )

    pred = X_proc.skb.apply(model, y=y)

    # Holdout validation for reporting
    tr_df, va_df = train_test_split(train_df, test_size=0.2, random_state=RANDOM_STATE)
    tr_data = skrub.var("tr_data", tr_df)
    va_data = skrub.var("va_data", va_df)

    tr_X = tr_data.drop(columns=TARGET_COL, errors="ignore").skb.mark_as_X()
    tr_y = tr_data[TARGET_COL].skb.mark_as_y()

    va_X = va_data.drop(columns=TARGET_COL, errors="ignore").skb.mark_as_X()
    va_y = va_data[TARGET_COL].skb.mark_as_y()

    tr_X_proc = tr_X.skb.apply(numeric_fill)
    va_X_proc = va_X.skb.apply(numeric_fill)

    # Fit a learner from the DataOps graph
    learner = tr_X_proc.skb.apply(
        HistGradientBoostingRegressor(
            learning_rate=0.05,
            max_depth=6,
            max_iter=300,
            min_samples_leaf=20,
            l2_regularization=0.0,
            random_state=RANDOM_STATE,
        ),
        y=tr_y,
    ).skb.make_learner(fitted=True)

    # Predict on validation using environment dict
    val_pred = learner.predict({"tr_data": tr_df})
    final_validation_score = rmse(va_df[TARGET_COL].values, val_pred)
    print(f"Final Validation Performance: {final_validation_score}")

    # Fit on full data for test prediction
    full_learner = pred.skb.make_learner(fitted=True)
    test_pred = full_learner.predict({"data": train_df.assign(**{TARGET_COL: train_df[TARGET_COL]}), "data": train_df})

    # Since the DataOps learner expects the original source variable name,
    # use a fresh training environment and predict from the test table with the same source name.
    # We build a separate single-source evaluation graph for reliable inference.
    test_data = skrub.var("data", train_df)
    test_X = test_data.drop(columns=TARGET_COL, errors="ignore").skb.mark_as_X()
    test_y = test_data[TARGET_COL].skb.mark_as_y()
    final_model = test_X.skb.apply(numeric_fill).skb.apply(
        HistGradientBoostingRegressor(
            learning_rate=0.05,
            max_depth=6,
            max_iter=300,
            min_samples_leaf=20,
            l2_regularization=0.0,
            random_state=RANDOM_STATE,
        ),
        y=test_y,
    ).skb.make_learner(fitted=True)

    # Predict on test using a clean environment dict with the required source variable.
    # Use the test CSV as the environment source.
    test_source = skrub.var("data", test_df)
    test_features = test_source.skb.mark_as_X()
    test_features_proc = test_features.skb.apply(numeric_fill)
    test_preds_learner = test_features_proc.skb.apply(
        HistGradientBoostingRegressor(
            learning_rate=0.05,
            max_depth=6,
            max_iter=300,
            min_samples_leaf=20,
            l2_regularization=0.0,
            random_state=RANDOM_STATE,
        ),
        y=None,
    ).skb.make_learner(fitted=True)

    # Fit a direct sklearn model for robust final submission generation using the same preprocessing
    # while keeping the DataOps path in place and fixed.
