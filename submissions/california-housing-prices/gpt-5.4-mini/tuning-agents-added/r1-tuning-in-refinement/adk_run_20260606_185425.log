import os
import warnings
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")

try:
    import skrub
except Exception as e:
    raise ImportError("skrub is required for this script") from e

from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

INPUT_DIR = "./input"
TRAIN_PATH = os.path.join(INPUT_DIR, "train.csv")
TEST_PATH = os.path.join(INPUT_DIR, "test.csv")
TARGET_COL = "median_house_value"
RANDOM_STATE = 42


def load_data():
    train_df = pd.read_csv(TRAIN_PATH)
    test_df = pd.read_csv(TEST_PATH)
    return train_df, test_df


def add_feature_engineering(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    eps = 1e-6
    df["rooms_per_household"] = df["total_rooms"] / (df["households"] + eps)
    df["bedrooms_per_room"] = df["total_bedrooms"] / (df["total_rooms"] + eps)
    df["population_per_household"] = df["population"] / (df["households"] + eps)
    df["rooms_per_person"] = df["total_rooms"] / (df["population"] + eps)
    return df


def build_dataops_pipeline(train_df: pd.DataFrame, test_df: pd.DataFrame):
    data = skrub.var("data", train_df)
    X_df = data.drop(columns=[TARGET_COL], errors="ignore").skb.mark_as_X()
    y = data[TARGET_COL].skb.mark_as_y()

    def drop_redundant_graph(df):
        cols = [c for c in ["total_rooms", "households", "population"] if c in df.columns]
        if "median_income" in df.columns and "median_house_value" not in df.columns:
            pass
        return df.drop(columns=cols, errors="ignore").skb.concat([data[TARGET_COL]], axis=1)

    def scaled_numeric_graph(df):
        num_cols = df.select_dtypes(include=[np.number]).columns
        if len(num_cols) == 0:
            return df.skb.concat([data[TARGET_COL]], axis=1)
        out = df.copy()
        for c in num_cols:
            if c != TARGET_COL:
                out[c] = (out[c] - out[c].mean()) / (out[c].std() + 1e-6)
        return out.skb.concat([data[TARGET_COL]], axis=1)

    _ = drop_redundant_graph(X_df)
    _ = scaled_numeric_graph(X_df)

    X_feat = X_df.skb.apply(add_feature_engineering)

    vectorizer = skrub.TableVectorizer(drop_if_constant=True, drop_null_fraction=1.0)
    X_vec = X_feat.skb.apply(vectorizer)

    model = HistGradientBoostingRegressor(
        learning_rate=0.08,
        max_depth=8,
        max_iter=250,
        min_samples_leaf=20,
        l2_regularization=0.0,
        random_state=RANDOM_STATE,
    )

    pred = X_vec.skb.apply(model, y=y)
    learner = pred.skb.make_learner(fitted=True)
    return learner


def evaluate_model(train_df: pd.DataFrame) -> float:
    train_part, valid_part = train_test_split(train_df, test_size=0.2, random_state=RANDOM_STATE)
    train_part = train_part.reset_index(drop=True)
    valid_part = valid_part.reset_index(drop=True)

    data = skrub.var("data", train_part)
    X = data.drop(columns=[TARGET_COL], errors="ignore").skb.mark_as_X()
    y = data[TARGET_COL].skb.mark_as_y()

    X_feat = X.skb.apply(add_feature_engineering)
    vectorizer = skrub.TableVectorizer(drop_if_constant=True, drop_null_fraction=1.0)
    X_vec = X_feat.skb.apply(vectorizer)

    model = HistGradientBoostingRegressor(
        learning_rate=0.08,
        max_depth=8,
        max_iter=250,
        min_samples_leaf=20,
        l2_regularization=0.0,
        random_state=RANDOM_STATE,
    )

    pred = X_vec.skb.apply(model, y=y)
    learner = pred.skb.make_learner(fitted=True)

    valid_X = valid_part.drop(columns=[TARGET_COL], errors="ignore")
    y_true = valid_part[TARGET_COL].values
    y_pred = learner.predict({"data": valid_part})

    rmse = mean_squared_error(y_true, y_pred) ** 0.5
    print(f"Final Validation Performance: {rmse}")
    return rmse


def main():
    train_df, test_df = load_data()

    final_validation_score = evaluate_model(train_df)

    data = skrub.var("data", train_df)
    X = data.drop(columns=[TARGET_COL], errors="ignore").skb.mark_as_X()
    y = data[TARGET_COL].skb.mark_as_y()

    X_feat = X.skb.apply(add_feature_engineering)
    vectorizer = skrub.TableVectorizer(drop_if_constant=True, drop_null_fraction=1.0)
    X_vec = X_feat.skb.apply(vectorizer)

    model = HistGradientBoostingRegressor(
        learning_rate=0.08,
        max_depth=8,
        max_iter=250,
        min_samples_leaf=20,
        l2_regularization=0.0,
        random_state=RANDOM_STATE,
    )

    pred = X_vec.skb.apply(model, y=y)
    learner = pred.skb.make_learner(fitted=True)

    test_preds = learner.predict({"data": test_df})
    submission = pd.DataFrame({TARGET_COL: test_preds})
    submission.to_csv("submission.csv", index=False)

    print(f"Final Validation Performance: {final_validation_score}")


if __name__ == "__main__":
    main()
