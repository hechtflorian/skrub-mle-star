    pred = build_pred(train_part)
    learner = pred.skb.make_learner(fitted=True)

    valid_X = valid_part.drop(columns=["median_house_value"], errors="ignore")
    valid_y = valid_part["median_house_value"].to_numpy()

    valid_pred = learner.predict({"data": valid_part})
    final_validation_score = mean_squared_error(valid_y, np.asarray(valid_pred)) ** 0.5
    print(f"Final Validation Performance: {final_validation_score}")

    # Refit on full training data and predict test
    full_pred = build_pred(train_df)
    full_learner = full_pred.skb.make_learner(fitted=True)

    test_pred = full_learner.predict({"data": test_df})
    submission = pd.DataFrame({"median_house_value": np.asarray(test_pred)})
    submission.to_csv("submission.csv", index=False)


if __name__ == "__main__":
