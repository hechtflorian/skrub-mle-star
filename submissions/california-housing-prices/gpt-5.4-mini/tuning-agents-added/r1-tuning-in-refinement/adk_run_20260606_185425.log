import os
import warnings

import numpy as np
import pandas as pd
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split
from sklearn.ensemble import HistGradientBoostingRegressor

import skrub

warnings.filterwarnings("ignore")


def load_data(path):
    return pd.read_csv(path)


def make_features(df):
    df = df.copy()

    # Basic robust preprocessing: fill missing numeric values with median,
    # keep the DataOps structure intact by using skrub for the main path.
    for col in df.columns:
        if pd.api.types.is_numeric_dtype(df[col]):
            med = df[col].median()
            df[col] = df[col].fillna(med)

    return df


def main():
    train_path = os.path.join("./input", "train.csv")
    test_path = os.path.join("./input", "test.csv")

    train_df = load_data(train_path)
    test_df = load_data(test_path)

    target_col = "median_house_value"

    # Keep DataOps-first graph
    data = skrub.var("data", train_df)
    X = data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data[target_col].skb.mark_as_y()

    # Preserve existing model class, but ensure stable fixed parameters
    model = HistGradientBoostingRegressor(
        learning_rate=0.05,
        max_depth=8,
        max_iter=300,
        min_samples_leaf=20,
        l2_regularization=0.1,
        random_state=42,
    )

    # Use a safe TableVectorizer config with verified defaults
    vectorizer = skrub.TableVectorizer()

    pred = X.skb.apply(vectorizer).skb.apply(model, y=y)

    # Validation split for performance reporting
    train_idx, valid_idx = train_test_split(
        np.arange(len(train_df)), test_size=0.2, random_state=42
    )
    train_split = train_df.iloc[train_idx].copy()
    valid_split = train_df.iloc[valid_idx].copy()

    # Fit via learner from DataOps graph
    learner = pred.skb.make_learner(fitted=True)

    # Predict on validation environment dict
    valid_pred = learner.predict({"data": valid_split})
    final_validation_score = mean_squared_error(
        valid_split[target_col].values, np.asarray(valid_pred)
    ) ** 0.5

    print(f"Final Validation Performance: {final_validation_score}")

    # Refit on all training data using the same DataOps graph
    full_learner = pred.skb.make_learner(fitted=True)
