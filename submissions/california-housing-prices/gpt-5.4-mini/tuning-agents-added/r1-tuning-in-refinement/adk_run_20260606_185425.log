import os
import warnings

import numpy as np
import pandas as pd
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error

import skrub

warnings.filterwarnings("ignore")


class NumericFillnaTransformer:
    """Fill numeric missing values and preserve pandas DataFrame output."""

    def fit(self, X, y=None):
        X = pd.DataFrame(X).copy()
        self.fill_values_ = X.median(numeric_only=True)
        self.columns_ = X.columns
        return self

    def transform(self, X):
        X = pd.DataFrame(X).copy()
        for col in self.columns_:
            if col in X.columns:
                X[col] = X[col].fillna(self.fill_values_.get(col, X[col].median()))
        return X

    def fit_transform(self, X, y=None):
        return self.fit(X, y).transform(X)


def load_data():
    train_path = os.path.join("./input", "train.csv")
    test_path = os.path.join("./input", "test.csv")
    train_df = pd.read_csv(train_path)
    test_df = pd.read_csv(test_path)
    return train_df, test_df


def build_and_eval(train_df):
    target_col = "median_house_value"
    data = skrub.var("data", train_df)

    X = data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data[target_col].skb.mark_as_y()

    numeric_fill = NumericFillnaTransformer()

    # Preserve DataFrame output for skrub DataOps
    X_proc = X.skb.apply(numeric_fill)

    vectorizer = skrub.TableVectorizer()
    X_vec = X_proc.skb.apply(vectorizer)

    model = HistGradientBoostingRegressor(
        learning_rate=0.05,
        max_depth=7,
        max_iter=300,
        min_samples_leaf=20,
        l2_regularization=0.1,
        random_state=0,
    )

    pred = X_vec.skb.apply(model, y=y)

    # Simple holdout validation
    n = len(train_df)
    val_size = max(1, int(0.2 * n))
    idx = np.arange(n)
    rng = np.random.RandomState(0)
    rng.shuffle(idx)
    val_idx = idx[:val_size]
    tr_idx = idx[val_size:]

    train_split = train_df.iloc[tr_idx].reset_index(drop=True)
    val_split = train_df.iloc[val_idx].reset_index(drop=True)

    train_env = {"data": train_split}
    val_env = {"data": val_split}

    learner = pred.skb.make_learner(fitted=True)
    learner.fit(train_env)
    val_pred = learner.predict(val_env)

    y_true = val_split[target_col].to_numpy()
    rmse = mean_squared_error(y_true, np.asarray(val_pred)) ** 0.5
    print(f"Final Validation Performance: {rmse}")

    return learner


def predict_and_save(learner, test_df):
    preds = learner.predict({"data": test_df})
    submission = pd.DataFrame({"median_house_value": np.asarray(preds)})
    submission.to_csv("submission.csv", index=False)
    return submission


def main():
    train_df, test_df = load_data()
    learner = build_and_eval(train_df)
    predict_and_save(learner, test_df)


if __name__ == "__main__":
    main()
