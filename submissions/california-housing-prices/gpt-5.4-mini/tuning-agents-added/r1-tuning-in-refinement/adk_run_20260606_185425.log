import warnings

warnings.filterwarnings("ignore")

import pandas as pd
import skrub
from catboost import CatBoostRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split
from skrub import DropCols
from skrub import selectors as s
import numpy as np

INPUT_DIR = "./input"
TRAIN_PATH = os.path.join(INPUT_DIR, "train.csv")
TARGET_COL = "median_house_value"
RANDOM_STATE = 42


def rmse(y_true, y_pred):
    return mean_squared_error(y_true, y_pred) ** 0.5


def fit_and_score(train_df, va_df, build_data_fn, variant_name):
    data = skrub.var("data", train_df)
    data = build_data_fn(data)

    X = data.drop(columns=TARGET_COL, errors="ignore").skb.mark_as_X()
    y = data[TARGET_COL].skb.mark_as_y()

    model = CatBoostRegressor(
        iterations=2000,
        learning_rate=0.03,
        depth=8,
        loss_function="RMSE",
        random_seed=RANDOM_STATE,
        verbose=0,
    )

    learner = X.skb.apply(model, y=y).skb.make_learner(fitted=True)
    val_pred = learner.predict({"data": va_df})
    score = rmse(va_df[TARGET_COL].values, val_pred)
    print(f"Ablation[{variant_name}] RMSE: {score}")
    return score


def main():
    train_df = pd.read_csv(TRAIN_PATH)
    tr_df, va_df = train_test_split(train_df, test_size=0.2, random_state=RANDOM_STATE)

    results = {}

    # Baseline: original solution
    def baseline_graph(data):
        return data

    results["baseline"] = fit_and_score(tr_df, va_df, baseline_graph, "baseline")

    # Ablation 1: drop one highly redundant column (households is highly correlated with bedrooms/rooms/population)
    def drop_redundant_graph(data):
        X_df = data.drop(columns=TARGET_COL, errors="ignore")
        X_df = X_df.skb.apply(DropCols(cols=s.cols("households")))
        return X_df.concat([data[TARGET_COL]], axis=1)

    results["drop_households"] = fit_and_score(tr_df, va_df, drop_redundant_graph, "drop_households")

    # Ablation 2: add a simple ratio feature block (rooms per household)
    @skrub.deferred
    def add_ratio_features(df):
        out = df.copy()
        denom = out["households"].replace(0, np.nan)
        out["rooms_per_household"] = (out["total_rooms"] / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        out["bedrooms_per_household"] = (out["total_bedrooms"] / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)
        return out

    def ratio_graph(data):
        return data.skb.apply_func(add_ratio_features)

    results["ratio_features"] = fit_and_score(tr_df, va_df, ratio_graph, "ratio_features")

    # Ablation 3: cleaner numeric routing via selector-based scaling of all numeric features
    from skrub import ApplyToCols, SquashingScaler

    def scaled_numeric_graph(data):
        X_df = data.drop(columns=TARGET_COL, errors="ignore")
        X_scaled = X_df.skb.apply(ApplyToCols(SquashingScaler(max_absolute_value=3), cols=s.numeric()))
        return X_scaled.concat([data[TARGET_COL]], axis=1)

    results["scaled_numeric"] = fit_and_score(tr_df, va_df, scaled_numeric_graph, "scaled_numeric")

    baseline = results["baseline"]
    best_variant = min(results, key=results.get)
    best_score = results[best_variant]

    print("\nPerformance deltas vs baseline:")
    for name, score in results.items():
        print(f"{name}: delta={score - baseline:+.6f} | rmse={score:.6f}")

    print(f"\nBest ablation variant: {best_variant} | RMSE: {best_score}")
    if best_variant == "baseline":
        print("Most contributing part: no ablation improved over the baseline; the original full feature pipeline is strongest.")
    else:
        print(f"Most contributing part: {best_variant} provided the largest validation gain relative to the baseline.")


if __name__ == "__main__":
    main()
