import os
import warnings
import numpy as np
import pandas as pd

import skrub
from sklearn.base import BaseEstimator, TransformerMixin
from sklearn.impute import SimpleImputer
from sklearn.metrics import mean_squared_error
from sklearn.pipeline import make_pipeline
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.preprocessing import StandardScaler

warnings.filterwarnings("ignore")


class NumericFillnaTransformer(BaseEstimator, TransformerMixin):
    def __init__(self, strategy="median"):
        self.strategy = strategy
        self.imputer = SimpleImputer(strategy=strategy)

    def fit(self, X, y=None):
        X = pd.DataFrame(X).copy()
        self.imputer.fit(X)
        return self

    def transform(self, X):
        X = pd.DataFrame(X).copy()
        return self.imputer.transform(X)


def load_data(path):
    return pd.read_csv(path)


def rmse(y_true, y_pred):
    return mean_squared_error(y_true, y_pred) ** 0.5


base_dir = "./input"
train_path = os.path.join(base_dir, "train.csv")
test_path = os.path.join(base_dir, "test.csv")

train_df = load_data(train_path)
test_df = load_data(test_path)

target_col = "median_house_value"

data = skrub.var("data", train_df)
X = data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y = data[target_col].skb.mark_as_y()

numeric_fill = NumericFillnaTransformer(strategy="median")
X_proc = X.skb.apply(numeric_fill)

model = make_pipeline(
    StandardScaler(with_mean=False),
    HistGradientBoostingRegressor(
        learning_rate=0.05,
        max_depth=6,
        max_iter=300,
        min_samples_leaf=20,
        random_state=42,
    ),
)

pred = X_proc.skb.apply(model, y=y)

# Holdout validation
n = len(train_df)
val_size = max(1, int(0.2 * n))
train_part = train_df.iloc[:-val_size].copy()
val_part = train_df.iloc[-val_size:].copy()

train_data = skrub.var("data", train_part)
X_train = train_data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = train_data[target_col].skb.mark_as_y()

X_train_proc = X_train.skb.apply(numeric_fill)
train_pred = X_train_proc.skb.apply(model, y=y_train)
learner = train_pred.skb.make_learner(fitted=True)

val_pred = learner.predict({"data": val_part})
final_validation_score = rmse(val_part[target_col].values, np.asarray(val_pred))
print(f"Final Validation Performance: {final_validation_score}")

# Fit on full training data and predict test
full_learner = pred.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df})

submission = pd.DataFrame({target_col: np.asarray(test_pred)})
submission.to_csv("submission.csv", index=False)
print(submission.head().to_string(index=False))
```
