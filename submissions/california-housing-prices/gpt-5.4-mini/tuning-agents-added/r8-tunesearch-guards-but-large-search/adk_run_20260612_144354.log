import numpy as np
import pandas as pd
import skrub
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split
from catboost import CatBoostRegressor
from xgboost import XGBRegressor

train_path = "./input/train.csv"
test_path = "./input/test.csv"

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "median_house_value"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

cat_model = CatBoostRegressor(
    loss_function="RMSE",
    depth=8,
    learning_rate=0.05,
    iterations=4000,
    random_seed=42,
    verbose=200,
)

xgb_model = XGBRegressor(
    n_estimators=3000,
    learning_rate=0.03,
    max_depth=8,
    subsample=0.8,
    colsample_bytree=0.8,
    reg_lambda=1.0,
    random_state=42,
    tree_method="hist",
)

cat_pred_graph = X_train.skb.apply(cat_model, y=y_train)
cat_learner = cat_pred_graph.skb.make_learner(fitted=True)

xgb_pred_graph = X_train.skb.apply(xgb_model, y=y_train)
xgb_learner = xgb_pred_graph.skb.make_learner(fitted=True)

cat_valid_pred = cat_learner.predict({"data": valid_part})
xgb_valid_pred = xgb_learner.predict({"data": valid_part})

valid_pred = 0.5 * cat_valid_pred + 0.5 * xgb_valid_pred
final_validation_score = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
X_full = data_full.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].skb.mark_as_y()

full_cat_model = CatBoostRegressor(
    loss_function="RMSE",
    depth=8,
    learning_rate=0.05,
    iterations=4000,
    random_seed=42,
    verbose=200,
)

full_xgb_model = XGBRegressor(
    n_estimators=3000,
    learning_rate=0.03,
    max_depth=8,
    subsample=0.8,
    colsample_bytree=0.8,
    reg_lambda=1.0,
    random_state=42,
    tree_method="hist",
)

full_cat_pred_graph = X_full.skb.apply(full_cat_model, y=y_full)
full_cat_learner = full_cat_pred_graph.skb.make_learner(fitted=True)

full_xgb_pred_graph = X_full.skb.apply(full_xgb_model, y=y_full)
full_xgb_learner = full_xgb_pred_graph.skb.make_learner(fitted=True)

cat_test_pred = full_cat_learner.predict({"data": test_df})
xgb_test_pred = full_xgb_learner.predict({"data": test_df})

test_pred = 0.5 * cat_test_pred + 0.5 * xgb_test_pred

sub = pd.DataFrame({"median_house_value": test_pred})
sub.to_csv("submission.csv", index=False)
```
