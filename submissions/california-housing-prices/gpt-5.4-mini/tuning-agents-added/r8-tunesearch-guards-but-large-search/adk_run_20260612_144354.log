import pandas as pd
import skrub
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split
from catboost import CatBoostRegressor

# Assumes train_df is already available in the runtime.
target_col = "median_house_value"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def run_ablation(df_train, df_valid, model, variant_name, feature_fn=None):
    data_train = skrub.var("data", df_train)

    if feature_fn is not None:
        data_train = data_train.skb.apply_func(feature_fn)

    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    pred_graph = X_train.skb.apply(model, y=y_train)
    learner = pred_graph.skb.make_learner(fitted=True)

    if feature_fn is None:
        valid_env = {"data": df_valid}
    else:
        valid_env = {"data": df_valid}

    valid_pred = learner.predict(valid_env)
    score = mean_squared_error(df_valid[target_col], valid_pred) ** 0.5
    print(f"Ablation[{variant_name}] RMSE: {score}")
    return score

base_model = CatBoostRegressor(
    loss_function="RMSE",
    depth=8,
    learning_rate=0.05,
    iterations=4000,
    random_seed=42,
    verbose=200,
)

drop_households_model = CatBoostRegressor(
    loss_function="RMSE",
    depth=8,
    learning_rate=0.05,
    iterations=4000,
