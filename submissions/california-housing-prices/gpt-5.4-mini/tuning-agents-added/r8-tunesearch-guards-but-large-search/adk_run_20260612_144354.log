)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# DataOps-first holdout binding: bind train_part only.
data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Backbone estimator preserved: HistGradientBoostingRegressor
model = HistGradientBoostingRegressor(
    learning_rate=0.05,
    max_depth=6,
    max_iter=300,
    min_samples_leaf=20,
    l2_regularization=0.1,
    random_state=42,
)

# Minimal robust preprocessing: TableVectorizer within DataOps graph.
vectorizer = skrub.TableVectorizer(
    cardinality_threshold=40,
    drop_null_fraction=1.0,
    drop_if_constant=False,
    drop_if_unique=False,
)

pred = X_train.skb.apply(vectorizer).skb.apply(model, y=y_train)

# Fix: create learner from the fitted train_part-bound pipeline,
