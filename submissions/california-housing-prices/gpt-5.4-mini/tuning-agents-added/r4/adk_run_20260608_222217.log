import os
import pandas as pd
import numpy as np
from sklearn.metrics import mean_squared_error
from catboost import CatBoostRegressor
import skrub


train_path = "./input/train.csv"
test_path = "./input/test.csv"

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "median_house_value"

data = skrub.var("data", train_df)
X = data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y = data[target_col].skb.mark_as_y()

# Basic fixed preprocessing compatible with CatBoost:
# - Keep numeric columns as-is
# - Fill missing values with median-like constant via pandas inside a DataOps apply block
# CatBoost can natively handle numeric features once missing values are filled.
def fill_missing_numeric(df: pd.DataFrame) -> pd.DataFrame:
    out = df.copy()
    for c in out.columns:
        if pd.api.types.is_numeric_dtype(out[c]):
            out[c] = out[c].fillna(out[c].median())
    return out

X_clean = X.skb.apply(fill_missing_numeric)

model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=5000,
    learning_rate=0.03,
    depth=8,
    random_seed=42,
    verbose=200,
)

predictor = X_clean.skb.apply(model, y=y)
trained_learner = predictor.skb.make_learner(fitted=True)

# Hold-out validation split done outside the model fitting, but the main pipeline remains DataOps-first.
from sklearn.model_selection import train_test_split

train_idx, val_idx = train_test_split(np.arange(len(train_df)), test_size=0.2, random_state=42)

train_part = train_df.iloc[train_idx].reset_index(drop=True)
val_part = train_df.iloc[val_idx].reset_index(drop=True)

train_data = skrub.var("train_data", train_part)
val_data = skrub.var("val_data", val_part)

train_X = train_data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
train_y = train_data[target_col].skb.mark_as_y()
val_X = val_data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
val_y = val_data[target_col].skb.mark_as_y()

train_X_clean = train_X.skb.apply(fill_missing_numeric)
val_X_clean = val_X.skb.apply(fill_missing_numeric)

val_predictor = train_X_clean.skb.apply(
    CatBoostRegressor(
        loss_function="RMSE",
        iterations=5000,
        learning_rate=0.03,
        depth=8,
        random_seed=42,
        verbose=200,
    ),
    y=train_y
)
val_learner = val_predictor.skb.make_learner(fitted=True)

val_preds = val_learner.predict({"train_data": train_part})
# Since the learned predictor is tied to train_data, use the fitted learner on validation through explicit re-fit on the split.
# A fully consistent validation run:
split_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=5000,
    learning_rate=0.03,
    depth=8,
    random_seed=42,
    verbose=200,
)
split_model.fit(
    fill_missing_numeric(train_part.drop(columns=[target_col])),
    train_part[target_col],
    eval_set=(fill_missing_numeric(val_part.drop(columns=[target_col])), val_part[target_col]),
    early_stopping_rounds=200,
)

val_pred = split_model.predict(fill_missing_numeric(val_part.drop(columns=[target_col])))
final_validation_score = mean_squared_error(val_part[target_col], val_pred) ** 0.5

print(f"Final Validation Performance: {final_validation_score}")

# Train final model on full training data and generate test predictions
full_model = CatBoostRegressor(
    loss_function="RMSE",
    iterations=5000,
    learning_rate=0.03,
    depth=8,
    random_seed=42,
    verbose=200,
)
full_X = fill_missing_numeric(train_df.drop(columns=[target_col]))
full_y = train_df[target_col]
full_model.fit(full_X, full_y)

test_X = fill_missing_numeric(test_df)
test_preds = full_model.predict(test_X)

submission = pd.DataFrame({target_col: test_preds})
submission.to_csv("submission.csv", index=False)
```
