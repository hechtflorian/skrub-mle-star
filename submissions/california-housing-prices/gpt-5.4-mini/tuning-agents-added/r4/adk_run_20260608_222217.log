final_pred = blended_norm * (blended_std + 1e-9) + blended_mean
final_pred = np.clip(final_pred, 0, 500000)

# Validation score printed from the weighted ensemble of validation RMSEs
final_validation_score = float(np.average(valid_scores, weights=weights))
print(f"Final Validation Performance: {final_validation_score}")

submission = pd.DataFrame({TARGET: final_pred})
submission.to_csv("submission.csv", index=False)
print(submission.head().to_string(index=False))
