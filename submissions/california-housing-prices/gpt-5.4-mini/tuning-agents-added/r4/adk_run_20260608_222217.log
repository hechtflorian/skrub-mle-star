import os
import warnings

warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import skrub
from scipy.stats import rankdata
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

TARGET = "median_house_value"
DATA_DIR = "./input"
TRAIN_PATH = os.path.join(DATA_DIR, "train.csv")
TEST_PATH = os.path.join(DATA_DIR, "test.csv")

train_df = pd.read_csv(TRAIN_PATH)
test_df = pd.read_csv(TEST_PATH)

# Keep a DataOps-first flow: define data, mark X/y, and use .skb.apply(...)
data = skrub.var("data", train_df)

X = data.drop(columns=TARGET, errors="ignore").skb.mark_as_X()
y = data[TARGET].skb.mark_as_y()

# Split once for validation (kept consistent across variants for fair RMSE weighting)
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)

train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def fill_missing_numeric(df):
    df = df.copy()
    for col in df.columns:
        if df[col].dtype.kind in "biufc":
            df[col] = df[col].fillna(df[col].median())
    return df

def add_ratio_features(df):
    df = df.copy()
    eps = 1e-9
    df["rooms_per_household"] = df["total_rooms"] / (df["households"] + eps)
    df["bedrooms_per_room"] = df["total_bedrooms"] / (df["total_rooms"] + eps)
    df["population_per_household"] = df["population"] / (df["households"] + eps)
    return df

# Preserve original DataOps structure; preprocessing stays identical.
X_clean = X.skb.apply_func(fill_missing_numeric)
X_feat = X_clean.skb.apply_func(add_ratio_features)

def run_variant(seed=42, bootstrap=False):
    if bootstrap:
        rng = np.random.RandomState(seed)
        boot_idx = rng.choice(len(train_df), size=len(train_df), replace=True)
        boot_df = train_df.iloc[boot_idx].copy()

        boot_data = skrub.var("boot_data", boot_df)
        boot_X = boot_data.drop(columns=TARGET, errors="ignore").skb.mark_as_X()
        boot_y = boot_data[TARGET].skb.mark_as_y()
        boot_X_clean = boot_X.skb.apply_func(fill_missing_numeric)
        boot_X_feat = boot_X_clean.skb.apply_func(add_ratio_features)

        model = HistGradientBoostingRegressor(
            learning_rate=0.05993292420985183,
            max_depth=6,
            max_iter=300,
            min_samples_leaf=13,
            l2_regularization=0.0,
            random_state=seed,
        )

        pred = boot_X_feat.skb.apply(model, y=boot_y)
        learner = pred.skb.make_learner(fitted=True)

        # Validation RMSE evaluated on the same fixed holdout from the original train_df
        valid_pred = learner.predict({"data": valid_part})
        valid_score = mean_squared_error(valid_part[TARGET], valid_pred) ** 0.5

        # Fit on bootstrap sample and predict test
        full_pred = boot_X_feat.skb.apply(model, y=boot_y)
        full_learner = full_pred.skb.make_learner(fitted=True)
        test_pred = full_learner.predict({"data": test_df})

        return valid_score, test_pred
    else:
        model = HistGradientBoostingRegressor(
            learning_rate=0.05993292420985183,
            max_depth=6,
            max_iter=300,
            min_samples_leaf=13,
            l2_regularization=0.0,
            random_state=seed,
        )

        pred = X_feat.skb.apply(model, y=y)
        learner = pred.skb.make_learner(fitted=True)

        # Validation performance
        valid_pred = learner.predict({"data": valid_part})
        valid_score = mean_squared_error(valid_part[TARGET], valid_pred) ** 0.5

        # Fit on full data and predict test
        full_pred = X_feat.skb.apply(model, y=y)
        full_learner = full_pred.skb.make_learner(fitted=True)
        test_pred = full_learner.predict({"data": test_df})

        return valid_score, test_pred

# 4 variants total: 3 different seeds on the full training set + 1 bootstrap-resampled fit
variants = [
    {"seed": 42, "bootstrap": False},
    {"seed": 43, "bootstrap": False},
    {"seed": 44, "bootstrap": False},
    {"seed": 45, "bootstrap": True},
]

valid_scores = []
test_preds = []

for v in variants:
    score, pred = run_variant(seed=v["seed"], bootstrap=v["bootstrap"])
    valid_scores.append(score)
    test_preds.append(np.asarray(pred, dtype=float))

# Soft weights based on holdout RMSE
weights = np.array([1.0 / (rmse + 1e-6) for rmse in valid_scores], dtype=float)
weights = weights / weights.sum()

# Rank-stabilized blend: rank normalize each prediction vector, weighted-average,
# then map back using weighted mean/std of raw predictions.
raw_means = np.array([p.mean() for p in test_preds], dtype=float)
raw_stds = np.array([p.std() for p in test_preds], dtype=float)

norm_preds = []
