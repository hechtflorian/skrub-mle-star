[ablation_agent_1]: import os
import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

train_path = os.path.join("./input", "train.csv")
train_df = pd.read_csv(train_path)

target_col = "median_house_value"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()


def evaluate_variant(variant_name, make_graph_fn):
    data_train = skrub.var("data", train_part)
    X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y_train = data_train[target_col].skb.mark_as_y()

    pred_graph = make_graph_fn(X_train, y_train)
    learner = pred_graph.skb.make_learner(fitted=True)
    valid_pred = learner.predict({"data": valid_part})
    rmse = mean_squared_error(valid_part[target_col], valid_pred) ** 0.5
    print(f"Ablation[{variant_name}] RMSE: {rmse}")
    return rmse


def baseline_graph(X_train, y_train):
    model = CatBoostRegressor(
        iterations=3000,
        depth=8,
        learning_rate=0.03,
        loss_function="RMSE",
        eval_metric="RMSE",
        verbose=0,
        random_seed=42,
        early_stopping_rounds=100,
    )
    return X_train.skb.apply(model, y=y_train)


def drop_redundant_graph(X_train, y_train):
    # Highly correlated size/count features: remove one likely redundant column.
    X_reduced = X_train.skb.drop(columns=["households"], errors="ignore")
    model = CatBoostRegressor(
        iterations=3000,
        depth=8,
        learning_rate=0.03,
        loss_function="RMSE",
        eval_metric="RMSE",
        verbose=0,
        random_seed=42,
        early_stopping_rounds=100,
    )
    return X_reduced.skb.apply(model, y=y_train)


def add_ratio_graph(X_train, y_train):
    # Add a simple ratio from strongly correlated count features.
    @skrub.deferred
    def add_room_density(df):
        out = df.copy()
        denom = out["households"].replace(0, np.nan) if "households" in out.columns else None
        if denom is not None and "total_rooms" in out.columns:
            out["rooms_per_household"] = (
                (out["total_rooms"] / denom).replace([np.inf, -np.inf], np.nan).fillna(0.0)
