import os
import numpy as np
import pandas as pd
import skrub
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

INPUT_DIR = "./input"
train_df = pd.read_csv(os.path.join(INPUT_DIR, "train.csv"))
test_df = pd.read_csv(os.path.join(INPUT_DIR, "test.csv"))

target_col = "Transported"

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def prep_rf(df):
    df = df.copy()
    cabin = df["Cabin"].astype(str).str.split("/", expand=True)
    df["CabinDeck"] = cabin[0]
    df["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
    df["CabinSide"] = cabin[2]
    df["NameLen"] = df["Name"].astype(str).str.len()
    df = df.drop(columns=["Cabin", "Name"], errors="ignore")
    df["CryoSleep"] = df["CryoSleep"].astype("float")
    df["VIP"] = df["VIP"].astype("float")
    df["HomePlanet"] = df["HomePlanet"].astype("category").cat.codes.replace(-1, np.nan)
    df["Destination"] = df["Destination"].astype("category").cat.codes.replace(-1, np.nan)
    df["CabinDeck"] = df["CabinDeck"].astype("category").cat.codes.replace(-1, np.nan)
    df["CabinSide"] = df["CabinSide"].astype("category").cat.codes.replace(-1, np.nan)
    return df

def prep_lr(df):
    df = df.copy()
    cabin = df["Cabin"].astype(str).str.split("/", expand=True)
    df["CabinDeck"] = cabin[0]
    df["CabinNum"] = pd.to_numeric(cabin[1], errors="coerce")
    df["CabinSide"] = cabin[2]
    df["NameLen"] = df["Name"].astype(str).str.len()
    df = df.drop(columns=["Cabin", "Name"], errors="ignore")
    df["CryoSleep"] = df["CryoSleep"].astype("float")
    df["VIP"] = df["VIP"].astype("float")
    df["HomePlanet"] = df["HomePlanet"].astype("category").cat.codes.replace(-1, np.nan)
    df["Destination"] = df["Destination"].astype("category").cat.codes.replace(-1, np.nan)
    df["CabinDeck"] = df["CabinDeck"].astype("category").cat.codes.replace(-1, np.nan)
    df["CabinSide"] = df["CabinSide"].astype("category").cat.codes.replace(-1, np.nan)
    return df

# --- Model 1: RandomForest pipeline kept intact ---
data_train_rf = skrub.var("data", train_part)
X_train_rf = data_train_rf.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train_rf = data_train_rf[target_col].skb.mark_as_y()

model_rf = RandomForestClassifier(random_state=42, n_estimators=300, n_jobs=-1)
pred_rf = X_train_rf.skb.apply_func(prep_rf).skb.apply(model_rf, y=y_train_rf)

val_learner_rf = pred_rf.skb.make_learner(fitted=True)
valid_pred_rf = val_learner_rf.predict({"data": valid_part})
valid_pred_rf = np.asarray(valid_pred_rf).astype(bool)

# --- Model 2: LogisticRegression pipeline added for late-fusion ensemble ---
data_train_lr = skrub.var("data", train_part)
X_train_lr = data_train_lr.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train_lr = data_train_lr[target_col].skb.mark_as_y()

model_lr = LogisticRegression(max_iter=1000, random_state=42)
pred_lr = X_train_lr.skb.apply_func(prep_lr).skb.apply(model_lr, y=y_train_lr)

val_learner_lr = pred_lr.skb.make_learner(fitted=True)
valid_pred_lr = val_learner_lr.predict({"data": valid_part})
valid_pred_lr = np.asarray(valid_pred_lr).astype(bool)

# --- Late-fusion ensemble on validation ---
# Preferred probability averaging; fallback to boolean soft-voting if needed.
def _to_prob(pred):
    pred = np.asarray(pred)
    if pred.ndim == 2 and pred.shape[1] >= 2:
        return pred[:, -1].astype(float)
    return pred.astype(float)

p_rf = _to_prob(valid_pred_rf)
p_lr = _to_prob(valid_pred_lr)

weights = np.arange(0.2, 0.81, 0.1)
best_w = 0.5
best_score = -1.0

for w_rf in weights:
    p_ens = w_rf * p_rf + (1.0 - w_rf) * p_lr
    y_ens = p_ens >= 0.5
    score = accuracy_score(valid_part[target_col], y_ens)
    if score > best_score:
        best_score = score
        best_w = w_rf

# Recompute final validation performance using the best blend weight
p_ens = best_w * p_rf + (1.0 - best_w) * p_lr
valid_pred_ens = p_ens >= 0.5
final_validation_score = accuracy_score(valid_part[target_col], valid_pred_ens)
print(f"Final Validation Performance: {final_validation_score}")

# --- Fit both full-data learners independently and generate test predictions ---
data_full_rf = skrub.var("data", train_df)
X_full_rf = data_full_rf.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full_rf = data_full_rf[target_col].skb.mark_as_y()

pred_full_rf = X_full_rf.skb.apply_func(prep_rf).skb.apply(model_rf, y=y_full_rf)
full_learner_rf = pred_full_rf.skb.make_learner(fitted=True)

data_full_lr = skrub.var("data", train_df)
X_full_lr = data_full_lr.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full_lr = data_full_lr[target_col].skb.mark_as_y()

pred_full_lr = X_full_lr.skb.apply_func(prep_lr).skb.apply(model_lr, y=y_full_lr)
full_learner_lr = pred_full_lr.skb.make_learner(fitted=True)

test_pred_rf = full_learner_rf.predict({"data": test_df})
test_pred_lr = full_learner_lr.predict({"data": test_df})

test_p_rf = _to_prob(test_pred_rf)
test_p_lr = _to_prob(test_pred_lr)
test_p_ens = best_w * test_p_rf + (1.0 - best_w) * test_p_lr
test_pred_final = test_p_ens >= 0.5

submission = pd.DataFrame({
    "PassengerId": test_df["PassengerId"],
    "Transported": test_pred_final.astype(bool)
})
submission.to_csv("submission.csv", index=False)
```
