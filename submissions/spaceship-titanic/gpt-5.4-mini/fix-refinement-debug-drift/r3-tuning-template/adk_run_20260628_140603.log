import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from catboost import CatBoostClassifier

# Load data
train_df = pd.read_csv("./input/train.csv")

target_col = "Transported"

# Holdout split
train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

# DataOps bind to train_part only for honest holdout
data_train = skrub.var("data", train_part)

# Small fix: ensure PassengerId is not treated as a numeric feature downstream
# by making it explicitly categorical/string-like before the CatBoost step.
# Keep the rest of the pipeline intact.
def fix_id_columns(df):
    df = df.copy()
    if "PassengerId" in df.columns:
        df["PassengerId"] = df["PassengerId"].astype(str)
    if "Cabin" in df.columns:
        df["Cabin"] = df["Cabin"].astype(str)
    if "Name" in df.columns:
        df["Name"] = df["Name"].astype(str)
    return df

X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

# Preserve DataOps graph structure; only patch the pre-CatBoost input so string IDs
# are not misinterpreted as numeric features.
X_train_fixed = X_train.skb.apply_func(fix_id_columns)

cat_model = CatBoostClassifier(
    loss_function="Logloss",
    iterations=300,
    depth=6,
    learning_rate=0.05,
    random_seed=42,
    verbose=0,
)

pred_graph = X_train_fixed.skb.apply(cat_model, y=y_train)

val_learner = pred_graph.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})

# CatBoost predicts probabilities for classifier; threshold at 0.5
valid_pred_labels = np.asarray(valid_pred) > 0.5
final_validation_score = accuracy_score(valid_part[target_col].values, valid_pred_labels)
print(f"Final Validation Performance: {final_validation_score}")
```
