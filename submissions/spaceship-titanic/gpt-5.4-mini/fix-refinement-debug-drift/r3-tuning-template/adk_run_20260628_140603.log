import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split

train_df = pd.read_csv("./input/train.csv")
test_df = pd.read_csv("./input/test.csv")
target_col = "Transported"


def feature_engineer(df):
    df = df.copy()
    cabin_split = df["Cabin"].astype("string").str.split("/", expand=True)
    df["Deck"] = cabin_split[0]
    df["Num"] = pd.to_numeric(cabin_split[1], errors="coerce")
    df["Side"] = cabin_split[2]
    df["Group"] = df["PassengerId"].astype("string").str.split("_").str[0]
    df["GroupSize"] = df.groupby("Group")["PassengerId"].transform("count")
    df["Spending"] = df[["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]].sum(axis=1, skipna=True)
    df["NoSpending"] = (df["Spending"].fillna(0) == 0).astype(int)
    df["AgeBin"] = pd.cut(
        df["Age"],
        bins=[-np.inf, 12, 18, 30, 50, np.inf],
        labels=["child", "teen", "young_adult", "adult", "senior"],
    )
    df["CabinKnown"] = df["Cabin"].notna().astype(int)
    df["NameLen"] = df["Name"].astype("string").fillna("").str.len()
    df["Surname"] = df["Name"].astype("string").fillna("").str.split().str[-1]
    df.drop(columns=["Cabin"], inplace=True)
    return df


def prep(df):
    df = feature_engineer(df)
    for c in ["CryoSleep", "VIP", "HomePlanet", "Destination", "Deck", "Side", "Group", "AgeBin", "Surname"]:
        df[c] = df[c].astype("string").fillna("missing")
    num_cols = ["Age", "RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck", "Num", "Spending", "NameLen", "GroupSize"]
    df[num_cols] = df[num_cols].apply(pd.to_numeric, errors="coerce")
    df[num_cols] = df[num_cols].fillna(df[num_cols].median(numeric_only=True))
    df["CabinKnown"] = df["CabinKnown"].fillna(0).astype(int)
    df["NoSpending"] = df["NoSpending"].fillna(0).astype(int)
    return df.drop(columns=["Name"])


train_df = prep(train_df)
test_df = prep(test_df)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42, stratify=train_df[target_col].astype(int)
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

cat_model = CatBoostClassifier(
    loss_function="Logloss",
    eval_metric="Accuracy",
    iterations=800,
    depth=6,
    learning_rate=0.03,
    random_seed=42,
    verbose=0,
    auto_class_weights="Balanced",
)

pred_graph = X_train.skb.apply(cat_model, y=y_train)
learner = pred_graph.skb.make_learner(fitted=True)
valid_pred = learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred).ravel()
valid_pred = (valid_pred.astype(int) > 0).astype(int)
final_validation_score = accuracy_score(valid_part[target_col].astype(int), valid_pred)
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
X_full = data_full.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].skb.mark_as_y()
full_graph = X_full.skb.apply(
    CatBoostClassifier(
        loss_function="Logloss",
        eval_metric="Accuracy",
        iterations=800,
        depth=6,
        learning_rate=0.03,
        random_seed=42,
        verbose=0,
        auto_class_weights="Balanced",
    ),
    y=y_full,
)
full_learner = full_graph.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df})
test_pred = np.asarray(test_pred).ravel()
test_bool = (test_pred.astype(int) > 0).astype(bool)

submission = pd.DataFrame(
    {
        "PassengerId": pd.read_csv("./input/test.csv")["PassengerId"],
        "Transported": test_bool,
    }
)
submission.to_csv("submission.csv", index=False)
```
