import os
import numpy as np
import pandas as pd
import skrub
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

train_path = os.path.join("./input", "train.csv")
test_path = os.path.join("./input", "test.csv")

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "Transported"
metric_fn = accuracy_score

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)),
    test_size=0.2,
    random_state=42,
    stratify=train_df[target_col].astype(int),
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

def feature_engineering(df):
    out = df.copy()

    cabin_split = out["Cabin"].astype("string").str.split("/", expand=True)
    out["CabinDeck"] = cabin_split[0]
    out["CabinNum"] = pd.to_numeric(cabin_split[1], errors="coerce")
    out["CabinSide"] = cabin_split[2]

    name_split = out["Name"].astype("string").str.split(" ", n=1, expand=True)
    out["FirstName"] = name_split[0]
    out["FamilyName"] = name_split[1]

    spend_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
    out["TotalSpend"] = out[spend_cols].sum(axis=1)
    out["HasSpend"] = (out["TotalSpend"] > 0).astype("int64")
    out["ZeroSpendCount"] = (out[spend_cols].fillna(0) == 0).sum(axis=1)

    out["AgeGroup"] = pd.cut(
        out["Age"],
        bins=[-np.inf, 12, 18, 30, 45, 60, np.inf],
        labels=["child", "teen", "young_adult", "adult", "middle_age", "senior"],
    ).astype("string")

    out["SpendPerAge"] = out["TotalSpend"] / (out["Age"].fillna(out["Age"].median()) + 1.0)

    out = out.drop(columns=["Cabin", "Name"])
    return out

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

X_train_fe = X_train.skb.apply_func(feature_engineering)

cat_features = [
    "HomePlanet",
    "CryoSleep",
    "Destination",
    "VIP",
    "CabinDeck",
    "CabinSide",
    "FirstName",
    "FamilyName",
    "AgeGroup",
]

model = CatBoostClassifier(
    iterations=800,
    learning_rate=0.03,
    depth=6,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=42,
    allow_writing_files=False,
)

pred_graph = X_train_fe.skb.apply(model, y=y_train)
val_learner = pred_graph.skb.make_learner(fitted=True)

valid_pred = val_learner.predict({"data": valid_part})
valid_pred_bool = pd.Series(valid_pred).astype(int).to_numpy()

y_valid = valid_part[target_col].astype(int).to_numpy()
final_validation_score = metric_fn(y_valid, valid_pred_bool)
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
X_full = data_full.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].skb.mark_as_y()

X_full_fe = X_full.skb.apply_func(feature_engineering)

full_model = CatBoostClassifier(
    iterations=800,
    learning_rate=0.03,
    depth=6,
    loss_function="Logloss",
    eval_metric="Accuracy",
    verbose=0,
    random_seed=42,
    allow_writing_files=False,
)

full_pred_graph = X_full_fe.skb.apply(full_model, y=y_full)
full_learner = full_pred_graph.skb.make_learner(fitted=True)

test_pred = full_learner.predict({"data": test_df})
test_pred_bool = pd.Series(test_pred).astype(bool)

submission = pd.DataFrame(
    {
        "PassengerId": test_df["PassengerId"],
        "Transported": test_pred_bool,
    }
)
submission.to_csv("submission.csv", index=False)
```
