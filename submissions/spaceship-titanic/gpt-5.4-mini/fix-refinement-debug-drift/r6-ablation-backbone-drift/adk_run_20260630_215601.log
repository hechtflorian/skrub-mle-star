        df["SpentTotal"] = pd.to_numeric(df[numeric_cols], errors="coerce").fillna(0).sum(axis=1)
        df["NoSpend"] = (df["SpentTotal"] == 0).astype(int)
    return df

train_df = preprocess(train_df)
test_df = preprocess(test_df)

