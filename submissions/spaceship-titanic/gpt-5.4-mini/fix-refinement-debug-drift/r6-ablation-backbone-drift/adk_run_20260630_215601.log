import os
import numpy as np
import pandas as pd
import skrub
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from catboost import CatBoostClassifier

INPUT_DIR = "./input"
train_df = pd.read_csv(os.path.join(INPUT_DIR, "train.csv"))
test_df = pd.read_csv(os.path.join(INPUT_DIR, "test.csv"))
target_col = "Transported"

def preprocess(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    if "PassengerId" in df.columns:
        pid = df["PassengerId"].astype(str)
        pid_parts = pid.str.split("_", expand=True)
        if pid_parts.shape[1] >= 2:
            df["PassengerGroup"] = pid_parts[0]
            df["PassengerGroupNumber"] = pd.to_numeric(pid_parts[1], errors="coerce")
    if "Cabin" in df.columns:
        cabin_parts = df["Cabin"].astype(str).str.split("/", expand=True)
        if cabin_parts.shape[1] >= 3:
            df["CabinDeck"] = cabin_parts[0]
            df["CabinNum"] = pd.to_numeric(cabin_parts[1], errors="coerce")
            df["CabinSide"] = cabin_parts[2]
    if "Name" in df.columns:
        df["NameLength"] = df["Name"].fillna("").astype(str).str.len()
        df["Surname"] = df["Name"].fillna("").astype(str).str.split().str[-1]
    for col in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]:
        if col in df.columns:
            df[f"{col}_log1p"] = np.log1p(pd.to_numeric(df[col], errors="coerce").fillna(0))
    if all(c in df.columns for c in ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]):
        numeric_cols = ["RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"]
        df["SpentTotal"] = pd.to_numeric(df[numeric_cols], errors="coerce").fillna(0).sum(axis=1)
        df["NoSpend"] = (df["SpentTotal"] == 0).astype(int)
    return df

train_df = preprocess(train_df)
test_df = preprocess(test_df)

train_idx, valid_idx = train_test_split(
    np.arange(len(train_df)), test_size=0.2, random_state=42, stratify=train_df[target_col]
)
train_part = train_df.iloc[train_idx].copy()
valid_part = train_df.iloc[valid_idx].copy()

data_train = skrub.var("data", train_part)
X_train = data_train.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = data_train[target_col].skb.mark_as_y()

model = CatBoostClassifier(
    loss_function="Logloss",
    eval_metric="Accuracy",
    iterations=400,
    learning_rate=0.05,
    depth=6,
    random_seed=42,
    verbose=0,
)

pred_graph = X_train.skb.apply(model, y=y_train)
val_learner = pred_graph.skb.make_learner(fitted=True)
valid_pred = val_learner.predict({"data": valid_part})
valid_pred = np.asarray(valid_pred)
if valid_pred.dtype != bool:
    valid_pred = valid_pred.astype(str)
final_validation_score = accuracy_score(valid_part[target_col], valid_pred)
print(f"Final Validation Performance: {final_validation_score}")

data_full = skrub.var("data", train_df)
X_full = data_full.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_full = data_full[target_col].skb.mark_as_y()
full_pred_graph = X_full.skb.apply(model, y=y_full)
full_learner = full_pred_graph.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test_df})
test_pred = np.asarray(test_pred)
if test_pred.dtype != bool:
    test_pred = test_pred.astype(str)

submission = pd.DataFrame(
    {
        "PassengerId": test_df["PassengerId"],
        "Transported": test_pred,
    }
)
submission.to_csv("submission.csv", index=False)
```
