import os
import pandas as pd
import numpy as np
import skrub
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error

DATA_DIR = "./input"
TRAIN_PATH = os.path.join(DATA_DIR, "train.csv")
TEST_PATH = os.path.join(DATA_DIR, "test.csv")

train_df = pd.read_csv(TRAIN_PATH)
test_df = pd.read_csv(TEST_PATH)

target_col = "median_house_value"

# Keep a small holdout subsample for fast ablation while preserving the original subsampling workflow.
rng = np.random.RandomState(0)
indices = np.arange(len(train_df))
rng.shuffle(indices)
split = int(len(indices) * 0.8)
train_idx, val_idx = indices[:split], indices[split:]

train_subset = train_df.iloc[train_idx].copy()
val_subset = train_df.iloc[val_idx].copy()

# Optional target transform for skewed house-price targets:
# model the log1p target and invert with expm1 at prediction time.
use_log_target = True

def build_and_fit_learner(train_frame, vectorizer):
    data = skrub.var("data", train_frame)
    X = data.drop(columns=[target_col], errors="ignore").skb.mark_as_X()
    y = data[target_col].skb.mark_as_y()

    if use_log_target:
        y = y.skb.apply(np.log1p)

    X_vec = X.skb.apply(vectorizer)
    model = HistGradientBoostingRegressor(random_state=0)
    pred_graph = X_vec.skb.apply(model, y=y)
    return pred_graph.skb.make_learner(fitted=True)

def predict_with_inverse_transform(learner, frame):
    preds = learner.predict({"data": frame})
    if use_log_target:
        preds = np.expm1(preds)
    return preds

# Variant 1: default TableVectorizer path.
default_vectorizer = skrub.TableVectorizer()

# Variant 2: two-branch style via explicit tree-friendly encoding bias:
# keep numerics intact and use a stronger categorical encoder for high-cardinality text/categorical columns.
# This stays fixed and low-cost: no broad search, just a comparison against the default path.
alternative_vectorizer = skrub.TableVectorizer(
    high_cardinality=skrub.MinHashEncoder(n_components=16),
)

vectorizer_candidates = {
    "default_table_vectorizer": default_vectorizer,
    "minhash_high_cardinality": alternative_vectorizer,
}

best_variant = None
best_score = np.inf
best_learner = None

for variant_name, vectorizer in vectorizer_candidates.items():
    trained_learner = build_and_fit_learner(train_subset, vectorizer)
    val_pred = predict_with_inverse_transform(trained_learner, val_subset.drop(columns=[target_col], errors="ignore"))
    rmse = mean_squared_error(val_subset[target_col], val_pred) ** 0.5
    print(f"Ablation[{variant_name}] RMSE: {rmse}")

    if rmse < best_score:
        best_score = rmse
        best_variant = variant_name
        best_learner = trained_learner

final_validation_score = best_score
print(f"Best ablation variant: {best_variant} | RMSE: {best_score}")
print(f"Final Validation Performance: {final_validation_score}")

# Refit once on the full training data using the best preprocessing configuration.
chosen_vectorizer = vectorizer_candidates[best_variant]

full_learner = build_and_fit_learner(train_df, chosen_vectorizer)
test_pred = predict_with_inverse_transform(full_learner, test_df)

submission = pd.DataFrame({"median_house_value": test_pred})
submission.to_csv("submission.csv", index=False)
