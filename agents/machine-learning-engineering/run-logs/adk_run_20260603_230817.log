import os
import pandas as pd
import skrub
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error

train_path = "./input/train.csv"
test_path = "./input/test.csv"

train = pd.read_csv(train_path)
test = pd.read_csv(test_path)

target = "median_house_value"

data = skrub.var("data", train)
X = data.drop(columns=[target]).skb.mark_as_X()
y = data[target].skb.mark_as_y()

# Simple, fixed-parameter DataOps-native pipeline using the required model.
# Evaluation metric: RMSE on a hold-out validation set.
vectorizer = skrub.TableVectorizer()

regressor = HistGradientBoostingRegressor(
    learning_rate=0.05,
    max_depth=8,
    max_iter=500,
    min_samples_leaf=20,
    random_state=42,
)

pred_graph = X.skb.apply(vectorizer).skb.apply(regressor, y=y)

# Hold-out evaluation
train_df = train.copy()
n = len(train_df)
val_size = max(1, int(0.2 * n))
split_idx = n - val_size

train_part = train_df.iloc[:split_idx].reset_index(drop=True)
val_part = train_df.iloc[split_idx:].reset_index(drop=True)

train_env = {"data": train_part}
val_env = {"data": val_part}

X_train = skrub.var("data", train_part).drop(columns=[target]).skb.mark_as_X()
y_train = skrub.var("data", train_part)[target].skb.mark_as_y()

train_pred_graph = X_train.skb.apply(vectorizer).skb.apply(regressor, y=y_train)
learner = train_pred_graph.skb.make_learner(fitted=True)

val_pred = learner.predict(val_env)
final_validation_score = mean_squared_error(val_part[target], val_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

# Fit on full data for test predictions
full_pred_graph = pred_graph
full_learner = full_pred_graph.skb.make_learner(fitted=True)
test_pred = full_learner.predict({"data": test})

submission = pd.DataFrame({"median_house_value": test_pred})
submission.to_csv("submission.csv", index=False)
```
