import os
import pandas as pd
import skrub
from catboost import CatBoostRegressor
from sklearn.metrics import mean_squared_error

train_path = "./input/train.csv"
test_path = "./input/test.csv"

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "median_house_value"

data = skrub.var("data", train_df)
X = data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y = data[target_col].skb.mark_as_y()

# Simple DataOps-native preprocessing: numeric features go directly to CatBoost.
# CatBoost can handle numeric columns without extra encoding; keeping the path DataOps-first.
X_pipeline = X.skb.apply(lambda df: df)

model = CatBoostRegressor(
    loss_function="RMSE",
    depth=8,
    learning_rate=0.05,
    iterations=5000,
    subsample=0.8,
    random_seed=42,
    verbose=200,
    early_stopping_rounds=200,
)

pred = X_pipeline.skb.apply(model, y=y)

# Hold-out validation split using a DataOps-friendly dataframe split via pandas
# while keeping the main training path in DataOps primitives.
from sklearn.model_selection import train_test_split

train_idx, val_idx = train_test_split(train_df.index, test_size=0.2, random_state=42)
train_part = train_df.loc[train_idx].reset_index(drop=True)
val_part = train_df.loc[val_idx].reset_index(drop=True)

train_data = skrub.var("data", train_part)
val_data = skrub.var("data", val_part)

X_train = train_data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_train = train_data[target_col].skb.mark_as_y()
X_val = val_data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_val = val_data[target_col].skb.mark_as_y()

train_pred = X_train.skb.apply(
    CatBoostRegressor(
        loss_function="RMSE",
        depth=8,
        learning_rate=0.05,
        iterations=5000,
        subsample=0.8,
        random_seed=42,
        verbose=200,
        early_stopping_rounds=200,
    ),
    y=y_train,
)

learner = train_pred.skb.make_learner(fitted=True)
val_pred = learner.predict({"data": val_part.drop(columns=[target_col], errors="ignore")})
final_validation_score = mean_squared_error(val_part[target_col], val_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

test_env = {"data": test_df}
test_pred = learner.predict(test_env)

submission = pd.DataFrame({target_col: test_pred})
submission.to_csv("submission.csv", index=False)
```
