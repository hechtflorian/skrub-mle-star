[ablation_agent_1]: import os
import numpy as np
import pandas as pd
from sklearn.ensemble import HistGradientBoostingRegressor
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import train_test_split

import skrub
from skrub import DropCols, ApplyToCols, SquashingScaler
import skrub.selectors as s


def make_data_features(df, variant):
    """Build variant-specific feature blocks inside a deferred function."""
    if variant == "baseline":
        return df

    out = df.copy()

    if variant == "drop_households":
        # Redundancy ablation: households is highly correlated with multiple columns.
        out = out.drop(columns=["households"], errors="ignore")

    elif variant == "add_room_ratios":
        # Structural ablation: add a ratio feature to summarize correlated size columns.
        denom = out["households"].replace(0, np.nan) if "households" in out.columns else np.nan
        if "total_rooms" in out.columns and "households" in out.columns:
            out["rooms_per_household"] = (out["total_rooms"] / denom).replace(
                [np.inf, -np.inf], np.nan
            ).fillna(0.0)
        if "population" in out.columns and "households" in out.columns:
            out["population_per_household"] = (out["population"] / denom).replace(
                [np.inf, -np.inf], np.nan
            ).fillna(0.0)

    elif variant == "drop_latitude":
        # Geo redundancy ablation: longitude and latitude are strongly correlated.
        out = out.drop(columns=["latitude"], errors="ignore")

    elif variant == "scale_numeric":
        # Preprocessing ablation: squash numeric outliers before model fitting.
        # This stays within the same model family.
        return out

    return out


def build_pipeline(train_df, target_col, variant):
    data = skrub.var("data", train_df)
    data = data.skb.apply_func(lambda df: make_data_features(df, variant))

    X = data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
    y = data[target_col].skb.mark_as_y()

    if variant == "scale_numeric":
        X = X.skb.apply(ApplyToCols(SquashingScaler(max_absolute_value=3), cols=s.numeric()))
    elif variant == "drop_households":
        X = X.skb.apply(DropCols(cols=s.cols("households")))
    elif variant == "drop_latitude":
        X = X.skb.apply(DropCols(cols=s.cols("latitude")))

    # Keep the same model family and similar hyperparameters as the original solution.
    model = HistGradientBoostingRegressor(
        learning_rate=0.05,
        max_depth=8,
        max_iter=300,
        min_samples_leaf=20,
        l2_regularization=0.0,
        random_state=42,
    )

    pred = X.skb.apply(model, y=y)
    learner = pred.skb.make_learner(fitted=True)
    return learner


def evaluate_variant(train_df, valid_df, target_col, variant):
    learner = build_pipeline(train_df, target_col, variant)
    valid_pred = learner.predict({"data": valid_df})
    rmse = mean_squared_error(valid_df[target_col], valid_pred) ** 0.5
    print(f"Ablation[{variant}] RMSE: {rmse}")
    return rmse


def main():
    train_path = os.path.join("./input", "train.csv")
    train_df = pd.read_csv(train_path)

    target_col = "median_house_value"
    train_part, valid_part = train_test_split(train_df, test_size=0.2, random_state=42)

    variants = [
        "baseline",
        "drop_households",
        "add_room_ratios",
        "drop_latitude",
        "scale_numeric",
    ]

    scores = {}
    for variant in variants:
        scores[variant] = evaluate_variant(train_part, valid_part, target_col, variant)

    best_variant = min(scores, key=scores.get)
    best_score = scores[best_variant]
    baseline_score = scores["baseline"]

    print(f"Final Validation Performance: {baseline_score}")
    print(f"Best ablation variant: {best_variant} | RMSE: {best_score}")

    improvements = {k: baseline_score - v for k, v in scores.items() if k != "baseline"}
    best_improvement_variant = max(improvements, key=improvements.get)
    print(
        f"Most contributing part: {best_improvement_variant} "
        f"(RMSE improvement over baseline: {improvements[best_improvement_variant]})"
    )


if __name__ == "__main__":
    main()
