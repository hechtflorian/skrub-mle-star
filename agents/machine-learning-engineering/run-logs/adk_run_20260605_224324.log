import os
import pandas as pd
import numpy as np
import skrub
from catboost import CatBoostRegressor, Pool
from sklearn.metrics import mean_squared_error

# Paths
train_path = "./input/train.csv"
test_path = "./input/test.csv"

train_df = pd.read_csv(train_path)
test_df = pd.read_csv(test_path)

target_col = "median_house_value"

# DataOps-native variables
data = skrub.var("data", train_df)
X = data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y = data[target_col].skb.mark_as_y()

# Simple, fixed-parameter preprocessing/training path in DataOps workflow
# CatBoost can handle raw numeric tables directly; keep the pipeline DataOps-first.
# No hyperparameter search for this first solution.
model = CatBoostRegressor(
    loss_function="RMSE",
    depth=8,
    learning_rate=0.05,
    iterations=500,
    verbose=0,
    random_seed=42,
)

pred_graph = X.skb.apply(model, y=y)

# Fit/validation split for metric computation
from sklearn.model_selection import train_test_split
train_idx, val_idx = train_test_split(np.arange(len(train_df)), test_size=0.2, random_state=42)

train_part = train_df.iloc[train_idx].reset_index(drop=True)
val_part = train_df.iloc[val_idx].reset_index(drop=True)

train_data = skrub.var("data", train_part)
X_tr = train_data.drop(columns=target_col, errors="ignore").skb.mark_as_X()
y_tr = train_data[target_col].skb.mark_as_y()

fit_model = CatBoostRegressor(
    loss_function="RMSE",
    depth=8,
    learning_rate=0.05,
    iterations=500,
    verbose=0,
    random_seed=42,
)

train_pred_graph = X_tr.skb.apply(fit_model, y=y_tr)
learner = train_pred_graph.skb.make_learner(fitted=True)

val_preds = learner.predict({"data": val_part.drop(columns=[target_col], errors="ignore")})
rmse = mean_squared_error(val_part[target_col], val_preds) ** 0.5

# Train on full data and predict test
full_learner = pred_graph.skb.make_learner(fitted=True)
test_preds = full_learner.predict({"data": test_df})

submission = pd.DataFrame({target_col: test_preds})
submission.to_csv("submission.csv", index=False)

print(f"Final Validation Performance: {rmse}")
```
