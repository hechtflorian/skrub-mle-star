import os
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import skrub
import lightgbm as lgb
from sklearn.metrics import mean_squared_error

DATA_DIR = "./input"
TRAIN_PATH = os.path.join(DATA_DIR, "train.csv")
TEST_PATH = os.path.join(DATA_DIR, "test.csv")
TARGET_COL = "median_house_value"

train_df = pd.read_csv(TRAIN_PATH)
test_df = pd.read_csv(TEST_PATH)

data = skrub.var("data", train_df)
X = data.drop(columns=TARGET_COL, errors="ignore").skb.mark_as_X()
y = data[TARGET_COL].skb.mark_as_y()

vectorizer = skrub.TableVectorizer()
X_vec = X.skb.apply(vectorizer)

model = lgb.LGBMRegressor(
    n_estimators=2000,
    learning_rate=0.03,
    num_leaves=64,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=42,
)

pred = X_vec.skb.apply(model, y=y)

X_train_df = train_df.drop(columns=[TARGET_COL], errors="ignore")
X_train_enc = vectorizer.fit_transform(X_train_df)
X_val_enc = None

rng = np.random.RandomState(42)
idx = np.arange(len(train_df))
rng.shuffle(idx)
split = int(len(train_df) * 0.8)
tr_idx = idx[:split]
va_idx = idx[split:]

X_tr = train_df.iloc[tr_idx].drop(columns=[TARGET_COL], errors="ignore")
y_tr = train_df.iloc[tr_idx][TARGET_COL].astype(float)
X_va = train_df.iloc[va_idx].drop(columns=[TARGET_COL], errors="ignore")
y_va = train_df.iloc[va_idx][TARGET_COL].astype(float)

X_tr_enc = vectorizer.fit_transform(X_tr)
X_va_enc = vectorizer.transform(X_va)
model.fit(X_tr_enc, y_tr)
val_pred = model.predict(X_va_enc)

final_validation_score = mean_squared_error(y_va, val_pred) ** 0.5
print(f"Final Validation Performance: {final_validation_score}")

model.fit(vectorizer.fit_transform(train_df.drop(columns=[TARGET_COL], errors="ignore")), train_df[TARGET_COL].astype(float))
test_pred = model.predict(vectorizer.transform(test_df))

submission = pd.DataFrame({TARGET_COL: test_pred})
submission.to_csv("submission.csv", index=False)
```
