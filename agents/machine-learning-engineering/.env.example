# Copy as .env file and fill your values below
# Run ./update_dotenv_example.sh to update .env-example from your .env file.

# Choose Model Backend: 0 -> ML Dev, 1 -> Vertex (Gemini / Vertex)
GOOGLE_GENAI_USE_VERTEXAI=0

# Optional: only if some Google client code paths need Gemini API
#GOOGLE_API_KEY=YOUR_KEY_HERE

# --- Chat AI (SAIA) — OpenAI-compatible API (follows openai API standards) ---------------------------------
# ADK + LiteLLM: use prefix openai/<api-model-id> (not ollama/... or bare names).
OPENAI_API_KEY=YOUR_KEY_HERE
OPENAI_API_BASE=https://chat-ai.academiccloud.de/v1

