# Copy as .env file and fill your values below
# Run ./update_dotenv_example.sh to update .env-example from your .env file.

# Choose Model Backend: 0 -> ML Dev, 1 -> Vertex
GOOGLE_GENAI_USE_VERTEXAI=0 # set 0 for ChatAI (SAIA)

# Optional: only if some Google client code paths need Gemini API. Fill if using Google AI Studio.
# GOOGLE_API_KEY=Your_Value_Here

# --- Chat AI (SAIA) — OpenAI-compatible API ---------------------------------
# Docs: https://docs.hpc.gwdg.de/services/ai-services/saia/index.html
# ADK + LiteLLM: use prefix openai/<api-model-id> (not ollama/... or bare names).
# Note: Must set OpenAI to make agent use lightllm -> ChatAI (instead of gemini)
OPENAI_API_KEY=Your_Value_Here
OPENAI_API_BASE=https://chat-ai.academiccloud.de/v1

# Vertex backend config. Google Cloud (import still runs google.auth.default() in __init__)
# just fill in some existing one or dummy values
GOOGLE_CLOUD_PROJECT=Your_Value_Here
GOOGLE_CLOUD_LOCATION=Your_Value_Here

# ---- Values below this point are specific to MLE-STAR ----

# Live list of ids on your key:
#   curl -s -X POST https://chat-ai.academiccloud.de/v1/models \
#     -H "Authorization: Bearer $OPENAI_API_KEY" -H "Accept: application/json"
#
# Friendly name  →  SAIA "model" field (use after openai/)
# - OpenAI GPT OSS 120B     →  gpt-oss-120b (runs but can't conduct google web search)
# - Llama 3.1 8B Instruct     →  meta-llama-3.1-8b-instruct
# - Llama 3.3 70B Instruct    →  llama-3.3-70b-instruct
# - DeepSeek R1 Distill 70B   →  deepseek-r1-distill-llama-70b
# - Mistral Large (current)   →  mistral-large-3-675b-instruct-2512
# - Qwen3 coder (closest to “Coder 32B”) →  qwen3-coder-30b-a3b-instruct
# - Qwen3.5 72B-class + vision →  qwen3.5-122b-a10b
# - InternVL (vision; doc is v3.5 30B)     →  internvl3.5-30b-a3b
# - Devstral / Codestral-class coding      →  devstral-2-123b-instruct-2512
# - E5 Mistral 7B Instruct      →  e5-mistral-7b-instruct  (embeddings API only — do not use for chat)
#
# Names like “DeepSeek R1” (full), “InternVL2.5 8B”, “SauerkrautLM”, “Nemotron”, “Codestral 22B”,
# “Qwen 2.5 …” may differ on your tenant — confirm via /v1/models above.

# Models used in Agents (must use openai/ prefix for litellm to work)
ROOT_AGENT_MODEL=openai/gpt-oss-120b

# When OPENAI_API_BASE or an openai/ model is set, retrieval uses DuckDuckGo via
# a function tool instead of Gemini native Google Search to fix google search exceptions.
