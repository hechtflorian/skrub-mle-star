# Copy as .env file and fill your values below

# Choose Model Backend: 0 -> ML Dev, 1 -> Vertex (Gemini / Vertex)
GOOGLE_GENAI_USE_VERTEXAI=0

# Google API: only if some Google client code paths need Gemini API
#GOOGLE_API_KEY=YOUR_KEY_HERE

# OPENAI API
OPENAI_API_KEY=YOUR_KEY_HERE
OPENAI_API_BASE=https://api.openai.com/v1

# --- Chat AI (SAIA) — OpenAI-compatible API (follows openai API standards) ---------------------------------
# ADK + LiteLLM: use prefix openai/<api-model-id> (not ollama/... or bare names).
#OPENAI_API_KEY=YOUR_KEY_HERE
#OPENAI_API_BASE=https://chat-ai.academiccloud.de/v1                      

# --- Gemini API models: -------------------------------------------------------------
#ROOT_AGENT_MODEL='gemini-2.5-flash-lite'
#ROOT_AGENT_MODEL='gemini-2.5-flash'
#ROOT_AGENT_MODEL='gemini-2.5'

# --- OPENAI API models: -------------------------------------------------------------
ROOT_AGENT_MODEL='openai/gpt-5.4-mini'
#ROOT_AGENT_MODEL='openai/gpt-5.4'

# --- ChatAI open-weights models: -------------------------------------------------------------
#ROOT_AGENT_MODEL='openai/llama-3.3-70b-instruct'
#ROOT_AGENT_MODEL='openai/mistral-large-3-675b-instruct-2512'   # Best option so far
#ROOT_AGENT_MODEL='openai/openai-gpt-oss-120b'
#ROOT_AGENT_MODEL='openai/qwen3.5-122b-a10b'
#ROOT_AGENT_MODEL='openai/devstral-2-123b-instruct-2512'

# Added for ChatAI search compatibility:
# - Gemini models keep ADK's native google_search tool.
# - Non-Gemini models (e.g. openai/* via ChatAI) use DuckDuckGo search automatically.