#
# Search compatibility notes:
# - ADK google_search tool works only with Gemini models (hard check in google_search_tool.py).
# - For ChatAI openai/* models, use a separate web-search tool integration (e.g. Tavily/SerpAPI/DDGS).
# - "Recommended" above means capable for MLE-STAR + external web search tool skills (not GoogleSearchTool).
#
# MLE-STAR: one model id for all agents (pick a capable instruct/reasoning model for best results)
#ROOT_AGENT_MODEL='gemini-2.5-flash-lite'
#ROOT_AGENT_MODEL='openai/llama-3.3-70b-instruct'   # very good (crashed sometimes still needs fixing)
ROOT_AGENT_MODEL='openai/mistral-large-3-675b-instruct-2512'   # BEST so far - runs through! (sometimes: crashes right at ensemble due to context window limit)
#ROOT_AGENT_MODEL='openai/openai-gpt-oss-120b'  # fine, seems to get stuck in debugging
#ROOT_AGENT_MODEL='openai/qwen3.5-122b-a10b'    # very good (rate limit) + reasoning
#ROOT_AGENT_MODEL='openai/qwen3.5-397b-a17b'
#ROOT_AGENT_MODEL='openai/devstral-2-123b-instruct-2512'    # runs fine, crashes during debugging

# When OPENAI_API_BASE or an openai/ model is set, retrieval uses DuckDuckGo via
# a function tool instead of Gemini native Google Search to fix google search exceptions.
